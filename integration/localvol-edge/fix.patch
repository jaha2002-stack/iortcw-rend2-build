+#if defined(USE_LOCAL_MULTISAMPLE_COVERAGE)
+#define MAX_LOCAL_COVERAGE_SAMPLES 32
+
+float localSampleDepth(ivec2 pixel, int index, float depthCap)
+{
+    float depth = texelFetch(u_ScreenDepthMap, pixel, index).r - DEPTH_MAX_ERROR;
+    return min(1.0 / mix(u_ViewInfo.x, 1.0, depth), depthCap);
+}
+
+vec4 resolveLocalCoverage(vec3 rayDir, float rayLength, float maxDistance, int mode)
+{
+    vec4 reconstructed = vec4(texture2D(u_TextureMap, var_DepthTex).rgb, 0.0);
+    float segmentStart, segmentEnd;
+    if (!raySphereSegment(u_ViewOrigin, rayDir, u_PrimaryLightOrigin.xyz,
+                         max(u_PrimaryLightOrigin.w, 1.0), maxDistance, segmentStart, segmentEnd))
+        return reconstructed;
+
+    // Coverage beyond the sphere cannot change the integral.
+    float depthCap = segmentEnd / rayLength;
+    ivec2 pixel = ivec2(gl_FragCoord.xy);
+    int sampleCount = int(u_LocalCoverageInfo.x + 0.5);
+    float nearest = depthCap;
+    float farthest = 0.0;
+    for (int index = 0; index < MAX_LOCAL_COVERAGE_SAMPLES; ++index)
+    {
+        if (index >= sampleCount)
+            break;
+        float depth = localSampleDepth(pixel, index, depthCap);
+        nearest = min(nearest, depth);
+        farthest = max(farthest, depth);
+    }
+
+    // Retain the filtered half-resolution result on continuous surfaces.
+    if (farthest - nearest <= 0.06 * max(nearest, 1.0 / u_ViewInfo.y))
+        return reconstructed;
+
+    float splitDepth = 0.5 * (nearest + farthest);
+    float nearSum = 0.0;
+    float farSum = 0.0;
+    float nearCount = 0.0;
+    float farCount = 0.0;
+    for (int index = 0; index < MAX_LOCAL_COVERAGE_SAMPLES; ++index)
+    {
+        if (index >= sampleCount)
+            break;
+        float depth = localSampleDepth(pixel, index, depthCap);
+        if (depth < splitDepth)
+        {
+            nearSum += depth;
+            nearCount += 1.0;
+        }
+        else
+        {
+            farSum += depth;
+            farCount += 1.0;
+        }
+    }
+    if (nearCount < 1.0 || farCount < 1.0)
+        return reconstructed;
+
+    // Use the producer's inverted Y grid for the accepted lamp jitter.
+    vec2 viewUV = (var_DepthTex - u_LocalViewRect.xy) / u_LocalViewRect.zw;
+    vec2 jitterPixel = floor(vec2(viewUV.x, 1.0 - viewUV.y) * u_LocalCoverageInfo.yz);
+    vec4 nearLight = localScatter(rayDir, rayLength * (nearSum / nearCount), mode, jitterPixel);
+    vec4 farLight = localScatter(rayDir, rayLength * (farSum / farCount), mode, jitterPixel);
+    return mix(nearLight, farLight, farCount / float(sampleCount));
+}
+#endif
+
+void main()
+{
+    int mode = int(clamp(u_EnableTextures.w, 1.0, 9.0) + 0.5);
+    float rayLength = max(length(var_ViewDir), 0.0001);
+    vec3 rayDir = var_ViewDir / rayLength;
+    float maxDistance = max(u_Color.w, 1.0);
+#if defined(USE_LOCAL_MULTISAMPLE_COVERAGE)
+    gl_FragColor = resolveLocalCoverage(rayDir, rayLength, maxDistance, mode);
+#else
+    // v0.7.2 isolation: mode 9 keeps the exact view-ray and sphere intersection
+    // but removes only scene-depth clipping. All other modes are byte-behavior equivalent.
+    if (mode != 9)
+    {
+        float sceneDepth = getLinearDepth(u_ScreenDepthMap, var_DepthTex, u_ViewInfo.x);
+        float sceneDistance = rayLength * sceneDepth;
+        maxDistance = min(sceneDistance, maxDistance);
+    }
+    gl_FragColor = localScatter(rayDir, maxDistance, mode, gl_FragCoord.xy);
+#endif
 }
