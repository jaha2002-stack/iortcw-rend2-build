#include "ui/menudef.h"

{
menuDef {
 name "darkwolf_developer"
 visible 0
 fullscreen 0
 rect 55 45 530 390
 focusColor 1 .75 0 1
 style WINDOW_STYLE_FILLED
 border WINDOW_BORDER_FULL
 borderSize 1
 backcolor 0.02 0.02 0.02 0.97
 bordercolor .45 .32 .18 .95
 onOpen { hide dev_static ; hide dev_shadow ; hide dev_material ; hide dev_fire ; show dev_static }
 onESC { close darkwolf_developer }

