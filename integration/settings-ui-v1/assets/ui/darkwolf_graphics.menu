    itemDef { name ad_wide group dw_advanced rect 367 176 92 20 type ITEM_TYPE_BUTTON text "WIDE INSPECT" textscale .16 textalign ITEM_ALIGN_CENTER textalignx 46 textaligny 14 forecolor 1 1 1 1 backcolor .12 .12 .12 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .35 .35 .35 .8 visible 0 action { exec "r_staticPromoteWideInspect" } }
