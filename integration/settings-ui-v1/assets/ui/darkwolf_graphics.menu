    itemDef { name restart rect 18 330 125 22 type ITEM_TYPE_BUTTON text "APPLY / RESTART" textscale .18 textalign ITEM_ALIGN_CENTER textalignx 62 textaligny 15 forecolor 1 1 1 1 backcolor .16 .28 .16 .95 style WINDOW_STYLE_FILLED border 1 bordercolor .45 .55 .45 .9 visible 1 action { exec "vid_restart" } }

