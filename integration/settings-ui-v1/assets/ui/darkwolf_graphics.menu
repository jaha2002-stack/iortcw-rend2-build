#include "ui/menudef.h"

{
menuDef {
    name "darkwolf_graphics"
    visible 0
    fullscreen 0
    rect 70 55 500 370
    focusColor 1 .75 0 1
    style WINDOW_STYLE_FILLED
    border WINDOW_BORDER_FULL
    borderSize 1
    backcolor 0.02 0.02 0.02 0.96
    bordercolor .40 .48 .40 .90
    onOpen { hide dw_core ; hide dw_lighting ; hide dw_effects ; hide dw_advanced ; show dw_core }
    onESC { close darkwolf_graphics }

    itemDef { name title rect 0 0 500 28 type ITEM_TYPE_TEXT text "DARKWOLF / ioRTCW REND2 GRAPHICS" textscale .30 textalign ITEM_ALIGN_CENTER textalignx 250 textaligny 20 forecolor 1 1 1 1 visible 1 decoration }

    itemDef { name tab_core rect 18 32 108 18 type ITEM_TYPE_BUTTON text "GRAPHICS" textscale .20 textalign ITEM_ALIGN_CENTER textalignx 54 textaligny 13 forecolor 1 1 1 1 backcolor .12 .22 .12 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .4 .5 .4 .7 visible 1 action { hide dw_core ; hide dw_lighting ; hide dw_effects ; hide dw_advanced ; show dw_core } }
    itemDef { name tab_lighting rect 136 32 108 18 type ITEM_TYPE_BUTTON text "LIGHTING" textscale .20 textalign ITEM_ALIGN_CENTER textalignx 54 textaligny 13 forecolor 1 1 1 1 backcolor .12 .22 .12 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .4 .5 .4 .7 visible 1 action { hide dw_core ; hide dw_lighting ; hide dw_effects ; hide dw_advanced ; show dw_lighting } }
    itemDef { name tab_effects rect 254 32 108 18 type ITEM_TYPE_BUTTON text "EFFECTS" textscale .20 textalign ITEM_ALIGN_CENTER textalignx 54 textaligny 13 forecolor 1 1 1 1 backcolor .12 .22 .12 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .4 .5 .4 .7 visible 1 action { hide dw_core ; hide dw_lighting ; hide dw_effects ; hide dw_advanced ; show dw_effects } }
    itemDef { name tab_advanced rect 372 32 108 18 type ITEM_TYPE_BUTTON text "ADVANCED" textscale .20 textalign ITEM_ALIGN_CENTER textalignx 54 textaligny 13 forecolor 1 1 1 1 backcolor .12 .22 .12 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .4 .5 .4 .7 visible 1 action { hide dw_core ; hide dw_lighting ; hide dw_effects ; hide dw_advanced ; show dw_advanced } }

    itemDef { name profile_label rect 18 58 90 15 type ITEM_TYPE_TEXT text "PROFILE:" textscale .20 textaligny 12 forecolor .8 .9 .8 1 visible 1 decoration }
    itemDef { name p_perf rect 105 57 82 18 type ITEM_TYPE_BUTTON text "PERFORMANCE" textscale .17 textalign ITEM_ALIGN_CENTER textalignx 41 textaligny 13 forecolor 1 1 1 1 backcolor .10 .10 .10 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .35 .35 .35 .8 visible 1 action { exec "exec darkwolf/profiles/performance.cfg" } }
    itemDef { name p_quality rect 191 57 82 18 type ITEM_TYPE_BUTTON text "QUALITY" textscale .18 textalign ITEM_ALIGN_CENTER textalignx 41 textaligny 13 forecolor 1 1 1 1 backcolor .10 .10 .10 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .35 .35 .35 .8 visible 1 action { exec "exec darkwolf/profiles/quality.cfg" } }
