    itemDef { name p_cine rect 375 57 105 18 type ITEM_TYPE_BUTTON text "CINEMATIC" textscale .18 textalign ITEM_ALIGN_CENTER textalignx 52 textaligny 13 forecolor 1 1 1 1 backcolor .10 .10 .10 .9 style WINDOW_STYLE_FILLED border 1 bordercolor .35 .35 .35 .8 visible 1 action { exec "exec darkwolf/profiles/cinematic.cfg" } }

