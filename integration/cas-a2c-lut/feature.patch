+// DARKWOLF_CAS_A2C_LUT_V01: after tone map, Bloom, sun rays and bokeh,
+// before resolve-to-screen, never touches HDR donors/shadows/SSGI or UI.
+static void RB_DWFinalPolish(FBO_t *srcFbo, ivec4_t srcBox)
+{
+	vec4_t parms, bounds;
+	int lutIndex;
+	float cas = (r_dwCas && r_dwCas->integer) ? Com_Clamp(0.0f, 0.75f, r_dwCasStrength->value) : 0.0f;
+	float lut = (r_dwLut && r_dwLut->integer) ? Com_Clamp(0.0f, 1.0f, r_dwLutStrength->value) : 0.0f;
+	if (cas <= 0.0f && lut <= 0.0f)
+		return; // exact old framebuffer path, no draw/bind/copy when disabled
+	if (!srcFbo || !srcFbo->colorImage[0] || !tr.screenScratchFbo ||
+		!tr.screenScratchFbo->colorImage[0] || srcFbo == tr.screenScratchFbo ||
+		!tr.dwFinalPolishShader.program || srcBox[2] <= 0 || srcBox[3] <= 0)
+		return;
+	// This shader is LDR-only: do not alter HDR energy when tone mapping is disabled.
+	if (!r_hdr || !r_hdr->integer ||
+		!(r_toneMap->integer || r_forceToneMap->integer))
+		return;
+	lutIndex = r_dwLutMode ? Com_Clamp(0, 2, r_dwLutMode->integer) : 0;
+	if (!tr.dwColorLutImages[lutIndex])
+		lut = 0.0f;
+	if (lut <= 0.0f && cas <= 0.0f)
+		return;
+	VectorSet4(parms, cas, lut, 0.0f, 0.0f);
+	VectorSet4(bounds,
+		(srcBox[0] + 0.5f) / (float)srcFbo->width,
+		(srcBox[1] + 0.5f) / (float)srcFbo->height,
+		(srcBox[0] + srcBox[2] - 0.5f) / (float)srcFbo->width,
+		(srcBox[1] + srcBox[3] - 0.5f) / (float)srcFbo->height);
+	GLSL_BindProgram(&tr.dwFinalPolishShader);
+	GLSL_SetUniformVec4(&tr.dwFinalPolishShader, UNIFORM_VIEWINFO, bounds);
+	// When CAS runs alone, bind a valid harmless sampler rather than relying on stale GL bindings.
+	GL_BindToTMU(lut > 0.0f ? tr.dwColorLutImages[lutIndex] : tr.whiteImage, TB_LEVELSMAP);
+	FBO_Blit(srcFbo, srcBox, NULL, tr.screenScratchFbo, srcBox,
+		&tr.dwFinalPolishShader, parms, 0);
+	FBO_FastBlit(tr.screenScratchFbo, srcBox, srcFbo, srcBox, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+}
+
 const void *RB_PostProcess(const void *data)
 {
 	const postProcessCommand_t *cmd = data;
@@ -9441,6 +9480,7 @@ const void *RB_PostProcess(const void *data)
 	else
 		RB_GaussianBlur(srcFbo, srcFbo, backEnd.refdef.blurFactor);
 	RB_USLRDRootCauseSampleStage(srcFbo, srcBox, s_uslrdRcAfterBokeh);
+	RB_DWFinalPolish(srcFbo, srcBox); // DARKWOLF_CAS_A2C_LUT_V01
 
