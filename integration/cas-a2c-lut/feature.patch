+// DARKWOLF_CAS_A2C_LUT_V01: independent 16^3 look-up-table atlases (256x16, 4 channels).
+// LDR display-space grading. All profiles are explicit, not automatically selected by maps.
+static void DW_CreateColorLuts(void)
+{
+	byte rgba[256 * 16 * 4];
+	int mode, r, g, b;
+	if (!r_dwLut || !r_dwLut->integer)
+		return; // no extra images or VRAM in the disabled stock profile
+	for (mode = 0; mode < 3; ++mode)
+	{
+		for (b = 0; b < 16; ++b)
+		for (g = 0; g < 16; ++g)
+		for (r = 0; r < 16; ++r)
+		{
+			float c[3] = { r / 15.0f, g / 15.0f, b / 15.0f };
+			float l = 0.2126f * c[0] + 0.7152f * c[1] + 0.0722f * c[2];
+			int index = ((g * 256) + b * 16 + r) * 4;
+			if (mode == 1) // subtle warm highlights, cool shadows
+			{
+				c[0] *= 1.0f + 0.070f * l;
+				c[1] *= 1.0f + 0.008f * l;
+				c[2] = c[2] * (1.0f - 0.046f * l) + 0.012f * (1.0f - l);
+			}
+			if (mode == 2) // cool industrial grade; neutral highlights
+			{
+				c[0] *= 1.0f - 0.065f * (1.0f - l);
+				c[1] *= 1.0f + 0.005f * (1.0f - l);
+				c[2] = c[2] * (1.0f + 0.070f * (1.0f - l));
+			}
+			for (int k = 0; k < 3; ++k)
+				rgba[index + k] = (byte)(Com_Clamp(0.0f, 1.0f, c[k]) * 255.0f + 0.5f);
+			rgba[index + 3] = 255;
+		}
+		tr.dwColorLutImages[mode] = R_CreateImage(
+			va("*dwColorLut%d", mode), rgba, 256, 16, IMGTYPE_COLORALPHA,
+			IMGFLAG_NO_COMPRESSION | IMGFLAG_NOLIGHTSCALE | IMGFLAG_CLAMPTOEDGE, GL_RGBA8);
+	}
+}
+
