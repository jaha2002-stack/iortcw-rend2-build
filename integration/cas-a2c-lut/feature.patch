new file mode 100644
index 0000000..54d4e44
--- /dev/null
+++ b/SP/code/rend2/glsl/dwfinal_fp.glsl
@@ -0,0 +1,51 @@
+// DARKWOLF_CAS_A2C_LUT_V01: optional adaptive sharpen and LUT in one draw.
+// Not a verbatim AMD FidelityFX CAS reference implementation.
+uniform sampler2D u_TextureMap;
+uniform sampler2D u_LevelsMap; // manually trilinearly sampled 16^3 LUT atlas
+uniform vec2 u_InvTexRes;
+uniform vec4 u_ViewInfo; // normalized viewport bounds, half-texel inset
+uniform vec4 u_Color;    // x = sharpen [0..0.75]; y = LUT mix [0..1]
+varying vec2 var_Tex1;
+
+vec3 DW_CAS(vec2 uv, vec3 center)
+{
+    vec2 lo = u_ViewInfo.xy;
+    vec2 hi = u_ViewInfo.zw;
+    vec3 n = texture2D(u_TextureMap, clamp(uv + vec2(0.0, -u_InvTexRes.y), lo, hi)).rgb;
+    vec3 s = texture2D(u_TextureMap, clamp(uv + vec2(0.0,  u_InvTexRes.y), lo, hi)).rgb;
+    vec3 w = texture2D(u_TextureMap, clamp(uv + vec2(-u_InvTexRes.x, 0.0), lo, hi)).rgb;
+    vec3 e = texture2D(u_TextureMap, clamp(uv + vec2( u_InvTexRes.x, 0.0), lo, hi)).rgb;
+    vec3 mn = min(center, min(min(n,s), min(w,e)));
+    vec3 mx = max(center, max(max(n,s), max(w,e)));
+    vec3 headroom = max(min(mn, 1.0 - mx), vec3(0.0));
+    vec3 attenuation = sqrt(clamp(headroom / max(mx, vec3(0.0001)), 0.0, 1.0));
+    vec3 weight = (-0.125 * clamp(u_Color.x, 0.0, 0.75)) * attenuation;
+    vec3 sharpened = (center + weight * (n + s + w + e)) / (1.0 + 4.0 * weight);
+    return clamp(sharpened, 0.0, 1.0);
+}
+
+vec3 DW_AtlasSlice(vec3 rgb, float sliceIndex)
+{
+    float x = (sliceIndex * 16.0 + rgb.r * 15.0 + 0.5) / 256.0;
+    float y = (rgb.g * 15.0 + 0.5) / 16.0;
+    return texture2D(u_LevelsMap, vec2(x, y)).rgb;
+}
+
+vec3 DW_Lut(vec3 rgb)
+{
+    vec3 v = clamp(rgb, 0.0, 1.0);
+    float z = v.b * 15.0;
+    float z0 = floor(z);
+    return mix(DW_AtlasSlice(v, z0), DW_AtlasSlice(v, min(z0 + 1.0, 15.0)), fract(z));
+}
+
+void main()
+{
+    vec4 scene = texture2D(u_TextureMap, var_Tex1);
+    vec3 rgb = clamp(scene.rgb, 0.0, 1.0);
+    if (u_Color.x > 0.0)
+        rgb = DW_CAS(var_Tex1, rgb);
+    if (u_Color.y > 0.0)
+        rgb = mix(rgb, DW_Lut(rgb), clamp(u_Color.y, 0.0, 1.0));
+    gl_FragColor = vec4(rgb, scene.a);
+}
