+static qboolean R_IFLC_SelectedEditable(void)
+{
+	if (!R_IFLC_ReadyForCommand()) return qfalse;
+	if (s_iflcSelected < 0 || s_iflcSelected >= s_iflcOwnerCount) { ri.Printf(PRINT_ALL, "IFLC: no unambiguous selection; use dw_fl_select / dw_fl_next.\n"); return qfalse; }
+	if (s_iflcOwners[s_iflcSelected].ambiguous) { ri.Printf(PRINT_WARNING, "IFLC: physical owner is ambiguous; no settings changed.\n"); return qfalse; }
+	return qtrue;
+}
