+static const char *R_IFLC_Route(const iflcOwner_t *owner)
+{
+	return owner->kind == IFLC_NATIVE ? "NATIVE_FIRE" : owner->kind == IFLC_PROMOTED ? "PROMOTED_FIRE" : "VOLUME_ONLY";
