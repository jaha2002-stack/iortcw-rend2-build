+void R_IFLC_Info_f(void)
+{
+	const iflcOwner_t *owner;
+	const iflcProfile_t *p;
+	if (!R_IFLC_ReadyForCommand()) return;
+	if (s_iflcSelected < 0 || s_iflcSelected >= s_iflcOwnerCount) { ri.Printf(PRINT_ALL, "IFLC: no selection. Use dw_fl_select.\n"); return; }
+	owner = &s_iflcOwners[s_iflcSelected]; p = R_IFLC_ProfileForOwner(s_iflcSelected, qfalse);
+	ri.Printf(PRINT_ALL, "IFLC: map=%s bsp=%08x key=%s route=%s anchor=(%.1f %.1f %.1f) surfaces=%d\n",
+		s_iflcMap, s_iflcFingerprint, owner->key, R_IFLC_Route(owner), owner->origin[0], owner->origin[1], owner->origin[2], owner->surfaceCount);
+	ri.Printf(PRINT_ALL, "IFLC: editable=%s realDlights=%d baseRadius=%.2f currentRadius=%.2f worldContainment=%d shadowClass=%d\n",
+		owner->ambiguous ? "NO_AMBIGUOUS_OWNER" : "YES", owner->runtimeCount, owner->baseRadius, owner->currentRadius, owner->worldContainment, owner->shadowClass);
+	ri.Printf(PRINT_ALL, "IFLC: shadowSlot=%d dynamicShadowBudget=%d (-1=none -2=not-captured)\n", owner->shadowSlot,
+		r_dlightShadowMaxLights ? r_dlightShadowMaxLights->integer : 0);
+	ri.Printf(PRINT_ALL, "IFLC: direct=%.3f radius=%.3f volume=%.3f enabled=%d colorOverride=%d master=%d profile=%s\n",
+		p ? p->direct : 1.0f, p ? p->radius : 1.0f, p ? p->volume : 1.0f, p ? p->enabled : 0, p ? p->colorEnabled : 0,
+		r_dwFireLightControl ? r_dwFireLightControl->integer : 0, s_iflcDirty ? "UNSAVED" : (p ? "SAVED" : "BASELINE"));
+	if (owner->runtimeCount > 1) ri.Printf(PRINT_WARNING, "IFLC: duplicate real owners; direct override blocked until ownership is unique.\n");
+	if (owner->surfaceCount > 1) ri.Printf(PRINT_ALL, "IFLC: these flame surfaces share one physical light; direct controls that owner.\n");
+	if (owner->blockedReason) ri.Printf(PRINT_ALL, "IFLC: direct bridge blocked=%d (1=global-light-off 2=containment-off 3=PVS/area 4=MAX_DLIGHTS 5=nearby-owner 6=solid-anchor 7=new-learned-owner).\n", owner->blockedReason);
+	if (owner->blockedReason == 7) ri.Printf(PRINT_ALL, "IFLC: StaticPromote ownership changed after selection; remove/reset this opt-in profile and reload the map before editing its promoted owner.\n");
+	if (r_dynamiclight->integer == 0 || r_dlightScale->value <= 0.0f) ri.Printf(PRINT_ALL, "IFLC: global direct lighting disabled by r_dynamiclight/r_dlightScale.\n");
+	if (r_dwFireLightControl && !r_dwFireLightControl->integer) ri.Printf(PRINT_ALL, "IFLC: overrides OFF; use r_dwFireLightControl 1 to apply.\n");
+}
