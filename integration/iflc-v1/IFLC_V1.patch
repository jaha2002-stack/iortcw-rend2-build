+void R_IFLC_Set_f(void)
+{
+	iflcProfile_t candidate, *p;
+	const char *parameter;
+	int i, argc = ri.Cmd_Argc();
+	if (!R_IFLC_SelectedEditable()) return;
+	if (argc < 3) { ri.Printf(PRINT_ALL, "Usage: dw_fl_set direct|radius|volume <value>; color <r> <g> <b>; enabled 0|1\n"); return; }
+	p = R_IFLC_ProfileForOwner(s_iflcSelected, qfalse);
+	if (p) candidate = *p;
+	else { memset(&candidate, 0, sizeof(candidate)); candidate.used = qtrue; candidate.owner = s_iflcSelected; candidate.direct = candidate.radius = candidate.volume = 1.0f; VectorSet(candidate.color, 1.0f, 1.0f, 1.0f); }
+	parameter = ri.Cmd_Argv(1);
+	if (!strcmp(parameter, "color")) {
+		if (argc != 5) goto invalid;
+		for (i = 0; i < 3; ++i) if (!R_IFLC_Float(ri.Cmd_Argv(i + 2), 0.0f, 1.0f, &candidate.color[i])) goto invalid;
+		if (candidate.color[0] + candidate.color[1] + candidate.color[2] <= 0.0f) goto invalid;
+		candidate.colorEnabled = 1;
+	} else {
+		if (argc != 3) goto invalid;
+		if (!strcmp(parameter, "direct")) { if (!R_IFLC_Float(ri.Cmd_Argv(2), 0.0f, 3.0f, &candidate.direct)) goto invalid; }
+		else if (!strcmp(parameter, "radius")) { if (!R_IFLC_Float(ri.Cmd_Argv(2), 0.25f, 2.0f, &candidate.radius)) goto invalid; }
+		else if (!strcmp(parameter, "volume")) { if (!R_IFLC_Float(ri.Cmd_Argv(2), 0.0f, 3.0f, &candidate.volume)) goto invalid; }
+		else if (!strcmp(parameter, "enabled")) {
+			if (s_iflcOwners[s_iflcSelected].kind != IFLC_SURFACE || !R_IFLC_Integer(ri.Cmd_Argv(2), 0, 1, &candidate.enabled)) goto invalid;
+		} else goto invalid;
+	}
+	p = R_IFLC_ProfileForOwner(s_iflcSelected, qtrue);
+	if (!p) { ri.Printf(PRINT_WARNING, "IFLC: profile limit reached; no changes.\n"); return; }
+	*p = candidate; s_iflcDirty = qtrue;
+	ri.Printf(PRINT_ALL, "IFLC: updated %s (%s); use dw_fl_save to persist.\n", s_iflcOwners[s_iflcSelected].key, parameter);
+	if (!r_dwFireLightControl->integer) ri.Printf(PRINT_ALL, "IFLC: overrides OFF; use r_dwFireLightControl 1.\n");
+	return;
+invalid:
+	ri.Printf(PRINT_WARNING, "IFLC: invalid value; direct/volume 0..3, radius 0.25..2, color 0..1 nonzero, enabled 0|1 for VOLUME_ONLY. No changes.\n");
+}
+
+void R_IFLC_Reset_f(void)
+{
+	iflcProfile_t *p;
+	if (!R_IFLC_SelectedEditable()) return;
+	p = R_IFLC_ProfileForOwner(s_iflcSelected, qfalse);
+	if (p) { memset(p, 0, sizeof(*p)); s_iflcDirty = qtrue; }
+	ri.Printf(PRINT_ALL, "IFLC: %s reset to baseline; save to persist the reset.\n", s_iflcOwners[s_iflcSelected].key);
+}
+
+static qboolean R_IFLC_VerifyFile(const char *path, const void *expected, int length)
+{
+	void *raw = NULL;
+	long got = ri.FS_ReadFile(path, &raw);
+	qboolean equal = raw && got == length && !memcmp(raw, expected, length);
+	if (raw) ri.FS_FreeFile(raw);
+	return equal;
+}
+
+void R_IFLC_Save_f(void)
+{
+	char *buffer, line[512], path[MAX_QPATH + 32], temporary[MAX_QPATH + 32], backup[MAX_QPATH + 32];
+	void *previous = NULL;
+	long previousLength;
+	int i, count = 0, used;
+	if (!R_IFLC_ReadyForCommand()) return;
+	for (i = 0; i < IFLC_MAX_PROFILES; ++i) if (s_iflcProfiles[i].used) ++count;
+	buffer = (char *)ri.Z_Malloc(IFLC_FILE_LIMIT);
+	Com_sprintf(buffer, IFLC_FILE_LIMIT, "DW_IFLC 1\nmap %s\nbsp %08x\ncount %d\n", s_iflcMap, s_iflcFingerprint, count);
+	used = (int)strlen(buffer);
+	for (i = 0; i < IFLC_MAX_PROFILES; ++i) {
+		const iflcProfile_t *p = &s_iflcProfiles[i];
+		int size;
+		if (!p->used) continue;
+		Com_sprintf(line, sizeof(line), "fixture %s %.9g %.9g %.9g %d %d %.9g %.9g %.9g\n",
+			s_iflcOwners[p->owner].key, p->direct, p->radius, p->volume, p->enabled, p->colorEnabled, p->color[0], p->color[1], p->color[2]);
+		size = (int)strlen(line);
+		if (used + size + 5 >= IFLC_FILE_LIMIT) { ri.Printf(PRINT_WARNING, "IFLC: save size overflow; nothing written.\n"); ri.Free(buffer); return; }
+		memcpy(buffer + used, line, size); used += size;
+	}
+	memcpy(buffer + used, "end\n", 4); used += 4;
+	R_IFLC_ProfilePath(path, sizeof(path), ""); R_IFLC_ProfilePath(temporary, sizeof(temporary), ".tmp"); R_IFLC_ProfilePath(backup, sizeof(backup), ".bak");
+	/* Renderer FS has no rename API. Verify staging and preserve a verified backup
+	 * before replacing the destination; report every failed read-back explicitly. */
+	ri.FS_WriteFile(temporary, buffer, used);
+	if (!R_IFLC_VerifyFile(temporary, buffer, used)) { ri.Printf(PRINT_WARNING, "IFLC: temporary write failed; saved profile unchanged.\n"); ri.Free(buffer); return; }
+	previousLength = ri.FS_ReadFile(path, NULL);
+	if (previousLength > IFLC_FILE_LIMIT) { ri.Printf(PRINT_WARNING, "IFLC: existing profile too large to back up; save refused.\n"); ri.Free(buffer); return; }
+	if (previousLength >= 0) {
+		previousLength = ri.FS_ReadFile(path, &previous);
+		if (previousLength < 0 || previousLength > IFLC_FILE_LIMIT || !previous) { ri.Printf(PRINT_WARNING, "IFLC: cannot read bounded existing profile for backup; save refused.\n"); if (previous) ri.FS_FreeFile(previous); ri.Free(buffer); return; }
+		ri.FS_WriteFile(backup, previous, (int)previousLength);
+		if (!R_IFLC_VerifyFile(backup, previous, (int)previousLength)) { ri.Printf(PRINT_WARNING, "IFLC: backup verification failed; save refused.\n"); ri.FS_FreeFile(previous); ri.Free(buffer); return; }
+	}
+	ri.FS_WriteFile(path, buffer, used);
+	if (!R_IFLC_VerifyFile(path, buffer, used)) {
+		if (previous) ri.FS_WriteFile(path, previous, (int)previousLength);
+		ri.Printf(PRINT_WARNING, "IFLC: final write/read-back failed; settings remain UNSAVED. Previous data retained in .bak when available.\n");
+	} else { s_iflcDirty = qfalse; ri.Printf(PRINT_ALL, "IFLC: saved and verified %d profiles in %s.\n", count, path); }
+	if (previous) ri.FS_FreeFile(previous);
+	ri.Free(buffer);
+}
+
+void R_IFLC_Reload_f(void)
+{
+	if (!R_IFLC_ReadyForCommand()) return;
+	R_IFLC_LoadProfile(qtrue);
+}
