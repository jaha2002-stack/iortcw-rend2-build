+}
+
+static int R_IFLC_DlightOwner(const dlight_t *dl)
+{
+	int i, found = -1;
+	for (i = 0; i < s_iflcOwnerCount; ++i) {
+		const iflcOwner_t *owner = &s_iflcOwners[i];
+		qboolean match = qfalse;
+		if (owner->kind == IFLC_SURFACE) continue;
+		if (dl->nativeAuthoredDlight && owner->nativeOrdinal >= 0) {
+			if (dl->fireVolumetricNativeOrdinal >= 0) match = dl->fireVolumetricNativeOrdinal == owner->nativeOrdinal;
+			else match = R_IFLC_DistanceSquared(dl->origin, owner->origin) <= 16.0f * 16.0f;
+		}
+		if (dl->localVolumetricLamp && owner->promotedOrdinal >= 0) {
+			if (dl->staticPromoteFixtureId >= 0) match = dl->staticPromoteFixtureId == owner->promotedOrdinal;
+			else if (R_IFLC_DistanceSquared(dl->origin, owner->origin) <= 2.0f * 2.0f) match = qtrue;
+		}
+		if (match) { if (found >= 0) return -1; found = i; }
+	}
+	return found;
+}
+
+static void R_IFLC_ApplyProfile(dlight_t *dl, const iflcProfile_t *p, qboolean optIn)
+{
+	vec3_t color;
+	if (!dl || !p || !p->used) return;
+	/* Re-entry is idempotent: every multiplication starts from original per-frame data. */
+	if (!dl->iflcActive) {
+		VectorCopy(dl->color, dl->iflcBaseColor); dl->iflcBaseRadius = dl->radius;
+	}
+	dl->iflcActive = qtrue; dl->iflcOptIn = optIn; dl->iflcVolumeGain = p->volume;
+	VectorCopy(dl->iflcBaseColor, color);
+	if (p->colorEnabled) {
+		float oldLuma = 0.2126f * color[0] + 0.7152f * color[1] + 0.0722f * color[2];
+		float peak = MAX(p->color[0], MAX(p->color[1], p->color[2]));
+		if (peak > 0.0f) {
+			vec3_t normalized;
+			float newLuma;
+			int channel;
+			/* Divide each channel directly: 1/peak could overflow for a valid
+			 * subnormal hue, producing Inf and 0*Inf NaNs. The normalized luma
+			 * is at least 0.0722 and the final gain is therefore well bounded. */
+			for (channel = 0; channel < 3; ++channel) normalized[channel] = p->color[channel] / peak;
+			newLuma = 0.2126f * normalized[0] + 0.7152f * normalized[1] + 0.0722f * normalized[2];
+			VectorScale(normalized, oldLuma / newLuma, color);
+		}
+	}
+	VectorScale(color, p->direct, dl->color);
+	dl->radius = dl->iflcBaseRadius;
+	/* New opt-in lights always obey the budget cap, even when global dlightScale
+	 * is high. An existing lamp with radius=1 remains byte-identical to its base. */
+	if (optIn || p->radius != 1.0f) dl->radius = MIN(512.0f, dl->iflcBaseRadius * p->radius);
+}
+
+static void R_IFLC_RecordRuntime(iflcOwner_t *owner, const dlight_t *dl, int index)
+{
+	owner->runtimeIndex = index;
+	owner->baseRadius = dl->iflcActive ? dl->iflcBaseRadius : dl->radius;
+	owner->currentRadius = dl->radius;
+	VectorCopy(dl->iflcActive ? dl->iflcBaseColor : dl->color, owner->baseColor);
+	owner->worldContainment = dl->worldOcclusion; owner->shadowClass = dl->shadowSourceClass;
+}
+
+static qboolean R_IFLC_SpherePVS(const refdef_t *fd, const vec3_t origin, float radius)
+{
+	mnode_t *viewLeaf = R_StaticPromotePointInLeafSafe(fd->vieworg);
+	mnode_t *sourceLeaf = R_StaticPromotePointInLeafSafe(origin);
+	const byte *vis = NULL;
+	int i, axis;
+	if (!viewLeaf || !sourceLeaf || sourceLeaf->cluster < 0) return qfalse;
+	if (sourceLeaf->area >= 0 && sourceLeaf->area < MAX_MAP_AREA_BYTES * 8 &&
+		(fd->areamask[sourceLeaf->area >> 3] & (1 << (sourceLeaf->area & 7)))) return qfalse;
+	if (tr.world->vis && viewLeaf->cluster >= 0 && viewLeaf->cluster < tr.world->numClusters)
+		vis = tr.world->vis + viewLeaf->cluster * tr.world->clusterBytes;
+	for (i = tr.world->numDecisionNodes; i < tr.world->numnodes; ++i) {
+		const mnode_t *leaf = &tr.world->nodes[i];
+		float distance = 0.0f;
+		if (leaf->cluster < 0 || leaf->cluster >= tr.world->numClusters) continue;
+		if (vis && !(vis[leaf->cluster >> 3] & (1 << (leaf->cluster & 7)))) continue;
+		if (leaf->area >= 0 && leaf->area < MAX_MAP_AREA_BYTES * 8 && (fd->areamask[leaf->area >> 3] & (1 << (leaf->area & 7)))) continue;
+		for (axis = 0; axis < 3; ++axis) {
+			float delta = origin[axis] < leaf->mins[axis] ? leaf->mins[axis] - origin[axis] : origin[axis] > leaf->maxs[axis] ? origin[axis] - leaf->maxs[axis] : 0.0f;
+			distance += delta * delta;
+		}
+		if (distance <= radius * radius) return qtrue;
+	}
+	return qfalse;
+}
+
+static void R_IFLC_AddOptIn(const refdef_t *fd, iflcOwner_t *owner, const iflcProfile_t *p)
+{
+	int i, before;
+	dlight_t *dl;
+	mnode_t *leaf;
+	if (!p->enabled) return;
+	if (!r_dynamiclight->integer || r_dlightScale->value <= 0.0f) { owner->blockedReason = 1; return; }
+	if (r_dlightWorldContainment->integer < 1 || r_dlightMode->integer < 2 || !tr.dlightWorldFbo) { owner->blockedReason = 2; return; }
+	leaf = R_StaticPromotePointInLeafSafe(owner->origin);
+	if (!leaf || leaf->cluster < 0) { owner->blockedReason = 6; return; }
+	/* Learn may change user policy without rebuilding the persistent registry.
+	 * A newly learned physical owner must suppress this bridge even when that
+	 * owner is dormant, outside PVS, or denied the current frame's light budget. */
+	for (i = 0; i < s_staticPromotePersistentCount; ++i) {
+		const staticPromotePersistentLight_t *physical = &s_staticPromotePersistentLights[i];
+		if (R_IFLC_DistanceSquared(physical->candidate.origin, owner->origin) < 96.0f * 96.0f &&
+			(R_StaticPromotePhysicalOverrideState(physical) > 0 || physical->physicalRecognitionAccepted)) {
+			owner->blockedReason = 7; return;
+		}
+	}
+	if (!R_IFLC_SpherePVS(fd, owner->origin, MIN(512.0f, 205.0f * r_dlightScale->value * p->radius))) { owner->blockedReason = 3; return; }
+	/* Learning/promoting a nearby lamp after catalog creation must not produce
+	 * a second direct emitter. This conservative guard never reassigns profiles. */
+	for (i = r_firstSceneDlight; i < r_numdlights; ++i) {
+		const dlight_t *existing = &backEndData->dlights[i];
+		float distanceSquared = R_IFLC_DistanceSquared(existing->origin, owner->origin);
+		if (existing->iflcOptIn) {
+			/* Distinct catalog fixtures may stand close together. Only this exact
+			 * opt-in anchor is a duplicate, not another edited neighbouring fire. */
+			if (distanceSquared < 0.01f) { owner->blockedReason = 5; return; }
+			continue;
+		}
+		if ((existing->nativeAuthoredDlight || existing->localVolumetricLamp) && distanceSquared < 96.0f * 96.0f) { owner->blockedReason = 5; return; }
+	}
+	if (r_numdlights >= MAX_DLIGHTS) { owner->blockedReason = 4; return; }
+	before = r_numdlights;
+	RE_AddLightToScene(owner->origin, 205.0f, 1.0f, 0.52f, 0.16f, REF_FORCE_DLIGHT | DARKWOLF_REF_WORLD_OCCLUSION);
+	if (r_numdlights == before) { owner->blockedReason = 1; return; }
+	dl = &backEndData->dlights[before];
+	/* Independent world-only containment is mandatory. This new source is not
+	 * native authored and never enters the V1.4 strict-native PCF4x4 branch. */
+	dl->worldOcclusion = qtrue; dl->forced = qtrue;
+	dl->shadowSourceClass = DWSHADOW_SOURCE_PERSISTENT_FIRE;
+	R_IFLC_ApplyProfile(dl, p, qtrue);
+	owner->runtimeCount = 1; R_IFLC_RecordRuntime(owner, dl, before - r_firstSceneDlight);
+}
+
+static void R_IFLC_Frame(const refdef_t *fd)
+{
+	int i, ownerIndex, sceneEnd;
+	qboolean enabled = r_dwFireLightControl && r_dwFireLightControl->integer;
+	if (!fd || !tr.world || (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))) return;
+	R_IFLC_SnapshotView(fd);
+	if (!enabled && !s_iflcReady) return;
+	if (!R_IFLC_EnsureCatalog() || s_iflcCatalogOverflow) return;
+	for (i = 0; i < s_iflcOwnerCount; ++i) {
+		s_iflcOwners[i].runtimeCount = 0; s_iflcOwners[i].runtimeIndex = -1; s_iflcOwners[i].blockedReason = 0;
+		s_iflcOwners[i].baseRadius = s_iflcOwners[i].currentRadius = 0.0f;
+		s_iflcOwners[i].worldContainment = s_iflcOwners[i].shadowClass = 0; s_iflcOwners[i].shadowSlot = -2;
+	}
+	sceneEnd = r_numdlights;
+	for (i = r_firstSceneDlight; i < sceneEnd; ++i) {
+		ownerIndex = R_IFLC_DlightOwner(&backEndData->dlights[i]);
+		if (ownerIndex >= 0) ++s_iflcOwners[ownerIndex].runtimeCount;
+	}
+	for (i = r_firstSceneDlight; i < sceneEnd; ++i) {
+		dlight_t *dl = &backEndData->dlights[i];
+		iflcOwner_t *owner;
+		const iflcProfile_t *p;
+		ownerIndex = R_IFLC_DlightOwner(dl);
+		if (ownerIndex < 0) continue;
+		owner = &s_iflcOwners[ownerIndex]; p = R_IFLC_ProfileForOwner(ownerIndex, qfalse);
+		if (enabled && p && owner->runtimeCount == 1 && !owner->ambiguous) R_IFLC_ApplyProfile(dl, p, qfalse);
+		R_IFLC_RecordRuntime(owner, dl, i - r_firstSceneDlight);
+	}
+	if (!enabled) return;
+	for (i = 0; i < IFLC_MAX_PROFILES; ++i) {
+		const iflcProfile_t *p = &s_iflcProfiles[i];
+		if (p->used && p->owner >= 0 && p->owner < s_iflcOwnerCount &&
+			s_iflcOwners[p->owner].kind == IFLC_SURFACE && !s_iflcOwners[p->owner].ambiguous)
+			R_IFLC_AddOptIn(fd, &s_iflcOwners[p->owner], p);
+	}
+}
+
+/* Read-only diagnostic snapshot, called after main-scene shadow assignment.
+ * No persistent profile ever contains a transient slot or dlight array index. */
+static void R_IFLC_CaptureShadowSlots(const refdef_t *fd)
+{
+	int i;
+	if (!s_iflcReady || !fd || !tr.world || (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))) return;
+	for (i = 0; i < s_iflcOwnerCount; ++i) {
+		iflcOwner_t *owner = &s_iflcOwners[i];
+		int index = owner->runtimeIndex;
+		owner->shadowSlot = -1;
+		if (owner->runtimeCount != 1 || index < 0 || index >= tr.refdef.num_dlights || index >= MAX_DLIGHTS) continue;
+		if ((tr.refdef.dlightShadowMask & (1u << index)) && tr.refdef.dlightShadowSlot[index] >= 0 &&
+			tr.refdef.dlightShadowSlot[index] < MAX_DLIGHT_SHADOWS) owner->shadowSlot = tr.refdef.dlightShadowSlot[index];
+	}
+}
+
+qboolean R_IFLC_VolumeOverride(int surfaceIndex, const char *shaderName, const vec3_t origin, float *gain)
+{
+	int i, j;
+	if (gain) *gain = 1.0f;
+	if (!s_iflcReady || s_iflcCatalogOverflow || !tr.world || !r_dwFireLightControl || !r_dwFireLightControl->integer ||
+		strcmp(s_iflcMap, tr.world->baseName) || !shaderName || !origin) return qfalse;
+	for (i = 0; i < s_iflcSurfaceCount; ++i) {
+		const iflcSurface_t *surface = &s_iflcSurfaces[i];
+		if (surface->surfaceIndex != surfaceIndex || strcmp(surface->shader, shaderName) ||
+			R_IFLC_DistanceSquared(surface->origin, origin) > 16.0f * 16.0f || surface->owner < 0 || s_iflcOwners[surface->owner].ambiguous) continue;
+		for (j = 0; j < IFLC_MAX_PROFILES; ++j)
+			if (s_iflcProfiles[j].used && s_iflcProfiles[j].owner == surface->owner) {
+				if (gain) *gain = s_iflcProfiles[j].volume;
+				return qtrue;
+			}
+		return qfalse;
+	}
+	return qfalse;
+}
