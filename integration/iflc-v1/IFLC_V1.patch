diff --git a/SP/code/rend2/tr_iflc.inc b/SP/code/rend2/tr_iflc.inc
new file mode 100644
index 0000000000000000000000000000000000000000..465aea366eeb0f89bfb78be4cf1a56c83c42cac0
--- /dev/null
+++ b/SP/code/rend2/tr_iflc.inc
@@ -0,0 +1,966 @@
+/*
+ * DarkWolf Individual Fire Light Control V1.
+ * Included by tr_scene.c after StaticPromote has resolved physical ownership.
+ * Only commands and map changes mutate the profile/catalog. They synchronize the
+ * render thread; the backend's surface-volume lookup is strictly read-only.
+ */
+#include <errno.h>
+#include <float.h>
+
+#define IFLC_MAX_OWNERS 1024
+#define IFLC_MAX_SURFACES 2048
+#define IFLC_MAX_PROFILES 256
+#define IFLC_MAX_PICK 32
+#define IFLC_MAX_BRUSHES 128
+#define IFLC_FILE_LIMIT (128 * 1024)
+#define IFLC_NATIVE 1
+#define IFLC_PROMOTED 2
+#define IFLC_SURFACE 3
+
+typedef struct {
+	char key[96];
+	int kind, nativeOrdinal, promotedOrdinal;
+	vec3_t origin;
+	int surfaceCount;
+	qboolean ambiguous;
+	/* Front-end diagnostics only; never used as persistent identity. */
+	int runtimeCount, runtimeIndex, blockedReason;
+	float baseRadius, currentRadius;
+	vec3_t baseColor;
+	int worldContainment, shadowClass, shadowSlot;
+} iflcOwner_t;
+
+typedef struct {
+	int surfaceIndex, owner;
+	char shader[MAX_QPATH];
+	vec3_t origin;
+} iflcSurface_t;
+
+typedef struct {
+	qboolean used;
+	int owner;
+	float direct, radius, volume;
+	int enabled, colorEnabled;
+	vec3_t color;
+} iflcProfile_t;
+
+typedef struct {
+	vec3_t origin, axis[3];
+	int handle;
+} iflcBrush_t;
+
+static iflcOwner_t s_iflcOwners[IFLC_MAX_OWNERS];
+static iflcSurface_t s_iflcSurfaces[IFLC_MAX_SURFACES];
+static iflcProfile_t s_iflcProfiles[IFLC_MAX_PROFILES];
+static int s_iflcOwnerCount, s_iflcSurfaceCount;
+static char s_iflcMap[MAX_QPATH];
+static unsigned int s_iflcFingerprint;
+static int s_iflcGeneration = -1;
+static qboolean s_iflcReady, s_iflcDirty, s_iflcCatalogOverflow;
+static vec3_t s_iflcViewOrigin, s_iflcViewForward;
+static byte s_iflcViewAreaMask[MAX_MAP_AREA_BYTES];
+static qboolean s_iflcViewValid, s_iflcBrushOverflow;
+static iflcBrush_t s_iflcBrushes[IFLC_MAX_BRUSHES];
+static int s_iflcBrushCount;
+static int s_iflcSelected = -1, s_iflcPickCount, s_iflcPickCursor = -1;
+static int s_iflcPicks[IFLC_MAX_PICK];
+static float s_iflcPickScores[IFLC_MAX_PICK];
+
+static qboolean R_IFLC_LoadProfile(qboolean explicitReload);
+
+static float R_IFLC_DistanceSquared(const vec3_t a, const vec3_t b)
+{
+	vec3_t delta;
+	VectorSubtract(a, b, delta);
+	return DotProduct(delta, delta);
+}
+
+static unsigned int R_IFLC_Hash(const void *data, int length)
+{
+	const byte *p = (const byte *)data;
+	unsigned int hash = 2166136261u;
+	int i;
+	for (i = 0; i < length; ++i) { hash ^= p[i]; hash *= 16777619u; }
+	return hash ? hash : 1u;
+}
+
+static qboolean R_IFLC_SafeMapName(const char *name)
+{
+	int i;
+	if (!name || !name[0]) return qfalse;
+	for (i = 0; name[i]; ++i)
+		if (!((name[i] >= 'a' && name[i] <= 'z') || (name[i] >= 'A' && name[i] <= 'Z') ||
+			(name[i] >= '0' && name[i] <= '9') || name[i] == '_' || name[i] == '-')) return qfalse;
+	return i < MAX_QPATH - 1;
+}
+
+static qboolean R_IFLC_FlameShader(const shader_t *shader)
+{
+	const char *name;
+	if (!shader) return qfalse;
+	name = shader->name;
+	/* Exactly the production BSP flame-name evidence, without weapon streams. */
+	if (strstr(name, "flamethrower") || strstr(name, "fthrow_")) return qfalse;
+	return (strstr(name, "xflame") || strstr(name, "torch_ember") ||
+		strstr(name, "flame") || strstr(name, "fire")) ? qtrue : qfalse;
+}
+
+static qboolean R_IFLC_SurfaceCenter(int index, vec3_t out)
+{
+	const msurface_t *surface;
+	const srfBspSurface_t *bsp;
+	int i;
+	if (!tr.world || index < 0 || index >= tr.world->numWorldSurfaces) return qfalse;
+	surface = &tr.world->surfaces[index];
+	if (!surface->data || (*surface->data != SF_FACE && *surface->data != SF_GRID && *surface->data != SF_TRIANGLES)) return qfalse;
+	bsp = (const srfBspSurface_t *)surface->data;
+	if (!bsp->verts || bsp->numVerts <= 0) return qfalse;
+	VectorClear(out);
+	for (i = 0; i < bsp->numVerts; ++i) VectorAdd(out, bsp->verts[i].xyz, out);
+	VectorScale(out, 1.0f / (float)bsp->numVerts, out);
+	return qtrue;
+}
+
+static int R_IFLC_FindOwnerKey(const char *key)
+{
+	int i;
+	for (i = 0; i < s_iflcOwnerCount; ++i) if (!strcmp(key, s_iflcOwners[i].key)) return i;
+	return -1;
+}
+
+static int R_IFLC_AddOwner(int kind, int nativeOrdinal, int promotedOrdinal, const vec3_t origin, const char *key)
+{
+	iflcOwner_t *owner;
+	if (s_iflcOwnerCount >= IFLC_MAX_OWNERS) { s_iflcCatalogOverflow = qtrue; return -1; }
+	owner = &s_iflcOwners[s_iflcOwnerCount];
+	memset(owner, 0, sizeof(*owner));
+	owner->kind = kind;
+	owner->nativeOrdinal = nativeOrdinal;
+	owner->promotedOrdinal = promotedOrdinal;
+	owner->runtimeIndex = -1; owner->shadowSlot = -2;
+	VectorCopy(origin, owner->origin);
+	Q_strncpyz(owner->key, key, sizeof(owner->key));
+	return s_iflcOwnerCount++;
+}
+
+static qboolean R_IFLC_NearFlame(const vec3_t origin, float radius)
+{
+	int i;
+	for (i = 0; i < s_iflcSurfaceCount; ++i)
+		if (R_IFLC_DistanceSquared(origin, s_iflcSurfaces[i].origin) <= radius * radius) return qtrue;
+	return qfalse;
+}
+
+static qboolean R_IFLC_NativeIsFire(const staticPromotePLRMarker_t *marker)
+{
+	int j;
+	if (R_IFLC_NearFlame(marker->origin, 128.0f)) return qtrue;
+	for (j = 0; j < s_staticPromotePLRMarkerCount; ++j) {
+		const staticPromotePLRMarker_t *speaker = &s_staticPromotePLRMarkers[j];
+		if (speaker->kind == PLR_V01_MARKER_SPEAKER && R_StaticPromotePLRNoiseIsFire(speaker->noise) &&
+			R_IFLC_DistanceSquared(marker->origin, speaker->origin) <= PLR_V01_FIRE_PAIR_MAX_DIST * PLR_V01_FIRE_PAIR_MAX_DIST) return qtrue;
+	}
+	return qfalse;
+}
+
+void R_IFLC_ResetWorld(void)
+{
+	R_IssuePendingRenderCommands();
+	if (s_iflcDirty) ri.Printf(PRINT_ALL, "IFLC: discarded unsaved overrides for %s on world change.\n", s_iflcMap);
+	s_iflcReady = s_iflcDirty = s_iflcViewValid = qfalse;
+	s_iflcOwnerCount = s_iflcSurfaceCount = s_iflcBrushCount = 0;
+	s_iflcCatalogOverflow = s_iflcBrushOverflow = qfalse;
+	s_iflcMap[0] = '\0'; s_iflcFingerprint = 0; s_iflcGeneration = -1;
+	s_iflcSelected = s_iflcPickCursor = -1; s_iflcPickCount = 0;
+	memset(s_iflcProfiles, 0, sizeof(s_iflcProfiles));
+}
+
+static qboolean R_IFLC_EnsureCatalog(void)
+{
+	int i, j;
+	void *raw = NULL;
+	long length;
+	char path[MAX_QPATH], key[96];
+	if (!tr.world || !tr.world->entityString || !R_IFLC_SafeMapName(tr.world->baseName)) return qfalse;
+	if (s_iflcReady && !strcmp(s_iflcMap, tr.world->baseName) &&
+		s_iflcGeneration == s_staticPromotePersistentBuildGeneration) return qtrue;
+	R_IssuePendingRenderCommands();
+	if (!R_StaticPromoteBuildPersistentRegistry()) return qfalse;
+	/* Rebuilding after explicit StaticPromote synthetic edits invalidates old selection.
+	 * Saved profiles are keyed and revalidated; unsaved profiles are not silently remapped. */
+	if (s_iflcDirty) ri.Printf(PRINT_WARNING, "IFLC: catalog changed; unsaved overrides discarded.\n");
+	s_iflcReady = qfalse; s_iflcDirty = qfalse;
+	s_iflcOwnerCount = s_iflcSurfaceCount = 0;
+	s_iflcSelected = s_iflcPickCursor = -1; s_iflcPickCount = 0;
+	s_iflcCatalogOverflow = qfalse;
+	memset(s_iflcProfiles, 0, sizeof(s_iflcProfiles));
+	Q_strncpyz(s_iflcMap, tr.world->baseName, sizeof(s_iflcMap));
+	Com_sprintf(path, sizeof(path), "maps/%s.bsp", s_iflcMap);
+	length = ri.FS_ReadFile(path, &raw);
+	if (length <= 0 || length > 0x7fffffffL || !raw) {
+		if (raw) ri.FS_FreeFile(raw);
+		ri.Printf(PRINT_WARNING, "IFLC: cannot fingerprint BSP; editing disabled.\n");
+		return qfalse;
+	}
+	s_iflcFingerprint = R_IFLC_Hash(raw, (int)length);
+	ri.FS_FreeFile(raw);
+	for (i = 0; i < tr.world->numWorldSurfaces; ++i) {
+		iflcSurface_t *surface;
+		vec3_t center;
+		if (!R_IFLC_FlameShader(tr.world->surfaces[i].shader) || !R_IFLC_SurfaceCenter(i, center)) continue;
+		if (s_iflcSurfaceCount >= IFLC_MAX_SURFACES) { s_iflcCatalogOverflow = qtrue; break; }
+		surface = &s_iflcSurfaces[s_iflcSurfaceCount++];
+		surface->surfaceIndex = i; surface->owner = -1;
+		VectorCopy(center, surface->origin);
+		Q_strncpyz(surface->shader, tr.world->surfaces[i].shader->name, sizeof(surface->shader));
+	}
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i) {
+		const staticPromotePLRMarker_t *marker = &s_staticPromotePLRMarkers[i];
+		if (marker->kind != PLR_V01_MARKER_DLIGHT || !R_IFLC_NativeIsFire(marker)) continue;
+		Com_sprintf(key, sizeof(key), "native:%d", marker->entityOrdinal);
+		R_IFLC_AddOwner(IFLC_NATIVE, marker->entityOrdinal, -1, marker->origin, key);
+	}
+	for (i = 0; i < s_staticPromotePersistentCount; ++i) {
+		const staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		int alias = -1;
+		qboolean learned = R_StaticPromotePhysicalOverrideState(light) > 0;
+		if (!R_IFLC_NearFlame(light->candidate.origin, 96.0f) && light->physicalFireSpeakerOrdinal < 0) continue;
+		for (j = 0; j < s_iflcOwnerCount; ++j)
+			if (s_iflcOwners[j].kind == IFLC_NATIVE && s_iflcOwners[j].nativeOrdinal == light->physicalNativeDlightOrdinal) { alias = j; break; }
+		if (alias >= 0) {
+			/* A single owner can have a promoted fallback for the same authored lamp. */
+			if (s_iflcOwners[alias].promotedOrdinal >= 0 && s_iflcOwners[alias].promotedOrdinal != light->candidate.entityOrdinal)
+				s_iflcOwners[alias].ambiguous = qtrue;
+			else s_iflcOwners[alias].promotedOrdinal = light->candidate.entityOrdinal;
+			continue;
+		}
+		/* Baked-only entities are not existing Direct owners. Accepted/learned
+		 * fixtures remain owners even when temporarily absent from the scene. */
+		if (!learned && !light->physicalRecognitionAccepted && !light->synthetic &&
+			R_StaticPromoteClassifyFixture(light) != STATIC_PROMOTE_CLASS_ACCEPT) continue;
+		Com_sprintf(key, sizeof(key), "promoted:%d", light->candidate.entityOrdinal);
+		R_IFLC_AddOwner(IFLC_PROMOTED, -1, light->candidate.entityOrdinal, light->candidate.origin, key);
+	}
+	for (i = 0; i < s_iflcSurfaceCount; ++i) {
+		iflcSurface_t *surface = &s_iflcSurfaces[i];
+		int best = -1, competing = -1;
+		float bestDistance = 128.0f * 128.0f + 1.0f, nextDistance = bestDistance;
+		for (j = 0; j < s_iflcOwnerCount; ++j) {
+			float distance;
+			if (s_iflcOwners[j].kind == IFLC_SURFACE) continue;
+			distance = R_IFLC_DistanceSquared(surface->origin, s_iflcOwners[j].origin);
+			if (distance < bestDistance) { nextDistance = bestDistance; competing = best; bestDistance = distance; best = j; }
+			else if (distance < nextDistance) { nextDistance = distance; competing = j; }
+		}
+		if (best >= 0) {
+			if (competing >= 0 && sqrt(nextDistance) - sqrt(bestDistance) < 12.0f) {
+				/* No arbitrary first/nearest winner among indistinguishable emitters. */
+				s_iflcOwners[best].ambiguous = s_iflcOwners[competing].ambiguous = qtrue;
+			}
+			surface->owner = best;
+		} else {
+			/* Same shader + 16-unit anchor is the production FireVol fixture key.
+			 * Match the representative, never chain nearby flames transitively. */
+			for (j = 0; j < i; ++j) {
+				int ownerIndex = s_iflcSurfaces[j].owner;
+				if (ownerIndex >= 0 && s_iflcOwners[ownerIndex].kind == IFLC_SURFACE &&
+					!strcmp(surface->shader, s_iflcSurfaces[j].shader) &&
+					R_IFLC_DistanceSquared(surface->origin, s_iflcOwners[ownerIndex].origin) <= 16.0f * 16.0f) {
+					surface->owner = ownerIndex; break;
+				}
+			}
+			if (surface->owner < 0) {
+				int quantized[3];
+				for (j = 0; j < 3; ++j) quantized[j] = (int)floor(surface->origin[j] * 8.0f + 0.5f);
+				Com_sprintf(key, sizeof(key), "surface:%d:%08x:%08x", surface->surfaceIndex,
+					R_IFLC_Hash(surface->shader, (int)strlen(surface->shader)), R_IFLC_Hash(quantized, sizeof(quantized)));
+				surface->owner = R_IFLC_AddOwner(IFLC_SURFACE, -1, -1, surface->origin, key);
+			}
+		}
+		if (surface->owner >= 0) s_iflcOwners[surface->owner].surfaceCount++;
+	}
+	s_iflcGeneration = s_staticPromotePersistentBuildGeneration;
+	s_iflcReady = qtrue;
+	if (s_iflcCatalogOverflow) ri.Printf(PRINT_WARNING, "IFLC: catalog capacity exceeded; editing and overrides disabled.\n");
+	R_IFLC_LoadProfile(qfalse);
+	return qtrue;
+}
+
+static iflcProfile_t *R_IFLC_ProfileForOwner(int owner, qboolean create)
+{
+	int i, freeSlot = -1;
+	for (i = 0; i < IFLC_MAX_PROFILES; ++i) {
+		if (s_iflcProfiles[i].used && s_iflcProfiles[i].owner == owner) return &s_iflcProfiles[i];
+		if (!s_iflcProfiles[i].used && freeSlot < 0) freeSlot = i;
+	}
+	if (create && freeSlot >= 0) {
+		iflcProfile_t *p = &s_iflcProfiles[freeSlot];
+		memset(p, 0, sizeof(*p)); p->used = qtrue; p->owner = owner;
+		p->direct = p->radius = p->volume = 1.0f;
+		VectorSet(p->color, 1.0f, 1.0f, 1.0f);
+		return p;
+	}
+	return NULL;
+}
+
+/* Strict bounded token stream: no command execution, no implicit atof defaults. */
+static qboolean R_IFLC_Token(const char **cursor, const char *end, char *out, int size)
+{
+	const char *p = *cursor;
+	int used = 0;
+	while (p < end && (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')) ++p;
+	if (p >= end) { out[0] = '\0'; *cursor = p; return qfalse; }
+	while (p < end && *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n') {
+		if ((unsigned char)*p < 33 || (unsigned char)*p > 126 || used >= size - 1) return qfalse;
+		out[used++] = *p++;
+	}
+	out[used] = '\0'; *cursor = p;
+	return used > 0;
+}
+
+static qboolean R_IFLC_Float(const char *text, float minimum, float maximum, float *out)
+{
+	char *end;
+	double value;
+	if (!text || !text[0]) return qfalse;
+	errno = 0; value = strtod(text, &end);
+	if (end == text || *end || errno == ERANGE || value != value || value < minimum || value > maximum) return qfalse;
+	*out = (float)value;
+	return qtrue;
+}
+
+static qboolean R_IFLC_Integer(const char *text, int minimum, int maximum, int *out)
+{
+	char *end;
+	long value;
+	if (!text || !text[0]) return qfalse;
+	errno = 0; value = strtol(text, &end, 10);
+	if (end == text || *end || errno == ERANGE || value < minimum || value > maximum) return qfalse;
+	*out = (int)value; return qtrue;
+}
+
+static qboolean R_IFLC_ParseProfile(const char *text, int length, iflcProfile_t *out, int *count, const char **reason)
+{
+	const char *cursor = text, *end = text + length;
+	char token[128], expected[16];
+	int number, i, j;
+	*count = 0; *reason = "invalid or truncated profile";
+	memset(out, 0, IFLC_MAX_PROFILES * sizeof(*out));
+	if (length <= 0 || length > IFLC_FILE_LIMIT || memchr(text, '\0', length)) return qfalse;
+#define IFLC_READ() R_IFLC_Token(&cursor, end, token, sizeof(token))
+#define IFLC_EXPECT(s) (IFLC_READ() && !strcmp(token, (s)))
+	if (!IFLC_EXPECT("DW_IFLC") || !IFLC_EXPECT("1")) { *reason = "unsupported profile version"; return qfalse; }
+	if (!IFLC_EXPECT("map") || !IFLC_READ() || strcmp(token, s_iflcMap)) { *reason = "map mismatch"; return qfalse; }
+	Com_sprintf(expected, sizeof(expected), "%08x", s_iflcFingerprint);
+	if (!IFLC_EXPECT("bsp") || !IFLC_READ() || strcmp(token, expected)) { *reason = "BSP fingerprint mismatch"; return qfalse; }
+	if (!IFLC_EXPECT("count") || !IFLC_READ() || !R_IFLC_Integer(token, 0, IFLC_MAX_PROFILES, &number)) return qfalse;
+	for (i = 0; i < number; ++i) {
+		iflcProfile_t *p = &out[i];
+		if (!IFLC_EXPECT("fixture") || !IFLC_READ()) return qfalse;
+		p->owner = R_IFLC_FindOwnerKey(token);
+		if (p->owner < 0 || s_iflcOwners[p->owner].ambiguous) { *reason = "unknown or ambiguous fixture"; return qfalse; }
+		for (j = 0; j < i; ++j) if (out[j].owner == p->owner) { *reason = "duplicate fixture"; return qfalse; }
+		if (!IFLC_READ() || !R_IFLC_Float(token, 0.0f, 3.0f, &p->direct) ||
+			!IFLC_READ() || !R_IFLC_Float(token, 0.25f, 2.0f, &p->radius) ||
+			!IFLC_READ() || !R_IFLC_Float(token, 0.0f, 3.0f, &p->volume) ||
+			!IFLC_READ() || !R_IFLC_Integer(token, 0, 1, &p->enabled) ||
+			!IFLC_READ() || !R_IFLC_Integer(token, 0, 1, &p->colorEnabled)) { *reason = "invalid parameter/range"; return qfalse; }
+		for (j = 0; j < 3; ++j) if (!IFLC_READ() || !R_IFLC_Float(token, 0.0f, 1.0f, &p->color[j])) return qfalse;
+		if (p->enabled && s_iflcOwners[p->owner].kind != IFLC_SURFACE) { *reason = "enabled is only valid for volume-only fixtures"; return qfalse; }
+		if (p->colorEnabled && p->color[0] + p->color[1] + p->color[2] <= 0.0f) { *reason = "zero color"; return qfalse; }
+		p->used = qtrue;
+	}
+	if (!IFLC_EXPECT("end")) return qfalse;
+	while (cursor < end && (*cursor == ' ' || *cursor == '\t' || *cursor == '\r' || *cursor == '\n')) ++cursor;
+	if (cursor != end) { *reason = "unexpected trailing data"; return qfalse; }
+	*count = number; *reason = "OK";
+#undef IFLC_EXPECT
+#undef IFLC_READ
+	return qtrue;
+}
+
+static void R_IFLC_ProfilePath(char *path, int size, const char *suffix)
+{
+	Com_sprintf(path, size, "firelights/%s.iflc%s", s_iflcMap, suffix ? suffix : "");
+}
+
+static qboolean R_IFLC_LoadProfile(qboolean explicitReload)
+{
+	iflcProfile_t *staging;
+	void *raw = NULL;
+	long length;
+	const char *reason;
+	char path[MAX_QPATH + 32];
+	int count;
+	qboolean valid;
+	R_IFLC_ProfilePath(path, sizeof(path), "");
+	length = ri.FS_ReadFile(path, NULL);
+	if (length < 0) {
+		if (explicitReload) {
+			memset(s_iflcProfiles, 0, sizeof(s_iflcProfiles)); s_iflcDirty = qfalse;
+			ri.Printf(PRINT_ALL, "IFLC: no saved profile; returned to baseline.\n");
+		}
+		return qtrue;
+	}
+	if (length <= 0 || length > IFLC_FILE_LIMIT) { ri.Printf(PRINT_WARNING, "IFLC: invalid profile size; not applied.\n"); return qfalse; }
+	length = ri.FS_ReadFile(path, &raw);
+	if (!raw || length <= 0 || length > IFLC_FILE_LIMIT) { if (raw) ri.FS_FreeFile(raw); return qfalse; }
+	staging = (iflcProfile_t *)ri.Z_Malloc(sizeof(s_iflcProfiles));
+	valid = R_IFLC_ParseProfile((const char *)raw, (int)length, staging, &count, &reason);
+	if (valid) {
+		memcpy(s_iflcProfiles, staging, sizeof(s_iflcProfiles)); s_iflcDirty = qfalse;
+		if (explicitReload || count) ri.Printf(PRINT_ALL, "IFLC: loaded %d profiles from %s.\n", count, path);
+	} else ri.Printf(PRINT_WARNING, "IFLC: profile rejected (%s); current settings preserved.\n", reason);
+	ri.Free(staging); ri.FS_FreeFile(raw);
+	return valid;
+}
+
+static qboolean R_IFLC_SurfaceBlocks(const msurface_t *surface)
+{
+	const shader_t *shader = surface->shader;
+	if (!shader) return qtrue;
+	if (R_IFLC_FlameShader(shader) || shader->isSky || (shader->contentFlags & CONTENTS_FOG) ||
+		(shader->surfaceFlags & SURF_NODRAW) || shader->sort == SS_FOG || shader->sort == SS_DECAL || shader->sort >= SS_SEE_THROUGH) return qfalse;
+	return qtrue;
+}
+
+static qboolean R_IFLC_RayTriangle(const vec3_t origin, const vec3_t direction,
+	const vec3_t a, const vec3_t b, const vec3_t c, float maximum, float *distance)
+{
+	vec3_t edge1, edge2, p, t, q;
+	float determinant, inverse, u, v, hit;
+	VectorSubtract(b, a, edge1); VectorSubtract(c, a, edge2); CrossProduct(direction, edge2, p);
+	determinant = DotProduct(edge1, p);
+	if (fabs(determinant) < 0.000001f) return qfalse;
+	inverse = 1.0f / determinant; VectorSubtract(origin, a, t);
+	u = DotProduct(t, p) * inverse;
+	if (u < 0.0f || u > 1.0f) return qfalse;
+	CrossProduct(t, edge1, q); v = DotProduct(direction, q) * inverse;
+	if (v < 0.0f || u + v > 1.0f) return qfalse;
+	hit = DotProduct(edge2, q) * inverse;
+	if (hit <= 0.01f || hit >= maximum) return qfalse;
+	*distance = hit; return qtrue;
+}
+
+static qboolean R_IFLC_RaySurface(const msurface_t *surface, const vec3_t origin,
+	const vec3_t direction, float maximum, float *distance)
+{
+	const srfBspSurface_t *bsp;
+	float best = maximum, hit;
+	qboolean found = qfalse;
+	int i;
+	if (!surface || !surface->data || (*surface->data != SF_FACE && *surface->data != SF_GRID && *surface->data != SF_TRIANGLES)) return qfalse;
+	bsp = (const srfBspSurface_t *)surface->data;
+	if (!bsp->verts || !bsp->indexes || bsp->numVerts <= 0) return qfalse;
+	if (surface->cullinfo.type & CULLINFO_BOX) {
+		float nearDistance = 0.0f, farDistance = maximum;
+		int axis;
+		for (axis = 0; axis < 3; ++axis) {
+			float a, b;
+			if (fabs(direction[axis]) < 0.000001f) {
+				if (origin[axis] < surface->cullinfo.bounds[0][axis] || origin[axis] > surface->cullinfo.bounds[1][axis]) return qfalse;
+				continue;
+			}
+			a = (surface->cullinfo.bounds[0][axis] - origin[axis]) / direction[axis];
+			b = (surface->cullinfo.bounds[1][axis] - origin[axis]) / direction[axis];
+			if (a > b) { float swap = a; a = b; b = swap; }
+			nearDistance = MAX(nearDistance, a); farDistance = MIN(farDistance, b);
+			if (nearDistance > farDistance) return qfalse;
+		}
+	}
+	for (i = 0; i + 2 < bsp->numIndexes; i += 3) {
+		unsigned int a = bsp->indexes[i], b = bsp->indexes[i + 1], c = bsp->indexes[i + 2];
+		if (a >= (unsigned int)bsp->numVerts || b >= (unsigned int)bsp->numVerts || c >= (unsigned int)bsp->numVerts) continue;
+		if (R_IFLC_RayTriangle(origin, direction, bsp->verts[a].xyz, bsp->verts[b].xyz, bsp->verts[c].xyz, best, &hit)) { best = hit; found = qtrue; }
+	}
+	if (found) *distance = best;
+	return found;
+}
+
+static qboolean R_IFLC_LineVisible(const vec3_t from, const vec3_t to)
+{
+	vec3_t direction;
+	float length, hit;
+	int i, j, axis;
+	VectorSubtract(to, from, direction); length = VectorNormalize(direction);
+	if (length <= 2.0f) return qtrue;
+	if (s_iflcBrushOverflow) return qfalse;
+	for (i = 0; i < tr.world->numWorldSurfaces; ++i)
+		if (R_IFLC_SurfaceBlocks(&tr.world->surfaces[i]) && R_IFLC_RaySurface(&tr.world->surfaces[i], from, direction, length - 1.0f, &hit)) return qfalse;
+	for (i = 0; i < s_iflcBrushCount; ++i) {
+		const iflcBrush_t *brush = &s_iflcBrushes[i];
+		model_t *model = R_GetModelByHandle(brush->handle);
+		vec3_t delta, localOrigin, localDirection;
+		if (!model || model->type != MOD_BRUSH || !model->bmodel) continue;
+		VectorSubtract(from, brush->origin, delta);
+		for (axis = 0; axis < 3; ++axis) {
+			float scale = DotProduct(brush->axis[axis], brush->axis[axis]);
+			if (scale <= 0.000001f) return qfalse;
+			localOrigin[axis] = DotProduct(delta, brush->axis[axis]) / scale;
+			localDirection[axis] = DotProduct(direction, brush->axis[axis]) / scale;
+		}
+		for (j = 0; j < model->bmodel->numSurfaces; ++j) {
+			int surfaceIndex = model->bmodel->firstSurface + j;
+			if (surfaceIndex < 0 || surfaceIndex >= tr.world->numsurfaces) continue;
+			if (R_IFLC_SurfaceBlocks(&tr.world->surfaces[surfaceIndex]) &&
+				R_IFLC_RaySurface(&tr.world->surfaces[surfaceIndex], localOrigin, localDirection, length - 1.0f, &hit)) return qfalse;
+		}
+	}
+	return qtrue;
+}
+
+static void R_IFLC_SnapshotView(const refdef_t *fd)
+{
+	int i;
+	VectorCopy(fd->vieworg, s_iflcViewOrigin); VectorCopy(fd->viewaxis[0], s_iflcViewForward);
+	s_iflcViewValid = VectorNormalize(s_iflcViewForward) > 0.001f;
+	memcpy(s_iflcViewAreaMask, fd->areamask, sizeof(s_iflcViewAreaMask));
+	s_iflcBrushCount = 0; s_iflcBrushOverflow = qfalse;
+	for (i = r_firstSceneEntity; i < r_numentities; ++i) {
+		const refEntity_t *entity = &backEndData->entities[i].e;
+		model_t *model;
+		iflcBrush_t *brush;
+		if (!entity->hModel) continue;
+		model = R_GetModelByHandle(entity->hModel);
+		if (!model || model->type != MOD_BRUSH || !model->bmodel || !strcmp(model->name, "*0")) continue;
+		if (s_iflcBrushCount >= IFLC_MAX_BRUSHES) { s_iflcBrushOverflow = qtrue; break; }
+		brush = &s_iflcBrushes[s_iflcBrushCount++];
+		brush->handle = entity->hModel; VectorCopy(entity->origin, brush->origin);
+		memcpy(brush->axis, entity->axis, sizeof(brush->axis));
+	}
+}
+
+static qboolean R_IFLC_ReadyForCommand(void)
+{
+	R_IssuePendingRenderCommands();
+	if (!R_IFLC_EnsureCatalog() || s_iflcCatalogOverflow) {
+		ri.Printf(PRINT_ALL, "IFLC: no complete editable BSP catalog; load a map first.\n"); return qfalse;
+	}
+	return qtrue;
+}
+
+static void R_IFLC_InsertPick(int owner, float score)
+{
+	int i, j;
+	for (i = 0; i < s_iflcPickCount; ++i) {
+		if (s_iflcPicks[i] != owner) continue;
+		if (s_iflcPickScores[i] <= score) return;
+		for (j = i + 1; j < s_iflcPickCount; ++j) { s_iflcPicks[j - 1] = s_iflcPicks[j]; s_iflcPickScores[j - 1] = s_iflcPickScores[j]; }
+		--s_iflcPickCount; break;
+	}
+	for (i = 0; i < s_iflcPickCount && s_iflcPickScores[i] <= score; ++i) {}
+	if (i >= IFLC_MAX_PICK) return;
+	if (s_iflcPickCount < IFLC_MAX_PICK) ++s_iflcPickCount;
+	for (j = s_iflcPickCount - 1; j > i; --j) { s_iflcPicks[j] = s_iflcPicks[j - 1]; s_iflcPickScores[j] = s_iflcPickScores[j - 1]; }
+	s_iflcPicks[i] = owner; s_iflcPickScores[i] = score;
+}
+
+static void R_IFLC_ConsiderPick(int owner, const vec3_t anchor, int surfaceIndex)
+{
+	vec3_t delta, rayTarget;
+	float forward, lateralSquared, threshold, hit, score;
+	qboolean exact = qfalse;
+	if (owner < 0 || owner >= s_iflcOwnerCount) return;
+	VectorSubtract(anchor, s_iflcViewOrigin, delta);
+	forward = DotProduct(delta, s_iflcViewForward);
+	if (forward < 1.0f || forward > 512.0f) return;
+	lateralSquared = MAX(0.0f, DotProduct(delta, delta) - forward * forward);
+	threshold = 4.0f + forward * 0.035f;
+	VectorCopy(anchor, rayTarget);
+	if (surfaceIndex >= 0 && R_IFLC_RaySurface(&tr.world->surfaces[surfaceIndex], s_iflcViewOrigin, s_iflcViewForward, 512.0f, &hit)) {
+		exact = qtrue; VectorMA(s_iflcViewOrigin, hit, s_iflcViewForward, rayTarget);
+	}
+	if (!exact && lateralSquared > threshold * threshold) return;
+	if (!R_IFLC_LineVisible(s_iflcViewOrigin, rayTarget)) return;
+	score = exact ? forward * 0.00001f : 1.0f + sqrt(lateralSquared) / forward;
+	R_IFLC_InsertPick(owner, score);
+}
+
+void R_IFLC_Select_f(void)
+{
+	int i;
+	if (!R_IFLC_ReadyForCommand()) return;
+	s_iflcSelected = s_iflcPickCursor = -1; s_iflcPickCount = 0;
+	if (!s_iflcViewValid) { ri.Printf(PRINT_ALL, "IFLC: no primary world view available.\n"); return; }
+	for (i = 0; i < s_iflcSurfaceCount; ++i)
+		R_IFLC_ConsiderPick(s_iflcSurfaces[i].owner, s_iflcSurfaces[i].origin, s_iflcSurfaces[i].surfaceIndex);
+	for (i = 0; i < s_iflcOwnerCount; ++i)
+		if (!s_iflcOwners[i].surfaceCount) R_IFLC_ConsiderPick(i, s_iflcOwners[i].origin, -1);
+	if (s_iflcPickCount == 0) { ri.Printf(PRINT_ALL, "IFLC: no eligible visible flame in crosshair; move closer.\n"); return; }
+	if (s_iflcPickCount > 1) {
+		ri.Printf(PRINT_ALL, "IFLC: ambiguous crosshair (%d candidates); no selection. Use dw_fl_next to choose explicitly.\n", s_iflcPickCount);
+		for (i = 0; i < s_iflcPickCount; ++i) ri.Printf(PRINT_ALL, "  %d: %s\n", i + 1, s_iflcOwners[s_iflcPicks[i]].key);
+		return;
+	}
+	s_iflcSelected = s_iflcPicks[0]; s_iflcPickCursor = 0;
+	R_IFLC_Info_f();
+}
+
+void R_IFLC_Next_f(void)
+{
+	if (!R_IFLC_ReadyForCommand()) return;
+	if (!s_iflcPickCount) { ri.Printf(PRINT_ALL, "IFLC: use dw_fl_select first.\n"); return; }
+	s_iflcPickCursor = (s_iflcPickCursor + 1) % s_iflcPickCount;
+	s_iflcSelected = s_iflcPicks[s_iflcPickCursor];
+	R_IFLC_Info_f();
+}
