+        FBO_t *mask = FBO_Create("_viewmodelMask", width, height);
+        FBO_CreateBuffer(mask, GL_R8, 0, multisample);
+        if (tr.volumetricCoverageDepthTexture)
+            qglNamedFramebufferTexture2DEXT(mask->frameBuffer, GL_DEPTH_ATTACHMENT,
+                GL_TEXTURE_2D_MULTISAMPLE, tr.volumetricCoverageDepthTexture, 0);
+        else
+            qglNamedFramebufferRenderbufferEXT(mask->frameBuffer, GL_DEPTH_ATTACHMENT,
+                GL_RENDERBUFFER, tr.renderFbo->depthBuffer);
+        if (R_CheckFBO(mask))
+        {
+            image_t *coverage = R_CreateImage("*viewmodelCoverage", NULL, width, height,
+                IMGTYPE_COLORALPHA, IMGFLAG_NO_COMPRESSION | IMGFLAG_CLAMPTOEDGE, GL_R8);
+            FBO_t *resolve = FBO_Create("_viewmodelMaskResolve", width, height);
+            FBO_AttachImage(resolve, coverage, GL_COLOR_ATTACHMENT0, 0);
+            if (R_CheckFBO(resolve))
+            {
+                tr.viewmodelMaskFbo = mask;
+                tr.viewmodelMaskResolveFbo = resolve;
+            }
+        }
+    }
+
 	GL_CheckErrors();
 
 	GL_BindFramebuffer(GL_FRAMEBUFFER, 0);
