diff --git a/SP/code/rend2/glsl/viewmodeledge_fp.glsl b/SP/code/rend2/glsl/viewmodeledge_fp.glsl
new file mode 100644
index 0000000..d16dec1
--- /dev/null
+++ b/SP/code/rend2/glsl/viewmodeledge_fp.glsl
@@ -0,0 +1,39 @@
+// Coverage-guided smoothing of first-person geometry after the scene resolve.
+uniform sampler2D u_TextureMap;
+uniform sampler2D u_ScreenDepthMap; // inverted viewmodel coverage
+uniform vec4 u_ViewInfo;           // inclusive viewport bounds in pixels
+
+float coverage(ivec2 pixel)
+{
+    return 1.0 - texelFetch(u_ScreenDepthMap, pixel, 0).r;
+}
+
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    float c = coverage(p);
+    if (c <= 0.001 || c >= 0.999)
+        discard;
+
+    ivec2 lo = ivec2(u_ViewInfo.xy);
+    ivec2 hi = ivec2(u_ViewInfo.zw);
+    ivec2 left  = max(p - ivec2(1, 0), lo);
+    ivec2 right = min(p + ivec2(1, 0), hi);
+    ivec2 down  = max(p - ivec2(0, 1), lo);
+    ivec2 up    = min(p + ivec2(0, 1), hi);
+    vec2 normal = abs(vec2(coverage(right) - coverage(left), coverage(up) - coverage(down)));
+    float slope = normal.x + normal.y;
+
+    // A balanced thin wire or isolated tip has no reliable direction.
+    if (slope < 0.5)
+        discard;
+
+    vec4 center = texelFetch(u_TextureMap, p, 0);
+    vec3 horizontal = 0.5 * (texelFetch(u_TextureMap, left, 0).rgb + texelFetch(u_TextureMap, right, 0).rgb);
+    vec3 vertical = 0.5 * (texelFetch(u_TextureMap, down, 0).rgb + texelFetch(u_TextureMap, up, 0).rgb);
+    vec3 alongEdge = (horizontal * normal.y + vertical * normal.x) / slope;
+
+    // Smooth across one adjacent pixel only, with maximum weight on half-covered pixels.
+    float amount = 0.32 * (4.0 * c * (1.0 - c));
+    gl_FragColor = vec4(mix(center.rgb, alongEdge, amount), center.a);
+}
diff --git a/SP/code/rend2/tr_backend.c b/SP/code/rend2/tr_backend.c
