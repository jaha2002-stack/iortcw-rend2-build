@@ -2155,6 +2155,66 @@ static void RB_FireV07CaptureDrawSurfs(drawSurf_t *drawSurfs, int numDrawSurfs)
 }
 
 
+
+static void RB_CaptureViewmodelCoverage(const drawSurfsCommand_t *cmd)
+{
+    drawSurf_t surfaces[256];
+    int count = 0;
+    int i;
+    ivec4_t rect;
+    unsigned long state;
+    int culling;
+
+    backEnd.viewmodelMaskReady = qfalse;
+    if (!r_viewmodelEdgeAA->integer || !r_postProcess->integer || !tr.viewmodelEdgeShader.program ||
+        !tr.viewmodelMaskFbo || glState.currentFBO != tr.renderFbo ||
+        (backEnd.refdef.rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL)) ||
+        (backEnd.viewParms.flags & (VPF_SHADOWMAP | VPF_DEPTHSHADOW | VPF_ORTHOGRAPHIC)) ||
+        backEnd.viewParms.isPortal || backEnd.viewParms.targetFbo ||
+        backEnd.viewParms.stereoFrame != STEREO_CENTER || r_materialDebug->integer || r_showtris->integer || r_shownormals->integer)
+        return;
+
+    for (i = 0; i < cmd->numDrawSurfs; i++)
+    {
+        const drawSurf_t *surface = &cmd->drawSurfs[i];
+        int entityNum = (surface->sort >> QSORT_REFENTITYNUM_SHIFT) & REFENTITYNUM_MASK;
+        const refEntity_t *entity;
+        if (entityNum == REFENTITYNUM_WORLD)
+            continue;
+        entity = &backEnd.refdef.entities[entityNum].e;
+        if (entity->reType != RT_MODEL || entity->fadeStartTime ||
+            (entity->renderfx & (RF_FIRST_PERSON | RF_DEPTHHACK | RF_CROSSHAIR)) != (RF_FIRST_PERSON | RF_DEPTHHACK))
+            continue;
+        if (count == ARRAY_LEN(surfaces))
+            return;
+        surfaces[count++] = *surface;
+    }
+    if (!count)
+        return;
+
+    VectorSet4(rect, backEnd.viewParms.viewportX, backEnd.viewParms.viewportY,
+        backEnd.viewParms.viewportWidth, backEnd.viewParms.viewportHeight);
+    state = glState.glStateBits;
+    culling = glState.faceCulling;
+    FBO_Bind(tr.viewmodelMaskFbo);
+    SetViewportAndScissor();
+    tr.viewmodelMaskClear(GL_COLOR, 0, colorWhite);
+
+    backEnd.depthFill = qtrue;
+    backEnd.viewmodelMaskFill = qtrue;
+    RB_RenderDrawSurfList(surfaces, count);
+    backEnd.viewmodelMaskFill = qfalse;
+    backEnd.depthFill = qfalse;
+
+    FBO_FastBlit(tr.viewmodelMaskFbo, rect, tr.viewmodelMaskResolveFbo, rect, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    FBO_Bind(tr.renderFbo);
+    SetViewportAndScissor();
+    GL_State(state);
+    GL_Cull(culling);
+    Vector4Copy(rect, backEnd.viewmodelMaskRect);
+    backEnd.viewmodelMaskReady = qtrue;
+}
+
 const void	*RB_DrawSurfs( const void *data ) {
 	const drawSurfsCommand_t	*cmd;
 	qboolean isShadowView;
@@ -2518,6 +2578,9 @@ const void	*RB_DrawSurfs( const void *data ) {
 	{
 		RB_RenderDrawSurfList( cmd->drawSurfs, cmd->numDrawSurfs );
 
+		if (!backEnd.viewParms.targetFbo && !backEnd.viewParms.isPortal)
+			RB_CaptureViewmodelCoverage(cmd);
+
 		if (r_drawSun->integer)
 		{
 			RB_DrawSun(0.2, tr.sunShader);
@@ -2766,6 +2829,7 @@ const void	*RB_SwapBuffers( const void *data ) {
 	}
 
 	cmd = (const swapBuffersCommand_t *)data;
+	backEnd.viewmodelMaskReady = qfalse;
 
 	// we measure overdraw by reading back the stencil buffer and
 	// counting up the number of increments that have happened
@@ -10329,6 +10393,29 @@ static void RB_DWFinalPolish(FBO_t *srcFbo, ivec4_t srcBox)
 	FBO_FastBlit(tr.screenScratchFbo, srcBox, srcFbo, srcBox, GL_COLOR_BUFFER_BIT, GL_NEAREST);
 }
 
+
+static void RB_ViewmodelEdgeAA(FBO_t *srcFbo, ivec4_t srcBox)
+{
+    shaderProgram_t *shader = &tr.viewmodelEdgeShader;
+    vec4_t clampRect;
+
+    if (!backEnd.viewmodelMaskReady)
+        return;
+    backEnd.viewmodelMaskReady = qfalse;
+    if (!r_viewmodelEdgeAA->integer || srcFbo != tr.msaaResolveFbo ||
+        memcmp(srcBox, backEnd.viewmodelMaskRect, sizeof(ivec4_t)))
+        return;
+
+    // Composite after lighting and grading. Sample a color-only copy while
+    // preserving the exact scene color and depth outside the weapon edge.
+    FBO_FastBlit(srcFbo, srcBox, tr.volumetricFullresFbo, srcBox, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    VectorSet4(clampRect, srcBox[0], srcBox[1], srcBox[0] + srcBox[2] - 1, srcBox[1] + srcBox[3] - 1);
+    GLSL_BindProgram(shader);
+    GLSL_SetUniformVec4(shader, UNIFORM_VIEWINFO, clampRect);
+    GL_BindToTMU(tr.viewmodelMaskResolveFbo->colorImage[0], TB_NORMALMAP);
+    FBO_Blit(tr.volumetricFullresFbo, srcBox, NULL, srcFbo, srcBox, shader, NULL, 0);
+}
+
 const void *RB_PostProcess(const void *data)
 {
 	const postProcessCommand_t *cmd = data;
@@ -10591,6 +10678,7 @@ const void *RB_PostProcess(const void *data)
 		RB_GaussianBlur(srcFbo, srcFbo, backEnd.refdef.blurFactor);
 	RB_USLRDRootCauseSampleStage(srcFbo, srcBox, s_uslrdRcAfterBokeh);
 	RB_DWFinalPolish(srcFbo, srcBox); // DARKWOLF_CAS_A2C_LUT_V01
+	RB_ViewmodelEdgeAA(srcFbo, srcBox);
 
 	RB_USLRDRootCauseEndPixelSample(srcFbo, srcBox, autoExposure);
 
