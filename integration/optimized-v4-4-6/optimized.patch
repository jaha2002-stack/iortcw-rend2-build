index 08593109..c67ca49f 100644
--- a/SP/code/rend2/tr_main.c
+++ b/SP/code/rend2/tr_main.c
@@ -2979,6 +2979,10 @@ static qboolean R_DarkWolfStaticPromoteShadowCompanionEquivalent(const dlight_t
 // Connected-component grouping makes the equivalence transitive and deterministic even if
 // three learned points form a short chain.  MAX_DLIGHTS is only 32, so this is tiny compared
 // with six-face cubemap rendering and avoids any map-specific identity assumptions.
+// v4.4.6 clean optimization: invocation-scoped labels, never a temporal shadow cache.
+static qboolean s_dwShadowGroupLabelsActive = qfalse;
+static int s_dwShadowGroupLabels[MAX_DLIGHTS];
+
 static int R_DarkWolfStaticPromoteShadowGroupCanonicalId(int startIndex)
 {
     int queue[MAX_DLIGHTS], visited[MAX_DLIGHTS];
@@ -2989,6 +2993,8 @@ static int R_DarkWolfStaticPromoteShadowGroupCanonicalId(int startIndex)
     R_DarkWolfEnsurePhysicalShadowGroupCvars();
     if (!s_rStaticPromotePhysicalShadowGroup || !s_rStaticPromotePhysicalShadowGroup->integer)
         return tr.refdef.dlights[startIndex].staticPromoteFixtureId;
+    if (s_dwShadowGroupLabelsActive && s_dwShadowGroupLabels[startIndex] != -2)
+        return s_dwShadowGroupLabels[startIndex];
     Com_Memset(visited, 0, sizeof(visited));
     visited[startIndex] = 1;
     queue[tail++] = startIndex;
@@ -3010,6 +3016,9 @@ static int R_DarkWolfStaticPromoteShadowGroupCanonicalId(int startIndex)
             }
         }
     }
+    if (s_dwShadowGroupLabelsActive)
+        for (i = 0; i < tail; ++i)
+            s_dwShadowGroupLabels[queue[i]] = canonical;
     return canonical;
 }
 
@@ -3295,6 +3304,12 @@ void R_RenderDlightCubemaps(const refdef_t *fd)
 	if (maxShadowLights == 0)
 		return;
 
+	// Reset for every scene invocation, including same-frame secondary views.
+	// Origins, radii, colors and eligibility remain immutable until this call returns.
+	for (historyInitIndex = 0; historyInitIndex < MAX_DLIGHTS; ++historyInitIndex)
+		s_dwShadowGroupLabels[historyInitIndex] = -2;
+	s_dwShadowGroupLabelsActive = qtrue;
+
 	allLightsMask = tr.refdef.num_dlights >= 32 ? 0xFFFFFFFFu : ((1u << tr.refdef.num_dlights) - 1u);
 	savedDlightMask = tr.refdef.dlightMask;
 	visibleLightsMask = allLightsMask & ~savedDlightMask;
@@ -3877,6 +3892,7 @@ void R_RenderDlightCubemaps(const refdef_t *fd)
 	// Shadow views update dlightMask while traversing the world. Restore the
 	// main-view visibility result so later front-end work is deterministic.
 	tr.refdef.dlightMask = savedDlightMask;
+	s_dwShadowGroupLabelsActive = qfalse;
 }
 
 
