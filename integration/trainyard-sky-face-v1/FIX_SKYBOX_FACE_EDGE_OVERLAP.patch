+/*
+ * DARKWOLF_SKYBOX_FACE_EDGE_OVERLAP_V1
+ * The old six-face skybox uses independently rasterized 8x8 grids.
+ * Adjacent sky face clip boundaries meet at exactly one shared ray, which
+ * can leave isolated uncovered MSAA samples at grid-vertex joins.
+ * Extend only the OUTER/INNER opaque skybox edge vertices by 0.3 percent
+ * into adjacent faces; leave all cloud geometry, cloud UV projections,
+ * sky texture samplers, depth state, scene, fog and lighting unchanged.
+ * The sky is still drawn through the existing depth-tested sky path.
+ */
+static void MakeSkyBoxFaceSeamSafeVec( float s, float t, int axis,
+                                      float outSt[2], vec3_t outXYZ )
+{
+    const float edgeOverlap = 0.003f;
+    const float edgeLimit = 0.99999f;
+    const float sOverlap = (s >= edgeLimit) ? s + edgeOverlap :
+                           (s <= -edgeLimit) ? s - edgeOverlap : s;
+    const float tOverlap = (t >= edgeLimit) ? t + edgeOverlap :
+                           (t <= -edgeLimit) ? t - edgeOverlap : t;
+    MakeSkyVec( sOverlap, tOverlap, axis, outSt, outXYZ );
+}
