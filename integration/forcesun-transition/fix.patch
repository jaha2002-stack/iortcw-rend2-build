+static sunCsmSource_t R_SunCsmSourceForView(void)
+{
+	if (!glRefConfig.framebufferObject || !r_sunlightMode->integer)
+		return SUN_CSM_NONE;
+	if (r_forceSun->integer == 1)
+		return SUN_CSM_FORCED_STATIC;
+	if (r_forceSun->integer == 2)
+		return SUN_CSM_FORCED_DYNAMIC;
+	if (r_forceSun->integer || tr.sunShadows)
+		return SUN_CSM_MAP_VISIBLE;
+	if (R_VolumetricSunMapSourceValid())
+		return SUN_CSM_MAP_VOLUMETRIC;
+	return SUN_CSM_NONE;
+}
+
+static viewParmFlags_t R_PrepareSunCascades(const refdef_t *fd)
+{
+	sunCsmSource_t source;
+	qboolean sourceChanged, cascades, sunChanged;
+	int firstCascade, cascade;
+
+	tr.volumetricSunPerfCsmRenderedThisFrame = 0;
+	tr.volumetricSunPerfCsmRequestThisFrame = 0;
+	// The skybox precedes the main view and has no cascades of its own.
+	if (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+		return VPF_NONE;
+
+	source = R_SunCsmSourceForView();
+	sourceChanged = source != tr.sunCsmSource;
+	if (sourceChanged)
+	{
+		// All producers overwrite the same depth textures. A matrix cached by
+		// a different producer no longer identifies the contents of that texture.
+		Com_Memset(tr.volumetricSunCsmValid, 0, sizeof(tr.volumetricSunCsmValid));
+		tr.volumetricSunCsmLastRequestTime = 0;
+		tr.sunCsmSource = source;
+	}
+	if (source == SUN_CSM_NONE)
+		return VPF_NONE;
+
+	cascades = r_shadowCascadeZFar->integer != 0;
+	firstCascade = cascades ? 0 : 3;
+	if (!cascades)
+	{
+		for (cascade = 0; cascade < 3; ++cascade)
+			Mat4Zero(tr.refdef.sunShadowMvp[cascade]);
+	}
+
+	if (source == SUN_CSM_MAP_VOLUMETRIC &&
+		(!r_volumetricSunCsmProducer || !r_volumetricSunCsmProducer->integer))
+	{
+		// A paused producer can only reuse a complete set from this source.
+		for (cascade = firstCascade; cascade < 4; ++cascade)
+		{
+			if (!tr.volumetricSunCsmValid[cascade])
+				return VPF_NONE;
+			R_VolumetricSunRestoreCascade(cascade);
+		}
+	}
+	else if (source == SUN_CSM_MAP_VOLUMETRIC || source == SUN_CSM_FORCED_STATIC)
+	{
+		const qboolean volumetricOnly = source == SUN_CSM_MAP_VOLUMETRIC;
+		sunChanged = R_VolumetricSunDirectionChanged(tr.refdef.sunDir, tr.volumetricSunCsmSunDirection);
+		if (volumetricOnly)
+		{
+			const int lastRequestTime = tr.volumetricSunCsmLastRequestTime;
+			sunChanged = sunChanged || lastRequestTime <= 0 || fd->time < lastRequestTime ||
+				fd->time - lastRequestTime > 1000;
+			tr.volumetricSunCsmRequestFrame = tr.frameCount;
+			tr.volumetricSunCsmLastRequestTime = fd->time;
+			tr.volumetricSunPerfCsmRequestThisFrame = 1;
+		}
+		else
+		{
+			if (R_ForceSunVisibleNeedsReprime(fd))
+				Com_Memset(tr.volumetricSunCsmValid, 0, sizeof(tr.volumetricSunCsmValid));
+			R_ForceSunVisibleRemember(fd);
+		}
+
+		for (cascade = firstCascade; cascade < 4; ++cascade)
+		{
+			if (sunChanged || (volumetricOnly ?
+				R_VolumetricSunShouldUpdateCascade(cascade, tr.frameCount) :
+				R_ForceSunVisibleShouldUpdateCascade(cascade)))
+			{
+				R_RenderSunShadowMaps(fd, cascade);
+				R_VolumetricSunCommitCascade(cascade);
+			}
+			else
+			{
+				R_VolumetricSunRestoreCascade(cascade);
+			}
+		}
+		if (sunChanged)
+			VectorCopy(tr.refdef.sunDir, tr.volumetricSunCsmSunDirection);
+	}
+	else
+	{
+		for (cascade = firstCascade; cascade < 3; ++cascade)
+			R_RenderSunShadowMaps(fd, cascade);
+
+		if (sourceChanged || source == SUN_CSM_FORCED_DYNAMIC ||
+			!VectorCompare(tr.refdef.sunDir, tr.lastCascadeSunDirection))
+		{
+			VectorCopy(tr.refdef.sunDir, tr.lastCascadeSunDirection);
+			R_RenderSunShadowMaps(fd, 3);
+			Mat4Copy(tr.refdef.sunShadowMvp[3], tr.lastCascadeSunMvp);
+		}
+		else
+		{
+			Mat4Copy(tr.lastCascadeSunMvp, tr.refdef.sunShadowMvp[3]);
+		}
+	}
+
+	if (!r_depthPrepass->integer)
+		return VPF_NONE;
+	if (source == SUN_CSM_MAP_VOLUMETRIC)
+		return VPF_USESUNCSM;
+	return VPF_USESUNCSM | VPF_USESUNLIGHT;
+}
