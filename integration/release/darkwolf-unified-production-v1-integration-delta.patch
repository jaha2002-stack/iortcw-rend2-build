+// DARKWOLF_UNIFIED_PHYSICAL_BLOCK_V1
+// Overrides remain backward-compatible on disk, but their effective ownership is
+// the map-lifetime PLR association.  Any blocked alias vetoes the complete physical
+// promoted lamp before Direct Light, LocalVol and point-shadow consumers.
+static int R_StaticPromotePhysicalOverrideState(const staticPromotePersistentLight_t *light)
+{
+	const char *mapName = tr.world ? tr.world->baseName : "";
+	int aliases[5];
+	int i;
+	int state = 0;
+	if (!light)
+		return 0;
+	aliases[0] = light->candidate.entityOrdinal;
+	aliases[1] = light->physicalLightJuniorOrdinal;
+	aliases[2] = light->physicalCoronaOrdinal;
+	aliases[3] = light->physicalNativeDlightOrdinal;
+	aliases[4] = light->physicalFireSpeakerOrdinal;
+	for (i = 0; i < 5; ++i)
+	{
+		int aliasState;
+		int j;
+		if (aliases[i] < 0)
+			continue;
+		for (j = 0; j < i; ++j)
+			if (aliases[j] == aliases[i])
+				break;
+		if (j < i)
+			continue;
+		aliasState = R_StaticPromoteUserOverrideState(mapName, aliases[i]);
+		if (aliasState < 0)
+			return -1;
+		if (aliasState > 0)
+			state = 1;
+	}
+	return state;
+}
+
+static qboolean R_StaticPromotePhysicalOverrideSet(const staticPromotePersistentLight_t *light, int state)
+{
+	const char *mapName = tr.world ? tr.world->baseName : "";
+	int aliases[5];
+	int i;
+	if (!light)
+		return qfalse;
+	aliases[0] = light->candidate.entityOrdinal;
+	aliases[1] = light->physicalLightJuniorOrdinal;
+	aliases[2] = light->physicalCoronaOrdinal;
+	aliases[3] = light->physicalNativeDlightOrdinal;
+	aliases[4] = light->physicalFireSpeakerOrdinal;
+	for (i = 0; i < 5; ++i)
+	{
+		int j;
+		if (aliases[i] < 0)
+			continue;
+		for (j = 0; j < i; ++j)
+			if (aliases[j] == aliases[i])
+				break;
+		if (j < i)
+			continue;
+		if (!R_StaticPromoteUserOverrideSet(mapName, aliases[i], state))
+			return qfalse;
+	}
+	return qtrue;
+}
