+// Use the scene's original depth coverage when SunVol will need it after the color resolve.
+#define MAX_SUN_COVERAGE_SAMPLES 32
+typedef void (APIENTRYP sunGetTexLevelProc_t)(GLenum, GLint, GLenum, GLint *);
+static qboolean FBO_AttachSunCoverageDepth(FBO_t *fbo, int samples)
+{
+    PFNGLTEXIMAGE2DMULTISAMPLEPROC storage;
+    sunGetTexLevelProc_t getLevel;
+    GLint maxSamples, oldBinding, actualSamples = 0;
+    GLuint texture;
+    GLenum error;
+
+    if (!r_hdr->integer || !r_volumetricSun->integer || !QGL_VERSION_ATLEAST(3, 2) ||
+        (glRefConfig.glslMajorVersion == 1 && glRefConfig.glslMinorVersion < 50) ||
+        samples > MAX_SUN_COVERAGE_SAMPLES)
+        return qfalse;
+    storage = (PFNGLTEXIMAGE2DMULTISAMPLEPROC)SDL_GL_GetProcAddress("glTexImage2DMultisample");
+    getLevel = (sunGetTexLevelProc_t)SDL_GL_GetProcAddress("glGetTexLevelParameteriv");
+    if (!storage || !getLevel)
+        return qfalse;
+
+    qglGetIntegerv(GL_MAX_DEPTH_TEXTURE_SAMPLES, &maxSamples);
+    if (samples > maxSamples)
+        return qfalse;
+
+    qglGetIntegerv(GL_TEXTURE_BINDING_2D_MULTISAMPLE, &oldBinding);
+    qglGenTextures(1, &texture);
+    qglBindTexture(GL_TEXTURE_2D_MULTISAMPLE, texture);
+    storage(GL_TEXTURE_2D_MULTISAMPLE, samples, GL_DEPTH_COMPONENT24, fbo->width, fbo->height, GL_TRUE);
+    error = qglGetError();
+    if (error == GL_NO_ERROR)
+        getLevel(GL_TEXTURE_2D_MULTISAMPLE, 0, GL_TEXTURE_SAMPLES, &actualSamples);
+    qglBindTexture(GL_TEXTURE_2D_MULTISAMPLE, oldBinding);
+    if (actualSamples >= 2 && actualSamples <= MAX_SUN_COVERAGE_SAMPLES)
+    {
+        qglNamedFramebufferTexture2DEXT(fbo->frameBuffer, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D_MULTISAMPLE, texture, 0);
+        if (R_CheckFBO(fbo))
+        {
+            fbo->depthFormat = GL_DEPTH_COMPONENT24;
+            tr.sunCoverageDepthTexture = texture;
+            tr.sunCoverageSamples = actualSamples;
+            return qtrue;
+        }
+    }
+    qglDeleteTextures(1, &texture);
+    return qfalse;
+}
