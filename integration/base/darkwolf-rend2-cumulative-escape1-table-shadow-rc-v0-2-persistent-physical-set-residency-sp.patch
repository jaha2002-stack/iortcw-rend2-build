+static qboolean R_DW_CCDFShouldSuppressWorldSurface(msurface_t *surf)
+{
+    static cvar_t *mode = NULL;
+    int surfaceIndex;
+    int canonical;
+
+    if (!mode)
+        mode = ri.Cvar_Get("r_coplanarContainedFaceDeconflict", "1", 0);
+    if (!mode || mode->integer != 1)
+        return qfalse;
+
+    if (!tr.world || tr.currentEntityNum != REFENTITYNUM_WORLD || tr.viewParms.isPortal ||
+        (tr.viewParms.flags & (VPF_SHADOWMAP | VPF_DEPTHSHADOW | VPF_ORTHOGRAPHIC)) ||
+        !surf || surf < tr.world->surfaces || surf >= tr.world->surfaces + tr.world->numWorldSurfaces)
+        return qfalse;
+
+    if (!s_dwCoplanarContainedRegistry.built ||
+        s_dwCoplanarContainedRegistry.world != tr.world ||
+        s_dwCoplanarContainedRegistry.surfaces != tr.world->surfaces ||
+        s_dwCoplanarContainedRegistry.numWorldSurfaces != tr.world->numWorldSurfaces)
+    {
+        R_DW_CCDFBuildRegistry();
+    }
+
+    if (!s_dwCoplanarContainedRegistry.built || !s_dwCoplanarContainedRegistry.canonicalForSurface)
+        return qfalse;
+
+    surfaceIndex = (int)(surf - tr.world->surfaces);
+    canonical = s_dwCoplanarContainedRegistry.canonicalForSurface[surfaceIndex];
+    if (canonical < 0 || canonical >= tr.world->numWorldSurfaces)
+        return qfalse;
+
+    if (tr.world->surfacesViewCount[canonical] != tr.viewCount)
+        return qfalse;
+
+    return qtrue;
+}
