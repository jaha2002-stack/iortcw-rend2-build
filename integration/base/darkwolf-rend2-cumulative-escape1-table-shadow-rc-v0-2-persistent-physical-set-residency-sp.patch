+static void RB_FireV071CopyPoolLatchToSelection(const fireVolumetricV07PoolSlot_t *pool,
+	fireVolumetricV07Selection_t *sel)
+{
+	if (!pool || !sel || !pool->latchValid)
+		return;
+	sel->latchValid = qtrue;
+	sel->latchedFlameSurface = pool->latchedFlameSurface;
+	VectorCopy(pool->latchedFlameOrigin, sel->latchedFlameOrigin);
+	Q_strncpyz(sel->latchedShader, pool->latchedShader, sizeof(sel->latchedShader));
+	sel->latchedAtMs = pool->latchedAtMs;
+	sel->anchorVisibleNow = RB_FireV071FindLatchedRenderedIndex(pool->latchedFlameSurface,
+		pool->latchedShader, pool->latchedFlameOrigin) >= 0 ? 1 : 0;
+}
