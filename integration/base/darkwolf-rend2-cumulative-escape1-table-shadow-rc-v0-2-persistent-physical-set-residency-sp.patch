+// REND2_REF_1_V1_MATERIAL_AWARE_CUBEMAP_REFLECTIONS
+// REND2_REF_1_V1_1_ROBUST_ANCHOR_FIX
+// Scale only Rend2's existing cubemap contribution. No GLSL/BRDF/cubemap capture math is changed.
+// Explicit/auto/legacy/author material response remains at vanilla cubemap scale 1.0.
+static qboolean R_Ref1ReflectionEligible(const shaderStage_t *pStage)
+{
+	int classBit;
+
+	if (!pStage || pStage->glslShaderGroup != tr.lightallShader)
+		return qfalse;
+	if (!r_materialAwareReflections || !r_materialAwareReflections->integer ||
+		!r_materialReflectionClassMask)
+		return qfalse;
+	if (pStage->materialSpecularSource != MATDBG_SPEC_FALLBACK || pStage->materialExplicitResponse)
+		return qfalse;
+	if (pStage->materialHeuristicClass > MATDBG_CLASS_CERAMIC)
+		return qfalse;
+
+	classBit = 1 << pStage->materialHeuristicClass;
+	return (r_materialReflectionClassMask->integer & classBit) ? qtrue : qfalse;
+}
+
+static float R_Ref1ClassReflectionScale(byte materialClass)
+{
+	switch (materialClass)
+	{
+		case MATDBG_CLASS_MINERAL: return r_materialReflectionMineralScale->value;
+		case MATDBG_CLASS_WOOD: return r_materialReflectionWoodScale->value;
+		case MATDBG_CLASS_METAL: return r_materialReflectionMetalScale->value;
+		case MATDBG_CLASS_GLASS: return r_materialReflectionGlassScale->value;
+		case MATDBG_CLASS_ORGANIC: return r_materialReflectionOrganicScale->value;
+		case MATDBG_CLASS_SNOW: return r_materialReflectionSnowScale->value;
+		case MATDBG_CLASS_FABRIC: return r_materialReflectionFabricScale->value;
+		case MATDBG_CLASS_CERAMIC: return r_materialReflectionCeramicScale->value;
+		case MATDBG_CLASS_UNKNOWN:
+		default: return r_materialReflectionUnknownScale->value;
+	}
+}
+
+static float R_Ref1ReflectionScale(const shaderStage_t *pStage)
+{
+	float scale;
+	float maxScale;
+
+	if (!R_Ref1ReflectionEligible(pStage))
+		return 1.0f;
+
+	scale = CLAMP(R_Ref1ClassReflectionScale(pStage->materialHeuristicClass), 0.0f, 1.0f);
+	maxScale = r_materialReflectionMax ? CLAMP(r_materialReflectionMax->value, 0.0f, 1.0f) : 1.0f;
+	if (scale > maxScale)
+		scale = maxScale;
+	return scale;
+}
