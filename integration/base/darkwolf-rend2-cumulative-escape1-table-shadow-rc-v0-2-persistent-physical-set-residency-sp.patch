+static void R_StaticPromoteLearnTargetAction(int desiredState, const char *actionName)
+{
+	int fixtureIndex;
+	float forwardDistance;
+	float lateralDistance;
+	staticPromotePersistentLight_t *light;
+	int currentOverride;
+	int classReason;
+
+	if (!tr.world || !R_StaticPromoteBuildPersistentRegistry())
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE LEARN: no loaded world registry\n");
+		return;
+	}
+	fixtureIndex = R_StaticPromoteFindCrosshairFixture(&forwardDistance, &lateralDistance);
+	if (fixtureIndex < 0)
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE LEARN: no BSP light fixture near crosshair. Aim at the bulb/fixture and move closer.\n");
+		return;
+	}
+	light = &s_staticPromotePersistentLights[fixtureIndex];
+	currentOverride = R_StaticPromoteUserOverrideState(tr.world->baseName, light->candidate.entityOrdinal);
+	classReason = R_StaticPromoteClassifyFixture(light);
+	ri.Printf(PRINT_ALL,
+		"STATIC_PROMOTE TARGET map=%s fixture=%d entity=%d origin=%.1f %.1f %.1f rawMembers=%d intensity=%.1f class=%s override=%d rayForward=%.1f rayLateral=%.1f\n",
+		tr.world->baseName, fixtureIndex, light->candidate.entityOrdinal,
+		light->candidate.origin[0], light->candidate.origin[1], light->candidate.origin[2],
+		light->rawMembers, light->candidate.intensity, R_StaticPromoteClassReasonName(classReason),
+		currentOverride, forwardDistance, lateralDistance);
+	if (desiredState == 99)
+		return;
+	if (!R_StaticPromoteUserOverrideSet(tr.world->baseName, light->candidate.entityOrdinal, desiredState))
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE %s FAILED: could not save %s\n", actionName, STATIC_PROMOTE_USER_OVERRIDE_FILE);
+		return;
+	}
+	s_staticPromoteLastReportWorld = NULL;
+	ri.Printf(PRINT_ALL, "STATIC_PROMOTE %s SAVED map=%s entity=%d state=%d file=%s\n",
+		actionName, tr.world->baseName, light->candidate.entityOrdinal, desiredState, STATIC_PROMOTE_USER_OVERRIDE_FILE);
+}
