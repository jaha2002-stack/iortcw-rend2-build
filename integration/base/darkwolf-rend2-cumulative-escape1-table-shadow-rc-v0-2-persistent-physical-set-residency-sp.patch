+static void R_StaticPromoteExact8MarkAccepted(staticPromotePersistentLight_t *light,
+	int evidenceFlags, float score, int juniorOrdinal, int coronaOrdinal)
+{
+	if (!light)
+		return;
+	light->physicalRecognitionAccepted = qtrue;
+	light->physicalEvidenceFlags |= PLR_EXACT8_EVIDENCE_EXACT_IDENTITY | evidenceFlags;
+	light->physicalSourceRoute = PLR_V01_SOURCE_PROMOTED;
+	if (juniorOrdinal >= 0)
+		light->physicalLightJuniorOrdinal = juniorOrdinal;
+	if (coronaOrdinal >= 0)
+		light->physicalCoronaOrdinal = coronaOrdinal;
+	if (score < light->physicalAssociationScore)
+		light->physicalAssociationScore = score;
+}
