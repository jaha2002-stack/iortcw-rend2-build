+static void R_DarkWolfVisibleSurfaceResidencyStartupDiag(void)
+{
+	// Production release: retired A/B startup diagnostic removed.
+}
+
+static int R_StaticPromoteSelectPersistentInfluenceLegacy(const refdef_t *fd,
+	staticPromotePersistentLight_t **selected, int maxLights,
+	int *viewClusterOut, int *visibleCountOut, int *heldCountOut, int *overflowCountOut,
+	int *classifierAcceptedOut, int *classifierRejectedOut)
+{
+	mnode_t *viewLeaf;
+	const byte *vis;
+	int viewCluster;
+	int now;
+	int holdMs;
+	int autoMapLights;
+	int pvsEnabled;
+	int visibleCount;
+	int physicalFallbackCount;
+	int surfaceFallbackCount;
+	int heldCount;
+	int selectedCount;
+	int eligibleCount;
+	int classifierAccepted;
+	int classifierRejected;
+	int i;
+	int pass;
+	int priority;
+
+	if (!fd || !selected)
+		return 0;
+	maxLights = CLAMP(maxLights, 1, STATIC_PROMOTE_PRODUCTION_MAX_ACTIVE);
+	now = ri.Milliseconds();
+	holdMs = r_staticPromotePVSHoldMs ? r_staticPromotePVSHoldMs->integer : 8000;
+	holdMs = CLAMP(holdMs, 0, 30000);
+	autoMapLights = r_staticPromoteAutoMapLights ? r_staticPromoteAutoMapLights->integer : 1;
+	pvsEnabled = r_staticPromotePVS ? r_staticPromotePVS->integer : 1;
+	viewLeaf = R_StaticPromotePointInLeafSafe(fd->vieworg);
+	viewCluster = viewLeaf ? viewLeaf->cluster : -1;
+	vis = NULL;
+	if (pvsEnabled && tr.world->vis && viewCluster >= 0 && viewCluster < tr.world->numClusters)
+		vis = tr.world->vis + viewCluster * tr.world->clusterBytes;
+
+	visibleCount = 0;
+	physicalFallbackCount = 0;
+	surfaceFallbackCount = 0;
+	heldCount = 0;
+	s_staticPromoteVisibleSurfaceProbeCount = 0;
+	Com_Memset(s_staticPromoteVisibleSurfaceSignalNow, 0, sizeof(s_staticPromoteVisibleSurfaceSignalNow));
+	Com_Memset(s_staticPromoteVisibleSurfaceResidencyNow, 0, sizeof(s_staticPromoteVisibleSurfaceResidencyNow));
+	classifierAccepted = 0;
+	Com_Memset(s_staticPromotePhysicalResidencyFallbackNow, 0, sizeof(s_staticPromotePhysicalResidencyFallbackNow));
+	Com_Memset(s_staticPromotePhysicalResidencyCoronaPresent, 0, sizeof(s_staticPromotePhysicalResidencyCoronaPresent));
+	Com_Memset(s_staticPromotePhysicalResidencyCoronaFlags, 0, sizeof(s_staticPromotePhysicalResidencyCoronaFlags));
+	classifierRejected = 0;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		qboolean allowed;
+		qboolean visibleNow = qfalse;
+		qboolean held = qfalse;
+		qboolean coronaPresent = qfalse;
+		qboolean physicalVisible = qfalse;
+		qboolean surfaceVisible = qfalse;
+		int coronaFlags = 0;
+		int classReason;
+		light->influenceVisibleNow = qfalse;
+		light->heldResident = qfalse;
+
+		if (!autoMapLights)
+		{
+			int userOverride = R_StaticPromoteUserOverrideState(tr.world ? tr.world->baseName : "", light->candidate.entityOrdinal);
+			allowed = userOverride < 0 ? qfalse : (userOverride > 0 || light->approvedFallback);
+		}
+		else
+		{
+			classReason = R_StaticPromoteClassifyFixture(light);
+			allowed = (classReason == STATIC_PROMOTE_CLASS_ACCEPT) ? qtrue : qfalse;
+		}
+		if (!allowed)
+		{
+			classifierRejected++;
+			continue;
+		}
+		classifierAccepted++;
+
+		if (!pvsEnabled)
+			visibleNow = qtrue;
+		else
+			visibleNow = R_StaticPromoteInfluenceVisible(fd, vis, light);
+		// DARKWOLF_PCRB_V0_5_VISIBLE_FIXTURE_IDENTITY_PVS_PORTAL_OCCLUDER_SURFACE_CORRELATION
+		// Observe the already-final PVS decision; never feed diagnostics back into residency.
+		R_DarkWolfPCRBV05ObservePVS(fd, vis, light, visibleNow);
+		physicalVisible = R_StaticPromotePhysicalCoronaVisible(light, &coronaPresent, &coronaFlags);
+		s_staticPromotePhysicalResidencyCoronaPresent[i] = coronaPresent;
+		s_staticPromotePhysicalResidencyCoronaFlags[i] = coronaFlags;
+		surfaceVisible = R_StaticPromoteVisibleSurfaceSignalForFixture(i, light);
+		s_staticPromoteVisibleSurfaceSignalNow[i] = surfaceVisible;
+		if (visibleNow)
+		{
+			light->lastInfluenceVisibleMs = now;
+			visibleCount++;
+		}
+		else if (R_StaticPromotePhysicalResidencyEnabled() && physicalVisible)
+		{
+			s_staticPromotePhysicalResidencyFallbackNow[i] = qtrue;
+			light->lastInfluenceVisibleMs = now;
+			physicalFallbackCount++;
+		}
+		else if (R_StaticPromoteVisibleSurfaceResidencyEnabled() && surfaceVisible)
+		{
+			s_staticPromoteVisibleSurfaceResidencyNow[i] = qtrue;
+			light->lastInfluenceVisibleMs = now;
+			surfaceFallbackCount++;
+		}
+		// Probe only the exact gap the new path is intended to solve. PVS-visible
+		// fixtures do not need probing; if PVS drops, the existing hold covers the
+		// first frame while this observer fills next[].
+		if (!visibleNow && !physicalVisible)
+			R_StaticPromoteVisibleSurfaceAddProbe(i, light);
+		if (!visibleNow && !s_staticPromotePhysicalResidencyFallbackNow[i] &&
+			!s_staticPromoteVisibleSurfaceResidencyNow[i] &&
+			holdMs > 0 && light->lastInfluenceVisibleMs > -900000000 &&
+			now - light->lastInfluenceVisibleMs <= holdMs)
+		{
+			held = qtrue;
+			heldCount++;
+		}
+		light->influenceVisibleNow = visibleNow;
+		light->heldResident = held;
+
+		// DARKWOLF_PCRB_V0_4_PHYSICAL_FIXTURE_MULTIPOINT_VISIBILITY_OCCLUDER_LOCALIZATION
+		// Observer only; all production selection/residency values above are final.
+		R_DarkWolfPCRBV04PublishFixture(light, visibleNow, physicalVisible, held,
+			coronaPresent, coronaFlags);
+	}
+
+	// Physical evidence is the overflow policy. Camera distance never participates.
+	// User FORCE ON wins first, then synthetic learned lights, validated fixtures, grouped fixtures,
+	// and only a permissive single-light classifier can reach priority 5. FORCE OFF never enters selection.
+	selectedCount = 0;
+	for (priority = 0; priority <= 5 && selectedCount < maxLights; ++priority)
+	{
+		for (pass = 0; pass < 4 && selectedCount < maxLights; ++pass)
+		{
+			for (i = 0; i < s_staticPromotePersistentCount && selectedCount < maxLights; ++i)
+			{
+				staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+				if (R_StaticPromotePhysicalPriority(light) != priority)
+					continue;
+				if ((pass == 0 && light->influenceVisibleNow) ||
+					(pass == 1 && s_staticPromotePhysicalResidencyFallbackNow[i]) ||
+					(pass == 2 && s_staticPromoteVisibleSurfaceResidencyNow[i]) ||
+					(pass == 3 && light->heldResident))
+					selected[selectedCount++] = light;
+			}
+		}
+	}
+
+	eligibleCount = visibleCount + physicalFallbackCount + surfaceFallbackCount + heldCount;
+	if (viewClusterOut)
+		*viewClusterOut = viewCluster;
+	if (visibleCountOut)
+		*visibleCountOut = visibleCount;
+	if (heldCountOut)
+		*heldCountOut = heldCount;
+	if (overflowCountOut)
+		*overflowCountOut = MAX(0, eligibleCount - selectedCount);
+	if (classifierAcceptedOut)
+		*classifierAcceptedOut = classifierAccepted;
+	if (classifierRejectedOut)
+		*classifierRejectedOut = classifierRejected;
+	return selectedCount;
+}
+
+// DARKWOLF_USLRD_V0_1 -------------------------------------------------------
+static int s_uslrdSceneNativeCount;
+static int s_uslrdGlobalDlightsUsed;
+static int s_uslrdHeadroom;
+static int s_uslrdStaticBudget;
+static int s_uslrdBudgetEvictions;
+static int s_uslrdSubmittedPromoted;
+static int s_uslrdLastSummaryMs;
+static unsigned int s_uslrdLastSummarySig;
+
+static const char *R_StaticPromoteUSLRDTierName(int tier)
+{
+	switch (tier)
+	{
+		case DWSP_TIER_SURFACE_VISIBLE: return "SURFACE_VISIBLE";
+		case DWSP_TIER_SPHERE_PVS_CONNECTED: return "SPHERE_PVS_CONNECTED";
+		case DWSP_TIER_PHYSICAL_FIXTURE_FALLBACK: return "PHYSICAL_FIXTURE_FALLBACK";
+		case DWSP_TIER_GRACE_HELD: return "GRACE_HELD";
+		default: return "LATENT";
+	}
+}
+
+static const char *R_StaticPromoteUSLRDRouteName(int route)
+{
+	if (route == USLRD_ROUTE_NATIVE) return "NATIVE";
+	if (route == USLRD_ROUTE_PROMOTED) return "PROMOTED";
+	return "NONE";
+}
+
+static const staticPromotePLRMarker_t *R_StaticPromoteUSLRDNativeMarker(const staticPromotePersistentLight_t *light)
+{
+	int i;
+	if (!light || light->physicalNativeDlightOrdinal < 0)
+		return NULL;
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		const staticPromotePLRMarker_t *m = &s_staticPromotePLRMarkers[i];
+		if (m->kind == PLR_V01_MARKER_DLIGHT && m->entityOrdinal == light->physicalNativeDlightOrdinal)
+			return m;
+	}
+	return NULL;
+}
+
+static int R_StaticPromoteUSLRDFindNativeRuntimeDlight(const staticPromotePersistentLight_t *light)
+{
+	const staticPromotePLRMarker_t *marker = R_StaticPromoteUSLRDNativeMarker(light);
+	int pass, j;
+	if (!marker)
+		return -1;
+	for (pass = 0; pass < 2; ++pass)
+	{
+		for (j = r_firstSceneDlight; j < r_numdlights && j < MAX_DLIGHTS; ++j)
+		{
+			dlight_t *dl = &backEndData->dlights[j];
+			vec3_t delta;
+			float colorDelta;
+			if (pass == 0 && !dl->nativeAuthoredDlight)
+				continue;
+			if (pass == 1 && dl->nativeAuthoredDlight)
+				continue;
+			VectorSubtract(dl->origin, marker->origin, delta);
+			if (DotProduct(delta, delta) > (PLR_V01_NATIVE_DUP_MAX_DIST * PLR_V01_NATIVE_DUP_MAX_DIST))
+				continue;
+			colorDelta = R_StaticPromotePLRColorDelta(dl->color, marker->color);
+			if (colorDelta > PLR_V01_NATIVE_COLOR_DELTA)
+				continue;
+			return j - r_firstSceneDlight;
+		}
+	}
+	return -1;
+}
+
+static qboolean R_StaticPromoteUSLRDInfluenceVisible(const refdef_t *fd, const byte *vis,
+	staticPromotePersistentLight_t *light, qboolean *pvsBitSeenOut, qboolean *areaRejectedOut)
+{
+	int i;
+	qboolean pvsBitSeen = qfalse;
+	qboolean areaRejected = qfalse;
+	if (!fd || !light)
+		return qfalse;
+	for (i = 0; i < light->unifiedInfluenceCount; ++i)
+	{
+		int cluster = light->unifiedInfluenceCluster[i];
+		int area = light->unifiedInfluenceArea[i];
+		qboolean clusterVisible = qtrue;
+		if (cluster < 0 || !tr.world || cluster >= tr.world->numClusters)
+			continue;
+		if (vis)
+			clusterVisible = (vis[cluster >> 3] & (1 << (cluster & 7))) ? qtrue : qfalse;
+		if (!clusterVisible)
+			continue;
+		pvsBitSeen = qtrue;
+		if (area >= 0 && area < MAX_MAP_AREA_BYTES * 8 &&
+			(fd->areamask[area >> 3] & (1 << (area & 7))))
+		{
+			areaRejected = qtrue;
+			continue;
+		}
+		if (pvsBitSeenOut) *pvsBitSeenOut = pvsBitSeen;
+		if (areaRejectedOut) *areaRejectedOut = areaRejected;
+		return qtrue;
+	}
+	if (pvsBitSeenOut) *pvsBitSeenOut = pvsBitSeen;
+	if (areaRejectedOut) *areaRejectedOut = areaRejected;
+	return qfalse;
+}
+
+static int R_StaticPromoteUSLRDPriority(const staticPromotePersistentLight_t *light)
+{
+	int userOverride;
+	if (!light)
+		return 99;
+	userOverride = R_StaticPromoteUserOverrideState(tr.world ? tr.world->baseName : "", light->candidate.entityOrdinal);
+	if (userOverride > 0)
+		return 0;
+	// Unlike legacy overflow priority, a physical fixture stays physical even when its authored route is NATIVE.
+	if (R_StaticPromotePLREnabled() && light->physicalRecognitionAccepted)
+		return 1;
+	if (light->synthetic) return 2;
+	if (light->approvedFallback) return 3;
+	if (light->rawMembers >= 3) return 4;
+	if (light->rawMembers >= 2) return 5;
+	return 6;
+}
+
+static qboolean R_StaticPromoteUSLRDAllowed(const staticPromotePersistentLight_t *light, int autoMapLights, int *classReasonOut)
+{
+	int classReason = STATIC_PROMOTE_CLASS_ACCEPT;
+	qboolean allowed;
+	if (!light)
+		return qfalse;
+	if (!autoMapLights)
+	{
+		int userOverride = R_StaticPromoteUserOverrideState(tr.world ? tr.world->baseName : "", light->candidate.entityOrdinal);
+		allowed = userOverride < 0 ? qfalse : (userOverride > 0 || light->approvedFallback);
+		classReason = allowed ? STATIC_PROMOTE_CLASS_ACCEPT : STATIC_PROMOTE_CLASS_USER_BLOCKED;
+	}
+	else
+	{
+		classReason = R_StaticPromoteClassifyFixture(light);
+		allowed = (classReason == STATIC_PROMOTE_CLASS_ACCEPT) ? qtrue : qfalse;
+		// Native authored association is a route preference, not a permanent suppression in USLRD.
+		if (!allowed && classReason == STATIC_PROMOTE_CLASS_NATIVE_SOURCE && light->physicalRecognitionAccepted)
+			allowed = qtrue;
+	}
+	if (classReasonOut) *classReasonOut = classReason;
+	return allowed;
+}
+
+// DARKWOLF_USLRD_ALWAYS_ON_DIRECT_SHADOW_CAPTURE_FIX_V1
+// Direct delivery is no longer a visibility/PVS resource.  Every classifier-accepted fixture
+// is kept as a Direct DLight while true front-end MAX_DLIGHTS headroom exists.  Visibility
+// tiers remain telemetry/relevance inputs for the scarce shadow selector only.
+static const qboolean s_uslrdProductionAllAcceptedDelivery = qtrue; // DARKWOLF_USLRD_CLEAN_PRODUCTION_V1: fixed accepted policy.
+
+static int R_StaticPromoteSelectPersistentInfluenceUnified(const refdef_t *fd,
+	staticPromotePersistentLight_t **selected, int requestedMaxLights,
+	int *viewClusterOut, int *visibleCountOut, int *heldCountOut, int *overflowCountOut,
+	int *classifierAcceptedOut, int *classifierRejectedOut)
+{
+	mnode_t *viewLeaf;
+	const byte *vis = NULL;
+	int viewCluster, now, holdMs, autoMapLights, pvsEnabled;
+	qboolean allAcceptedDelivery;
+	int selectedCount = 0, classifierAccepted = 0, classifierRejected = 0;
+	int visibleCount = 0, heldCount = 0, eligiblePromoted = 0;
+	int i, tier, priority, retainedPass;
+	byte selectedFlags[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+
+	if (!fd || !selected)
+		return 0;
+	requestedMaxLights = CLAMP(requestedMaxLights, 1, STATIC_PROMOTE_PRODUCTION_MAX_ACTIVE);
+	now = ri.Milliseconds();
+	holdMs = r_staticPromotePVSHoldMs ? r_staticPromotePVSHoldMs->integer : 8000;
+	holdMs = CLAMP(holdMs, 0, 30000);
+	autoMapLights = r_staticPromoteAutoMapLights ? r_staticPromoteAutoMapLights->integer : 1;
+	pvsEnabled = r_staticPromotePVS ? r_staticPromotePVS->integer : 1;
+	allAcceptedDelivery = s_uslrdProductionAllAcceptedDelivery;
+	viewLeaf = R_StaticPromotePointInLeafSafe(fd->vieworg);
+	viewCluster = viewLeaf ? viewLeaf->cluster : -1;
+	if (pvsEnabled && tr.world && tr.world->vis && viewCluster >= 0 && viewCluster < tr.world->numClusters)
+		vis = tr.world->vis + viewCluster * tr.world->clusterBytes;
+
+	// True front-end array headroom. Using only scene-local count can still over-select after another view used dlight slots.
+	s_uslrdSceneNativeCount = MAX(0, r_numdlights - r_firstSceneDlight);
+	s_uslrdGlobalDlightsUsed = r_numdlights;
+	s_uslrdHeadroom = MAX(0, MAX_DLIGHTS - r_numdlights);
+	s_uslrdStaticBudget = MIN(requestedMaxLights, s_uslrdHeadroom);
+	s_uslrdBudgetEvictions = 0;
+	s_uslrdSubmittedPromoted = 0;
+	Com_Memset(selectedFlags, 0, sizeof(selectedFlags));
+	s_staticPromoteVisibleSurfaceProbeCount = 0;
+	Com_Memset(s_staticPromoteVisibleSurfaceSignalNow, 0, sizeof(s_staticPromoteVisibleSurfaceSignalNow));
+	Com_Memset(s_staticPromoteVisibleSurfaceResidencyNow, 0, sizeof(s_staticPromoteVisibleSurfaceResidencyNow));
+	Com_Memset(s_staticPromotePhysicalResidencyFallbackNow, 0, sizeof(s_staticPromotePhysicalResidencyFallbackNow));
+	Com_Memset(s_staticPromotePhysicalResidencyCoronaPresent, 0, sizeof(s_staticPromotePhysicalResidencyCoronaPresent));
+	Com_Memset(s_staticPromotePhysicalResidencyCoronaFlags, 0, sizeof(s_staticPromotePhysicalResidencyCoronaFlags));
+
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		qboolean allowed, surfaceVisible, sphereVisible, physicalVisible, coronaPresent = qfalse;
+		qboolean pvsBitSeen = qfalse, areaRejected = qfalse;
+		int coronaFlags = 0, classReason = STATIC_PROMOTE_CLASS_ACCEPT, nativeIndex = -1;
+		light->unifiedWasResident = light->unifiedResident;
+		light->unifiedResident = qfalse;
+		light->unifiedSurfaceSignal = qfalse;
+		light->unifiedSpherePvsConnected = qfalse;
+		light->unifiedSpherePvsBitSeen = qfalse;
+		light->unifiedAreaPortalRejected = qfalse;
+		light->unifiedPhysicalFallback = qfalse;
+		light->unifiedHeld = qfalse;
+		light->unifiedNativeRuntimePresent = qfalse;
+		light->unifiedBudgetEvicted = qfalse;
+		light->unifiedNativeSceneIndex = -1;
+		light->unifiedSelectedSlot = -1;
+		light->unifiedActualDlightIndex = -1;
+		light->unifiedRoute = USLRD_ROUTE_NONE;
+		light->unifiedClassAccepted = qfalse;
+		light->unifiedVisibilityTier = DWSP_TIER_LATENT;
+		// Live radius cvars remain supported: rebuild the precomputed sphere only when its real radius changed.
+		if (fabs(light->unifiedRuntimeRadius - R_StaticPromoteUSLRDRuntimeRadius(&light->candidate)) > 0.01f)
+			R_StaticPromoteBuildUnifiedInfluenceMetadata(light);
+		allowed = R_StaticPromoteUSLRDAllowed(light, autoMapLights, &classReason);
+		if (!allowed)
+		{
+			classifierRejected++;
+			continue;
+		}
+		classifierAccepted++;
+		light->unifiedClassAccepted = qtrue;
+		surfaceVisible = R_StaticPromoteVisibleSurfaceSignalForFixture(i, light);
+		s_staticPromoteVisibleSurfaceSignalNow[i] = surfaceVisible;
+		light->unifiedSurfaceSignal = surfaceVisible;
+		if (!pvsEnabled)
+			sphereVisible = qtrue;
+		else
+			sphereVisible = R_StaticPromoteUSLRDInfluenceVisible(fd, vis, light, &pvsBitSeen, &areaRejected);
+		light->unifiedSpherePvsConnected = sphereVisible;
+		light->unifiedSpherePvsBitSeen = pvsBitSeen;
+		light->unifiedAreaPortalRejected = areaRejected;
+		physicalVisible = R_StaticPromotePhysicalCoronaVisible(light, &coronaPresent, &coronaFlags);
+		light->unifiedPhysicalFallback = physicalVisible;
+		s_staticPromotePhysicalResidencyFallbackNow[i] = physicalVisible;
+		s_staticPromotePhysicalResidencyCoronaPresent[i] = coronaPresent;
+		s_staticPromotePhysicalResidencyCoronaFlags[i] = coronaFlags;
+
+		if (surfaceVisible)
+			light->unifiedVisibilityTier = DWSP_TIER_SURFACE_VISIBLE;
+		else if (sphereVisible)
+			light->unifiedVisibilityTier = DWSP_TIER_SPHERE_PVS_CONNECTED;
+		else if (physicalVisible)
+			light->unifiedVisibilityTier = DWSP_TIER_PHYSICAL_FIXTURE_FALLBACK;
+		else if (light->unifiedLastVisibleMs >= 0 && now - light->unifiedLastVisibleMs <= holdMs)
+		{
+			light->unifiedVisibilityTier = DWSP_TIER_GRACE_HELD;
+			light->unifiedHeld = qtrue;
+		}
+		if (light->unifiedVisibilityTier <= DWSP_TIER_PHYSICAL_FIXTURE_FALLBACK)
+			light->unifiedLastVisibleMs = now;
+		if (light->unifiedVisibilityTier < DWSP_TIER_LATENT)
+			R_StaticPromoteVisibleSurfaceAddProbe(i, light);
+		if (light->unifiedVisibilityTier <= DWSP_TIER_SPHERE_PVS_CONNECTED)
+			visibleCount++;
+		if (light->unifiedHeld)
+			heldCount++;
+
+		if (light->physicalNativeDlightOrdinal >= 0 || light->nativeDuplicateSuppressed)
+			nativeIndex = R_StaticPromoteUSLRDFindNativeRuntimeDlight(light);
+		if (nativeIndex >= 0)
+		{
+			int globalIndex = r_firstSceneDlight + nativeIndex;
+			dlight_t *dl = &backEndData->dlights[globalIndex];
+			light->unifiedNativeRuntimePresent = qtrue;
+			light->unifiedNativeSceneIndex = nativeIndex;
+			light->unifiedActualDlightIndex = nativeIndex;
+			light->unifiedRoute = USLRD_ROUTE_NATIVE;
+			dl->staticPromoteFixtureId = light->candidate.entityOrdinal;
+			dl->staticPromoteVisibilityTier = light->unifiedVisibilityTier;
+			if (allAcceptedDelivery || light->unifiedVisibilityTier < DWSP_TIER_LATENT)
+				light->unifiedResident = qtrue;
+		}
+		else if (allAcceptedDelivery || light->unifiedVisibilityTier < DWSP_TIER_LATENT)
+		{
+			eligiblePromoted++;
+		}
+	}
+
+	// DARKWOLF_USLRD_ALWAYS_ON_DIRECT_SHADOW_CAPTURE_FIX_V1
+	// If all-accepted delivery fits the actual front-end headroom, PVS/tier never turns a lamp off.
+	// When the accepted set exceeds headroom, deterministic priority + previous ownership decides
+	// which fixtures remain delivered; visibility still does not alter base Direct energy.
+	if (allAcceptedDelivery)
+	{
+		for (priority = 0; priority <= 6 && selectedCount < s_uslrdStaticBudget; ++priority)
+		{
+			for (retainedPass = 0; retainedPass < 2 && selectedCount < s_uslrdStaticBudget; ++retainedPass)
+			{
+				for (i = 0; i < s_staticPromotePersistentCount && selectedCount < s_uslrdStaticBudget; ++i)
+				{
+					staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+					if (selectedFlags[i] || !light->unifiedClassAccepted || light->unifiedNativeRuntimePresent)
+						continue;
+					if (R_StaticPromoteUSLRDPriority(light) != priority)
+						continue;
+					if ((retainedPass == 0) != (light->unifiedWasResident ? 1 : 0))
+						continue;
+					selected[selectedCount] = light;
+					selectedFlags[i] = 1;
+					light->unifiedResident = qtrue;
+					light->unifiedRoute = USLRD_ROUTE_PROMOTED;
+					light->unifiedSelectedSlot = selectedCount;
+					selectedCount++;
+				}
+			}
+		}
+	}
+	else
+	{
+		// Parent A/B path: current physical relevance is the outer criterion.
+		for (tier = DWSP_TIER_SURFACE_VISIBLE; tier <= DWSP_TIER_GRACE_HELD && selectedCount < s_uslrdStaticBudget; ++tier)
+		{
+			for (priority = 0; priority <= 6 && selectedCount < s_uslrdStaticBudget; ++priority)
+			{
+				for (retainedPass = 0; retainedPass < 2 && selectedCount < s_uslrdStaticBudget; ++retainedPass)
+				{
+					for (i = 0; i < s_staticPromotePersistentCount && selectedCount < s_uslrdStaticBudget; ++i)
+					{
+						staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+						if (selectedFlags[i] || light->unifiedVisibilityTier != tier || light->unifiedNativeRuntimePresent)
+							continue;
+						if (R_StaticPromoteUSLRDPriority(light) != priority)
+							continue;
+						if ((retainedPass == 0) != (light->unifiedWasResident ? 1 : 0))
+							continue;
+						selected[selectedCount] = light;
+						selectedFlags[i] = 1;
+						light->unifiedResident = qtrue;
+						light->unifiedRoute = USLRD_ROUTE_PROMOTED;
+						light->unifiedSelectedSlot = selectedCount;
+						selectedCount++;
+					}
+				}
+			}
+		}
+	}
+
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		if ((allAcceptedDelivery ? light->unifiedClassAccepted : (light->unifiedVisibilityTier < DWSP_TIER_LATENT)) && !light->unifiedNativeRuntimePresent && !selectedFlags[i])
+		{
+			light->unifiedBudgetEvicted = qtrue;
+			s_uslrdBudgetEvictions++;
+		}
+	}
+	if (viewClusterOut) *viewClusterOut = viewCluster;
+	if (visibleCountOut) *visibleCountOut = visibleCount;
+	if (heldCountOut) *heldCountOut = heldCount;
+	if (overflowCountOut) *overflowCountOut = s_uslrdBudgetEvictions;
+	if (classifierAcceptedOut) *classifierAcceptedOut = classifierAccepted;
+	if (classifierRejectedOut) *classifierRejectedOut = classifierRejected;
+	return selectedCount;
+}
+
+static int R_StaticPromoteSelectPersistentInfluence(const refdef_t *fd,
+	staticPromotePersistentLight_t **selected, int maxLights,
+	int *viewClusterOut, int *visibleCountOut, int *heldCountOut, int *overflowCountOut,
+	int *classifierAcceptedOut, int *classifierRejectedOut)
+{
+	if (!r_staticPromoteUnifiedResidency || !r_staticPromoteUnifiedResidency->integer)
+		return R_StaticPromoteSelectPersistentInfluenceLegacy(fd, selected, maxLights,
+			viewClusterOut, visibleCountOut, heldCountOut, overflowCountOut,
+			classifierAcceptedOut, classifierRejectedOut);
+	return R_StaticPromoteSelectPersistentInfluenceUnified(fd, selected, maxLights,
+		viewClusterOut, visibleCountOut, heldCountOut, overflowCountOut,
+		classifierAcceptedOut, classifierRejectedOut);
+}
+
+static void R_StaticPromoteUSLRDTagPromotedDlight(staticPromotePersistentLight_t *light)
+{
+	int globalIndex;
+	dlight_t *dl;
+	if (!light || !r_staticPromoteUnifiedResidency || !r_staticPromoteUnifiedResidency->integer)
+		return;
+	globalIndex = r_numdlights - 1;
+	if (globalIndex < r_firstSceneDlight || globalIndex < 0 || globalIndex >= MAX_DLIGHTS)
+	{
+		light->unifiedResident = qfalse;
+		light->unifiedRoute = USLRD_ROUTE_NONE;
+		return;
+	}
+	dl = &backEndData->dlights[globalIndex];
+	dl->staticPromoteFixtureId = light->candidate.entityOrdinal;
+	dl->staticPromoteVisibilityTier = light->unifiedVisibilityTier;
+	light->unifiedActualDlightIndex = globalIndex - r_firstSceneDlight;
+	s_uslrdSubmittedPromoted++;
+}
+
+static void R_StaticPromoteUSLRDDiagFrame(void)
+{
+	int i, accepted = 0, t0 = 0, t1 = 0, t2 = 0, held = 0, latent = 0, native = 0, promoted = 0;
+	unsigned int sig = 2166136261u;
+	int now;
+	if (!r_staticPromoteUnifiedResidency || !r_staticPromoteUnifiedResidency->integer ||
+		!r_staticPromoteUnifiedDiag || !r_staticPromoteUnifiedDiag->integer)
+		return;
+	now = ri.Milliseconds();
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		if (light->unifiedClassAccepted) accepted++;
+		if (light->unifiedVisibilityTier == DWSP_TIER_SURFACE_VISIBLE) t0++;
+		else if (light->unifiedVisibilityTier == DWSP_TIER_SPHERE_PVS_CONNECTED) t1++;
+		else if (light->unifiedVisibilityTier == DWSP_TIER_PHYSICAL_FIXTURE_FALLBACK) t2++;
+		else if (light->unifiedVisibilityTier == DWSP_TIER_GRACE_HELD) held++;
+		else latent++;
+		if (light->unifiedRoute == USLRD_ROUTE_NATIVE) native++;
+		else if (light->unifiedRoute == USLRD_ROUTE_PROMOTED) promoted++;
+		if (!light->unifiedDiagValid || light->unifiedDiagTier != light->unifiedVisibilityTier ||
+			light->unifiedDiagRoute != light->unifiedRoute || light->unifiedDiagResident != (light->unifiedResident ? 1 : 0) ||
+			light->unifiedDiagBudgetEvicted != (light->unifiedBudgetEvicted ? 1 : 0))
+		{
+			const char *decision = "OK";
+			if (!light->unifiedClassAccepted)
+				decision = "CLASS_REJECTED";
+			else if (light->unifiedVisibilityTier == DWSP_TIER_LATENT)
+				decision = light->unifiedSpherePvsBitSeen && light->unifiedAreaPortalRejected ? "AREA_PORTAL_DISCONNECTED" : "FULL_SPHERE_NO_PVS";
+			else if (light->unifiedBudgetEvicted)
+				decision = "BUDGET_EVICTED";
+			else if (light->nativeDuplicateSuppressed && !light->unifiedNativeRuntimePresent && light->unifiedRoute != USLRD_ROUTE_PROMOTED)
+				decision = "NATIVE_EXPECTED_RUNTIME_MISSING";
+			ri.Printf(PRINT_ALL,
+				"USLRD_TRANSITION map=%s fixture=%d priority=%d radius=%.1f spherePairs=%d sphereOverflow=%d tier=%s surface=%d spherePvs=%d pvsBit=%d areaRejected=%d physicalFallback=%d held=%d nativeRuntime=%d route=%s resident=%d selectedSlot=%d dlightIndex=%d sceneNative=%d globalUsed=%d headroom=%d staticBudget=%d budgetEvicted=%d decision=%s\n",
+				tr.world ? tr.world->baseName : "<none>", light->candidate.entityOrdinal,
+				R_StaticPromoteUSLRDPriority(light), light->unifiedRuntimeRadius,
+				light->unifiedInfluenceCount, light->unifiedInfluenceOverflow,
+				R_StaticPromoteUSLRDTierName(light->unifiedVisibilityTier), light->unifiedSurfaceSignal ? 1 : 0,
+				light->unifiedSpherePvsConnected ? 1 : 0, light->unifiedSpherePvsBitSeen ? 1 : 0,
+				light->unifiedAreaPortalRejected ? 1 : 0, light->unifiedPhysicalFallback ? 1 : 0,
+				light->unifiedHeld ? 1 : 0, light->unifiedNativeRuntimePresent ? 1 : 0,
+				R_StaticPromoteUSLRDRouteName(light->unifiedRoute), light->unifiedResident ? 1 : 0,
+				light->unifiedSelectedSlot, light->unifiedActualDlightIndex,
+				s_uslrdSceneNativeCount, s_uslrdGlobalDlightsUsed, s_uslrdHeadroom, s_uslrdStaticBudget,
+				light->unifiedBudgetEvicted ? 1 : 0, decision);
+			light->unifiedDiagValid = qtrue;
+			light->unifiedDiagTier = light->unifiedVisibilityTier;
+			light->unifiedDiagRoute = light->unifiedRoute;
+			light->unifiedDiagResident = light->unifiedResident ? 1 : 0;
+			light->unifiedDiagBudgetEvicted = light->unifiedBudgetEvicted ? 1 : 0;
+		}
+		sig = (sig ^ (unsigned int)(light->unifiedVisibilityTier + 7 * light->unifiedRoute + 13 * (light->unifiedResident ? 1 : 0))) * 16777619u;
+	}
+	sig ^= (unsigned int)(s_uslrdHeadroom * 31 + s_uslrdStaticBudget * 131 + s_uslrdBudgetEvictions * 521);
+	if (sig != s_uslrdLastSummarySig || s_uslrdLastSummaryMs == 0 || now - s_uslrdLastSummaryMs >= 1000)
+	{
+		s_uslrdLastSummarySig = sig;
+		s_uslrdLastSummaryMs = now;
+		ri.Printf(PRINT_ALL,
+			"USLRD_SUMMARY map=%s acceptedFixtures=%d tier0=%d tier1=%d tier2=%d held=%d latent=%d nativeRoutes=%d promotedRoutes=%d sceneNative=%d globalUsed=%d headroom=%d staticBudget=%d submittedPromoted=%d budgetEvictions=%d\n",
+			tr.world ? tr.world->baseName : "<none>", accepted,
+			t0, t1, t2, held, latent, native, promoted, s_uslrdSceneNativeCount, s_uslrdGlobalDlightsUsed,
+			s_uslrdHeadroom, s_uslrdStaticBudget, s_uslrdSubmittedPromoted, s_uslrdBudgetEvictions);
+	}
+}
