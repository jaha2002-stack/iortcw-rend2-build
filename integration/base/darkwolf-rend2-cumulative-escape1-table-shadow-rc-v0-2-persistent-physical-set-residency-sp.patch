+static int R_DlightMaterialFindWorldSurface(surfaceType_t *surface)
+{
+	int surfaceIndex;
+	if (!tr.world || !surface)
+		return -1;
+	for (surfaceIndex = 0; surfaceIndex < tr.world->numsurfaces; surfaceIndex++)
+	{
+		if (tr.world->surfaces[surfaceIndex].data == surface)
+			return surfaceIndex;
+	}
+	return -1;
+}
+
+static void R_DlightMaterialInsertHit(dlightMaterialRayHit_t *hits, int *hitCount,
+	const dlightMaterialRayHit_t *candidate)
+{
+	int i;
+	for (i = 0; i < *hitCount; i++)
+	{
+		if (hits[i].draw->surface == candidate->draw->surface && hits[i].entityNum == candidate->entityNum)
+		{
+			if (candidate->distanceSquared < hits[i].distanceSquared)
+				hits[i] = *candidate;
+			return;
+		}
+	}
+	if (*hitCount < DLIGHT_MATERIAL_MAX_RAY_HITS)
+	{
+		hits[*hitCount] = *candidate;
+		(*hitCount)++;
+	}
+	else
+	{
+		int farthest = 0;
+		for (i = 1; i < *hitCount; i++)
+			if (hits[i].distanceSquared > hits[farthest].distanceSquared)
+				farthest = i;
+		if (candidate->distanceSquared < hits[farthest].distanceSquared)
+			hits[farthest] = *candidate;
+	}
+}
+
+static void R_DlightMaterialSortHits(dlightMaterialRayHit_t *hits, int hitCount)
+{
+	int i, j;
+	for (i = 0; i < hitCount; i++)
+	{
+		for (j = i + 1; j < hitCount; j++)
+		{
+			if (hits[j].distanceSquared < hits[i].distanceSquared)
+			{
+				dlightMaterialRayHit_t temp = hits[i];
+				hits[i] = hits[j];
+				hits[j] = temp;
+			}
+		}
+	}
+}
+
+static void R_DlightMaterialAddBspHits(drawSurf_t *draw, shader_t *shader, int entityNum,
+	dlightMaterialRayHit_t *hits, int *hitCount)
+{
+	srfBspSurface_t *bsp = (srfBspSurface_t *)draw->surface;
+	vec3_t localOrigin, localDir;
+	int indexOffset;
+	if (!R_DlightMaterialLocalRay(entityNum, localOrigin, localDir))
+		return;
+	if (!bsp->verts || !bsp->indexes || bsp->numIndexes < 3 || bsp->numVerts < 3)
+		return;
+	for (indexOffset = 0; indexOffset + 2 < bsp->numIndexes; indexOffset += 3)
+	{
+		int i0 = (int)bsp->indexes[indexOffset + 0];
+		int i1 = (int)bsp->indexes[indexOffset + 1];
+		int i2 = (int)bsp->indexes[indexOffset + 2];
+		float t;
+		vec3_t localHit, worldHit, worldDelta;
+		dlightMaterialRayHit_t candidate;
+		if (i0 < 0 || i0 >= bsp->numVerts || i1 < 0 || i1 >= bsp->numVerts || i2 < 0 || i2 >= bsp->numVerts)
+			continue;
+		if (!R_DlightMaterialRayTriangle(localOrigin, localDir,
+			bsp->verts[i0].xyz, bsp->verts[i1].xyz, bsp->verts[i2].xyz, &t))
+			continue;
+		memset(&candidate, 0, sizeof(candidate));
+		VectorMA(localOrigin, t, localDir, localHit);
+		R_DlightMaterialLocalToWorld(entityNum, localHit, worldHit);
+		VectorSubtract(worldHit, tr.viewParms.or.origin, worldDelta);
+		candidate.distanceSquared = DotProduct(worldDelta, worldDelta);
+		candidate.draw = draw;
+		candidate.shader = shader;
+		candidate.entityNum = entityNum;
+		candidate.triangle = indexOffset / 3;
+		candidate.surfaceIndex = R_DlightMaterialFindWorldSurface(draw->surface);
+		candidate.geometryKind = entityNum == REFENTITYNUM_WORLD ? "WORLD" : "BMODEL";
+		candidate.modelType = -1;
+		candidate.modelName = "<bsp>";
+		candidate.accepted = R_DlightMaterialShadowCapable(shader, &candidate.reason,
+			&candidate.hasAlpha, &candidate.hasBlend, &candidate.hasDepthWrite) ? 1 : 0;
+		if (candidate.accepted && candidate.surfaceIndex < 0)
+		{
+			candidate.accepted = 0;
+			candidate.reason = "bsp_surface_untracked";
+		}
+		R_DlightMaterialInsertHit(hits, hitCount, &candidate);
+	}
+}
+
+static qboolean R_DlightMaterialAddMdvHits(drawSurf_t *draw, shader_t *shader, int entityNum,
+	dlightMaterialRayHit_t *hits, int *hitCount)
+{
+	trRefEntity_t *ent;
+	mdvModel_t *mdvModel;
+	mdvSurface_t *surface;
+	model_t *handleModel;
+	vec3_t localOrigin, localDir;
+	int indexOffset;
+	float backlerp;
+	if (!R_DlightMaterialResolveMdv(draw, entityNum, &mdvModel, &surface, &handleModel))
+		return qfalse;
+	if (!R_DlightMaterialLocalRay(entityNum, localOrigin, localDir))
+		return qfalse;
+	ent = &tr.refdef.entities[entityNum];
+	backlerp = ent->e.backlerp;
+	if (backlerp < 0.0f) backlerp = 0.0f;
+	if (backlerp > 1.0f) backlerp = 1.0f;
+	for (indexOffset = 0; indexOffset + 2 < surface->numIndexes; indexOffset += 3)
+	{
+		int i0 = (int)surface->indexes[indexOffset + 0];
+		int i1 = (int)surface->indexes[indexOffset + 1];
+		int i2 = (int)surface->indexes[indexOffset + 2];
+		vec3_t v0, v1, v2;
+		float t;
+		vec3_t localHit, worldHit, worldDelta;
+		dlightMaterialRayHit_t candidate;
+		if (!R_DlightMaterialMdvVertex(surface, ent->e.frame, ent->e.oldframe, backlerp, i0, v0)
+			|| !R_DlightMaterialMdvVertex(surface, ent->e.frame, ent->e.oldframe, backlerp, i1, v1)
+			|| !R_DlightMaterialMdvVertex(surface, ent->e.frame, ent->e.oldframe, backlerp, i2, v2))
+			continue;
+		if (!R_DlightMaterialRayTriangle(localOrigin, localDir, v0, v1, v2, &t))
+			continue;
+		memset(&candidate, 0, sizeof(candidate));
+		VectorMA(localOrigin, t, localDir, localHit);
+		R_DlightMaterialLocalToWorld(entityNum, localHit, worldHit);
+		VectorSubtract(worldHit, tr.viewParms.or.origin, worldDelta);
+		candidate.distanceSquared = DotProduct(worldDelta, worldDelta);
+		candidate.draw = draw;
+		candidate.shader = shader;
+		candidate.entityNum = entityNum;
+		candidate.triangle = indexOffset / 3;
+		candidate.surfaceIndex = DLIGHT_MATERIAL_MODEL_SURFACE_SENTINEL;
+		candidate.geometryKind = "MDV_MODEL";
+		candidate.modelType = handleModel ? (int)handleModel->type : -1;
+		candidate.modelName = (handleModel && handleModel->name[0]) ? handleModel->name : "<unnamed-model>";
+		candidate.accepted = R_DlightMaterialShadowCapable(shader, &candidate.reason,
+			&candidate.hasAlpha, &candidate.hasBlend, &candidate.hasDepthWrite) ? 1 : 0;
+		if (candidate.accepted)
+			candidate.reason = "model_shadow_candidate";
+		R_DlightMaterialInsertHit(hits, hitCount, &candidate);
+	}
+	return qtrue;
+}
