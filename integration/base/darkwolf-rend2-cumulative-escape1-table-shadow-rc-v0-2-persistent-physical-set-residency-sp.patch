+static void R_StaticPromoteSyntheticClampColor(vec3_t color)
+{
+	int i;
+	float maxc = 0.0f;
+	for (i = 0; i < 3; ++i)
+	{
+		if (color[i] < 0.0f) color[i] = 0.0f;
+		if (color[i] > 1.0f) color[i] = 1.0f;
+		if (color[i] > maxc) maxc = color[i];
+	}
+	if (maxc <= 0.001f)
+		VectorSet(color, 1.0f, 0.90f, 0.80f);
+}
