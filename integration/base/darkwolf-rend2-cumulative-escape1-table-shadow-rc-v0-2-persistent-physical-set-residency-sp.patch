+static void CG_DarkWolfPCRBV05Diagnostic( centity_t *cent ) {
+	static int s_lastSampleTime[4];
+	static int s_sampleSeq[4];
+	static vec3_t s_hitPoint[4][PCRB_V05_PVS_POINT_COUNT];
+	static qboolean s_hitValid[4][PCRB_V05_PVS_POINT_COUNT];
+	static qboolean s_startupPrinted = qfalse;
+	pcrbV04FixtureState_t state;
+	vec3_t points[PCRB_V05_PVS_POINT_COUNT];
+	vec3_t bodyMid;
+	trace_t trc;
+	const char *role;
+	int runtimeId;
+	int slot;
+	int sample;
+	int clearCount = 0;
+	int blockedCount = 0;
+	int worldBlocks = 0;
+	int entityBlocks = 0;
+	int i;
+
+	if ( !cent || !CG_DarkWolfDiagCvarEnabled( "dw_pcrbV05Diag" ) ) return;
+	runtimeId = cent->currentState.number;
+	slot = CG_DarkWolfPCRBV05Slot( runtimeId );
+	if ( slot < 0 ) return;
+	role = CG_DarkWolfPCRBV03Role( runtimeId );
+	if ( !role || !CG_DarkWolfPCRBV04ReadFixtureState( runtimeId, &state ) ) return;
+
+	// DARKWOLF_PCRB_E2E_V0_7_VISIBLE_SURFACE_INFLUENCE_AUDIT
+	// Marker-only mode deliberately shows only the two problem runtime coronas.
+	// It does not touch the residency metadata submitted earlier in CG_Corona().
+	if ( CG_DarkWolfDiagCvarEnabled( "dw_pcrbE2E07MarkerOnly" ) &&
+		runtimeId != 352 && runtimeId != 628 ) return;
+
+	CG_DarkWolfPCRBV05BuildInfluencePoints( state.lightCenter, points );
+	VectorAdd( state.coronaOrigin, state.lightCenter, bodyMid );
+	VectorScale( bodyMid, 0.5f, bodyMid );
+
+	if ( CG_DarkWolfDiagCvarEnabled( "dw_pcrbV05Markers" ) ) {
+		// legend: corona=yellow, renderer light center=green, fixture body midpoint=cyan,
+		// collision endpoints=red. These are sprites only and add no light energy.
+		CG_DarkWolfPCRBV05DrawMarker( state.coronaOrigin, 6.0f, 255, 220, 32, 220 );
+		CG_DarkWolfPCRBV05DrawMarker( state.lightCenter, 6.0f, 32, 255, 64, 220 );
+		CG_DarkWolfPCRBV05DrawMarker( bodyMid, 5.0f, 32, 220, 255, 220 );
+		for ( i = 0; i < PCRB_V05_PVS_POINT_COUNT; ++i ) {
+			if ( s_hitValid[slot][i] )
+				CG_DarkWolfPCRBV05DrawMarker( s_hitPoint[slot][i], 2.5f, 255, 48, 48, 210 );
+		}
+	}
+
+	// DARKWOLF_PCRB_E2E_V0_7_VISIBLE_SURFACE_INFLUENCE_AUDIT
+	// Keep the marker sprites, but suppress the old high-volume 27-point CG trace.
+	if ( CG_DarkWolfDiagCvarEnabled( "dw_pcrbE2E07MarkerOnly" ) ) return;
+
+	if ( !s_startupPrinted ) {
+		s_startupPrinted = qtrue;
+		CG_Printf( "SPR_PVS05_CG_STARTUP enabled=1 pointCount=27 exactProductionInfluenceGeometry=1 cmTraceTagging=1 markers=1 functionalDecisionChanged=0\n" );
+		CG_Printf( "SPR_PVS05_MARKER_LEGEND corona=YELLOW lightCenter=GREEN bodyMid=CYAN collision=RED lightingContribution=0\n" );
