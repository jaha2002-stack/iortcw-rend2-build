+
+    s_dwCoplanarContainedRegistry.world = tr.world;
+    s_dwCoplanarContainedRegistry.surfaces = tr.world->surfaces;
+    s_dwCoplanarContainedRegistry.numWorldSurfaces = n;
+    for (i = 0; i < n; ++i)
+    {
+        s_dwCoplanarContainedRegistry.canonicalForSurface[i] = -1;
+        next[i] = -1;
+    }
+    for (bucket = 0; bucket < DW_CCDF_HASH_SIZE; ++bucket)
+        heads[bucket] = -1;
+
+    for (i = 0; i < n; ++i)
+    {
+        msurface_t *ms = &tr.world->surfaces[i];
+        if (!R_DW_CCDFValidFace(ms))
+            continue;
+        bucket = (int)R_DW_CCDFShaderBucket(ms->shader);
+        next[i] = heads[bucket];
+        heads[bucket] = i;
+    }
+
+    for (i = 0; i < n; ++i)
+    {
+        msurface_t *a = &tr.world->surfaces[i];
+        int j;
+        if (!R_DW_CCDFValidFace(a))
+            continue;
+
+        for (j = next[i]; j >= 0; j = next[j])
+        {
+            msurface_t *b = &tr.world->surfaces[j];
+            msurface_t *smallMs;
+            msurface_t *largeMs;
+            const srfBspSurface_t *large;
+            int smallIndex, largeIndex;
+            int previousCanonical;
+            float largeArea, previousArea;
+
+            if (a->shader != b->shader)
+                continue;
+
+            if (((const srfBspSurface_t *)a->data)->numVerts == ((const srfBspSurface_t *)b->data)->numVerts)
+                continue;
+
+            if (((const srfBspSurface_t *)a->data)->numVerts < ((const srfBspSurface_t *)b->data)->numVerts)
+            {
+                smallMs = a; largeMs = b; smallIndex = i; largeIndex = j;
+            }
+            else
+            {
+                smallMs = b; largeMs = a; smallIndex = j; largeIndex = i;
+            }
+
+            if (!R_DW_CCDFQualifies(smallMs, largeMs))
+                continue;
+
+            large = (const srfBspSurface_t *)largeMs->data;
+            largeArea = R_DW_CCDFTotalArea(large);
+            previousCanonical = s_dwCoplanarContainedRegistry.canonicalForSurface[smallIndex];
+            previousArea = previousCanonical >= 0
+                ? R_DW_CCDFTotalArea((const srfBspSurface_t *)tr.world->surfaces[previousCanonical].data)
+                : -1.0f;
+
+            if (previousCanonical < 0 || largeArea > previousArea ||
+                (largeArea == previousArea && largeIndex < previousCanonical))
+            {
+                s_dwCoplanarContainedRegistry.canonicalForSurface[smallIndex] = largeIndex;
+            }
+        }
+    }
+
+    s_dwCoplanarContainedRegistry.built = qtrue;
+    ri.Free(heads);
+    ri.Free(next);
+}
