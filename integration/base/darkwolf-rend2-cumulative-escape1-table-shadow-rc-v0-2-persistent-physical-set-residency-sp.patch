+static void R_StaticPromoteWideInsertCandidate(int fixtureIndex, float score)
+{
+	int pos;
+	int i;
+	for (pos = 0; pos < s_staticPromoteWideCandidateCount; ++pos)
+	{
+		int other = s_staticPromoteWideCandidates[pos];
+		vec3_t delta;
+		float fwd, totalSq, latSq, cone, otherScore;
+		VectorSubtract(s_staticPromotePersistentLights[other].candidate.origin, s_staticPromoteLastViewOrg, delta);
+		fwd = DotProduct(delta, s_staticPromoteLastViewForward);
+		totalSq = DotProduct(delta, delta); latSq = totalSq - fwd * fwd; if (latSq < 0.0f) latSq = 0.0f;
+		cone = 192.0f + fwd * 0.45f; if (cone > 768.0f) cone = 768.0f;
+		otherScore = latSq / (cone * cone) + fwd * 0.000005f;
+		if (score < otherScore) break;
+	}
+	if (pos >= STATIC_PROMOTE_WIDE_MAX_CANDIDATES) return;
+	if (s_staticPromoteWideCandidateCount < STATIC_PROMOTE_WIDE_MAX_CANDIDATES) s_staticPromoteWideCandidateCount++;
+	for (i = s_staticPromoteWideCandidateCount - 1; i > pos; --i)
+		s_staticPromoteWideCandidates[i] = s_staticPromoteWideCandidates[i - 1];
+	s_staticPromoteWideCandidates[pos] = fixtureIndex;
+}
+
+void R_StaticPromoteWideInspect_f(void)
+{
+	int i;
+	if (!tr.world || !R_StaticPromoteBuildPersistentRegistry() || !s_staticPromoteLastViewValid)
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE WIDE: no loaded world/view\n");
+		return;
+	}
+	s_staticPromoteWideCandidateCount = 0;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		vec3_t delta;
+		float forwardDistance, totalSq, lateralSq, lateralDistance, coneRadius, score;
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		if (light->synthetic) continue;
+		VectorSubtract(light->candidate.origin, s_staticPromoteLastViewOrg, delta);
+		forwardDistance = DotProduct(delta, s_staticPromoteLastViewForward);
+		if (forwardDistance < 16.0f || forwardDistance > 8192.0f) continue;
+		totalSq = DotProduct(delta, delta);
+		lateralSq = totalSq - forwardDistance * forwardDistance; if (lateralSq < 0.0f) lateralSq = 0.0f;
+		lateralDistance = sqrt(lateralSq);
+		coneRadius = 192.0f + forwardDistance * 0.45f; if (coneRadius > 768.0f) coneRadius = 768.0f;
+		if (lateralDistance > coneRadius) continue;
+		score = lateralSq / (coneRadius * coneRadius) + forwardDistance * 0.000005f;
+		R_StaticPromoteWideInsertCandidate(i, score);
+	}
+	s_staticPromoteWideGeneration = s_staticPromotePersistentBuildGeneration;
+	Q_strncpyz(s_staticPromoteWideMapName, tr.world->baseName, sizeof(s_staticPromoteWideMapName));
+	if (s_staticPromoteWideCandidateCount <= 0)
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE WIDE: no BSP fixture in wide cone. Use r_staticPromoteSynthetic [distance] [intensity] [r g b].\n");
+		return;
+	}
+	ri.Printf(PRINT_ALL, "STATIC_PROMOTE WIDE map=%s candidates=%d; choose with r_staticPromoteLearnCandidate <slot>\n", tr.world->baseName, s_staticPromoteWideCandidateCount);
+	for (i = 0; i < s_staticPromoteWideCandidateCount; ++i)
+	{
+		int idx = s_staticPromoteWideCandidates[i];
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[idx];
+		vec3_t delta;
+		float fwd, totalSq, latSq, lat;
+		int classReason = R_StaticPromoteClassifyFixture(light);
+		int overrideState = R_StaticPromoteUserOverrideState(tr.world->baseName, light->candidate.entityOrdinal);
+		VectorSubtract(light->candidate.origin, s_staticPromoteLastViewOrg, delta);
+		fwd = DotProduct(delta, s_staticPromoteLastViewForward);
+		totalSq = DotProduct(delta, delta); latSq = totalSq - fwd * fwd; if (latSq < 0.0f) latSq = 0.0f; lat = sqrt(latSq);
+		ri.Printf(PRINT_ALL, "  slot=%d fixture=%d entity=%d origin=%.1f %.1f %.1f rawMembers=%d intensity=%.1f class=%s override=%d forward=%.1f lateral=%.1f\n",
+			i, idx, light->candidate.entityOrdinal, light->candidate.origin[0], light->candidate.origin[1], light->candidate.origin[2],
+			light->rawMembers, light->candidate.intensity, R_StaticPromoteClassReasonName(classReason), overrideState, fwd, lat);
+	}
+}
+
+static void R_StaticPromoteWideCandidateAction(int desiredState, const char *actionName)
+{
+	int slot;
+	int idx;
+	staticPromotePersistentLight_t *light;
+	if (ri.Cmd_Argc() < 2)
+	{
+		ri.Printf(PRINT_WARNING, "usage: %s <slot>  (run r_staticPromoteWideInspect first)\n", ri.Cmd_Argv(0));
+		return;
+	}
+	if (!tr.world || s_staticPromoteWideGeneration != s_staticPromotePersistentBuildGeneration || Q_stricmp(s_staticPromoteWideMapName, tr.world->baseName))
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE WIDE: candidate list is stale; run r_staticPromoteWideInspect again.\n");
+		return;
+	}
+	slot = atoi(ri.Cmd_Argv(1));
+	if (slot < 0 || slot >= s_staticPromoteWideCandidateCount)
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE WIDE: slot must be 0..%d\n", s_staticPromoteWideCandidateCount - 1);
+		return;
+	}
+	idx = s_staticPromoteWideCandidates[slot];
+	if (idx < 0 || idx >= s_staticPromotePersistentCount) return;
+	light = &s_staticPromotePersistentLights[idx];
+	if (!R_StaticPromoteUserOverrideSet(tr.world->baseName, light->candidate.entityOrdinal, desiredState))
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE %s FAILED: could not save %s\n", actionName, STATIC_PROMOTE_USER_OVERRIDE_FILE);
+		return;
+	}
+	s_staticPromoteLastReportWorld = NULL;
+	ri.Printf(PRINT_ALL, "STATIC_PROMOTE %s SAVED map=%s slot=%d entity=%d state=%d file=%s\n", actionName, tr.world->baseName, slot, light->candidate.entityOrdinal, desiredState, STATIC_PROMOTE_USER_OVERRIDE_FILE);
+}
+
+void R_StaticPromoteLearnCandidate_f(void) { R_StaticPromoteWideCandidateAction(1, "WIDE_FORCE_ON"); }
+void R_StaticPromoteBlockCandidate_f(void) { R_StaticPromoteWideCandidateAction(-1, "WIDE_FORCE_OFF"); }
+void R_StaticPromoteAutoCandidate_f(void) { R_StaticPromoteWideCandidateAction(0, "WIDE_RETURN_AUTO"); }
