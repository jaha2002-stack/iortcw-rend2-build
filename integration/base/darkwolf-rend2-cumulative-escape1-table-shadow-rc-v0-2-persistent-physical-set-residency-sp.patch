+// REND2_GI_2_DIAG_1_FRINGE_ROOT_CAUSE_MATRIX
+// Diagnostic matrix over the accepted v1.6 generator.
+// u_ViewInfo.z = entity guard mode: 0 v1.6 receiver-only, 1 symmetric 1 texel, 2 symmetric 2 texels.
+// u_Color.w = debug mode 0..6 during generation; values >=16 select bilateral resolve mode.
+uniform sampler2D u_ScreenImageMap;
+uniform sampler2D u_ScreenDepthMap;
+uniform sampler2D u_NormalMap; // half-resolution scene-entity depth mask
+uniform vec4 u_ViewInfo; // x=zFar/zNear, y=zFar, z=entity guard mode, w=reserved
+uniform vec4 u_Color;    // generation: x=strength y=saturation z=cap w=debug; resolve: w>=16
