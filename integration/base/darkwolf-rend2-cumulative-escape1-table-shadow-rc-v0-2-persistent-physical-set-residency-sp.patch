+static void RB_VolumetricFireV07(FBO_t *srcFbo, ivec4_t srcBox)
+{
+	static int lastDiagMs = 0;
+	static int lastResidencyDiagMs = 0;
+	static int perfLastFrameMs = 0, perfFrames = 0;
+	static float perfFrameMsSum = 0.0f, perfFrameMsMax = 0.0f;
+	fireVolumetricV07Selection_t selected[FIREVOL081_RENDER_CAP];
+	int selectedCount = 0;
+	int usedAnchors[FIREVOL07_MAX_POOL];
+	int usedAnchorCount = 0;
+	int variant = Com_Clamp(1, 2, s_rVolumetricFireV07Mode->integer);
+	int sourceMode = Com_Clamp(0, 2, s_rVolumetricFireSourceMode->integer);
+	int maxActive = (variant == 1) ? 1 : Com_Clamp(1, FIREVOL081_RENDER_CAP, s_rVolumetricFireMaxActive->integer);
+	int nowMs = ri.Milliseconds();
+	int graceMs = s_rVolumetricFirePoolGraceMs ? Com_Clamp(250, 10000, s_rVolumetricFirePoolGraceMs->integer) : 3000;
+	float maxDistance = s_rVolumetricFireRenderedMaxDist ? Com_Clamp(32.0f, 2048.0f, s_rVolumetricFireRenderedMaxDist->value) : 256.0f;
+	int renderMode = RB_FireV07RenderMode();
+	qboolean coreReady = (srcFbo && tr.quarterFbo[0] && tr.renderDepthImage && tr.volumetricLocalShader.program) ? qtrue : qfalse;
+	int strictCount = 0, nativeCount = 0;
+	int i;
+	int renderedCount = 0, greenMarkers = 0;
+	int v083OwnerDedupDrops = 0, v083FrustumSelected = 0, v083RenderedSelected = 0, v083LatentSelected = 0;
+	int v084VisibleFixtureHolds = 0;
+	const dlight_t *fallbackDl = NULL;
+	qboolean captureFresh = s_fireV07CaptureValid &&
+		s_fireV07CaptureTime == backEnd.refdef.time &&
+		s_fireV07CaptureViewport[0] == backEnd.viewParms.viewportX &&
+		s_fireV07CaptureViewport[1] == backEnd.viewParms.viewportY &&
+		s_fireV07CaptureViewport[2] == backEnd.viewParms.viewportWidth &&
+		s_fireV07CaptureViewport[3] == backEnd.viewParms.viewportHeight;
+
+	if (!captureFresh)
+	{
+		if (s_rVolumetricFireDiag && s_rVolumetricFireDiag->integer &&
+			(lastDiagMs == 0 || nowMs - lastDiagMs >= 1000))
+		{
+			ri.Printf(PRINT_ALL,
+				"FIREVOL07_SCAN map=%s variant=%s captureFresh=0 anchors=0 selected=0 rendered=0 reason=NO_MATCHING_MAIN_DRAW_COMMAND\n",
+				tr.world ? tr.world->baseName : "<none>", variant == 1 ? "B_RENDERED_SINGLE" : "C_RENDERED_MULTI");
+			lastDiagMs = nowMs;
+		}
+		return;
+	}
+
+	memset(selected, 0, sizeof(selected));
+	for (i = 0; i < FIREVOL081_RENDER_CAP; ++i)
+	{
+		selected[i].dlightIndex = -1;
+		selected[i].shadowSlot = -1;
+		selected[i].anchorIndex = -1;
+		selected[i].poolSlot = -1;
+	}
+	for (i = 0; i < FIREVOL07_MAX_POOL; ++i)
+		usedAnchors[i] = -1;
+	RB_FireV07ResetStateForMap();
+	RB_FireVFinalEnsureCatalog();
+
+	if (perfLastFrameMs > 0)
+	{
+		int frameMs = nowMs - perfLastFrameMs;
+		if (frameMs > 0 && frameMs <= 250)
+		{
+			perfFrameMsSum += (float)frameMs;
+			if ((float)frameMs > perfFrameMsMax) perfFrameMsMax = (float)frameMs;
+			perfFrames++;
+		}
+	}
+	perfLastFrameMs = nowMs;
+
+	for (i = 0; i < backEnd.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+	{
+		if (backEnd.refdef.dlights[i].fireVolumetricSource) strictCount++;
+		if (backEnd.refdef.dlights[i].nativeAuthoredDlight) nativeCount++;
+	}
+
+	if (variant == 1)
+	{
+		int index = -1, shadowSlot = -1;
+		int ignoredStrict = 0, ignoredNative = 0;
+		if (s_fireV07SingleValid)
+			index = RB_FireVolumetricFindOwner(sourceMode, s_fireV07SingleNativeOrdinal, -1, &shadowSlot);
+		else
+		{
+			// B keeps the exact v0.7 single DLight identity policy. v0.7.1 changes only anchor persistence.
+			index = RB_FireVolumetricSelect(sourceMode, NULL, 0, &shadowSlot, &ignoredStrict, &ignoredNative);
+			if (index >= 0)
+			{
+				s_fireV07SingleValid = qtrue;
+				s_fireV07SingleNativeOrdinal = backEnd.refdef.dlights[index].fireVolumetricNativeOrdinal;
+			}
+		}
+		if (index >= 0)
+		{
+			dlight_t *dl = &backEnd.refdef.dlights[index];
+			float second = -1.0f;
+			int candidates = 0, ambiguity = 0;
+			int anchor = RB_FireV07FindRenderedAnchor(dl, NULL, 0, maxDistance,
+				&selected[0].dlightToFlame, &selected[0].speakerToFlame, &candidates, &second, &ambiguity);
+			fallbackDl = dl;
+			if (!s_fireV071SingleLatchValid && anchor >= 0)
+			{
+				const fireVolumetricV07Anchor_t *first = &s_fireV07Anchors[anchor];
+				s_fireV071SingleLatchValid = qtrue;
+				s_fireV071SingleLatchedFlameSurface = first->surfaceIndex;
+				VectorCopy(first->origin, s_fireV071SingleLatchedFlameOrigin);
+				Q_strncpyz(s_fireV071SingleLatchedShader, first->shaderName, sizeof(s_fireV071SingleLatchedShader));
+				s_fireV071SingleLatchedAtMs = nowMs;
+			}
+			if (s_fireV071SingleLatchValid)
+			{
+				selected[0].dlightIndex = index;
+				selected[0].shadowSlot = shadowSlot;
+				selected[0].anchorIndex = anchor;
+				selected[0].poolSlot = 0;
+				selected[0].sourceClass = dl->fireVolumetricSource ? FIREVOL082_SOURCE_STRICT : FIREVOL082_SOURCE_FALLBACK;
+				selected[0].syntheticVolumeOnly = qfalse;
+				selected[0].sourceNativeOrdinal = dl->fireVolumetricNativeOrdinal;
+				selected[0].sourceSpeakerOrdinal = dl->fireVolumetricSpeakerOrdinal;
+				selected[0].anchorCandidates = candidates;
+				selected[0].secondDistance = second;
+				selected[0].ambiguity = ambiguity;
+				selected[0].latchValid = qtrue;
+				selected[0].latchedFlameSurface = s_fireV071SingleLatchedFlameSurface;
+				VectorCopy(s_fireV071SingleLatchedFlameOrigin, selected[0].latchedFlameOrigin);
+				Q_strncpyz(selected[0].latchedShader, s_fireV071SingleLatchedShader, sizeof(selected[0].latchedShader));
+				selected[0].latchedAtMs = s_fireV071SingleLatchedAtMs;
+				selected[0].sourceWeight = 1.0f;
+				selected[0].anchorVisibleNow = RB_FireV071FindLatchedRenderedIndex(
+					s_fireV071SingleLatchedFlameSurface, s_fireV071SingleLatchedShader,
+					s_fireV071SingleLatchedFlameOrigin) >= 0 ? 1 : 0;
+				selectedCount = 1;
+				if (anchor >= 0) usedAnchors[usedAnchorCount++] = anchor;
+			}
+		}
+	}
+	else
+	{
+		int slot, admission, anchorAdmission, viewTier;
+		int liveIndex[FIREVOL07_MAX_POOL];
+		int liveShadowSlot[FIREVOL07_MAX_POOL];
+		qboolean liveSynthetic[FIREVOL07_MAX_POOL];
+		qboolean renderChosen[FIREVOL07_MAX_POOL];
+		qboolean fallbackOwnerUsed[MAX_DLIGHTS];
+
+		for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+		{
+			liveIndex[slot] = -1;
+			liveShadowSlot[slot] = -1;
+			liveSynthetic[slot] = qfalse;
+			renderChosen[slot] = qfalse;
+		}
+		for (slot = 0; slot < MAX_DLIGHTS; ++slot)
+			fallbackOwnerUsed[slot] = qfalse;
+
+		// Pass 1: reacquire registry entries. Positive native ordinals are untouched. For -1
+		// DLight-backed entries we postpone lastSeen refresh until owner de-duplication picks one winner.
+		for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+		{
+			fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+			int index = -1, shadowSlot = -1;
+			float fixtureOwnerDistance = -1.0f;
+			if (!pool->valid)
+				continue;
+
+			if (pool->sourceClass == FIREVOL082_SOURCE_SYNTHETIC)
+			{
+				RB_FireV083RefreshSyntheticLifetime(pool, nowMs, graceMs, &liveSynthetic[slot]);
+			}
+			else if (pool->nativeOrdinal >= 0)
+			{
+				index = RB_FireVolumetricFindOwner(sourceMode, pool->nativeOrdinal, -1, &shadowSlot);
+			}
+			else
+			{
+				index = RB_FireV082FindNearestFixtureOwner(sourceMode, pool, maxDistance,
+					&shadowSlot, &fixtureOwnerDistance);
+			}
+
+			if (index >= 0)
+			{
+				liveIndex[slot] = index;
+				liveShadowSlot[slot] = shadowSlot;
+				if (pool->nativeOrdinal >= 0)
+				{
+					pool->lastSeenMs = nowMs;
+					pool->missingSinceMs = 0;
+				}
+				if (!fallbackDl)
+					fallbackDl = &backEnd.refdef.dlights[index];
+			}
+			else if (pool->sourceClass != FIREVOL082_SOURCE_SYNTHETIC && pool->latchValid &&
+				RB_FireV082ShaderLooksLikeFlame(pool->latchedShader))
+			{
+				// DLight disappeared: volume-only fallback is allowed only while the flame fixture is
+				// freshly recaptured, plus PoolGraceMs. It is no longer immortal.
+				RB_FireV083RefreshSyntheticLifetime(pool, nowMs, graceMs, &liveSynthetic[slot]);
+			}
+			else if (!pool->missingSinceMs)
+			{
+				pool->missingSinceMs = nowMs;
+			}
+
+			// v0.8.4 visible fixture hold: if a registered -1 flame fixture remains in the main-camera
+			// frustum but its tiny surface drops out of rendered capture, do not let PoolGraceMs switch it off.
+			// Once it leaves the frustum, the original v0.8.3 grace/recycling lifecycle resumes unchanged.
+			if (pool->latchValid && liveIndex[slot] < 0 && pool->nativeOrdinal < 0 &&
+				(pool->sourceClass == FIREVOL082_SOURCE_SYNTHETIC || pool->sourceClass == FIREVOL082_SOURCE_FALLBACK) &&
+				RB_FireV082ShaderLooksLikeFlame(pool->latchedShader) &&
+				RB_FireV071FindLatchedRenderedIndex(pool->latchedFlameSurface, pool->latchedShader, pool->latchedFlameOrigin) < 0 &&
+				RB_FireV083ViewTier(srcFbo, pool) == 0)
+			{
+				v084VisibleFixtureHolds++;
+				liveSynthetic[slot] = qtrue;
+				pool->lastSeenMs = nowMs;
+				pool->missingSinceMs = 0;
+			}
+
+			if (pool->latchValid)
+			{
+				int latchedRenderedIndex = RB_FireV071FindLatchedRenderedIndex(pool->latchedFlameSurface,
+					pool->latchedShader, pool->latchedFlameOrigin);
+				if (latchedRenderedIndex >= 0 && usedAnchorCount < FIREVOL07_MAX_POOL)
+					usedAnchors[usedAnchorCount++] = latchedRenderedIndex;
+			}
+		}
+
+		// Pass 1b: one current DLight with nativeOrdinal==-1 may back AT MOST one fixture.
+		// Frustum fixture wins first, then rendered/PVS, then latent. Losers can only survive as
+		// finite volume-only fixtures if their own flame surface is fresh.
+		for (viewTier = 0; viewTier < 3; ++viewTier)
+		{
+			for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+			{
+				fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+				int index = liveIndex[slot];
+				if (!pool->valid || index < 0 || pool->nativeOrdinal >= 0 ||
+					pool->sourceClass == FIREVOL082_SOURCE_SYNTHETIC)
+					continue;
+				if (RB_FireV083ViewTier(srcFbo, pool) != viewTier)
+					continue;
+				if (index >= MAX_DLIGHTS)
+					continue;
+				if (!fallbackOwnerUsed[index])
+				{
+					fallbackOwnerUsed[index] = qtrue;
+					pool->lastSeenMs = nowMs;
+					pool->missingSinceMs = 0;
+				}
+				else
+				{
+					liveIndex[slot] = -1;
+					liveShadowSlot[slot] = -1;
+					v083OwnerDedupDrops++;
+					if (RB_FireV082ShaderLooksLikeFlame(pool->latchedShader))
+						RB_FireV083RefreshSyntheticLifetime(pool, nowMs, graceMs, &liveSynthetic[slot]);
+					else if (!pool->missingSinceMs)
+						pool->missingSinceMs = nowMs;
+				}
+			}
+		}
+
+		// Pass 2: DLight-backed admissions. Positive native identity is unchanged. For -1,
+		// blockedFallbackOwners prevents one current DLight from filling multiple registry slots.
+		for (admission = 0; admission < FIREVOL07_MAX_POOL; ++admission)
+		{
+			int targetSlot = -1;
+			int index, anchor = -1, candidates = 0, ambiguity = 0;
+			int shadowSlot;
+			float dlightDistance = -1.0f, speakerDistance = -1.0f, secondDistance = -1.0f;
+			for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+			{
+				if (!s_fireV07Pool[slot].valid)
+				{
+					targetSlot = slot;
+					break;
+				}
+			}
+			if (targetSlot < 0)
+			{
+				int staleSlot = -1;
+				int oldestSeen = 0x7fffffff;
+				for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+				{
+					fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+					if (!pool->valid || liveIndex[slot] >= 0 || liveSynthetic[slot] || !pool->missingSinceMs ||
+						RB_FireVStablePoolIsResident(slot))
+						continue;
+					if (nowMs - pool->missingSinceMs < graceMs)
+						continue;
+					if (pool->lastSeenMs < oldestSeen)
+					{
+						oldestSeen = pool->lastSeenMs;
+						staleSlot = slot;
+					}
+				}
+				if (staleSlot < 0)
+					break;
+				memset(&s_fireV07Pool[staleSlot], 0, sizeof(s_fireV07Pool[staleSlot]));
+				liveIndex[staleSlot] = -1;
+				liveShadowSlot[staleSlot] = -1;
+				liveSynthetic[staleSlot] = qfalse;
+				renderChosen[staleSlot] = qfalse;
+				s_fireV07PoolChangeCount++;
+				targetSlot = staleSlot;
+			}
+
+			index = RB_FireV07BestAdmissionDlight(sourceMode, FIREVOL07_MAX_POOL,
+				usedAnchors, usedAnchorCount, fallbackOwnerUsed, maxDistance, &anchor, &dlightDistance,
+				&speakerDistance, &candidates, &secondDistance, &ambiguity);
+			if (index < 0 || anchor < 0)
+				break;
+			{
+				dlight_t *dl = &backEnd.refdef.dlights[index];
+				fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[targetSlot];
+				pool->valid = qtrue;
+				pool->nativeOrdinal = dl->fireVolumetricNativeOrdinal;
+				pool->speakerOrdinal = dl->fireVolumetricSpeakerOrdinal;
+				pool->sourceClass = dl->fireVolumetricSource ? FIREVOL082_SOURCE_STRICT : FIREVOL082_SOURCE_FALLBACK;
+				pool->createdMs = nowMs;
+				pool->lastSeenMs = nowMs;
+				pool->missingSinceMs = 0;
+				pool->latchValid = qtrue;
+				pool->latchedFlameSurface = s_fireV07Anchors[anchor].surfaceIndex;
+				VectorCopy(s_fireV07Anchors[anchor].origin, pool->latchedFlameOrigin);
+				Q_strncpyz(pool->latchedShader, s_fireV07Anchors[anchor].shaderName, sizeof(pool->latchedShader));
+				pool->latchedAtMs = nowMs;
+				liveIndex[targetSlot] = index;
+				shadowSlot = RB_FireVolumetricShadowSlotForIndex(index);
+				liveShadowSlot[targetSlot] = shadowSlot;
+				liveSynthetic[targetSlot] = qfalse;
+				if (dl->fireVolumetricNativeOrdinal < 0 && index < MAX_DLIGHTS)
+					fallbackOwnerUsed[index] = qtrue;
+				s_fireV07PoolChangeCount++;
+				if (usedAnchorCount < FIREVOL07_MAX_POOL)
+					usedAnchors[usedAnchorCount++] = anchor;
+				if (!fallbackDl)
+					fallbackDl = dl;
+			}
+		}
+
+		// Pass 2b: genuine rendered flame fixtures still lacking a binding receive a volume-only
+		// source. Full registries may recycle only entries stale beyond PoolGraceMs.
+		for (anchorAdmission = 0; anchorAdmission < s_fireV07AnchorCount &&
+			anchorAdmission < FIREVOL07_MAX_RENDERED_ANCHORS; ++anchorAdmission)
+		{
+			const fireVolumetricV07Anchor_t *anchor = &s_fireV07Anchors[anchorAdmission];
+			int targetSlot = -1;
+			if (!RB_FireV082SyntheticAnchorEligible(anchor))
+				continue;
+			if (RB_FireV082AnchorSpatiallyCovered(anchor, 32.0f))
+				continue;
+			for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+			{
+				if (!s_fireV07Pool[slot].valid)
+				{
+					targetSlot = slot;
+					break;
+				}
+			}
+			if (targetSlot < 0)
+			{
+				int staleSlot = -1;
+				int oldestSeen = 0x7fffffff;
+				for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+				{
+					fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+					if (!pool->valid || liveIndex[slot] >= 0 || liveSynthetic[slot] || !pool->missingSinceMs ||
+						RB_FireVStablePoolIsResident(slot))
+						continue;
+					if (nowMs - pool->missingSinceMs < graceMs)
+						continue;
+					if (pool->lastSeenMs < oldestSeen)
+					{
+						oldestSeen = pool->lastSeenMs;
+						staleSlot = slot;
+					}
+				}
+				if (staleSlot >= 0)
+				{
+					memset(&s_fireV07Pool[staleSlot], 0, sizeof(s_fireV07Pool[staleSlot]));
+					liveIndex[staleSlot] = -1;
+					liveShadowSlot[staleSlot] = -1;
+					liveSynthetic[staleSlot] = qfalse;
+					renderChosen[staleSlot] = qfalse;
+					s_fireV07PoolChangeCount++;
+					targetSlot = staleSlot;
+				}
+			}
+			if (targetSlot < 0)
+			{
+				targetSlot = RB_FireVStableFindRegistryPreemptionSlot(srcFbo, liveIndex, liveSynthetic, anchor->origin, nowMs, graceMs);
+				if (targetSlot >= 0)
+				{
+					s_fireVStableRegistryPreemptions++;
+					memset(&s_fireV07Pool[targetSlot], 0, sizeof(s_fireV07Pool[targetSlot]));
+					liveIndex[targetSlot] = -1;
+					liveShadowSlot[targetSlot] = -1;
+					liveSynthetic[targetSlot] = qfalse;
+					renderChosen[targetSlot] = qfalse;
+				}
+			}
+			if (targetSlot < 0)
+				continue;
+			{
+				fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[targetSlot];
+				pool->valid = qtrue;
+				pool->nativeOrdinal = -1;
+				pool->speakerOrdinal = -1;
+				pool->sourceClass = FIREVOL082_SOURCE_SYNTHETIC;
+				pool->createdMs = nowMs;
+				pool->lastSeenMs = nowMs;
+				pool->missingSinceMs = 0;
+				pool->latchValid = qtrue;
+				pool->latchedFlameSurface = anchor->surfaceIndex;
+				VectorCopy(anchor->origin, pool->latchedFlameOrigin);
+				Q_strncpyz(pool->latchedShader, anchor->shaderName, sizeof(pool->latchedShader));
+				pool->latchedAtMs = nowMs;
+				liveIndex[targetSlot] = -1;
+				liveShadowSlot[targetSlot] = -1;
+				liveSynthetic[targetSlot] = qtrue;
+				s_fireV07PoolChangeCount++;
+				if (usedAnchorCount < FIREVOL07_MAX_POOL)
+					usedAnchors[usedAnchorCount++] = anchorAdmission;
+			}
+		}
+
+
+		// Final architecture Pass 2c: authoritative BSP catalog admission. Only static flame fixtures
+		// whose physical FireVol sphere is currently Tier0/Tier1 are admitted. The full catalog remains
+		// outside the 128-entry working registry, so an unseen fixture is never permanently forgotten.
+		{
+			int catalogIndex;
+			for (catalogIndex = 0; catalogIndex < s_fireVFinalCatalogCount; ++catalogIndex)
+			{
+				const fireVolumetricFinalCatalogEntry_t *entry = &s_fireVFinalCatalog[catalogIndex];
+				const char *catalogShader;
+				int targetSlot = -1;
+				int tier;
+				if (!tr.world || entry->surfaceIndex < 0 || entry->surfaceIndex >= tr.world->numWorldSurfaces)
+					continue;
+				if (RB_FireVFinalPoolForCatalog(entry) >= 0)
+					continue;
+				if (RB_FireVStableDistanceWeight(entry->origin) <= 0.001f)
+					continue;
+				tier = RB_FireVFinalCatalogTier(entry);
+				if (tier > 1)
+					continue;
+				for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+				{
+					if (!s_fireV07Pool[slot].valid)
+					{
+						targetSlot = slot;
+						break;
+					}
+				}
+				if (targetSlot < 0)
+				{
+					targetSlot = RB_FireVStableFindRegistryPreemptionSlot(srcFbo, liveIndex,
+						liveSynthetic, entry->origin, nowMs, graceMs);
+					if (targetSlot >= 0)
+					{
+						s_fireVStableRegistryPreemptions++;
+						memset(&s_fireV07Pool[targetSlot], 0, sizeof(s_fireV07Pool[targetSlot]));
+						liveIndex[targetSlot] = -1;
+						liveShadowSlot[targetSlot] = -1;
+						liveSynthetic[targetSlot] = qfalse;
+						renderChosen[targetSlot] = qfalse;
+					}
+				}
+				if (targetSlot < 0)
+					continue;
+				catalogShader = tr.world->surfaces[entry->surfaceIndex].shader ?
+					tr.world->surfaces[entry->surfaceIndex].shader->name : "";
+				{
+					fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[targetSlot];
+					pool->valid = qtrue;
+					pool->nativeOrdinal = -1;
+					pool->speakerOrdinal = -1;
+					pool->sourceClass = FIREVOL082_SOURCE_SYNTHETIC;
+					pool->createdMs = nowMs;
+					pool->lastSeenMs = nowMs;
+					pool->missingSinceMs = 0;
+					pool->latchValid = qtrue;
+					pool->latchedFlameSurface = entry->surfaceIndex;
+					VectorCopy(entry->origin, pool->latchedFlameOrigin);
+					Q_strncpyz(pool->latchedShader, catalogShader, sizeof(pool->latchedShader));
+					pool->latchedAtMs = nowMs;
+					liveIndex[targetSlot] = -1;
+					liveShadowSlot[targetSlot] = -1;
+					liveSynthetic[targetSlot] = qtrue;
+					s_fireV07PoolChangeCount++;
+					s_fireVFinalCatalogAdmissions++;
+				}
+			}
+		}
+
+		// Production v1 Pass 3: persistent eight-slot active residency. Existing owners are retained;
+		// free slots are filled by locality, and strong locality changes retire the old owner through FadeMs.
+		{
+			int stablePools[FIREVOL081_RENDER_CAP];
+			float stableWeights[FIREVOL081_RENDER_CAP];
+			int stableCount = RB_FireVStableSelectResidents(srcFbo, liveIndex, liveSynthetic,
+				maxActive, nowMs, stablePools, stableWeights);
+			int stableIndex;
+			for (stableIndex = 0; stableIndex < stableCount && selectedCount < maxActive; ++stableIndex)
+			{
+				int bestSlot = stablePools[stableIndex];
+				fireVolumetricV07PoolSlot_t *pool;
+				int index, latchedRenderedIndex, stableViewTier;
+				fireVolumetricV07Selection_t *sel;
+				if (bestSlot < 0 || bestSlot >= FIREVOL07_MAX_POOL)
+					continue;
+				pool = &s_fireV07Pool[bestSlot];
+				if (!pool->valid || !pool->latchValid)
+					continue;
+				index = liveIndex[bestSlot];
+				// A retiring resident may outlive current owner evidence for FadeMs; render its immutable
+				// fixture latch as a synthetic volume during that short fade instead of popping to zero.
+				latchedRenderedIndex = RB_FireV071FindLatchedRenderedIndex(pool->latchedFlameSurface,
+					pool->latchedShader, pool->latchedFlameOrigin);
+				renderChosen[bestSlot] = qtrue;
+				sel = &selected[selectedCount];
+				sel->dlightIndex = index;
+				sel->shadowSlot = (index >= 0) ? liveShadowSlot[bestSlot] : -1;
+				sel->anchorIndex = latchedRenderedIndex;
+				sel->poolSlot = bestSlot;
+				sel->sourceClass = pool->sourceClass;
+				sel->syntheticVolumeOnly = (index < 0) ? qtrue : qfalse;
+				sel->sourceWeight = Com_Clamp(0.0f, 1.0f, stableWeights[stableIndex]);
+				if (index >= 0)
+				{
+					dlight_t *dl = &backEnd.refdef.dlights[index];
+					vec3_t delta;
+					sel->sourceNativeOrdinal = dl->fireVolumetricNativeOrdinal;
+					sel->sourceSpeakerOrdinal = dl->fireVolumetricSpeakerOrdinal;
+					VectorSubtract(pool->latchedFlameOrigin, dl->origin, delta);
+					sel->dlightToFlame = VectorLength(delta);
+					if (dl->fireVolumetricSpeakerOrdinal >= 0)
+					{
+						VectorSubtract(pool->latchedFlameOrigin, dl->fireVolumetricSpeakerOrigin, delta);
+						sel->speakerToFlame = VectorLength(delta);
+					}
+					else
+						sel->speakerToFlame = -1.0f;
+				}
+				else
+				{
+					sel->sourceNativeOrdinal = -1;
+					sel->sourceSpeakerOrdinal = -1;
+					sel->dlightToFlame = 0.0f;
+					sel->speakerToFlame = -1.0f;
+				}
+				sel->anchorCandidates = latchedRenderedIndex >= 0 ? 1 : 0;
+				sel->secondDistance = -1.0f;
+				sel->ambiguity = 0;
+				RB_FireV071CopyPoolLatchToSelection(pool, sel);
+				stableViewTier = RB_FireV083ViewTier(srcFbo, pool);
+				if (stableViewTier == 0) v083FrustumSelected++;
+				else if (stableViewTier == 1) v083RenderedSelected++;
+				else v083LatentSelected++;
+				selectedCount++;
+			}
+		}
+
+		// R3 full registry-candidate audit. This block intentionally remains inside variant==2,
+		// where liveIndex/liveSynthetic are authoritative and lexically valid.
+		if (s_rVolumetricFireResidencyDiag && s_rVolumetricFireResidencyDiag->integer > 0 &&
+			(lastResidencyDiagMs == 0 || nowMs - lastResidencyDiagMs >= 1000))
+		{
+			int r3PoolSlot, r3ResidentIndex, r3SelectedIndex;
+			int r3OccupiedResidents = 0, r3RegistryCount = 0, r3Tier2GatedCandidates = 0;
+			for (r3ResidentIndex = 0; r3ResidentIndex < maxActive; ++r3ResidentIndex)
+				if (s_fireVStableResidents[r3ResidentIndex].poolSlot >= 0)
+					r3OccupiedResidents++;
+
+			for (r3PoolSlot = 0; r3PoolSlot < FIREVOL07_MAX_POOL; ++r3PoolSlot)
+			{
+				fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[r3PoolSlot];
+				const char *rejectReason = "INVALID";
+				int currentTier = -1, residentIndex = -1, residentTier = -1, selectedIndex = -1;
+				int eligible = 0, live = 0, staticCatalog = 0, retiring = 0;
+				float cameraDistance = -1.0f, distanceWeight = 0.0f, priority = -999999.0f;
+				int lastSeenAgeMs = -1, missingAgeMs = -1;
+				if (!pool->valid)
+					continue;
+				r3RegistryCount++;
+				for (r3ResidentIndex = 0; r3ResidentIndex < maxActive; ++r3ResidentIndex)
+					if (s_fireVStableResidents[r3ResidentIndex].poolSlot == r3PoolSlot)
+					{
+						residentIndex = r3ResidentIndex;
+						residentTier = s_fireVStableResidents[r3ResidentIndex].viewTier;
+						retiring = s_fireVStableResidents[r3ResidentIndex].retireStartMs > 0 ? 1 : 0;
+						break;
+					}
+				for (r3SelectedIndex = 0; r3SelectedIndex < selectedCount; ++r3SelectedIndex)
+					if (selected[r3SelectedIndex].poolSlot == r3PoolSlot)
+					{
+						selectedIndex = r3SelectedIndex;
+						break;
+					}
+				if (pool->lastSeenMs > 0)
+					lastSeenAgeMs = nowMs - pool->lastSeenMs;
+				if (pool->missingSinceMs > 0)
+					missingAgeMs = nowMs - pool->missingSinceMs;
+				if (pool->latchValid)
+				{
+					currentTier = RB_FireV083ViewTier(srcFbo, pool);
+					cameraDistance = RB_FireVStableCameraDistance(pool->latchedFlameOrigin);
+					distanceWeight = RB_FireVStableDistanceWeight(pool->latchedFlameOrigin);
+					live = (liveIndex[r3PoolSlot] >= 0 || liveSynthetic[r3PoolSlot]) ? 1 : 0;
+					priority = RB_FireVStableCandidatePriority(srcFbo, r3PoolSlot, liveIndex, liveSynthetic);
+					if (priority < -1.0e20f)
+						priority = -999999.0f;
+					staticCatalog = RB_FireVFinalCatalogIndexForFixture(pool->latchedFlameSurface,
+						pool->latchedShader, pool->latchedFlameOrigin) >= 0 ? 1 : 0;
+				}
+
+				if (!pool->latchValid)
+					rejectReason = "NO_LATCH";
+				else if (residentIndex >= 0)
+					rejectReason = currentTier == 2 ? "RESIDENT_TIER2_GRACE" : "RESIDENT";
+				else if (currentTier == 2)
+				{
+					rejectReason = "TIER2_REACQUIRE_GATED";
+					if (live && distanceWeight > 0.001f)
+						r3Tier2GatedCandidates++;
+				}
+				else if (!live)
+					rejectReason = "NOT_LIVE";
+				else if (distanceWeight <= 0.001f)
+					rejectReason = "OUTSIDE_ACTIVE_RADIUS";
+				else
+				{
+					eligible = 1;
+					rejectReason = r3OccupiedResidents >= maxActive ? "RENDER_CAP_OR_PRIORITY" : "ELIGIBLE_FREE_SLOT";
+				}
+
+				ri.Printf(PRINT_ALL,
+					"FIREVOL_STABLE_RESIDENCY_R3_CANDIDATE map=%s pool=%d REGISTERED=1 TIER=%d ELIGIBLE=%d RESIDENT=%d REJECT_REASON=%s residentSlot=%d residentTier=%d selected=%d retiring=%d staticCatalog=%d origin=%.1f,%.1f,%.1f distance=%.2f distanceWeight=%.3f priority=%.1f live=%d liveIndex=%d liveSynthetic=%d sourceClass=%d nativeOrdinal=%d speakerOrdinal=%d flameSurface=%d shader=%s lastSeenAgeMs=%d missingAgeMs=%d\n",
+					tr.world ? tr.world->baseName : "<none>", r3PoolSlot, currentTier, eligible,
+					residentIndex >= 0 ? 1 : 0, rejectReason, residentIndex, residentTier,
+					selectedIndex >= 0 ? 1 : 0, retiring, staticCatalog,
+					pool->latchValid ? pool->latchedFlameOrigin[0] : 0.0f,
+					pool->latchValid ? pool->latchedFlameOrigin[1] : 0.0f,
+					pool->latchValid ? pool->latchedFlameOrigin[2] : 0.0f,
+					cameraDistance, distanceWeight, priority, live, liveIndex[r3PoolSlot],
+					liveSynthetic[r3PoolSlot] ? 1 : 0, pool->sourceClass, pool->nativeOrdinal,
+					pool->speakerOrdinal, pool->latchedFlameSurface, pool->latchedShader,
+					lastSeenAgeMs, missingAgeMs);
+			}
+
+			ri.Printf(PRINT_ALL,
+				"FIREVOL_STABLE_RESIDENCY_R3_SUMMARY map=%s registry=%d registryCap=%d occupiedResidents=%d selected=%d renderCap=%d newAcquireMaxTier=1 tier2GatedCandidates=%d tier2Evictions=%d tier1Evictions=%d\n",
+				tr.world ? tr.world->baseName : "<none>", r3RegistryCount, FIREVOL07_MAX_POOL,
+				r3OccupiedResidents, selectedCount, maxActive, r3Tier2GatedCandidates,
+				s_fireVStableR2Tier2Evictions, s_fireVStableR2Tier1Evictions);
+			ri.Printf(PRINT_ALL,
+				"FIREVOL_FINAL_ARCH_SUMMARY map=%s catalog=%d catalogAdmissions=%d registry=%d selected=%d renderCap=%d volumePairOverflows=%d\n",
+				tr.world ? tr.world->baseName : "<none>", s_fireVFinalCatalogCount,
+				s_fireVFinalCatalogAdmissions, r3RegistryCount, selectedCount, maxActive,
+				s_fireVFinalVolumePairOverflows);
+		}
+	}
+
+	// DARKWOLF_FIREVOL_OCCLUSION_PRODUCTION_V1: publish, but do not re-rank/reselect, the exact already-selected production sources.
+	tr.fireVolumetricSyntheticShadowHintCount = 0;
+	for (i = 0; i < selectedCount && tr.fireVolumetricSyntheticShadowHintCount < FIREVOL_SYNTH_SHADOW_CACHE_MAX; ++i)
+	{
