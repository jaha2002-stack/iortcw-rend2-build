+static void R_DarkWolfPCRBE2E07Prepare(const refdef_t *fd,
+    staticPromotePersistentLight_t **selected, int selectedCount)
+{
+    mnode_t *viewLeaf;
+    int viewCluster;
+    int viewArea;
+    int i;
+
+    if (!fd || !tr.world || !0)
+        return;
+    if (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+        return;
+
+    viewLeaf = R_StaticPromotePointInLeafSafe(fd->vieworg);
+    viewCluster = viewLeaf ? viewLeaf->cluster : -1;
+    viewArea = viewLeaf ? viewLeaf->area : -1;
+
+    for (i = 0; i < s_staticPromotePersistentCount; ++i)
+    {
+        staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+        int runtimeId;
+        int mapCode;
+        const char *role;
+        int targetSlot;
+        int selectedSlot = -1;
+        int j;
+        vec3_t delta;
+
+        if (!R_DarkWolfPCRBV04ExpectedTarget(tr.world->baseName,
+            light->candidate.entityOrdinal, &runtimeId, &mapCode, &role))
+            continue;
+        (void)mapCode;
+        targetSlot = (runtimeId == 352 || runtimeId == 628) ? 0 : 1;
+        if (targetSlot < 0 || targetSlot >= PCRB_E2E07_TARGETS)
+            continue;
+
+        s_pcrbE2E07[targetSlot].active = qtrue;
+        s_pcrbE2E07[targetSlot].problem = (targetSlot == 0) ? qtrue : qfalse;
+        s_pcrbE2E07[targetSlot].runtimeId = runtimeId;
+        s_pcrbE2E07[targetSlot].fixtureOrdinal = light->candidate.entityOrdinal;
+        s_pcrbE2E07[targetSlot].role = role;
+        s_pcrbE2E07[targetSlot].frameTime = fd->time;
+        s_pcrbE2E07[targetSlot].viewCluster = viewCluster;
+        s_pcrbE2E07[targetSlot].viewArea = viewArea;
+        VectorCopy(light->candidate.origin, s_pcrbE2E07[targetSlot].origin);
+        s_pcrbE2E07[targetSlot].runtimeRadius = R_DarkWolfPCRBE2E07RuntimeRadius(&light->candidate);
+        VectorSubtract(fd->vieworg, light->candidate.origin, delta);
+        s_pcrbE2E07[targetSlot].cameraDistance = VectorLength(delta);
+        s_pcrbE2E07[targetSlot].influenceCount = light->influenceCount;
+        s_pcrbE2E07[targetSlot].productionPointPVS = light->influenceVisibleNow;
+        s_pcrbE2E07[targetSlot].coronaPresent = s_staticPromotePhysicalResidencyCoronaPresent[i];
+        s_pcrbE2E07[targetSlot].coronaLOS =
+            (s_staticPromotePhysicalResidencyCoronaFlags[i] & 1) ? qtrue : qfalse;
+        s_pcrbE2E07[targetSlot].physicalFallback = s_staticPromotePhysicalResidencyFallbackNow[i];
+        s_pcrbE2E07[targetSlot].surfaceInfluenceVisible = s_staticPromoteVisibleSurfaceSignalNow[i];
+        s_pcrbE2E07[targetSlot].surfaceResidency = s_staticPromoteVisibleSurfaceResidencyNow[i];
+        s_pcrbE2E07[targetSlot].surfaceSignalSourceTime =
+            s_staticPromoteVisibleSurfaceCurrent[i].valid ? s_staticPromoteVisibleSurfaceCurrent[i].sourceFrameTime : -1;
+        s_pcrbE2E07[targetSlot].held = light->heldResident;
+        for (j = 0; j < selectedCount; ++j)
+        {
+            if (selected[j] == light)
+            {
+                selectedSlot = j;
+                break;
+            }
+        }
+        s_pcrbE2E07[targetSlot].selectedSlot = selectedSlot;
+        s_pcrbE2E07[targetSlot].addedDlightIndex = R_DarkWolfFindPromotedDlightIndex(light);
+        s_pcrbE2E07[targetSlot].finalDecision = R_DarkWolfPCRBE2E07FinalDecision(light, i);
+        R_DarkWolfPCRBE2E07ScanVolumeLeaves(fd, &s_pcrbE2E07[targetSlot]);
+    }
+
+    if (!s_pcrbE2E07StartupPrinted)
+    {
+        s_pcrbE2E07StartupPrinted = qtrue;
+        ri.Printf(PRINT_ALL,
+            "SPR_E2E07_STARTUP enabled=1 functionalDecisionChanged=0 pointPvsReadOnly=1 volumeLeafReadOnly=1 visibleSurfaceReadOnly=1 surfacePredicate=exact_R_DlightSurface_geometry mainViewOnly=1 v06FallbackForcedOffByProfile=1\\n");
+    }
+}
