+static void R_DarkWolfPCRBV05BuildInfluencePoints(const staticPromotePersistentLight_t *light,
+	vec3_t points[PCRB_V05_PVS_POINT_COUNT])
+{
+	float radius;
+	int i;
+	radius = r_staticPromoteInfluenceRadius ? r_staticPromoteInfluenceRadius->value : 320.0f;
+	radius = CLAMP(radius, 128.0f, 512.0f);
+	VectorCopy(light->candidate.origin, points[0]);
+	for (i = 0; i < 26; ++i)
+		VectorMA(light->candidate.origin, radius, s_pcrbV05InfluenceDirections[i], points[i + 1]);
+}
+
+static int R_DarkWolfPCRBV05UniqueSlot(const staticPromotePersistentLight_t *light, int cluster, int area)
+{
+	int i;
+	for (i = 0; i < light->influenceCount; ++i)
+		if (light->influenceCluster[i] == cluster && light->influenceArea[i] == area)
+			return i;
+	return -1;
+}
+
+static const char *R_DarkWolfPCRBV05Reason(const refdef_t *fd, const byte *vis,
+	int cluster, int area, int *pvsBitOut, int *areaMaskOut, qboolean *visibleOut)
+{
+	int pvsBit = -1;
+	int areaMask = -1;
+	qboolean visible = qfalse;
+	const char *reason;
+	if (cluster < 0 || cluster >= tr.world->numClusters)
+		reason = "REJECT_INVALID_CLUSTER";
+	else {
+		if (vis) pvsBit = (vis[cluster >> 3] & (1 << (cluster & 7))) ? 1 : 0;
+		if (vis && !pvsBit)
+			reason = "REJECT_PVS_BIT_CLEAR";
+		else {
+			if (area >= 0 && area < MAX_MAP_AREA_BYTES * 8)
+				areaMask = (fd->areamask[area >> 3] & (1 << (area & 7))) ? 1 : 0;
+			if (areaMask == 1)
+				reason = "REJECT_AREA_PORTAL_MASK";
+			else {
+				visible = qtrue;
+				reason = vis ? "ACCEPT_PVS_AND_AREA" : "ACCEPT_NO_VIS_DATA_AREA_OK";
+			}
+		}
+	}
+	if (pvsBitOut) *pvsBitOut = pvsBit;
+	if (areaMaskOut) *areaMaskOut = areaMask;
+	if (visibleOut) *visibleOut = visible;
+	return reason;
+}
