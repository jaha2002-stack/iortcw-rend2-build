+		return;
+	if (!backEnd.refdef.dlightShadowMask || backEnd.refdef.dlightDiagSelectedIndex < 0)
+		return;
+
+	now = ri.Milliseconds();
+	stageTime = r_dlightShadowAutoStageTime->integer;
+
+	if (s_dlightShadowAutoState == 0)
+	{
+		RB_DlightShadowAutoReset();
+		s_dlightShadowAutoState = 1;
+		s_dlightShadowAutoStamp = now;
+		RB_DlightShadowAutoAppend("REND2_DLIGHT_SHADOW_QUALITY_DIAG_V8_6\n");
+		RB_DlightShadowAutoAppend("purpose=player_softness_and_grating_caster_isolation\n");
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_SHADOW_AUTOTEST armed: keep camera still, four stages will capture automatically\n");
+		return;
+	}
+
+	if (s_dlightShadowAutoState == 1)
+	{
+		if (now - s_dlightShadowAutoStamp < 900)
+			return;
+		RB_DlightShadowAutoConfigureStage(0);
+		s_dlightShadowAutoState = 2;
+		s_dlightShadowAutoStamp = now;
+		return;
+	}
+
+	if (s_dlightShadowAutoState == 2)
+	{
+		if (now - s_dlightShadowAutoStamp < stageTime)
+			return;
+		RB_DlightShadowAutoRecordStage(s_dlightShadowAutoStage);
+		s_dlightShadowAutoState = 3;
+		s_dlightShadowAutoStamp = now;
+		return;
+	}
+
+	if (s_dlightShadowAutoState == 3)
+	{
+		if (now - s_dlightShadowAutoStamp < 650)
+			return;
+		if (s_dlightShadowAutoStage < 3)
+		{
+			RB_DlightShadowAutoConfigureStage(s_dlightShadowAutoStage + 1);
+			s_dlightShadowAutoState = 2;
+			s_dlightShadowAutoStamp = now;
+			return;
+		}
+
+		if (s_dlightShadowStageSkipped[0] > 0 && s_dlightShadowStageSeeThrough[2] > 0)
