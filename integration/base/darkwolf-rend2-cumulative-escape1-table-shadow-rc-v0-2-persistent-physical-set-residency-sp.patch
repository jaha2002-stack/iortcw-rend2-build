+	// DARKWOLF_PCRB_E2E_V0_7_VISIBLE_SURFACE_INFLUENCE_AUDIT
+	// Snapshot the already-final production decision before the main-view surface walk.
+	R_DarkWolfPCRBE2E07Prepare(fd, selected, selectedCount);
