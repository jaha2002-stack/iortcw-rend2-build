+// REND2_DLIGHT_DIAGNOSTIC_V2
+static int R_AddDlightDiagnosticSource(const refdef_t *fd)
+{
+	vec3_t origin;
+	float phase;
+	float lateral;
+	float vertical;
+	int before;
+
+	if (!r_dlightDiagInject || !r_dlightDiagInject->integer)
+		return -1;
+
+	if (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+		return -1;
+
+	before = r_numdlights;
+	phase = r_dlightDiagFreeze->integer ? 0.0f : fd->time * 0.001f * r_dlightDiagSpeed->value;
+	lateral = sin(phase) * r_dlightDiagOrbit->value;
+	vertical = 24.0f + cos(phase * 0.73f) * r_dlightDiagOrbit->value * 0.35f;
+
+	VectorCopy(fd->vieworg, origin);
+	VectorMA(origin, r_dlightDiagDistance->value, fd->viewaxis[0], origin);
+	VectorMA(origin, lateral, fd->viewaxis[1], origin);
+	VectorMA(origin, vertical, fd->viewaxis[2], origin);
+
+	// Cyan means the source was injected. Once selected for the shadow slot,
+	// the lightall diagnostic path can override it to magenta.
+	RE_AddLightToScene(origin, r_dlightDiagRadius->value,
+		0.05f, 0.85f, 1.00f, REF_FORCE_DLIGHT);
+
+	if (r_numdlights == before)
+		return -1;
+
+	// Independent cyan marker proves where the source is even when surface
+	// lighting or lightall sampling is broken.
+	RE_AddCoronaToScene(origin, 0.05f, 0.85f, 1.00f, 1.60f, 0x7D1A, 1);
+
+	return before - r_firstSceneDlight;
+}
