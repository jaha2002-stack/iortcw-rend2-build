+		state->fixtureOrdinal != CG_DarkWolfPCRBV04ExpectedFixture( runtimeId ) ||
+		state->mapCode != CG_DarkWolfPCRBV04ExpectedMapCode( runtimeId ) ) {
+		return qfalse;
