+static void R_DarkWolfPCRBV05ObservePVS(const refdef_t *fd, const byte *vis,
+	const staticPromotePersistentLight_t *light, qboolean functionalVisible)
+{
+	static int s_lastPrint[4];
+	static int s_sequence[4];
+	static qboolean s_startupPrinted = qfalse;
+	vec3_t points[PCRB_V05_PVS_POINT_COUNT];
+	mnode_t *viewLeaf;
+	const char *mapName;
+	const char *role;
+	int runtimeId, mapCode, slot, now, seq;
+	int viewLeafIndex, viewCluster, viewArea;
+	int visibleCount = 0, pvsReject = 0, areaReject = 0, invalid = 0;
+	int i;
+
+	if (!fd || !light || !tr.world ||
+		!0) return;
+	// DARKWOLF_PCRB_E2E_V0_7_VISIBLE_SURFACE_INFLUENCE_AUDIT
+	// v0.7 reuses v0.5 markers only; its renderer ledger replaces the old 27-point print flood.
+	if (0) return;
+	mapName = tr.world->baseName;
+	if (!R_DarkWolfPCRBV04ExpectedTarget(mapName, light->candidate.entityOrdinal,
+		&runtimeId, &mapCode, &role)) return;
+	slot = (runtimeId == 352) ? 0 : (runtimeId == 342) ? 1 : (runtimeId == 628) ? 2 : 3;
+	now = ri.Milliseconds();
+	if (s_lastPrint[slot] && now >= s_lastPrint[slot] && now - s_lastPrint[slot] < PCRB_V05_SAMPLE_INTERVAL_MS)
+		return;
+	s_lastPrint[slot] = now;
+	seq = ++s_sequence[slot];
+	if (!s_startupPrinted) {
+		s_startupPrinted = qtrue;
+		ri.Printf(PRINT_ALL, "SPR_PVS05_REND_STARTUP enabled=1 rawPvsPoints=27 exactProductionInfluenceGeometry=1 exactFunctionalPvsGates=1 functionalDecisionChanged=0\n");
+	}
+	viewLeaf = R_StaticPromotePointInLeafSafe(fd->vieworg);
+	viewLeafIndex = viewLeaf ? (int)(viewLeaf - tr.world->nodes) : -1;
+	viewCluster = viewLeaf ? viewLeaf->cluster : -1;
+	viewArea = viewLeaf ? viewLeaf->area : -1;
+	ri.Printf(PRINT_ALL,
+		"SPR_PVS05_CAMERA map=%s role=%s runtimeId=%d fixture=%d time=%d sample=%d viewOrigin=%.3f,%.3f,%.3f bspLeaf=%d cluster=%d area=%d visAvailable=%d clusterBytes=%d influenceCount=%d functionalVisible=%d\n",
+		mapName, role, runtimeId, light->candidate.entityOrdinal, now, seq,
+		fd->vieworg[0], fd->vieworg[1], fd->vieworg[2], viewLeafIndex, viewCluster,
+		viewArea, vis ? 1 : 0, tr.world->clusterBytes, light->influenceCount,
+		functionalVisible ? 1 : 0);
+
+	R_DarkWolfPCRBV05BuildInfluencePoints(light, points);
+	for (i = 0; i < PCRB_V05_PVS_POINT_COUNT; ++i) {
+		mnode_t *leaf = R_StaticPromotePointInLeafSafe(points[i]);
+		int leafIndex = leaf ? (int)(leaf - tr.world->nodes) : -1;
+		int cluster = leaf ? leaf->cluster : -1;
+		int area = leaf ? leaf->area : -1;
+		int pvsBit, areaMask, uniqueSlot;
+		qboolean pointVisible;
+		const char *reason = R_DarkWolfPCRBV05Reason(fd, vis, cluster, area, &pvsBit, &areaMask, &pointVisible);
+		uniqueSlot = R_DarkWolfPCRBV05UniqueSlot(light, cluster, area);
+		if (pointVisible) visibleCount++;
+		else if (!Q_stricmp(reason, "REJECT_PVS_BIT_CLEAR")) pvsReject++;
+		else if (!Q_stricmp(reason, "REJECT_AREA_PORTAL_MASK")) areaReject++;
+		else invalid++;
+		ri.Printf(PRINT_ALL,
+			"SPR_PVS05_POINT map=%s role=%s runtimeId=%d fixture=%d time=%d sample=%d pvsPoint=%02d pointOrigin=%.3f,%.3f,%.3f bspLeaf=%d cluster=%d area=%d uniqueInfluenceSlot=%d pvsBit=%d areaPortalMask=%d visible=%d reason=%s\n",
+			mapName, role, runtimeId, light->candidate.entityOrdinal, now, seq, i,
+			points[i][0], points[i][1], points[i][2], leafIndex, cluster, area,
+			uniqueSlot, pvsBit, areaMask, pointVisible ? 1 : 0, reason);
+	}
+	for (i = 0; i < light->influenceCount; ++i) {
+		int cluster = light->influenceCluster[i];
+		int area = light->influenceArea[i];
+		int pvsBit, areaMask;
+		qboolean pointVisible;
+		const char *reason = R_DarkWolfPCRBV05Reason(fd, vis, cluster, area, &pvsBit, &areaMask, &pointVisible);
+		ri.Printf(PRINT_ALL,
+			"SPR_PVS05_INFLUENCE_SLOT map=%s role=%s runtimeId=%d fixture=%d time=%d sample=%d slot=%02d cluster=%d area=%d pvsBit=%d areaPortalMask=%d visible=%d reason=%s\n",
+			mapName, role, runtimeId, light->candidate.entityOrdinal, now, seq, i,
+			cluster, area, pvsBit, areaMask, pointVisible ? 1 : 0, reason);
+	}
+	ri.Printf(PRINT_ALL,
+		"SPR_PVS05_SUMMARY map=%s role=%s runtimeId=%d fixture=%d time=%d sample=%d rawPoints=27 rawVisible=%d pvsReject=%d areaPortalReject=%d invalid=%d uniqueInfluence=%d functionalVisible=%d consistency=%s\n",
+		mapName, role, runtimeId, light->candidate.entityOrdinal, now, seq,
+		visibleCount, pvsReject, areaReject, invalid, light->influenceCount,
+		functionalVisible ? 1 : 0, ((visibleCount > 0) == (functionalVisible ? 1 : 0)) ? "MATCH" : "CHECK_DEDUP_OR_GATE");
+}
+
+static qboolean R_StaticPromoteInfluenceVisible(const refdef_t *fd, const byte *vis,
+	const staticPromotePersistentLight_t *light)
+{
+	int i;
+	if (!fd || !light)
+		return qfalse;
+	for (i = 0; i < light->influenceCount; ++i)
+	{
+		int cluster = light->influenceCluster[i];
+		int area = light->influenceArea[i];
+		if (cluster < 0 || cluster >= tr.world->numClusters)
+			continue;
+		if (vis && !(vis[cluster >> 3] & (1 << (cluster & 7))))
+			continue;
+		if (area >= 0 && area < MAX_MAP_AREA_BYTES * 8 &&
+			(fd->areamask[area >> 3] & (1 << (area & 7))))
+			continue;
+		return qtrue;
+	}
+	return qfalse;
+}
