+	if (shader->isSky || (shader->surfaceFlags & (SURF_SKY | SURF_NODRAW | SURF_NODLIGHT)))
+		return DWSHADOW_MATERIAL_EXCLUDED;
+	for (i = 0; i < shader->numUnfoggedPasses && i < MAX_SHADER_STAGES; ++i)
+	{
+		shaderStage_t *stage = shader->stages[i];
+		if (stage && stage->active && (stage->stateBits & GLS_ATEST_BITS)
+			&& !(stage->stateBits & (GLS_SRCBLEND_BITS | GLS_DSTBLEND_BITS)))
+			return DWSHADOW_MATERIAL_ALPHA_CUTOUT;
+	}
+	if (shader->sort == SS_OPAQUE)
+		return DWSHADOW_MATERIAL_OPAQUE_SOLID;
+	if (shader->sort >= SS_SEE_THROUGH)
+		return DWSHADOW_MATERIAL_TRUE_TRANSLUCENT;
+	return DWSHADOW_MATERIAL_EXCLUDED;
+}
