+// DARKWOLF_SUN_VOLUMETRIC_V0_3
+static qboolean R_VolumetricSunMapSourceValid(const refdef_t *fd)
+{
+	float dirLenSq;
+	float sunPeak;
+	if (!r_volumetricSun || !r_volumetricSun->integer ||
+		!r_volumetricSunCsmProducer || !r_volumetricSunCsmProducer->integer ||
+		!r_sunlightMode || !r_sunlightMode->integer ||
+		(fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL)))
+		return qfalse; // DARKWOLF_SUN_VOLUMETRIC_PERF_ISOLATION_V0_3; DARKWOLF_SUN_VOLUMETRIC_CSM_SMART_UPDATE_V1: main-world producer only
+	dirLenSq = DotProduct(tr.refdef.sunDir, tr.refdef.sunDir);
+	sunPeak = MAX(tr.refdef.sunCol[0], MAX(tr.refdef.sunCol[1], tr.refdef.sunCol[2]));
+	return (dirLenSq > 0.25f && sunPeak > 0.0001f) ? qtrue : qfalse;
+}
+
+// DARKWOLF_SUN_VOLUMETRIC_CSM_SMART_UPDATE_V1
+static qboolean R_VolumetricSunDirectionChanged(const vec3_t currentDir, const vec3_t cachedDir)
+{
+	vec3_t delta;
+	VectorSubtract(currentDir, cachedDir, delta);
+	// Avoid exact-float VectorCompare forcing all four cascades to refresh on tiny direction noise.
+	return (DotProduct(delta, delta) > 0.000001f) ? qtrue : qfalse;
+}
+
+static qboolean R_VolumetricSunShouldUpdateCascade(int cascade, int frame, qboolean sunChanged)
+{
+	int baseInterval;
+	int period;
+	int phase;
+	if (cascade < 0 || cascade > 3)
+		return qfalse;
+	if (!tr.volumetricSunCsmValid[cascade] || sunChanged)
+		return qtrue;
+
+	// Conservative fallback: original approved v0.3 cadence, but with the resume/direction false-positive fixes below.
+	if (!r_volumetricSunCsmSmart || !r_volumetricSunCsmSmart->integer)
+	{
+		if (cascade == 0) return qtrue;
+		if (cascade == 1) return (frame & 1) == 0 ? qtrue : qfalse;
+		if (cascade == 2) return (frame & 3) == 0 ? qtrue : qfalse;
+		return (frame & 15) == 0 ? qtrue : qfalse;
+	}
+
+	// F3 production concept: raymarch stays live every frame; valid CSM is reused between real updates.
+	// Default base=4 gives staggered 4/8/16/32 cadence. Phases 0/2/6/14 prevent normal
+	// steady-state collisions, so at most one valid cascade is refreshed on a scheduled frame.
+	baseInterval = r_volumetricSunCsmBaseInterval ? r_volumetricSunCsmBaseInterval->integer : 4;
+	if (baseInterval < 2) baseInterval = 2;
+	if (baseInterval > 16) baseInterval = 16;
+	period = baseInterval << cascade;
+	if (period > 128) period = 128;
+	phase = (cascade == 0) ? 0 : (period / 2 - baseInterval / 2);
+	return ((frame % period) == phase) ? qtrue : qfalse;
+}
+
+static void R_VolumetricSunCommitCascade(int cascade)
+{
+	Mat4Copy(tr.refdef.sunShadowMvp[cascade], tr.volumetricSunCsmMvp[cascade]);
+	tr.volumetricSunCsmRenderFrame[cascade] = tr.frameCount;
+	tr.volumetricSunCsmValid[cascade] = qtrue;
+	tr.volumetricSunPerfCsmRenderedThisFrame++; // DARKWOLF_SUN_VOLUMETRIC_PERF_ISOLATION_V0_3
+}
+
+static void R_VolumetricSunRestoreCascade(int cascade)
+{
+	if (tr.volumetricSunCsmValid[cascade])
+		Mat4Copy(tr.volumetricSunCsmMvp[cascade], tr.refdef.sunShadowMvp[cascade]);
+}
