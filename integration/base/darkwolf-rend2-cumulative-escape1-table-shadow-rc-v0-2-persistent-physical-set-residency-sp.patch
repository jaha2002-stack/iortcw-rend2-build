+
+static int RB_FireV07FindRenderedAnchor(const dlight_t *dl, const int *usedAnchors, int usedCount,
+	float maxDistance, float *bestDistance, float *speakerDistance, int *candidateCount,
+	float *secondDistance, int *ambiguity)
+{
+	int i;
+	int best = -1;
+	float bestSq = maxDistance * maxDistance;
+	float secondSq = 1.0e30f;
+	int candidates = 0;
+	float allBestSq = 1.0e30f;
+	float allSecondSq = 1.0e30f;
+	if (bestDistance) *bestDistance = -1.0f;
+	if (speakerDistance) *speakerDistance = -1.0f;
+	if (candidateCount) *candidateCount = 0;
+	if (secondDistance) *secondDistance = -1.0f;
+	if (ambiguity) *ambiguity = 0;
+	if (!dl)
+		return -1;
+
+	for (i = 0; i < s_fireV07AnchorCount && i < FIREVOL07_MAX_RENDERED_ANCHORS; ++i)
+	{
+		const fireVolumetricV07Anchor_t *anchor = &s_fireV07Anchors[i];
+		vec3_t delta;
+		float distSq;
+		if (!anchor->semanticFire)
+			continue;
+		VectorSubtract(anchor->origin, dl->origin, delta);
+		distSq = DotProduct(delta, delta);
+		if (distSq > maxDistance * maxDistance)
+			continue;
+		candidates++;
+		if (distSq < allBestSq)
+		{
+			allSecondSq = allBestSq;
+			allBestSq = distSq;
+		}
+		else if (distSq < allSecondSq)
+			allSecondSq = distSq;
+		if (RB_FireV07AnchorAlreadyUsed(i, usedAnchors, usedCount))
+			continue;
+		if (distSq < bestSq)
+		{
+			secondSq = bestSq;
+			bestSq = distSq;
+			best = i;
+		}
+		else if (distSq < secondSq)
+			secondSq = distSq;
+	}
+	if (candidateCount) *candidateCount = candidates;
+	if (allSecondSq < 1.0e29f && secondDistance) *secondDistance = sqrt(allSecondSq);
+	if (ambiguity && candidates > 1 && allSecondSq < 1.0e29f && allBestSq < 1.0e29f &&
+		(sqrt(allSecondSq) - sqrt(allBestSq)) < 48.0f)
+		*ambiguity = 1;
+	if (best >= 0)
+	{
+		const fireVolumetricV07Anchor_t *anchor = &s_fireV07Anchors[best];
+		if (bestDistance) *bestDistance = sqrt(bestSq);
+		if (speakerDistance && dl->fireVolumetricSpeakerOrdinal >= 0)
+		{
+			vec3_t delta;
+			VectorSubtract(anchor->origin, dl->fireVolumetricSpeakerOrigin, delta);
+			*speakerDistance = VectorLength(delta);
+		}
+	}
+	return best;
+}
+
+static int RB_FireV07RenderMode(void)
+{
+	int mode = Com_Clamp(1, 3, s_rVolumetricFireMode->integer);
+	int shapeEnabled = Com_Clamp(0, 1, s_rVolumetricFireShape->integer);
+	int proofMode = s_rVolumetricFireProofMode ? Com_Clamp(0, 2, s_rVolumetricFireProofMode->integer) : 0;
+	if (shapeEnabled && mode != 1)
+	{
+		if (proofMode == 1) return 7;
+		if (proofMode == 2) return 8;
+		return (mode == 3) ? 6 : 5;
+	}
+	return mode;
+}
