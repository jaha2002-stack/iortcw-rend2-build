+static float R_DlightShadowSelectionScore(const dlight_t *dl, const refdef_t *fd)
+{
+	vec3_t delta;
+	float distanceSquared;
+	float radiusSquared;
+	float luminance;
+
+	VectorSubtract(dl->origin, fd->vieworg, delta);
+	distanceSquared = DotProduct(delta, delta);
+	radiusSquared = dl->radius * dl->radius;
+	luminance = 0.2126f * dl->color[0] + 0.7152f * dl->color[1] + 0.0722f * dl->color[2];
+	return radiusSquared * (0.25f + luminance) /
+		(distanceSquared + radiusSquared * 0.25f + 1.0f);
+}
+
+static qboolean R_DlightShadowHistoryMatches(const dlight_t *dl, const vec3_t oldOrigin, float oldRadius)
+{
+	vec3_t delta;
+	float maxRadius;
+	float maxMovement;
+	float ratio;
+
+	if (oldRadius <= 0.0f || dl->radius <= 0.0f)
+		return qfalse;
+
+	maxRadius = dl->radius > oldRadius ? dl->radius : oldRadius;
+	maxMovement = maxRadius * 0.50f;
+	if (maxMovement < 64.0f)
+		maxMovement = 64.0f;
+
+	VectorSubtract(dl->origin, oldOrigin, delta);
+	if (DotProduct(delta, delta) > maxMovement * maxMovement)
+		return qfalse;
+
+	ratio = dl->radius / oldRadius;
+	return ratio >= 0.50f && ratio <= 2.0f;
