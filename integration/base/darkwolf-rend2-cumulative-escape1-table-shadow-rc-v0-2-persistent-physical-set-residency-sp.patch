+// REND2_MAT_1_V2_PBR_AWARE_CLASS_FALLBACK
+// MAT-1 v2 changes no GLSL/BRDF math. It only encodes class-aware fallback inputs using the
+// semantics already expected by the active LightAll path: classic uses RGB F0 + alpha gloss,
+// PBR uses red gloss + green metallicness. Explicit/auto/legacy/author responses stay untouched.
+static float R_Mat1RoughnessToEncodedGloss(float roughness)
+{
+	float r = CLAMP(roughness, 0.02f, 1.0f);
+
+	switch (r_glossType->integer)
+	{
+		case 1: // GLOSS_IS_SMOOTHNESS: roughness = 1 - gloss
+			return 1.0f - r;
+		case 2: // GLOSS_IS_ROUGHNESS: roughness = gloss
+			return r;
+		case 3: // GLOSS_IS_SHININESS: roughness = pow(2 / (8190 * gloss + 2), 0.25)
+		{
+			float r2 = r * r;
+			float r4 = r2 * r2;
+			return CLAMP((2.0f / r4 - 2.0f) / 8190.0f, 0.0f, 1.0f);
+		}
+		case 0:
+		default: // GLOSS_IS_GLOSS: roughness = exp2(-3 * gloss)
+			return CLAMP(log2f(1.0f / r) / 3.0f, 0.0f, 1.0f);
+	}
+}
