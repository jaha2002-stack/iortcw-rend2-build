+static void R_DarkWolfFactoryDiagMeta(void)
+{
+	static int reportedGeneration = -1;
+	int i;
+	if (!tr.world || Q_stricmp(tr.world->baseName, "factory") ||
+		!0 ||
+		reportedGeneration == s_staticPromotePersistentBuildGeneration)
+		return;
+	reportedGeneration = s_staticPromotePersistentBuildGeneration;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		int watch = R_DarkWolfFactoryWatchIndex(light->candidate.entityOrdinal);
+		char influence[1024];
+		int pos = 0, j;
+		if (watch < 0)
+			continue;
+		influence[0] = '\0';
+		for (j = 0; j < light->influenceCount && pos < (int)sizeof(influence) - 32; ++j)
+		{
+			Com_sprintf(influence + pos, sizeof(influence) - pos, "%s%d/%d", j ? "," : "", light->influenceCluster[j], light->influenceArea[j]);
+			pos = (int)strlen(influence);
+		}
+		ri.Printf(PRINT_ALL, "PLR_FACTORY_META watch=%d entity=%d fixtureIndex=%d origin=%.1f,%.1f,%.1f intensity=%.1f rawMembers=%d scripted=%d approved=%d override=%d runtimeClass=%s legacyClassNoOverride=%s influenceCount=%d influence=%s\\n",
+			watch, light->candidate.entityOrdinal, i, light->candidate.origin[0], light->candidate.origin[1], light->candidate.origin[2],
+			light->candidate.intensity, light->rawMembers, light->scripted ? 1 : 0, light->approvedFallback ? 1 : 0,
+			R_StaticPromoteUserOverrideState(tr.world->baseName, light->candidate.entityOrdinal),
+			R_StaticPromoteClassReasonName(R_StaticPromoteClassifyFixture(light)),
+			R_StaticPromoteClassReasonName(R_DarkWolfLegacyClassReasonNoOverride(light)), light->influenceCount, influence);
+	}
+}
