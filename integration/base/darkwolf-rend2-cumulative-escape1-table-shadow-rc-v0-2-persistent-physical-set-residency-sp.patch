+static int R_DlightMaterialAlphaTestBits(unsigned stateBits)
+{
+	unsigned alphaBits = stateBits & GLS_ATEST_BITS;
+	if (alphaBits == GLS_ATEST_GT_0) return 1;
+	if (alphaBits == GLS_ATEST_LT_80) return 2;
+	if (alphaBits == GLS_ATEST_GE_80) return 3;
+	return 0;
+}
