+
+// DARKWOLF_USLRD_PHYSICAL_SHADOW_GROUP_CONTINUITY_FIX_V2
+// StaticPromote may contain near-coincident learned/synthetic companions for one physical
+// fixture.  They remain separate Direct DLights so accepted brightness/coverage is preserved,
+// but scarce point-shadow cubemaps are allocated per physical group, never per duplicate.
+static cvar_t *s_rStaticPromotePhysicalShadowGroup;
+static cvar_t *s_rStaticPromotePhysicalGroupMergeRadius;
+static cvar_t *s_rStaticPromotePhysicalGroupDiag;
+static cvar_t *s_rStaticPromoteShadowCaptureOffset; // DARKWOLF_USLRD_ALWAYS_ON_DIRECT_SHADOW_CAPTURE_FIX_V1
+static cvar_t *s_rStaticPromoteShadowCaptureStable; // DARKWOLF_USLRD_STABLE_SYNTHETIC_SHADOW_CAPTURE_FINAL_V2
+static cvar_t s_uslrdMainProductionOnCvar; // DARKWOLF_USLRD_CLEAN_PRODUCTION_V1: internal fixed values, not registered cvars.
+static cvar_t s_uslrdMainProductionOffCvar;
+static cvar_t s_uslrdMainProductionMergeRadiusCvar;
+static cvar_t s_uslrdMainProductionCaptureOffsetCvar;
+static qboolean s_uslrdMainProductionValuesInitialized = qfalse;
+
+#define USLRD_SYNTHETIC_CAPTURE_DIR_CACHE_MAX 1024
+static qboolean s_uslrdSyntheticCaptureDirValid[USLRD_SYNTHETIC_CAPTURE_DIR_CACHE_MAX];
+static vec3_t s_uslrdSyntheticCaptureDir[USLRD_SYNTHETIC_CAPTURE_DIR_CACHE_MAX];
+static char s_uslrdSyntheticCaptureDirMap[MAX_QPATH] = "";
+
+static void R_DarkWolfEnsurePhysicalShadowGroupCvars(void)
+{
+    // DARKWOLF_USLRD_CLEAN_PRODUCTION_V1: accepted point-shadow grouping/capture policy is fixed in production.
+    if (!s_uslrdMainProductionValuesInitialized)
+    {
+        s_uslrdMainProductionOnCvar.integer = 1;
+        s_uslrdMainProductionOnCvar.value = 1.0f;
+        s_uslrdMainProductionOffCvar.integer = 0;
+        s_uslrdMainProductionOffCvar.value = 0.0f;
+        s_uslrdMainProductionMergeRadiusCvar.integer = 16;
+        s_uslrdMainProductionMergeRadiusCvar.value = 16.0f;
+        s_uslrdMainProductionCaptureOffsetCvar.integer = 32;
+        s_uslrdMainProductionCaptureOffsetCvar.value = 32.0f;
+        s_uslrdMainProductionValuesInitialized = qtrue;
+    }
+    s_rStaticPromotePhysicalShadowGroup = &s_uslrdMainProductionOnCvar;
+    s_rStaticPromotePhysicalGroupMergeRadius = &s_uslrdMainProductionMergeRadiusCvar;
+    s_rStaticPromotePhysicalGroupDiag = &s_uslrdMainProductionOffCvar;
+    s_rStaticPromoteShadowCaptureOffset = &s_uslrdMainProductionCaptureOffsetCvar;
+    s_rStaticPromoteShadowCaptureStable = &s_uslrdMainProductionOnCvar;
+}
+
+static void R_DarkWolfStableSyntheticShadowCaptureResetForMap(void)
+{
+    const char *mapName = (tr.world && tr.world->baseName[0]) ? tr.world->baseName : "<none>";
+    if (!Q_stricmp(s_uslrdSyntheticCaptureDirMap, mapName))
+        return;
+    Com_Memset(s_uslrdSyntheticCaptureDirValid, 0, sizeof(s_uslrdSyntheticCaptureDirValid));
+    Com_Memset(s_uslrdSyntheticCaptureDir, 0, sizeof(s_uslrdSyntheticCaptureDir));
+    Q_strncpyz(s_uslrdSyntheticCaptureDirMap, mapName, sizeof(s_uslrdSyntheticCaptureDirMap));
+}
+
+static qboolean R_DarkWolfStableSyntheticShadowCaptureDirection(const refdef_t *fd, const dlight_t *dl,
+    const vec3_t baseOrigin, vec3_t outDirection, qboolean *outStable)
+{
+    int cacheIndex;
+
+    if (outStable)
+        *outStable = qfalse;
+    VectorClear(outDirection);
+    if (!fd || !dl || dl->staticPromoteFixtureId < 1000000)
+        return qfalse;
+
+    R_DarkWolfEnsurePhysicalShadowGroupCvars();
+
+    // Final v2 A/B escape hatch: stable=0 reproduces final-v1 camera-following capture.
+    if (!s_rStaticPromoteShadowCaptureStable || !s_rStaticPromoteShadowCaptureStable->integer)
+    {
+        VectorSubtract(fd->vieworg, baseOrigin, outDirection);
+        return VectorNormalize(outDirection) > 0.001f ? qtrue : qfalse;
+    }
+
+    R_DarkWolfStableSyntheticShadowCaptureResetForMap();
+    cacheIndex = dl->staticPromoteFixtureId - 1000000;
+    if (cacheIndex < 0 || cacheIndex >= USLRD_SYNTHETIC_CAPTURE_DIR_CACHE_MAX)
+        return qfalse;
+
+    if (s_uslrdSyntheticCaptureDirValid[cacheIndex])
+    {
+        VectorCopy(s_uslrdSyntheticCaptureDir[cacheIndex], outDirection);
+        if (outStable)
+            *outStable = qtrue;
+        return qtrue;
+    }
+
+    // Do not freeze a direction through unseen BSP. The all-active Direct light remains resident,
+    // but its synthetic shadow de-embed direction is learned only from a genuinely PVS-connected view.
+    if (dl->staticPromoteVisibilityTier > DWSP_TIER_SPHERE_PVS_CONNECTED)
+        return qfalse;
+
+    VectorSubtract(fd->vieworg, baseOrigin, outDirection);
+    if (VectorNormalize(outDirection) <= 0.001f)
+        return qfalse;
+
+    VectorCopy(outDirection, s_uslrdSyntheticCaptureDir[cacheIndex]);
+    s_uslrdSyntheticCaptureDirValid[cacheIndex] = qtrue;
+    if (outStable)
+        *outStable = qtrue;
+
+    if (s_rStaticPromotePhysicalGroupDiag && s_rStaticPromotePhysicalGroupDiag->integer)
+    {
+        ri.Printf(PRINT_ALL,
+            "USLRD_CAPTURE_CACHE_INIT map=%s fixture=%d dir=%.5f,%.5f,%.5f\n",
+            s_uslrdSyntheticCaptureDirMap, dl->staticPromoteFixtureId,
+            outDirection[0], outDirection[1], outDirection[2]);
+    }
+    return qtrue;
+}
+
+static qboolean R_DarkWolfStaticPromoteShadowGroupEligible(const dlight_t *dl)
+{
+    R_DarkWolfEnsurePhysicalShadowGroupCvars();
+    if (!s_rStaticPromotePhysicalShadowGroup || !s_rStaticPromotePhysicalShadowGroup->integer)
+        return qfalse;
+    if (!dl || dl->staticPromoteFixtureId < 0 || dl->noDlightShadow)
+        return qfalse;
+    return R_DarkWolfShadowSourceIsPersistent(dl);
+}
+
+static qboolean R_DarkWolfStaticPromoteShadowCompanionEquivalent(const dlight_t *a, const dlight_t *b)
+{
+    vec3_t delta, colorDelta;
+    float mergeRadius, radiusDelta;
+    if (!R_DarkWolfStaticPromoteShadowGroupEligible(a) || !R_DarkWolfStaticPromoteShadowGroupEligible(b) ||
+        a->staticPromoteFixtureId == b->staticPromoteFixtureId)
+        return qfalse;
+    mergeRadius = Com_Clamp(0.0f, 64.0f, s_rStaticPromotePhysicalGroupMergeRadius->value);
+    if (mergeRadius <= 0.0f)
+        return qfalse;
+    VectorSubtract(a->origin, b->origin, delta);
+    if (DotProduct(delta, delta) > mergeRadius * mergeRadius)
+        return qfalse;
+    radiusDelta = fabs(a->radius - b->radius);
+    if (radiusDelta > 16.0f)
+        return qfalse;
+    VectorSubtract(a->color, b->color, colorDelta);
+    if (DotProduct(colorDelta, colorDelta) > 0.01f)
+        return qfalse;
+    return qtrue;
+}
+
+// Connected-component grouping makes the equivalence transitive and deterministic even if
+// three learned points form a short chain.  MAX_DLIGHTS is only 32, so this is tiny compared
+// with six-face cubemap rendering and avoids any map-specific identity assumptions.
+static int R_DarkWolfStaticPromoteShadowGroupCanonicalId(int startIndex)
+{
+    int queue[MAX_DLIGHTS], visited[MAX_DLIGHTS];
+    int head = 0, tail = 0, canonical, i;
+    if (startIndex < 0 || startIndex >= tr.refdef.num_dlights || startIndex >= MAX_DLIGHTS ||
+        !R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[startIndex]))
+        return -1;
+    R_DarkWolfEnsurePhysicalShadowGroupCvars();
+    if (!s_rStaticPromotePhysicalShadowGroup || !s_rStaticPromotePhysicalShadowGroup->integer)
+        return tr.refdef.dlights[startIndex].staticPromoteFixtureId;
+    Com_Memset(visited, 0, sizeof(visited));
+    visited[startIndex] = 1;
+    queue[tail++] = startIndex;
+    canonical = tr.refdef.dlights[startIndex].staticPromoteFixtureId;
+    while (head < tail)
+    {
+        int current = queue[head++];
+        const dlight_t *a = &tr.refdef.dlights[current];
+        if (a->staticPromoteFixtureId < canonical)
+            canonical = a->staticPromoteFixtureId;
+        for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+        {
+            if (visited[i])
+                continue;
+            if (R_DarkWolfStaticPromoteShadowCompanionEquivalent(a, &tr.refdef.dlights[i]))
+            {
+                visited[i] = 1;
+                queue[tail++] = i;
+            }
+        }
+    }
+    return canonical;
+}
+
+static qboolean R_DarkWolfStaticPromoteShadowSameGroup(int aIndex, int bIndex)
+{
+    int aId, bId;
+    if (aIndex < 0 || bIndex < 0)
+        return qfalse;
+    aId = R_DarkWolfStaticPromoteShadowGroupCanonicalId(aIndex);
+    bId = R_DarkWolfStaticPromoteShadowGroupCanonicalId(bIndex);
+    return (aId >= 0 && aId == bId) ? qtrue : qfalse;
+}
+
+static int R_DarkWolfStaticPromoteShadowGroupCanonicalIndex(int index)
+{
+    int canonical = R_DarkWolfStaticPromoteShadowGroupCanonicalId(index);
+    int i;
+    if (canonical < 0)
+        return index;
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+        if (R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[i]) &&
+            tr.refdef.dlights[i].staticPromoteFixtureId == canonical &&
+            R_DarkWolfStaticPromoteShadowGroupCanonicalId(i) == canonical)
+            return i;
+    return index;
+}
+
+static float R_DarkWolfStaticPromoteShadowGroupSelectionScore(int canonicalIndex, const refdef_t *fd)
+{
+    int canonical = R_DarkWolfStaticPromoteShadowGroupCanonicalId(canonicalIndex);
+    int i;
+    float best = -1.0f;
+    if (canonical < 0)
+        return R_DlightShadowSelectionScore(&tr.refdef.dlights[canonicalIndex], fd);
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+    {
+        if (!R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[i]) ||
+            R_DarkWolfStaticPromoteShadowGroupCanonicalId(i) != canonical)
+            continue;
+        {
+            float score = R_DlightShadowSelectionScore(&tr.refdef.dlights[i], fd);
+            // DARKWOLF_USLRD_ALWAYS_ON_DIRECT_SHADOW_CAPTURE_FIX_V1: all delivered fixtures compete on the existing physical distance/radius/luminance score.
+            // PVS/surface visibility no longer changes scarce shadow ownership.
+            if (score > best)
+                best = score;
+        }
+    }
+    return best;
+}
+
+static void R_DarkWolfStaticPromoteShadowGroupCaptureParams(int canonicalIndex, vec3_t captureOrigin,
+    float *captureRadius, int *memberCount)
+{
+    int canonical = R_DarkWolfStaticPromoteShadowGroupCanonicalId(canonicalIndex);
+    int i, count = 0;
+    vec3_t sum;
+    float radius = 0.0f;
+    VectorClear(sum);
+    if (canonical < 0)
+    {
+        VectorCopy(tr.refdef.dlights[canonicalIndex].origin, captureOrigin);
+        if (captureRadius) *captureRadius = tr.refdef.dlights[canonicalIndex].radius;
+        if (memberCount) *memberCount = 1;
+        return;
+    }
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+    {
+        if (!R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[i]) ||
+            R_DarkWolfStaticPromoteShadowGroupCanonicalId(i) != canonical)
+            continue;
+        VectorAdd(sum, tr.refdef.dlights[i].origin, sum);
+        ++count;
+    }
+    if (count <= 0)
+    {
+        VectorCopy(tr.refdef.dlights[canonicalIndex].origin, captureOrigin);
+        radius = tr.refdef.dlights[canonicalIndex].radius;
+        count = 1;
+    }
+    else
+    {
+        VectorScale(sum, 1.0f / (float)count, captureOrigin);
+        for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+        {
+            vec3_t delta;
+            float extent;
+            if (!R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[i]) ||
+                R_DarkWolfStaticPromoteShadowGroupCanonicalId(i) != canonical)
+                continue;
+            VectorSubtract(tr.refdef.dlights[i].origin, captureOrigin, delta);
+            extent = sqrtf(DotProduct(delta, delta)) + tr.refdef.dlights[i].radius;
+            if (extent > radius)
+                radius = extent;
+        }
+    }
+    if (captureRadius) *captureRadius = radius;
+    if (memberCount) *memberCount = count;
+}
+
+static unsigned int R_DarkWolfStaticPromoteShadowExpandPending(unsigned int mask)
+{
+    int i, j;
+    // DARKWOLF_USLRD_ALWAYS_ON_DIRECT_SHADOW_CAPTURE_FIX_V1: every delivered StaticPromote Direct light is immediately eligible for the
+    // scarce cubemap selector.  PVS no longer decides whether a Direct light may cast; the existing
+    // distance/radius/luminance score decides which three (or the user-selected budget) win.
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+    {
+        dlight_t *dl = &tr.refdef.dlights[i];
+        if (R_DarkWolfStaticPromoteShadowGroupEligible(dl))
+            mask |= 1u << i;
+    }
+    // If any member is eligible, expose the whole physical group so its deterministic canonical
+    // member can compete and all companions can later share one cubemap.
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+    {
+        if (!(mask & (1u << i)) || !R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[i]))
+            continue;
+        for (j = 0; j < tr.refdef.num_dlights && j < MAX_DLIGHTS; ++j)
+            if (R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[j]) &&
+                R_DarkWolfStaticPromoteShadowSameGroup(i, j))
+                mask |= 1u << j;
+    }
+    return mask;
+}
+
+static unsigned int R_DarkWolfStaticPromoteShadowClearGroup(unsigned int mask, int index)
+{
+    int i;
+    if (!R_DarkWolfStaticPromoteShadowGroupEligible(&tr.refdef.dlights[index]))
+        return mask & ~(1u << index);
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+        if ((mask & (1u << i)) && R_DarkWolfStaticPromoteShadowSameGroup(index, i))
+            mask &= ~(1u << i);
+    return mask;
+}
+
+
+// DARKWOLF_PERSISTENT_PHYSICAL_SHADOW_SET_RESIDENCY_RC_V0_2
+// Generic persistent-physical shadow residency.  This is deliberately
+// map/fixture agnostic: an already selected StaticPromote physical group
+// remains a resident shadow owner while the main camera is still inside
+// that group's physical capture radius plus the existing shadow hysteresis
+// margin.  Resident identities are consumed as a SET before any fresh
+// score challenger is admitted to the persistent budget.  This prevents
+// compact-slot rank migration from opening a false vacancy and admitting
+// an overlapping fourth lamp merely because camera-distance scores cross.
+// Direct-light delivery, radii/colors, grouping, shadow strength, budgets,
+// dynamic/Tesla/blast slots, materials and post-processing are untouched.
+static int R_DarkWolfPersistentPhysicalShadowResidentCandidate(
+    int stableGroupId, const vec3_t viewOrigin, unsigned int pendingLightsMask,
+    float *distanceOut, float *limitOut)
+{
+    int i;
+    int canonicalIndex = -1;
+    vec3_t captureOrigin, delta;
+    float captureRadius = 0.0f;
+    float hysteresis = r_dlightShadowHysteresis
+        ? Com_Clamp(0.0f, 0.5f, r_dlightShadowHysteresis->value) : 0.0f;
+    float residencyLimit;
+    float distance;
+
+    if (distanceOut) *distanceOut = -1.0f;
+    if (limitOut) *limitOut = -1.0f;
+    if (stableGroupId < 0)
+        return -1;
+
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+    {
+        dlight_t *candidate = &tr.refdef.dlights[i];
+        if (!(pendingLightsMask & (1u << i)))
+            continue;
+        if (!R_DarkWolfStaticPromoteShadowGroupEligible(candidate))
+            continue;
+        if (R_DarkWolfStaticPromoteShadowGroupCanonicalIndex(i) != i)
+            continue;
+        if (R_DarkWolfStaticPromoteShadowGroupCanonicalId(i) != stableGroupId)
+            continue;
+        canonicalIndex = i;
+        break;
+    }
+
+    if (canonicalIndex < 0)
+        return -1;
+
+    R_DarkWolfStaticPromoteShadowGroupCaptureParams(
+        canonicalIndex, captureOrigin, &captureRadius, NULL);
+    if (captureRadius <= 0.0f)
+        return -1;
+
+    residencyLimit = captureRadius * (1.0f + hysteresis);
+    VectorSubtract(captureOrigin, viewOrigin, delta);
+    distance = sqrtf(DotProduct(delta, delta));
+    if (distanceOut) *distanceOut = distance;
+    if (limitOut) *limitOut = residencyLimit;
+
+    return distance <= residencyLimit ? canonicalIndex : -1;
+}
+
+// On-demand validation snapshot inherited from RC v0.1.  No continuous
+// telemetry is enabled; this only records state when the command is used.
+static qboolean s_dlightShadowSnapshotViewValid = qfalse;
+static vec3_t s_dlightShadowSnapshotViewOrigin;
+static int s_dlightShadowSnapshotViewTime = 0;
+
+void R_RenderDlightCubemaps(const refdef_t *fd)
+{
+	static qboolean historyInitialized = qfalse;
+	static int historyLight[MAX_DLIGHT_SHADOWS];
+	static int historyNativeOrdinal[MAX_DLIGHT_SHADOWS];
+	static int historyStaticPromoteGroupId[MAX_DLIGHT_SHADOWS]; // DARKWOLF_USLRD_PHYSICAL_SHADOW_GROUP_CONTINUITY_FIX_V2
+	static int historyHold[MAX_DLIGHT_SHADOWS];
+	static vec3_t historyOrigin[MAX_DLIGHT_SHADOWS];
+	static float historyRadius[MAX_DLIGHT_SHADOWS];
+	static char historyMap[MAX_QPATH] = "";
+	// REND2_DLIGHT_MATERIAL_LOCK_DIAG_V8_6_5: track one real dlight source across index churn/pulses.
+	// REND2_DLIGHT_ROBUST_PROBE_FROZEN_RES_V8_6_6: live identity tracking + immutable render snapshot.
+	static qboolean testLockValid = qfalse;
+	static vec3_t testLockMatchOrigin;
+	static vec3_t testLockMatchColor;
+	static float testLockMatchRadius = 0.0f;
+	static vec3_t testLockFrozenOrigin;
+	static vec3_t testLockFrozenColor;
+	static float testLockFrozenRadius = 0.0f;
+	static int testLockOverdraw = 0;
+	unsigned int allLightsMask;
+	unsigned int visibleLightsMask;
+	unsigned int pendingLightsMask;
+	unsigned int savedDlightMask;
+	int maxShadowLights;
+	int renderedLights = 0;
+	int historyInitIndex;
+	int persistentShadowBudget = 0;
+	int dynamicShadowBudget = 0; // DARKWOLF_STAGE11_UNIFIED_ASSET_SHADOW_COVERAGE_CLEAN_PRODUCTION_V1: fixed accepted transient reserve = 2.
+
+	// DARKWOLF_PERSISTENT_PHYSICAL_SHADOW_SET_RESIDENCY_RC_V0_2
+	// Cache the exact selector camera for the on-demand snapshot only.
+	if (fd)
+	{
+		VectorCopy(fd->vieworg, s_dlightShadowSnapshotViewOrigin);
+		s_dlightShadowSnapshotViewTime = fd->time;
+		s_dlightShadowSnapshotViewValid = qtrue;
+	}
+
+	{
+		const char *historyMapName = tr.world ? tr.world->baseName : "<none>";
+		if (!historyInitialized || Q_stricmp(historyMap, historyMapName))
+		{
+			for (historyInitIndex = 0; historyInitIndex < MAX_DLIGHT_SHADOWS; historyInitIndex++)
+			{
+				historyLight[historyInitIndex] = -1;
+				historyNativeOrdinal[historyInitIndex] = -1;
+				historyStaticPromoteGroupId[historyInitIndex] = -1;
+				historyHold[historyInitIndex] = 0;
+				VectorClear(historyOrigin[historyInitIndex]);
+				historyRadius[historyInitIndex] = 0.0f;
+			}
+			Q_strncpyz(historyMap, historyMapName, sizeof(historyMap));
+			historyInitialized = qtrue;
+		}
+	}
+
+	if (!r_dlightShadowTestLock || !r_dlightShadowTestLock->integer)
+	{
+		testLockValid = qfalse;
+		dlightMaterialDiagLockValid = 0;
+		dlightMaterialDiagLockCurrentIndex = -1;
+		dlightMaterialDiagLockRadius = 0.0f;
+		VectorClear(dlightMaterialDiagLockOrigin);
+		VectorClear(dlightMaterialDiagLockColor);
+	}
+	else
+	{
+		dlightMaterialDiagLockValid = testLockValid ? 1 : 0;
+		dlightMaterialDiagLockCurrentIndex = -1;
+	}
+
+	tr.refdef.dlightShadowMask = 0;
+	Com_Memset(tr.refdef.dlightShadowSlot, -1, sizeof(tr.refdef.dlightShadowSlot));
+	Com_Memset(tr.refdef.dlightShadowCaptureOrigin, 0, sizeof(tr.refdef.dlightShadowCaptureOrigin));
+	Com_Memset(tr.refdef.dlightShadowCaptureRadius, 0, sizeof(tr.refdef.dlightShadowCaptureRadius));
+	Com_Memset(tr.refdef.dlightShadowGroupId, -1, sizeof(tr.refdef.dlightShadowGroupId));
+	tr.refdef.dlightDiagSelectedIndex = -1;
+	tr.refdef.dlightDiagSelectedSlot = -1;
+	tr.refdef.dlightDiagFacesIssued = 0;
