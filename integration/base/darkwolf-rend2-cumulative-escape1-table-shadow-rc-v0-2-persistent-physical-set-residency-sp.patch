+// DARKWOLF_PCRB_V0_4_PHYSICAL_FIXTURE_MULTIPOINT_VISIBILITY_OCCLUDER_LOCALIZATION
+// Publish exact renderer-owned PLR fixture centers to the diagnostic CGAME observer.
+// This function cannot alter selection, LOS, hold timers, residency, or scene lights.
+static qboolean R_DarkWolfPCRBV04ExpectedTarget(const char *mapName, int fixtureOrdinal,
+	int *runtimeIdOut, int *mapCodeOut, const char **roleOut)
+{
+	int runtimeId = -1;
+	int mapCode = 0;
+	const char *role = NULL;
+	if ( mapName && !Q_stricmp(mapName, "factory") )
+	{
+		mapCode = 1;
+		if (fixtureOrdinal == 300) { runtimeId = 352; role = "PROBLEM_FACTORY"; }
+		else if (fixtureOrdinal == 110) { runtimeId = 342; role = "POSITIVE_FACTORY"; }
+	}
+	else if ( mapName && !Q_stricmp(mapName, "escape1") )
+	{
+		mapCode = 2;
+		if (fixtureOrdinal == 918) { runtimeId = 628; role = "PROBLEM_ESCAPE1"; }
+		else if (fixtureOrdinal == 782) { runtimeId = 609; role = "POSITIVE_ESCAPE1"; }
+	}
+	if (runtimeId < 0)
+		return qfalse;
+	if (runtimeIdOut) *runtimeIdOut = runtimeId;
+	if (mapCodeOut) *mapCodeOut = mapCode;
+	if (roleOut) *roleOut = role;
+	return qtrue;
+}
+
+static void R_DarkWolfPCRBV04PublishFixture(const staticPromotePersistentLight_t *light,
+	qboolean influencePVSVisible, qboolean physicalVisible, qboolean heldResident,
+	qboolean coronaPresent, int coronaFlags)
+{
+	static char s_lastState[4][256];
+	static int s_lastPrint[4];
+	static unsigned int s_lastSig[4];
+	static qboolean s_startupPrinted = qfalse;
+	const staticPromotePLRMarker_t *bspCorona;
+	const char *mapName;
+	const char *role;
+	char cvarName[64];
+	char state[256];
+	int expectedRuntimeId;
+	int mapCode;
+	int slot;
+	int matchedRuntimeId;
+	int acceptedCount;
+	int spatialCount;
+	int nearestRuntimeId;
+	float nearestDist;
+	float nearestColor;
+	float nearestScale;
+	qboolean valid;
+	int now;
+	unsigned int sig;
+
+	if (!light || !tr.world ||
+		!0)
+		return;
+	mapName = tr.world->baseName;
+	if (!R_DarkWolfPCRBV04ExpectedTarget(mapName, light->candidate.entityOrdinal,
+		&expectedRuntimeId, &mapCode, &role))
+		return;
+	slot = (expectedRuntimeId == 352) ? 0 : (expectedRuntimeId == 342) ? 1 :
+		(expectedRuntimeId == 628) ? 2 : 3;
+	bspCorona = R_DarkWolfPCRBFindBspCorona(light->physicalCoronaOrdinal);
+	acceptedCount = 0;
+	spatialCount = 0;
+	nearestRuntimeId = -1;
+	nearestDist = 1.0e30f;
+	nearestColor = 1.0e30f;
+	nearestScale = 1.0e30f;
+	matchedRuntimeId = bspCorona ? R_DarkWolfPCRBSpatialMatchRuntimeCorona(bspCorona,
+		&acceptedCount, &spatialCount, &nearestRuntimeId,
+		&nearestDist, &nearestColor, &nearestScale) : -1;
+	valid = (bspCorona && matchedRuntimeId == expectedRuntimeId && acceptedCount == 1) ? qtrue : qfalse;
+	Com_sprintf(cvarName, sizeof(cvarName), "dw_pcrbV04Fixture%d", expectedRuntimeId);
+	Com_sprintf(state, sizeof(state),
+		"%d %d %d %d %.3f %.3f %.3f %.3f %.3f %.3f %d %d %d %d %d %.3f",
+		mapCode, expectedRuntimeId, light->candidate.entityOrdinal, valid ? 1 : 0,
+		light->candidate.origin[0], light->candidate.origin[1], light->candidate.origin[2],
+		bspCorona ? bspCorona->origin[0] : 0.0f,
+		bspCorona ? bspCorona->origin[1] : 0.0f,
+		bspCorona ? bspCorona->origin[2] : 0.0f,
+		influencePVSVisible ? 1 : 0, physicalVisible ? 1 : 0, heldResident ? 1 : 0,
+		coronaPresent ? 1 : 0, (coronaFlags & 1) ? 1 : 0,
+		light->physicalAssociationScore);
+	if (Q_stricmp(s_lastState[slot], state))
+	{
+		Q_strncpyz(s_lastState[slot], state, sizeof(s_lastState[slot]));
+		ri.Cvar_Set(cvarName, state);
+	}
+	if (!s_startupPrinted)
+	{
+		s_startupPrinted = qtrue;
+		ri.Printf(PRINT_ALL,
+			"SPR_LOS04_REND_STARTUP enabled=1 valid=1 transport=renderer_cvar functionalDecisionChanged=0\n");
+	}
+	now = ri.Milliseconds();
+	sig = (unsigned int)(valid ? 1 : 0);
+	sig = sig * 33u + (unsigned int)(influencePVSVisible ? 1 : 0);
+	sig = sig * 33u + (unsigned int)(physicalVisible ? 1 : 0);
+	sig = sig * 33u + (unsigned int)(heldResident ? 1 : 0);
+	sig = sig * 33u + (unsigned int)(coronaFlags + 1);
+	if (s_lastPrint[slot] == 0 || now < s_lastPrint[slot] || now - s_lastPrint[slot] >= 1000 ||
+		s_lastSig[slot] != sig)
+	{
+		s_lastPrint[slot] = now;
+		s_lastSig[slot] = sig;
+		ri.Printf(PRINT_ALL,
+			"SPR_LOS04_FIXTURE map=%s role=%s runtimeId=%d fixture=%d valid=%d matchedRuntimeId=%d acceptedCandidates=%d spatialCandidates=%d lightCenter=%.3f,%.3f,%.3f corona=%.3f,%.3f,%.3f centerCoronaDelta=%.3f associationScore=%.3f influencePVSVisible=%d physicalVisible=%d held=%d coronaPresent=%d coronaLOS=%d\n",
+			mapName, role, expectedRuntimeId, light->candidate.entityOrdinal, valid ? 1 : 0,
+			matchedRuntimeId, acceptedCount, spatialCount,
+			light->candidate.origin[0], light->candidate.origin[1], light->candidate.origin[2],
+			bspCorona ? bspCorona->origin[0] : 0.0f,
+			bspCorona ? bspCorona->origin[1] : 0.0f,
+			bspCorona ? bspCorona->origin[2] : 0.0f,
+			bspCorona ? Distance(light->candidate.origin, bspCorona->origin) : -1.0f,
+			light->physicalAssociationScore, influencePVSVisible ? 1 : 0,
+			physicalVisible ? 1 : 0, heldResident ? 1 : 0,
+			coronaPresent ? 1 : 0, (coronaFlags & 1) ? 1 : 0);
+	}
+}
+
+static qboolean R_StaticPromotePhysicalCoronaVisible(const staticPromotePersistentLight_t *light,
+	qboolean *presentOut, int *flagsOut)
+{
+	int i;
+	int bspOrdinal;
+	int matchedRuntimeId = -1;
+	int nearestRuntimeId = -1;
+	int acceptedCount = 0;
+	int spatialCount = 0;
+	int flags = 0;
+	int visualFlags = 0;
+	float nearestDist = 1.0e30f;
+	float nearestColor = 1.0e30f;
+	float nearestScale = 1.0e30f;
+	qboolean bridgeOn;
+	qboolean bindDiag;
+	qboolean visualPresent = qfalse;
+	qboolean visualLOS = qfalse;
+	qboolean spatialPresent = qfalse;
+	qboolean spatialLOS = qfalse;
+	qboolean physicalVisible = qfalse;
+	const staticPromotePLRMarker_t *bspCorona;
+
+	if (presentOut) *presentOut = qfalse;
+	if (flagsOut) *flagsOut = 0;
+	if (!light || !light->physicalRecognitionAccepted ||
+		light->physicalSourceRoute != PLR_V01_SOURCE_PROMOTED ||
+		light->physicalCoronaOrdinal < 0)
+		return qfalse;
+
+	bspOrdinal = light->physicalCoronaOrdinal;
+	bridgeOn = qtrue;
+	bindDiag = qfalse;
+	bspCorona = R_DarkWolfPCRBFindBspCorona(bspOrdinal);
+
+	// Build the runtime-to-BSP identity relation strictly from physical metadata.
+	// Never compare runtime entity id with BSP entity ordinal.
+	if (bspCorona)
+	{
+		matchedRuntimeId = R_DarkWolfPCRBSpatialMatchRuntimeCorona(bspCorona,
+			&acceptedCount, &spatialCount, &nearestRuntimeId,
+			&nearestDist, &nearestColor, &nearestScale);
+		if (matchedRuntimeId >= 0)
+		{
+			const corona_t *meta = &s_darkWolfCoronaResidencyMeta[matchedRuntimeId];
+			spatialPresent = qtrue;
+			spatialLOS = (meta->flags & DARKWOLF_REF_CORONA_RESIDENCY_LOS) ? qtrue : qfalse;
+			flags = meta->flags;
+			flags &= ~1;
+			if (spatialLOS)
+				flags |= 1;
+		}
+	}
+
+	// Exact PCRB v0.1 / pre-v0.2 control path. It remains functional only when
+	// bridge mode is OFF. The direct id comparison is retained here solely so the
+	// baseline is byte-semantically equivalent to the parent behavior.
+	if (!bridgeOn || bindDiag)
+	{
+		for (i = r_firstSceneCorona; i < r_numcoronas; ++i)
+		{
+			const corona_t *cor = &backEndData->coronas[i];
+			if (cor->id != bspOrdinal)
+				continue;
+			visualPresent = qtrue;
+			visualFlags |= cor->flags;
+			if (cor->flags & 1)
+				visualLOS = qtrue;
+		}
+	}
+
+	if (bridgeOn)
+	{
+		// No fallback to a guessed visual/runtime id when spatial binding is absent
+		// or ambiguous. Normal PVS/hold residency outside this function remains intact.
+		physicalVisible = spatialPresent && spatialLOS;
+	}
+	else
+	{
+		physicalVisible = visualLOS;
+		flags = visualFlags;
+	}
+
+	if (bindDiag)
+	{
+		int slot = (int)(light - s_staticPromotePersistentLights);
+		if (slot >= 0 && slot < STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES)
+		{
+			static int s_lastBindPrint[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+			static unsigned int s_lastBindSig[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+			int now = ri.Milliseconds();
+			unsigned int sig = (unsigned int)(bridgeOn ? 1 : 0);
+			sig = sig * 33u + (unsigned int)(matchedRuntimeId + 2);
+			sig = sig * 33u + (unsigned int)(acceptedCount + 1);
+			sig = sig * 33u + (unsigned int)(spatialCount + 1);
+			sig = sig * 33u + (unsigned int)(spatialLOS ? 1 : 0);
+			sig = sig * 33u + (unsigned int)(physicalVisible ? 1 : 0);
+			if (s_lastBindSig[slot] != sig || s_lastBindPrint[slot] == 0 ||
+				now < s_lastBindPrint[slot] || now - s_lastBindPrint[slot] >= 5000)
+			{
+				s_lastBindSig[slot] = sig;
+				s_lastBindPrint[slot] = now;
+				if (bspCorona)
+				{
+					ri.Printf(PRINT_ALL,
+						"SPR_BIND_REND map=%s mode=%d fixture=%d bspCoronaOrdinal=%d bspOrigin=%.3f,%.3f,%.3f bspColor=%.4f,%.4f,%.4f bspScale=%.4f matchedRuntimeId=%d nearestRuntimeId=%d distance=%.4f colorDelta=%.5f scaleDelta=%.5f spatialCandidates=%d acceptedCandidates=%d unambiguous=%d LOS=%d physicalVisible=%d visualPresent=%d visualLOS=%d metaCount=%d\n",
+						tr.world ? tr.world->baseName : "<none>", bridgeOn ? 1 : 0,
+						light->candidate.entityOrdinal, bspOrdinal,
+						bspCorona->origin[0], bspCorona->origin[1], bspCorona->origin[2],
+						bspCorona->color[0], bspCorona->color[1], bspCorona->color[2], bspCorona->scale,
+						matchedRuntimeId, nearestRuntimeId, nearestDist, nearestColor, nearestScale,
+						spatialCount, acceptedCount, acceptedCount == 1 ? 1 : 0,
+						spatialLOS ? 1 : 0, physicalVisible ? 1 : 0,
+						visualPresent ? 1 : 0, visualLOS ? 1 : 0, s_darkWolfCoronaResidencyMetaCount);
+				}
+				else
+				{
+					ri.Printf(PRINT_ALL,
+						"SPR_BIND_REND map=%s mode=%d fixture=%d bspCoronaOrdinal=%d bspFound=0 matchedRuntimeId=-1 unambiguous=0 LOS=0 physicalVisible=%d metaCount=%d\n",
+						tr.world ? tr.world->baseName : "<none>", bridgeOn ? 1 : 0,
+						light->candidate.entityOrdinal, bspOrdinal, physicalVisible ? 1 : 0,
+						s_darkWolfCoronaResidencyMetaCount);
+				}
+			}
+		}
+	}
+
+	if (presentOut) *presentOut = bridgeOn ? spatialPresent : visualPresent;
+	if (flagsOut) *flagsOut = flags;
+	return physicalVisible;
+}
