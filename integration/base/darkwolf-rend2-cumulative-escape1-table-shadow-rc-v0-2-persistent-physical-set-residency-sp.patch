+static void R_DarkWolfNativeShadowTrace(const refdef_t *fd, unsigned int visibleLightsMask, int maxShadowLights)
+{
+	static int lastPrintMs[9];
+	static int lastSelected[9] = { -2,-2,-2,-2,-2,-2,-2,-2,-2 };
+	int i;
+	int nowMs;
+	if (!fd || !0)
+		return;
+	nowMs = ri.Milliseconds();
+	for (i = 0; i < tr.refdef.num_dlights; ++i)
+	{
+		dlight_t *dl = &tr.refdef.dlights[i];
+		int watch;
+		int slot;
+		int cube = 0;
+		int selected;
+		if (!dl->nativeAuthoredDlight)
+			continue;
+		watch = R_DarkWolfNativeShadowWatchSlot(dl->origin);
+		if (!0 && watch < 0)
+			continue;
+		slot = (i >= 0 && i < MAX_DLIGHTS) ? tr.refdef.dlightShadowSlot[i] : -1;
+		selected = slot >= 0 ? 1 : 0;
+		if (slot >= 0 && slot < MAX_DLIGHT_SHADOWS && tr.shadowCubemaps[slot])
+			cube = tr.shadowCubemaps[slot]->width;
+		if (watch >= 0 && lastSelected[watch] == selected && lastPrintMs[watch] != 0 && nowMs - lastPrintMs[watch] < 500)
+			continue;
+		if (watch >= 0) { lastSelected[watch] = selected; lastPrintMs[watch] = nowMs; }
+		ri.Printf(PRINT_ALL, "PLR_NATIVE_SHADOW frame=%d time=%d watch=%d lightIndex=%d visiblePrev=%d selected=%d slot=%d faces=%d cube=%d radius=%.2f score=%.5f budget=%d sceneDlights=%d origin=%.1f,%.1f,%.1f color=%.3f,%.3f,%.3f\\n",
+			tr.frameCount, fd->time, watch, i, (visibleLightsMask & (1u << i)) ? 1 : 0, selected, slot, selected ? 6 : 0, cube,
+			dl->radius, R_DlightShadowSelectionScore(dl, fd), maxShadowLights, tr.refdef.num_dlights,
+			dl->origin[0], dl->origin[1], dl->origin[2], dl->color[0], dl->color[1], dl->color[2]);
+	}
+}
