+static qboolean R_DlightMaterialRayTriangle(const vec3_t rayOrigin, const vec3_t rayDir,
+	const vec3_t v0, const vec3_t v1, const vec3_t v2, float *outT)
+{
+	vec3_t e1, e2, p, tvec, q;
+	float det, invDet, u, v, t;
+	VectorSubtract(v1, v0, e1);
+	VectorSubtract(v2, v0, e2);
+	CrossProduct(rayDir, e2, p);
+	det = DotProduct(e1, p);
+	if (fabs(det) < 0.000001f)
+		return qfalse;
+	invDet = 1.0f / det;
+	VectorSubtract(rayOrigin, v0, tvec);
+	u = DotProduct(tvec, p) * invDet;
+	if (u < 0.0f || u > 1.0f)
+		return qfalse;
+	CrossProduct(tvec, e1, q);
+	v = DotProduct(rayDir, q) * invDet;
+	if (v < 0.0f || u + v > 1.0f)
+		return qfalse;
+	t = DotProduct(e2, q) * invDet;
+	if (t <= 0.001f)
+		return qfalse;
+	*outT = t;
+	return qtrue;
+}
+
+static qboolean R_DlightMaterialLocalRay(int entityNum, vec3_t localOrigin, vec3_t localDir)
+{
+	int axisIndex;
+	vec3_t delta;
+	trRefEntity_t *ent;
+	if (entityNum == REFENTITYNUM_WORLD)
+	{
+		VectorCopy(tr.viewParms.or.origin, localOrigin);
+		VectorCopy(tr.viewParms.or.axis[0], localDir);
+		return qtrue;
+	}
+	if (entityNum < 0 || entityNum >= tr.refdef.num_entities)
+		return qfalse;
+	ent = &tr.refdef.entities[entityNum];
+	VectorSubtract(tr.viewParms.or.origin, ent->e.origin, delta);
+	for (axisIndex = 0; axisIndex < 3; axisIndex++)
+	{
+		float axisLengthSquared = DotProduct(ent->e.axis[axisIndex], ent->e.axis[axisIndex]);
+		if (axisLengthSquared < 0.000001f)
+			return qfalse;
+		localOrigin[axisIndex] = DotProduct(delta, ent->e.axis[axisIndex]) / axisLengthSquared;
+		localDir[axisIndex] = DotProduct(tr.viewParms.or.axis[0], ent->e.axis[axisIndex]) / axisLengthSquared;
+	}
+	return VectorNormalize(localDir) > 0.000001f ? qtrue : qfalse;
+}
+
+static void R_DlightMaterialLocalToWorld(int entityNum, const vec3_t localPoint, vec3_t worldPoint)
+{
+	trRefEntity_t *ent;
+	if (entityNum == REFENTITYNUM_WORLD)
+	{
+		VectorCopy(localPoint, worldPoint);
+		return;
+	}
+	ent = &tr.refdef.entities[entityNum];
+	VectorCopy(ent->e.origin, worldPoint);
+	VectorMA(worldPoint, localPoint[0], ent->e.axis[0], worldPoint);
+	VectorMA(worldPoint, localPoint[1], ent->e.axis[1], worldPoint);
+	VectorMA(worldPoint, localPoint[2], ent->e.axis[2], worldPoint);
+}
