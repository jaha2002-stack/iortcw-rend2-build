+static void RB_DlightDiagnosticOverlay(FBO_t *dstFbo)
+{
+	static int lastPrintTime = -100000;
+	const vec4_t panel = {0.0f, 0.0f, 0.0f, 0.72f};
+	const vec4_t cyan = {0.05f, 0.90f, 1.0f, 1.0f};
+	const vec4_t magenta = {1.0f, 0.05f, 0.78f, 1.0f};
+	const vec4_t yellow = {1.0f, 0.85f, 0.05f, 1.0f};
+	const vec4_t green = {0.10f, 1.0f, 0.20f, 1.0f};
+	const vec4_t orange = {1.0f, 0.42f, 0.05f, 1.0f};
+	const vec4_t purple = {0.72f, 0.25f, 1.0f, 1.0f};
+	const vec4_t blue = {0.10f, 0.35f, 1.0f, 1.0f};
+	const vec4_t red = {1.0f, 0.05f, 0.05f, 1.0f};
+	const vec4_t white = {1.0f, 1.0f, 1.0f, 1.0f};
+	int selected = backEnd.refdef.dlightDiagSelectedIndex;
+	int slot = backEnd.refdef.dlightDiagSelectedSlot;
+	int depthSlot = r_dlightDiagDepthSlot->integer >= 0 ? r_dlightDiagDepthSlot->integer : slot;
+	int active = backEnd.refdef.num_dlights;
+	int sampled = backEnd.dlightDiagShadowLightallDraws;
+	int captured = backEnd.dlightDiagCaptureTime == backEnd.refdef.time
+		? backEnd.dlightDiagFacesCaptured : 0;
+	int injected = backEnd.refdef.dlightDiagInjectedIndex;
+	int rowY;
+
+	if (!r_dlightDiagOverlay->integer && !r_dlightDiagDepth->integer)
+		return;
+
+	if (r_dlightDiagOverlay->integer)
+	{
+		RB_DlightDiagRect(dstFbo, 12, 12, 92, 168, panel);
+		if (s_dlightDiagAutoStage >= 0)
+		{
+			RB_DlightDiagRect(dstFbo, 112, 12, 70, 42, panel);
+			RB_DlightDiagNumber(dstFbo, 122, 20, s_dlightDiagAutoStage + 7, 2, 3, white);
+		}
+
+		rowY = 20;
+		RB_DlightDiagRect(dstFbo, 20, rowY + 6, 10, 10, cyan);
+		RB_DlightDiagNumber(dstFbo, 40, rowY, active > 99 ? 99 : active, 2, 2, cyan);
+
+		rowY += 26;
+		RB_DlightDiagRect(dstFbo, 20, rowY + 6, 10, 10, magenta);
+		RB_DlightDiagNumber(dstFbo, 40, rowY, selected >= 0 ? selected + 1 : 0, 2, 2, magenta);
+
+		rowY += 26;
+		RB_DlightDiagRect(dstFbo, 20, rowY + 6, 10, 10, yellow);
+		RB_DlightDiagNumber(dstFbo, 40, rowY, slot >= 0 ? slot + 1 : 0, 1, 2, yellow);
+
+		rowY += 26;
+		RB_DlightDiagRect(dstFbo, 20, rowY + 6, 10, 10, green);
+		RB_DlightDiagNumber(dstFbo, 40, rowY, backEnd.refdef.dlightDiagFacesIssued > 9 ? 9 : backEnd.refdef.dlightDiagFacesIssued, 1, 2, green);
+
+		rowY += 26;
+		RB_DlightDiagRect(dstFbo, 20, rowY + 6, 10, 10, orange);
+		RB_DlightDiagNumber(dstFbo, 40, rowY, captured > 9 ? 9 : captured, 1, 2, orange);
+
+		rowY += 26;
+		RB_DlightDiagRect(dstFbo, 20, rowY + 6, 10, 10, purple);
+		RB_DlightDiagNumber(dstFbo, 40, rowY, sampled > 99 ? 99 : sampled, 2, 2, purple);
+
+		// Full-screen stage border: red=no source, yellow=no slot,
+		// orange=incomplete six-face execution, blue=no lightall sampling,
+		// magenta=the complete path reached a shadow-enabled lightall draw.
+		if (injected < 0)
+		{
+			RB_DlightDiagRect(dstFbo, 0, 0, glConfig.vidWidth, 4, red);
+			RB_DlightDiagRect(dstFbo, 0, glConfig.vidHeight - 4, glConfig.vidWidth, 4, red);
+		}
+		else if (selected < 0 || slot < 0)
+		{
+			RB_DlightDiagRect(dstFbo, 0, 0, glConfig.vidWidth, 4, yellow);
+			RB_DlightDiagRect(dstFbo, 0, glConfig.vidHeight - 4, glConfig.vidWidth, 4, yellow);
+		}
+		else if (backEnd.refdef.dlightDiagFacesIssued != 6 || captured != 6)
+		{
+			RB_DlightDiagRect(dstFbo, 0, 0, glConfig.vidWidth, 4, orange);
+			RB_DlightDiagRect(dstFbo, 0, glConfig.vidHeight - 4, glConfig.vidWidth, 4, orange);
+		}
+		else if (sampled <= 0)
+		{
+			RB_DlightDiagRect(dstFbo, 0, 0, glConfig.vidWidth, 4, blue);
+			RB_DlightDiagRect(dstFbo, 0, glConfig.vidHeight - 4, glConfig.vidWidth, 4, blue);
+		}
+		else
+		{
+			RB_DlightDiagRect(dstFbo, 0, 0, glConfig.vidWidth, 4, magenta);
+			RB_DlightDiagRect(dstFbo, 0, glConfig.vidHeight - 4, glConfig.vidWidth, 4, magenta);
+		}
+	}
+
+	if (r_dlightDiagDepth->integer)
+	{
+		if (depthSlot >= 0 && depthSlot < MAX_DLIGHT_SHADOWS && tr.shadowCubemaps[depthSlot])
+		{
+			RB_DlightDiagDrawCubeFaces(dstFbo, tr.shadowCubemaps[depthSlot], r_dlightDiagDepthMode->integer);
+		}
+		else
+		{
+			int i;
+			int width = dstFbo ? dstFbo->width : glConfig.vidWidth;
+			int originX = width - (3 * 92 + 2 * 4) - 16;
+			for (i = 0; i < 6; i++)
+			{
+				int x = originX + (i % 3) * 96;
+				int y = 16 + (i / 3) * 96;
+				RB_DlightDiagRect(dstFbo, x, y, 92, 92, red);
+			}
+		}
+	}
+
+	RB_DlightDiagAutoCaptureStep();
+
+	if (backEnd.refdef.time - lastPrintTime >= 1000)
+	{
+		lastPrintTime = backEnd.refdef.time;
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_DIAG active=%d injected=%d selected=%d slot=%d facesIssued=%d facesCaptured=%d lightallShadowDraws=%d depthSlot=%d shadowView=%d\n",
+			active, injected, selected, slot, backEnd.refdef.dlightDiagFacesIssued, captured,
+			sampled, depthSlot, r_dlightDiagShadowView->integer);
+	}
+}
