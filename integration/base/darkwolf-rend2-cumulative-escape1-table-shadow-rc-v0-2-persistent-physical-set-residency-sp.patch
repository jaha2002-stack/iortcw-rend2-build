+void R_RenderFireVolumetricSyntheticShadows(const refdef_t *fd)
+{
+	static char lastMap[MAX_QPATH] = {0};
+	viewParms_t shadowParms;
+	qboolean activeCache[FIREVOL_SYNTH_SHADOW_CACHE_MAX];
+	int hintIndex, cacheIndex, captureHint = -1, captureSlot = -1, side;
+	int oldestTime = 0x7fffffff;
+	if (!fd || !tr.world || !tr.fireVolumetricSyntheticShadowFbo) return;
+	if (Q_stricmp(lastMap, tr.world->baseName))
+	{
+		Com_Memset(tr.fireVolumetricSyntheticShadowCache, 0, sizeof(tr.fireVolumetricSyntheticShadowCache));
+		Q_strncpyz(lastMap, tr.world->baseName, sizeof(lastMap));
+	}
+	Com_Memset(activeCache, 0, sizeof(activeCache));
+	for (hintIndex = 0; hintIndex < tr.fireVolumetricSyntheticShadowHintCount && hintIndex < FIREVOL_SYNTH_SHADOW_CACHE_MAX; ++hintIndex)
+	{
+		fireVolumetricSyntheticShadowHint_t *hint = &tr.fireVolumetricSyntheticShadowHints[hintIndex];
+		qboolean matched = qfalse;
+		if (!hint->valid || fd->time - hint->stampTime < 0 || fd->time - hint->stampTime > 2000) continue;
+		for (cacheIndex = 0; cacheIndex < FIREVOL_SYNTH_SHADOW_CACHE_MAX; ++cacheIndex)
+		{
+			if (R_FireVolProductionCacheMatchesHint(&tr.fireVolumetricSyntheticShadowCache[cacheIndex], hint))
+			{
+				activeCache[cacheIndex] = qtrue;
+				tr.fireVolumetricSyntheticShadowCache[cacheIndex].lastUsedTime = fd->time;
+				matched = qtrue;
+				break;
+			}
+		}
+		if (!matched && captureHint < 0) captureHint = hintIndex;
+	}
+	if (captureHint < 0) return;
+	for (cacheIndex = 0; cacheIndex < FIREVOL_SYNTH_SHADOW_CACHE_MAX; ++cacheIndex)
+	{
+		if (!tr.fireVolumetricSyntheticShadowCache[cacheIndex].valid) { captureSlot = cacheIndex; break; }
+	}
+	if (captureSlot < 0)
+	{
+		for (cacheIndex = 0; cacheIndex < FIREVOL_SYNTH_SHADOW_CACHE_MAX; ++cacheIndex)
+		{
+			if (activeCache[cacheIndex]) continue;
+			if (tr.fireVolumetricSyntheticShadowCache[cacheIndex].lastUsedTime < oldestTime)
+			{
+				oldestTime = tr.fireVolumetricSyntheticShadowCache[cacheIndex].lastUsedTime;
+				captureSlot = cacheIndex;
+			}
+		}
+	}
+	if (captureSlot < 0) return;
+	{
+		fireVolumetricSyntheticShadowHint_t *hint = &tr.fireVolumetricSyntheticShadowHints[captureHint];
+		fireVolumetricSyntheticShadowCache_t *cache = &tr.fireVolumetricSyntheticShadowCache[captureSlot];
+		Com_Memset(&shadowParms, 0, sizeof(shadowParms));
+		shadowParms.viewportX = 0;
+		shadowParms.viewportY = 0;
+		shadowParms.viewportWidth = FIREVOL_SYNTH_SHADOW_SIZE;
+		shadowParms.viewportHeight = FIREVOL_SYNTH_SHADOW_SIZE;
+		shadowParms.targetFbo = tr.fireVolumetricSyntheticShadowFbo;
+		shadowParms.isPortal = qfalse;
+		shadowParms.isMirror = qtrue;
+		shadowParms.fovX = 90;
+		shadowParms.fovY = 90;
+		shadowParms.flags = VPF_SHADOWMAP | VPF_DEPTHSHADOW | VPF_NOVIEWMODEL | VPF_FIREVOL_SYNTHETIC_SHADOW;
+		shadowParms.zFar = Com_Clamp(64.0f, 1024.0f, hint->sampleRadius);
+		VectorCopy(hint->flameOrigin, shadowParms.or.origin);
+		for (side = 0; side < 6; ++side)
+		{
+			R_FireVolProductionSetCubeAxis(&shadowParms, side);
+			R_RenderView(&shadowParms);
+			R_AddCapShadowmapCmd(FIREVOL_SYNTH_SHADOW_MAP_BASE + captureSlot, side);
+		}
+		cache->valid = qtrue;
+		cache->flameSurface = hint->flameSurface;
+		cache->captureTime = fd->time;
+		cache->lastUsedTime = fd->time;
+		VectorCopy(hint->flameOrigin, cache->captureOrigin);
+		cache->captureRadius = shadowParms.zFar;
+	}
+}
