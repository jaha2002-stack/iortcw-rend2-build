+	trRefEntity_t *ent;
+	if (entityNum == REFENTITYNUM_WORLD)
+	{
+		VectorCopy(localPoint, worldPoint);
+		return;
+	}
+	if (entityNum < 0 || entityNum >= backEnd.refdef.num_entities)
+	{
+		VectorCopy(localPoint, worldPoint);
+		return;
