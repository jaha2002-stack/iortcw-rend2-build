+static qboolean R_StaticPromoteExact8SurfaceBounds(const msurface_t *surface, vec3_t mins, vec3_t maxs)
+{
+	const srfBspSurface_t *bsp;
+	surfaceType_t type;
+	int axis;
+
+	if (!surface || !surface->data)
+		return qfalse;
+	if (surface->cullinfo.type & CULLINFO_BOX)
+	{
+		VectorCopy(surface->cullinfo.bounds[0], mins);
+		VectorCopy(surface->cullinfo.bounds[1], maxs);
+	}
+	else
+	{
+		type = *surface->data;
+		if (type != SF_FACE && type != SF_GRID && type != SF_TRIANGLES)
+			return qfalse;
+		bsp = (const srfBspSurface_t *)surface->data;
+		VectorCopy(bsp->cullBounds[0], mins);
+		VectorCopy(bsp->cullBounds[1], maxs);
+	}
+	for (axis = 0; axis < 3; ++axis)
+	{
+		if (mins[axis] > maxs[axis] || mins[axis] < -1048576.0f || maxs[axis] > 1048576.0f)
+			return qfalse;
+	}
+	return qtrue;
+}
+
+static void R_StaticPromoteExact8BoundsCenter(const vec3_t mins, const vec3_t maxs, vec3_t center)
+{
+	center[0] = 0.5f * (mins[0] + maxs[0]);
+	center[1] = 0.5f * (mins[1] + maxs[1]);
+	center[2] = 0.5f * (mins[2] + maxs[2]);
+}
+
+static float R_StaticPromoteExact8PointBoundsDistance(const vec3_t point, const vec3_t mins, const vec3_t maxs)
+{
+	vec3_t delta;
+	int axis;
+	VectorClear(delta);
+	for (axis = 0; axis < 3; ++axis)
+	{
+		if (point[axis] < mins[axis])
+			delta[axis] = mins[axis] - point[axis];
+		else if (point[axis] > maxs[axis])
+			delta[axis] = point[axis] - maxs[axis];
+	}
+	return VectorLength(delta);
+}
+
+static qboolean R_StaticPromoteExact8ReadEntityMeta(int wantedOrdinal, staticPromoteExact8EntityMeta_t *out)
+{
+	char *parse;
+	char *token;
+	int entityOrdinal = -1;
+	if (!out)
+		return qfalse;
+	memset(out, 0, sizeof(*out));
+	VectorSet(out->color, 1.0f, 1.0f, 1.0f);
+	if (!tr.world || !tr.world->entityString || wantedOrdinal < 0)
+		return qfalse;
+	parse = tr.world->entityString;
+	for (;;)
+	{
+		token = COM_ParseExt(&parse, qtrue);
+		if (!token || !token[0])
+			break;
+		if (token[0] != '{')
+			continue;
+		entityOrdinal++;
+		if (entityOrdinal == wantedOrdinal)
+		{
+			for (;;)
+			{
+				char key[MAX_QPATH];
+				char value[256];
+				float a, b, c, d;
+				int parsed;
+				token = COM_ParseExt(&parse, qtrue);
+				if (!token || !token[0] || token[0] == '}')
+					break;
+				Q_strncpyz(key, token, sizeof(key));
+				token = COM_ParseExt(&parse, qtrue);
+				if (!token || !token[0])
+					break;
+				Q_strncpyz(value, token, sizeof(value));
+				if (!Q_stricmp(key, "classname"))
+					Q_strncpyz(out->classname, value, sizeof(out->classname));
+				else if (!Q_stricmp(key, "model"))
+					Q_strncpyz(out->model, value, sizeof(out->model));
+				else if (!Q_stricmp(key, "origin"))
+				{
+					if (sscanf(value, "%f %f %f", &out->origin[0], &out->origin[1], &out->origin[2]) == 3)
+						out->haveOrigin = qtrue;
+				}
+				else if (!Q_stricmp(key, "_color"))
+				{
+					if (sscanf(value, "%f %f %f", &out->color[0], &out->color[1], &out->color[2]) == 3)
+						R_StaticPromoteNormalizeColor(out->color);
+				}
+				else if (!Q_stricmp(key, "light"))
+					out->intensity = (float)atof(value);
+				else if (!Q_stricmp(key, "_light"))
+				{
+					a = b = c = d = 0.0f;
+					parsed = sscanf(value, "%f %f %f %f", &a, &b, &c, &d);
+					if (parsed == 1)
+						out->intensity = a;
+					else if (parsed == 4)
+					{
+						VectorSet(out->color, a, b, c);
+						R_StaticPromoteNormalizeColor(out->color);
+						out->intensity = d;
+					}
+				}
+				else if (!Q_stricmp(key, "fade"))
+				{
+					out->fade = (float)atof(value);
+					out->haveFade = qtrue;
+				}
+				else if (!Q_stricmp(key, "style"))
+					out->style = atoi(value);
+				else if (!Q_stricmp(key, "spawnflags"))
+					out->spawnflags = atoi(value);
+				else if (!Q_stricmp(key, "target"))
+					Q_strncpyz(out->target, value, sizeof(out->target));
+				else if (!Q_stricmp(key, "targetname"))
+					Q_strncpyz(out->targetname, value, sizeof(out->targetname));
+			}
+			out->found = qtrue;
+			return qtrue;
+		}
+		for (;;)
+		{
+			token = COM_ParseExt(&parse, qtrue);
+			if (!token || !token[0] || token[0] == '}')
+				break;
+			token = COM_ParseExt(&parse, qtrue);
+			if (!token || !token[0])
+				break;
+		}
+	}
+	return qfalse;
+}
+
+static qboolean R_StaticPromoteExact8TargetIsUniqueInfoNull(const char *wantedTarget)
+{
+	char *parse;
+	char *token;
+	int matches = 0;
+	qboolean infoNull = qfalse;
+	if (!wantedTarget || !wantedTarget[0] || !tr.world || !tr.world->entityString)
+		return qfalse;
+	parse = tr.world->entityString;
+	for (;;)
+	{
+		char classname[MAX_QPATH];
+		char targetname[64];
+		token = COM_ParseExt(&parse, qtrue);
+		if (!token || !token[0])
+			break;
+		if (token[0] != '{')
+			continue;
+		classname[0] = '\0';
+		targetname[0] = '\0';
+		for (;;)
+		{
+			char key[MAX_QPATH];
+			char value[256];
+			token = COM_ParseExt(&parse, qtrue);
+			if (!token || !token[0] || token[0] == '}')
+				break;
+			Q_strncpyz(key, token, sizeof(key));
+			token = COM_ParseExt(&parse, qtrue);
+			if (!token || !token[0])
+				break;
+			Q_strncpyz(value, token, sizeof(value));
+			if (!Q_stricmp(key, "classname"))
+				Q_strncpyz(classname, value, sizeof(classname));
+			else if (!Q_stricmp(key, "targetname"))
+				Q_strncpyz(targetname, value, sizeof(targetname));
+		}
+		if (targetname[0] && !Q_stricmp(targetname, wantedTarget))
+		{
+			matches++;
+			infoNull = !Q_stricmp(classname, "info_null") ? qtrue : qfalse;
+			if (matches > 1)
+				return qfalse;
+		}
+	}
+	return matches == 1 && infoNull ? qtrue : qfalse;
+}
+
+static qboolean R_StaticPromoteExact8MarkerNear(const vec3_t origin, int kind, float maxDistance, int *ordinalOut)
+{
+	float bestDistance = maxDistance + 0.01f;
+	int bestOrdinal = -1;
+	int i;
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		staticPromotePLRMarker_t *marker = &s_staticPromotePLRMarkers[i];
+		float distance;
+		if (marker->kind != kind)
+			continue;
+		distance = R_StaticPromotePLRDistance(origin, marker->origin);
+		if (distance <= maxDistance && distance < bestDistance)
+		{
+			bestDistance = distance;
+			bestOrdinal = marker->entityOrdinal;
+		}
+	}
+	if (ordinalOut)
+		*ordinalOut = bestOrdinal;
+	return bestOrdinal >= 0 ? qtrue : qfalse;
+}
+
+static int R_StaticPromoteExact8CountSurfacesNear(const vec3_t origin, const char *shaderName,
+	float maxDistance, int *nearestSurfaceOut, float *nearestDistanceOut)
+{
+	int count = 0;
+	int bestSurface = -1;
+	float bestDistance = maxDistance + 0.01f;
+	int i;
+	if (!tr.world || !tr.world->surfaces || !shaderName)
+		return 0;
+	for (i = 0; i < tr.world->numWorldSurfaces; ++i)
+	{
+		msurface_t *surface = &tr.world->surfaces[i];
+		vec3_t mins, maxs;
+		float distance;
+		if (!surface->shader || Q_stricmp(surface->shader->name, shaderName))
+			continue;
+		if (!R_StaticPromoteExact8SurfaceBounds(surface, mins, maxs))
+			continue;
+		distance = R_StaticPromoteExact8PointBoundsDistance(origin, mins, maxs);
+		if (distance > maxDistance)
+			continue;
+		count++;
+		if (distance < bestDistance)
+		{
+			bestDistance = distance;
+			bestSurface = i;
+		}
+	}
+	if (nearestSurfaceOut)
+		*nearestSurfaceOut = bestSurface;
+	if (nearestDistanceOut)
+		*nearestDistanceOut = bestSurface >= 0 ? bestDistance : maxDistance + 0.01f;
+	return count;
+}
+
+static qboolean R_StaticPromoteExact8ModelNear(const vec3_t origin, const char *modelName, float maxDistance)
+{
+	char *parse;
+	char *token;
+	if (!modelName || !modelName[0] || !tr.world || !tr.world->entityString)
+		return qfalse;
+	parse = tr.world->entityString;
+	for (;;)
+	{
+		char classname[MAX_QPATH];
+		char model[MAX_QPATH];
+		vec3_t modelOrigin;
+		qboolean haveOrigin = qfalse;
+		token = COM_ParseExt(&parse, qtrue);
+		if (!token || !token[0])
+			break;
+		if (token[0] != '{')
+			continue;
+		classname[0] = '\0';
+		model[0] = '\0';
+		VectorClear(modelOrigin);
+		for (;;)
+		{
+			char key[MAX_QPATH];
+			char value[256];
+			token = COM_ParseExt(&parse, qtrue);
+			if (!token || !token[0] || token[0] == '}')
+				break;
+			Q_strncpyz(key, token, sizeof(key));
+			token = COM_ParseExt(&parse, qtrue);
+			if (!token || !token[0])
+				break;
+			Q_strncpyz(value, token, sizeof(value));
+			if (!Q_stricmp(key, "classname"))
+				Q_strncpyz(classname, value, sizeof(classname));
+			else if (!Q_stricmp(key, "model"))
+				Q_strncpyz(model, value, sizeof(model));
+			else if (!Q_stricmp(key, "origin"))
+			{
+				if (sscanf(value, "%f %f %f", &modelOrigin[0], &modelOrigin[1], &modelOrigin[2]) == 3)
+					haveOrigin = qtrue;
+			}
+		}
+		if (haveOrigin && !Q_stricmp(classname, "misc_model") && !Q_stricmp(model, modelName) &&
+			R_StaticPromotePLRDistance(origin, modelOrigin) <= maxDistance)
+			return qtrue;
+	}
+	return qfalse;
+}
+
+static qboolean R_StaticPromoteExact8PersistentNearBounds(const vec3_t mins, const vec3_t maxs,
+	float maxDistance, int limitCount)
+{
+	int i;
+	int limit = limitCount >= 0 ? MIN(limitCount, s_staticPromotePersistentCount) : s_staticPromotePersistentCount;
+	for (i = 0; i < limit; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		if (light->synthetic)
+			continue;
+		if (R_StaticPromoteExact8PointBoundsDistance(light->candidate.origin, mins, maxs) <= maxDistance)
+			return qtrue;
+	}
+	return qfalse;
+}
+
+static qboolean R_StaticPromoteExact8PersistentIntensityNear(const vec3_t origin, float intensity, float maxDistance)
+{
+	int i;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *other = &s_staticPromotePersistentLights[i];
+		if (other->synthetic || other->rawMembers != 1)
+			continue;
+		if (fabs(other->candidate.intensity - intensity) > 0.5f)
+			continue;
+		if (R_StaticPromotePLRDistance(origin, other->candidate.origin) <= maxDistance)
+			return qtrue;
+	}
+	return qfalse;
+}
+
+static qboolean R_StaticPromoteExact8DerivedCenterNear(const vec3_t center, float maxDistance, int firstDerived)
+{
+	int i;
+	for (i = firstDerived; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		if (light->candidate.entityOrdinal < PLR_EXACT8_SURFACE_ENTITY_BASE)
+			continue;
+		if (R_StaticPromotePLRDistance(center, light->candidate.origin) <= maxDistance)
+			return qtrue;
+	}
+	return qfalse;
+}
+
+static staticPromotePLRMarker_t *R_StaticPromoteExact8NearestJuniorToBounds(const vec3_t mins, const vec3_t maxs,
+	float maxDistance, float *distanceOut)
+{
+	staticPromotePLRMarker_t *best = NULL;
+	float bestDistance = maxDistance + 0.01f;
+	int i;
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		staticPromotePLRMarker_t *marker = &s_staticPromotePLRMarkers[i];
+		float distance;
+		if (marker->kind != PLR_V01_MARKER_LIGHTJUNIOR)
+			continue;
+		distance = R_StaticPromoteExact8PointBoundsDistance(marker->origin, mins, maxs);
+		if (distance <= maxDistance && distance < bestDistance)
+		{
+			best = marker;
+			bestDistance = distance;
+		}
+	}
+	if (distanceOut)
+		*distanceOut = best ? bestDistance : maxDistance + 0.01f;
+	return best;
+}
