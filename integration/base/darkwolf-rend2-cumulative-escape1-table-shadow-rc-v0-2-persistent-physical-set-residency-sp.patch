+static void R_DarkWolfPLRPerfTrace(const refdef_t *fd)
+{
+	static char lastMap[MAX_QPATH] = "";
+	static int lastFrameMs = 0;
+	static int windowStartMs = 0;
+	static int windowFrames = 0;
+	static int minFrameMs = 999999;
+	static int maxFrameMs = 0;
+	int nowMs, dt, elapsed;
+	float fps;
+	if (!fd || !tr.world || !0)
+		return;
+	if (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+		return;
+	if (Q_stricmp(lastMap, tr.world->baseName))
+	{
+		Q_strncpyz(lastMap, tr.world->baseName, sizeof(lastMap));
+		lastFrameMs = 0;
+		windowStartMs = 0;
+		windowFrames = 0;
+		minFrameMs = 999999;
+		maxFrameMs = 0;
+	}
+	nowMs = ri.Milliseconds();
+	if (lastFrameMs > 0)
+	{
+		dt = nowMs - lastFrameMs;
+		if (dt <= 0 || dt >= 250)
+		{
+			windowStartMs = nowMs;
+			windowFrames = 0;
+			minFrameMs = 999999;
+			maxFrameMs = 0;
+		}
+		else
+		{
+			if (dt < minFrameMs) minFrameMs = dt;
+			if (dt > maxFrameMs) maxFrameMs = dt;
+			windowFrames++;
+		}
+	}
+	lastFrameMs = nowMs;
+	if (windowStartMs == 0)
+		windowStartMs = nowMs;
+	elapsed = nowMs - windowStartMs;
+	if (elapsed >= 2000 && windowFrames > 0)
+	{
+		fps = (float)windowFrames * 1000.0f / (float)elapsed;
+		ri.Printf(PRINT_ALL, "PLR_PERF map=%s windowMs=%d frames=%d avgFps=%.2f minFrameMs=%d maxFrameMs=%d sceneDlights=%d\\n",
+			tr.world->baseName, elapsed, windowFrames, fps, minFrameMs == 999999 ? -1 : minFrameMs, maxFrameMs,
+			r_numdlights - r_firstSceneDlight);
+		windowStartMs = nowMs;
+		windowFrames = 0;
+		minFrameMs = 999999;
+		maxFrameMs = 0;
+	}
+}
