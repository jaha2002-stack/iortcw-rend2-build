+static qboolean R_StaticPromoteAddCandidate(int slot, staticPromoteCandidate_t *candidate,
+	const char *sourceName, int sourceIndex, char *report, int reportSize, int *reportLength)
+{
+	vec3_t baseColor;
+	vec3_t color;
+	float gain;
+	float directGain;
+	float radiusScale;
+	float minRadius;
+	float maxRadius;
+	float maxColorLimit;
+	float radius;
+	float maxColor;
+	float colorScale;
+	char line[768];
+	int before;
+
+	if (!candidate)
+		return qfalse;
+
+	gain = r_staticPromoteGain ? r_staticPromoteGain->value : 0.35f;
+	directGain = r_staticPromoteDirectGain ? r_staticPromoteDirectGain->value : 1.10f;
+	radiusScale = r_staticPromoteRadiusScale ? r_staticPromoteRadiusScale->value : 0.70f;
+	minRadius = r_staticPromoteMinRadius ? r_staticPromoteMinRadius->value : 192.0f;
+	maxRadius = r_staticPromoteMaxRadius ? r_staticPromoteMaxRadius->value : 320.0f;
+	maxColorLimit = r_staticPromoteMaxColor ? r_staticPromoteMaxColor->value : 0.50f;
+	gain = CLAMP(gain, 0.0f, 1.0f);
+	directGain = CLAMP(directGain, 0.0f, 4.0f);
+	radiusScale = CLAMP(radiusScale, 0.10f, 1.50f);
+	maxRadius = CLAMP(maxRadius, 64.0f, 512.0f);
+	minRadius = CLAMP(minRadius, 64.0f, maxRadius);
+	maxColorLimit = CLAMP(maxColorLimit, 0.10f, 2.00f);
+
+	radius = candidate->intensity * radiusScale;
+	radius = CLAMP(radius, minRadius, maxRadius);
+	VectorScale(candidate->color, gain, baseColor);
+	VectorScale(baseColor, directGain, color);
+	maxColor = MAX(color[0], MAX(color[1], color[2]));
+	if (maxColor > maxColorLimit)
+	{
+		colorScale = maxColorLimit / maxColor;
+		VectorScale(color, colorScale, color);
+	}
+
+	before = r_numdlights;
+	RE_AddLightToScene(candidate->origin, radius, color[0], color[1], color[2], REF_FORCE_DLIGHT | DARKWOLF_REF_LOCALVOL_LAMP); // DARKWOLF_LOCAL_VOLUMETRIC_V0_1
+	if (r_numdlights > before)
+		backEndData->dlights[r_numdlights - 1].forced = qtrue;
+
+	Com_sprintf(line, sizeof(line),
+		"slot=%d source=%s sourceIndex=%d entity=%d origin=%.2f,%.2f,%.2f baseLight=%.2f baseColor=%.3f,%.3f,%.3f directGain=%.3f maxColor=%.3f runtimeRadius=%.2f runtimeColor=%.3f,%.3f,%.3f added=%d\n",
+		slot, sourceName ? sourceName : "<none>", sourceIndex, candidate->entityOrdinal,
+		candidate->origin[0], candidate->origin[1], candidate->origin[2], candidate->intensity,
+		baseColor[0], baseColor[1], baseColor[2], directGain, maxColorLimit, radius,
+		color[0], color[1], color[2], r_numdlights > before ? 1 : 0);
+	R_StaticPromoteAppend(report, reportSize, reportLength, line);
+	return r_numdlights > before ? qtrue : qfalse;
+}
+
+static qboolean R_StaticPromoteAddSlot(int slot, int index, char *report, int reportSize, int *reportLength)
+{
+	staticPromoteCandidate_t *candidate;
+	if (!R_StaticPromoteResolve(index, &candidate))
+		return qfalse;
+	return R_StaticPromoteAddCandidate(slot, candidate, "manual-nearest32", index,
+		report, reportSize, reportLength);
+}
