+			tr.world->baseName, i, light->candidate.entityOrdinal,
+			light->candidate.origin[0], light->candidate.origin[1], light->candidate.origin[2],
+			light->candidate.intensity, light->rawMembers, light->scripted ? 1 : 0,
+			light->approvedFallback ? 1 : 0,
+			R_StaticPromoteUserOverrideState(tr.world->baseName, light->candidate.entityOrdinal),
