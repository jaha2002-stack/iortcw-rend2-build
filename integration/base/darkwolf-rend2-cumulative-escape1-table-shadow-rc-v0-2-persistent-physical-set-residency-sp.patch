+
+// DARKWOLF_FIREVOL_FINAL_ARCHITECTURE_PRODUCTION_CANDIDATE_V1
+// Static BSP flame discovery is authoritative and map-wide. The catalog is intentionally
+// separate from the 128-entry working registry: catalog entries are never lost merely
+// because their tiny flame surface is outside the current drawSurf list.
+typedef struct fireVolumetricFinalCatalogEntry_s
+{
+	int surfaceIndex;
+	int shaderIndex;
+	vec3_t origin;
+} fireVolumetricFinalCatalogEntry_t;
+
+#define FIREVOL_FINAL_VOLUME_PAIR_MAX 64
+
+typedef struct fireVolumetricFinalVolumePairs_s
+{
+	int pairCount;
+	qboolean overflow;
+	int clusters[FIREVOL_FINAL_VOLUME_PAIR_MAX];
+	int areas[FIREVOL_FINAL_VOLUME_PAIR_MAX];
+} fireVolumetricFinalVolumePairs_t;
+
+static fireVolumetricFinalCatalogEntry_t s_fireVFinalCatalog[MAX_MAP_DRAW_SURFS];
+static fireVolumetricFinalVolumePairs_t *s_fireVFinalCatalogPairs = NULL;
+static int s_fireVFinalCatalogCount = 0;
+static char s_fireVFinalCatalogMap[MAX_QPATH] = "";
+static float s_fireVFinalCatalogPairRadius = 0.0f;
+static int s_fireVFinalCatalogAdmissions = 0;
+static int s_fireVFinalVolumePairOverflows = 0;
+
+static float RB_FireVFinalVisibilityRadius(const fireVolumetricV07PoolSlot_t *pool)
+{
+	float minRadius = s_rVolumetricFireRadiusMin ? s_rVolumetricFireRadiusMin->value : 170.0f;
+	float maxRadius = s_rVolumetricFireRadiusMax ? s_rVolumetricFireRadiusMax->value : 240.0f;
+	float radius;
+	if (maxRadius < minRadius)
+	{
+		float temp = maxRadius;
+		maxRadius = minRadius;
+		minRadius = temp;
+	}
+	radius = Com_Clamp(64.0f, 1024.0f, maxRadius);
+	if (pool && pool->radiusStateValid && pool->radiusStateValue > radius)
+		radius = Com_Clamp(64.0f, 1024.0f, pool->radiusStateValue);
+	return radius;
+}
+
+static qboolean RB_FireVFinalSphereIntersectsBounds(const vec3_t origin, float radius,
+	const vec3_t mins, const vec3_t maxs)
+{
+	float distanceSquared = 0.0f;
+	int axis;
+	for (axis = 0; axis < 3; ++axis)
+	{
+		float d = 0.0f;
+		if (origin[axis] < mins[axis]) d = mins[axis] - origin[axis];
+		else if (origin[axis] > maxs[axis]) d = origin[axis] - maxs[axis];
+		distanceSquared += d * d;
+	}
+	return distanceSquared <= radius * radius ? qtrue : qfalse;
+}
+
+static mnode_t *RB_FireVFinalPointInLeaf(const vec3_t point)
+{
+	mnode_t *node;
+	if (!tr.world || !tr.world->nodes)
+		return NULL;
+	node = tr.world->nodes;
+	while (node && node->contents == CONTENTS_NODE)
+	{
+		float d = DotProduct(point, node->plane->normal) - node->plane->dist;
+		node = node->children[d > 0.0f ? 0 : 1];
+	}
+	return node;
+}
+
+static void RB_FireVFinalBuildVolumePairs(fireVolumetricFinalVolumePairs_t *pairs,
+	const vec3_t origin, float radius)
+{
+	int i;
+	if (!pairs)
+		return;
+	memset(pairs, 0, sizeof(*pairs));
+	if (!tr.world)
+		return;
+	for (i = tr.world->numDecisionNodes; i < tr.world->numnodes; ++i)
+	{
+		mnode_t *leaf = &tr.world->nodes[i];
+		int pairIndex;
+		qboolean duplicate = qfalse;
+		if (leaf->contents == CONTENTS_NODE)
+			continue;
+		if (leaf->cluster < 0 || leaf->cluster >= tr.world->numClusters)
+			continue;
+		if (!RB_FireVFinalSphereIntersectsBounds(origin, radius, leaf->mins, leaf->maxs))
+			continue;
+		for (pairIndex = 0; pairIndex < pairs->pairCount; ++pairIndex)
+		{
+			if (pairs->clusters[pairIndex] == leaf->cluster && pairs->areas[pairIndex] == leaf->area)
+			{
+				duplicate = qtrue;
+				break;
+			}
+		}
+		if (duplicate)
+			continue;
+		if (pairs->pairCount >= FIREVOL_FINAL_VOLUME_PAIR_MAX)
+		{
+			pairs->overflow = qtrue;
+			continue;
+		}
+		pairs->clusters[pairs->pairCount] = leaf->cluster;
+		pairs->areas[pairs->pairCount] = leaf->area;
+		pairs->pairCount++;
+	}
+	if (pairs->overflow)
+		s_fireVFinalVolumePairOverflows++;
+}
+
+static qboolean RB_FireVFinalPairsVisible(const fireVolumetricFinalVolumePairs_t *pairs)
+{
+	mnode_t *viewLeaf;
+	const byte *vis = NULL;
+	int viewCluster;
+	int i;
+	if (!tr.world || !pairs)
+		return qtrue;
+	viewLeaf = RB_FireVFinalPointInLeaf(backEnd.refdef.vieworg);
+	viewCluster = viewLeaf ? viewLeaf->cluster : -1;
+	if (viewCluster < 0 || viewCluster >= tr.world->numClusters)
+		return qtrue;
+	if (tr.world->vis)
+		vis = tr.world->vis + viewCluster * tr.world->clusterBytes;
+	for (i = 0; i < pairs->pairCount; ++i)
+	{
+		int cluster = pairs->clusters[i];
+		int area = pairs->areas[i];
+		if (vis && !(vis[cluster >> 3] & (1 << (cluster & 7))))
+			continue;
+		if (area >= 0 && area < MAX_MAP_AREA_BYTES * 8 &&
+			(backEnd.refdef.areamask[area >> 3] & (1 << (area & 7))))
+			continue;
+		return qtrue;
+	}
+	// Overflow or a degenerate pair set resolves conservatively. A visibility helper must never
+	// false-cull a FireVol merely because the precomputed BSP-pair representation was incomplete.
+	if (pairs->overflow || pairs->pairCount == 0)
+		return qtrue;
+	return qfalse;
+}
+
+static qboolean RB_FireVFinalWorldSurfaceCenter(int surfaceIndex, vec3_t out)
+{
+	msurface_t *surface;
+	srfBspSurface_t *bsp;
+	int i;
+	if (!tr.world || surfaceIndex < 0 || surfaceIndex >= tr.world->numWorldSurfaces)
+		return qfalse;
+	surface = &tr.world->surfaces[surfaceIndex];
+	if (!surface->data)
+		return qfalse;
+	if (*surface->data != SF_FACE && *surface->data != SF_GRID && *surface->data != SF_TRIANGLES)
+		return qfalse;
+	bsp = (srfBspSurface_t *)surface->data;
+	if (!bsp->verts || bsp->numVerts <= 0)
+		return qfalse;
+	VectorClear(out);
+	for (i = 0; i < bsp->numVerts; ++i)
+		VectorAdd(out, bsp->verts[i].xyz, out);
+	VectorScale(out, 1.0f / (float)bsp->numVerts, out);
+	return qtrue;
+}
+
+static void RB_FireVFinalEnsureCatalog(void)
+{
+	const char *mapName = tr.world ? tr.world->baseName : "<none>";
+	float pairRadius = RB_FireVFinalVisibilityRadius(NULL);
+	qboolean mapChanged = Q_stricmp(s_fireVFinalCatalogMap, mapName) ? qtrue : qfalse;
+	int surfaceIndex;
+	int catalogIndex;
+	if (!mapChanged && fabs(s_fireVFinalCatalogPairRadius - pairRadius) <= 1.0f)
+		return;
+	if (mapChanged)
+	{
+		Q_strncpyz(s_fireVFinalCatalogMap, mapName, sizeof(s_fireVFinalCatalogMap));
+		s_fireVFinalCatalogCount = 0;
+		s_fireVFinalCatalogAdmissions = 0;
+		if (s_fireVFinalCatalogPairs)
+		{
+			ri.Free(s_fireVFinalCatalogPairs);
+			s_fireVFinalCatalogPairs = NULL;
+		}
+	}
+	s_fireVFinalCatalogPairRadius = pairRadius;
+	s_fireVFinalVolumePairOverflows = 0;
+	if (!tr.world)
+		return;
+	if (tr.world->numWorldSurfaces > MAX_MAP_DRAW_SURFS)
+	{
+		ri.Printf(PRINT_WARNING,
+			"FIREVOL_FINAL_ARCH_CATALOG_ERROR map=%s worldSurfaces=%d engineMax=%d\n",
+			mapName, tr.world->numWorldSurfaces, MAX_MAP_DRAW_SURFS);
+		return;
+	}
+	if (mapChanged)
+	{
+		for (surfaceIndex = 0; surfaceIndex < tr.world->numWorldSurfaces; ++surfaceIndex)
+		{
+			msurface_t *surface = &tr.world->surfaces[surfaceIndex];
+			shader_t *shader = surface->shader;
+			fireVolumetricFinalCatalogEntry_t *entry;
+			int animated = 0, animationFrames = 0;
+			vec3_t center;
+			if (!shader || !surface->data)
+				continue;
+			if (!RB_FireV07ShaderEvidence(shader, &animated, &animationFrames))
+				continue;
+			if (!RB_FireV082ShaderLooksLikeFlame(shader->name))
+				continue;
+			if (!RB_FireVFinalWorldSurfaceCenter(surfaceIndex, center))
+				continue;
+			entry = &s_fireVFinalCatalog[s_fireVFinalCatalogCount++];
+			entry->surfaceIndex = surfaceIndex;
+			entry->shaderIndex = shader->index;
+			VectorCopy(center, entry->origin);
+		}
+		if (s_fireVFinalCatalogCount > 0)
+		{
+			s_fireVFinalCatalogPairs = (fireVolumetricFinalVolumePairs_t *)ri.Z_Malloc(
+				s_fireVFinalCatalogCount * sizeof(*s_fireVFinalCatalogPairs));
+			memset(s_fireVFinalCatalogPairs, 0,
+				s_fireVFinalCatalogCount * sizeof(*s_fireVFinalCatalogPairs));
+		}
+	}
+	if (s_fireVFinalCatalogCount > 0 && !s_fireVFinalCatalogPairs)
+	{
+		ri.Printf(PRINT_WARNING, "FIREVOL_FINAL_ARCH_CATALOG_ERROR map=%s pairCacheAllocation=0\n", mapName);
+		return;
+	}
+	for (catalogIndex = 0; catalogIndex < s_fireVFinalCatalogCount; ++catalogIndex)
+		RB_FireVFinalBuildVolumePairs(&s_fireVFinalCatalogPairs[catalogIndex],
+			s_fireVFinalCatalog[catalogIndex].origin, pairRadius);
+	ri.Printf(PRINT_ALL,
+		"FIREVOL_FINAL_ARCH_CATALOG map=%s worldSurfaces=%d catalog=%d registryCap=%d renderCap=%d pairRadius=%.1f pairOverflows=%d\n",
+		mapName, tr.world->numWorldSurfaces, s_fireVFinalCatalogCount,
+		FIREVOL07_MAX_POOL, FIREVOL081_RENDER_CAP, pairRadius, s_fireVFinalVolumePairOverflows);
+}
+
+static int RB_FireVFinalCatalogIndexForFixture(int surfaceIndex, const char *shaderName, const vec3_t origin)
+{
+	int i;
+	for (i = 0; i < s_fireVFinalCatalogCount; ++i)
+	{
+		const fireVolumetricFinalCatalogEntry_t *entry = &s_fireVFinalCatalog[i];
+		const msurface_t *surface;
+		const char *catalogShader;
+		if (!tr.world || entry->surfaceIndex < 0 || entry->surfaceIndex >= tr.world->numWorldSurfaces)
+			continue;
+		surface = &tr.world->surfaces[entry->surfaceIndex];
+		catalogShader = (surface->shader && surface->shader->name[0]) ? surface->shader->name : "";
+		if (RB_FireV082FixtureKeyMatches(surfaceIndex, shaderName, origin,
+			entry->surfaceIndex, catalogShader, entry->origin))
+			return i;
+	}
+	return -1;
+}
+
+static qboolean RB_FireVFinalVolumePVSVisibleForCatalog(int catalogIndex)
+{
+	if (catalogIndex < 0 || catalogIndex >= s_fireVFinalCatalogCount || !s_fireVFinalCatalogPairs)
+		return qtrue;
+	return RB_FireVFinalPairsVisible(&s_fireVFinalCatalogPairs[catalogIndex]);
+}
+
+static qboolean RB_FireVFinalVolumePVSVisibleForPool(const fireVolumetricV07PoolSlot_t *pool)
+{
+	int catalogIndex;
+	if (!pool || !pool->valid || !pool->latchValid)
+		return qfalse;
+	catalogIndex = RB_FireVFinalCatalogIndexForFixture(pool->latchedFlameSurface,
+		pool->latchedShader, pool->latchedFlameOrigin);
+	if (catalogIndex < 0)
+		return qtrue;
+	return RB_FireVFinalVolumePVSVisibleForCatalog(catalogIndex);
+}
+
+static qboolean RB_FireVFinalSphereIntersectsMainFrustum(const vec3_t origin, float radius)
+{
+	int numPlanes = (backEnd.viewParms.flags & VPF_FARPLANEFRUSTUM) ? 5 : 4;
+	return R_CullPointAndRadiusEx(origin, radius, backEnd.viewParms.frustum, numPlanes) == CULL_OUT
+		? qfalse : qtrue;
+}
+
+static int RB_FireVFinalCatalogTier(const fireVolumetricFinalCatalogEntry_t *entry)
+{
+	int catalogIndex;
+	float radius;
+	if (!entry)
+		return 2;
+	catalogIndex = (int)(entry - s_fireVFinalCatalog);
+	radius = RB_FireVFinalVisibilityRadius(NULL);
+	if (!RB_FireVFinalVolumePVSVisibleForCatalog(catalogIndex))
+		return 2;
+	return RB_FireVFinalSphereIntersectsMainFrustum(entry->origin, radius) ? 0 : 1;
+}
+
+static int RB_FireVFinalPoolForCatalog(const fireVolumetricFinalCatalogEntry_t *entry)
+{
+	int slot;
+	const char *catalogShader;
+	if (!entry || !tr.world || entry->surfaceIndex < 0 || entry->surfaceIndex >= tr.world->numWorldSurfaces)
+		return -1;
+	catalogShader = tr.world->surfaces[entry->surfaceIndex].shader ?
+		tr.world->surfaces[entry->surfaceIndex].shader->name : "";
+	for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+	{
+		fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+		vec3_t delta;
+		if (!pool->valid || !pool->latchValid)
+			continue;
+		if (RB_FireV082FixtureKeyMatches(pool->latchedFlameSurface, pool->latchedShader,
+			pool->latchedFlameOrigin, entry->surfaceIndex, catalogShader, entry->origin))
+			return slot;
+		VectorSubtract(pool->latchedFlameOrigin, entry->origin, delta);
+		if (DotProduct(delta, delta) <= 32.0f * 32.0f)
+			return slot;
+	}
+	return -1;
+}
+
+static qboolean RB_FireV082AnchorSpatiallyCovered(const fireVolumetricV07Anchor_t *anchor, float tolerance)
+{
+	int slot;
+	float toleranceSq = tolerance * tolerance;
+	for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+	{
+		fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+		vec3_t delta;
+		if (!pool->valid || !pool->latchValid)
+			continue;
+		if (RB_FireV082PoolMatchesAnchor(pool, anchor))
+			return qtrue;
+		VectorSubtract(pool->latchedFlameOrigin, anchor->origin, delta);
+		if (DotProduct(delta, delta) <= toleranceSq)
+			return qtrue;
+	}
+	return qfalse;
+}
+
+static qboolean RB_FireV082IdentityInPool(int nativeOrdinal,
+	const fireVolumetricV07Anchor_t *anchor, int maxSlots)
+{
+	int slot;
+	for (slot = 0; slot < maxSlots; ++slot)
+	{
+		fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+		if (!pool->valid)
+			continue;
+		// Positive authored identity remains exactly the proven v0.8.1 policy.
+		if (nativeOrdinal >= 0 && pool->nativeOrdinal >= 0 && pool->nativeOrdinal == nativeOrdinal)
+			return qtrue;
+		// nativeOrdinal==-1 is NEVER an identity. The immutable fixture key is authoritative.
+		if (anchor && RB_FireV082PoolMatchesAnchor(pool, anchor))
+			return qtrue;
+	}
+	return qfalse;
+}
+
+static int RB_FireV082FindNearestFixtureOwner(int sourceMode,
+	const fireVolumetricV07PoolSlot_t *pool, float maxDistance,
+	int *shadowSlot, float *outDistance)
+{
+	int i, best = -1;
+	float bestSq = maxDistance * maxDistance;
+	if (shadowSlot) *shadowSlot = -1;
+	if (outDistance) *outDistance = -1.0f;
+	if (!pool || !pool->latchValid)
+		return -1;
+	for (i = 0; i < backEnd.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+	{
+		dlight_t *dl = &backEnd.refdef.dlights[i];
+		vec3_t delta;
+		float distSq;
+		if (!RB_FireVolumetricEligible(dl, sourceMode))
+			continue;
+		if (pool->nativeOrdinal < 0 && dl->fireVolumetricNativeOrdinal >= 0)
+			continue;
+		if (pool->sourceClass == FIREVOL082_SOURCE_STRICT && !dl->fireVolumetricSource)
+			continue;
+		VectorSubtract(pool->latchedFlameOrigin, dl->origin, delta);
+		distSq = DotProduct(delta, delta);
+		if (distSq > bestSq)
+			continue;
+		bestSq = distSq;
+		best = i;
+	}
+	if (best >= 0)
+	{
+		if (shadowSlot) *shadowSlot = RB_FireVolumetricShadowSlotForIndex(best);
+		if (outDistance) *outDistance = sqrt(bestSq);
+	}
+	return best;
+}
+
+static void RB_FireV082BuildSyntheticDlight(const fireVolumetricV07PoolSlot_t *pool, dlight_t *out)
+{
+	float minRadius = s_rVolumetricFireRadiusMin ? s_rVolumetricFireRadiusMin->value : 170.0f;
+	float maxRadius = s_rVolumetricFireRadiusMax ? s_rVolumetricFireRadiusMax->value : 240.0f;
+	float radius;
+	if (!out)
+		return;
+	memset(out, 0, sizeof(*out));
+	if (maxRadius < minRadius)
+	{
+		float t = minRadius;
+		minRadius = maxRadius;
+		maxRadius = t;
+	}
+	radius = Com_Clamp(64.0f, 1024.0f, 0.5f * (minRadius + maxRadius));
+	if (pool && pool->latchValid)
+		VectorCopy(pool->latchedFlameOrigin, out->origin);
+	VectorSet(out->color, 1.0f, 0.52f, 0.16f);
+	out->radius = radius;
+	out->fireVolumetricNativeOrdinal = -1;
+	out->fireVolumetricSpeakerOrdinal = -1;
+	out->nativeAuthoredDlight = qfalse;
+	out->fireVolumetricSource = qfalse;
+}
+
+static int RB_FireV083ViewTier(FBO_t *srcFbo, const fireVolumetricV07PoolSlot_t *pool)
+{
+	fireVolumetricV072Projection_t projection;
+	int renderedIndex;
+	if (!pool || !pool->valid || !pool->latchValid)
+		return 2;
+	// Final architecture: static BSP flame fixtures are classified by the physical FireVol sphere,
+	// not by one tiny flame-surface center. PVS + area decides physical reachability; the sphere
+	// against the main-view frustum distinguishes Tier0 from Tier1.
+	if (RB_FireVFinalCatalogIndexForFixture(pool->latchedFlameSurface, pool->latchedShader,
+		pool->latchedFlameOrigin) >= 0)
+	{
+		float volumeRadius = RB_FireVFinalVisibilityRadius(pool);
+		if (!RB_FireVFinalVolumePVSVisibleForPool(pool))
+			return 2;
+		return RB_FireVFinalSphereIntersectsMainFrustum(pool->latchedFlameOrigin, volumeRadius) ? 0 : 1;
+	}
+	// Dynamic/model/poly sources retain the proven Build65 drawSurf/projection policy.
+	if (srcFbo && RB_FireV072ProjectWorldPoint(srcFbo, pool->latchedFlameOrigin, &projection) && projection.inFrustum)
+		return 0;
+	renderedIndex = RB_FireV071FindLatchedRenderedIndex(pool->latchedFlameSurface,
+		pool->latchedShader, pool->latchedFlameOrigin);
+	if (renderedIndex >= 0)
+		return 1;
+	return 2;
+}
+
+static void RB_FireV083RefreshSyntheticLifetime(fireVolumetricV07PoolSlot_t *pool,
+	int nowMs, int graceMs, qboolean *liveSynthetic)
+{
+	int renderedIndex;
+	if (liveSynthetic)
+		*liveSynthetic = qfalse;
+	if (!pool || !pool->valid || !pool->latchValid)
+		return;
+	// Static BSP fixtures stay live while their FireVol sphere remains in current PVS/area, even
+	// if the tiny emissive face itself drops out of drawSurfs. This is the lifetime counterpart
+	// of volume-based Tier0/Tier1 classification.
+	if (RB_FireVFinalCatalogIndexForFixture(pool->latchedFlameSurface, pool->latchedShader,
+		pool->latchedFlameOrigin) >= 0)
+	{
+		if (RB_FireVFinalVolumePVSVisibleForPool(pool))
+		{
+			pool->lastSeenMs = nowMs;
+			pool->missingSinceMs = 0;
+			if (liveSynthetic) *liveSynthetic = qtrue;
+			return;
+		}
+		if (!pool->missingSinceMs)
+			pool->missingSinceMs = nowMs;
+		if (nowMs - pool->missingSinceMs < graceMs)
+		{
+			if (liveSynthetic) *liveSynthetic = qtrue;
+		}
+		return;
+	}
+	renderedIndex = RB_FireV071FindLatchedRenderedIndex(pool->latchedFlameSurface,
+		pool->latchedShader, pool->latchedFlameOrigin);
+	if (renderedIndex >= 0)
+	{
+		pool->lastSeenMs = nowMs;
+		pool->missingSinceMs = 0;
+		if (liveSynthetic) *liveSynthetic = qtrue;
+		return;
+	}
+	if (!pool->missingSinceMs)
+		pool->missingSinceMs = nowMs;
+	if (nowMs - pool->missingSinceMs < graceMs)
+	{
+		if (liveSynthetic) *liveSynthetic = qtrue;
+	}
+}
+
+// FireVol Stable Residency + Full Fixture Registry Production v1 helpers.
+static float RB_FireVStableSmooth01(float t)
+{
+	t = Com_Clamp(0.0f, 1.0f, t);
+	return t * t * (3.0f - 2.0f * t);
+}
+
+static float RB_FireVStableCameraDistance(const vec3_t origin)
+{
+	vec3_t delta;
+	VectorSubtract(origin, backEnd.refdef.vieworg, delta);
+	return VectorLength(delta);
+}
+
+static float RB_FireVStableDistanceWeight(const vec3_t origin)
+{
+	float fullRadius, activeRadius, dist, t;
+	RB_FireVolumetricEnsureCvars();
+	fullRadius = Com_Clamp(0.0f, 4096.0f, s_rVolumetricFireResidencyFullRadius->value);
+	activeRadius = Com_Clamp(64.0f, 8192.0f, s_rVolumetricFireResidencyActiveRadius->value);
+	if (activeRadius < fullRadius + 1.0f)
+		activeRadius = fullRadius + 1.0f;
+	dist = RB_FireVStableCameraDistance(origin);
+	if (dist <= fullRadius)
+		return 1.0f;
+	if (dist >= activeRadius)
+		return 0.0f;
+	t = (activeRadius - dist) / (activeRadius - fullRadius);
+	return RB_FireVStableSmooth01(t);
+}
+
+static int RB_FireVStableResidentIndexForPool(int poolSlot)
+{
+	int i;
+	for (i = 0; i < FIREVOL081_RENDER_CAP; ++i)
+		if (s_fireVStableResidents[i].poolSlot == poolSlot)
+			return i;
+	return -1;
+}
+
+static qboolean RB_FireVStablePoolIsResident(int poolSlot)
+{
+	return RB_FireVStableResidentIndexForPool(poolSlot) >= 0 ? qtrue : qfalse;
+}
+
+static void RB_FireVStableClearResident(int residentSlot)
+{
+	if (residentSlot < 0 || residentSlot >= FIREVOL081_RENDER_CAP)
+		return;
+	memset(&s_fireVStableResidents[residentSlot], 0, sizeof(s_fireVStableResidents[residentSlot]));
+	s_fireVStableResidents[residentSlot].poolSlot = -1;
+}
+
+static float RB_FireVStableCandidatePriority(FBO_t *srcFbo, int poolSlot,
+	const int *liveIndex, const qboolean *liveSynthetic)
+{
+	fireVolumetricV07PoolSlot_t *pool;
+	int index, viewTier;
+	float distanceWeight, cameraDist, score = 0.0f;
+	dlight_t syntheticDl;
+	const dlight_t *scoreDl;
+	if (poolSlot < 0 || poolSlot >= FIREVOL07_MAX_POOL)
+		return -1.0e30f;
+	pool = &s_fireV07Pool[poolSlot];
+	if (!pool->valid || !pool->latchValid)
+		return -1.0e30f;
+	index = liveIndex[poolSlot];
+	if (index < 0 && !liveSynthetic[poolSlot])
+		return -1.0e30f;
+	distanceWeight = RB_FireVStableDistanceWeight(pool->latchedFlameOrigin);
+	if (distanceWeight <= 0.001f)
+		return -1.0e30f;
+	cameraDist = RB_FireVStableCameraDistance(pool->latchedFlameOrigin);
+	viewTier = RB_FireV083ViewTier(srcFbo, pool);
+	if (index >= 0)
+		scoreDl = &backEnd.refdef.dlights[index];
+	else
+	{
+		RB_FireV082BuildSyntheticDlight(pool, &syntheticDl);
+		scoreDl = &syntheticDl;
+	}
+	// R2: visibility class is authoritative. Distance only orders fixtures inside the same tier.
+	// The 15k gaps are larger than the complete proximity range, so tier0 always beats tier1/2.
+	if (viewTier == 0) score = 30000.0f;
+	else if (viewTier == 1) score = 15000.0f;
+	else score = 0.0f;
+	score += 10000.0f - Com_Clamp(0.0f, 10000.0f, cameraDist);
+	score += Com_Clamp(0.0f, 50.0f, RB_LocalVolumetricDlightScore(scoreDl));
+	if (index >= 0) score += 25.0f;
+	if (pool->sourceClass == FIREVOL082_SOURCE_STRICT) score += 10.0f;
+	return score;
+}
+
+static int RB_FireVStableBestNonResidentTier(FBO_t *srcFbo, const int *liveIndex,
+	const qboolean *liveSynthetic, int maxViewTier)
+{
+	int slot, best = -1;
+	float bestScore = -1.0e30f;
+	for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+	{
+		fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+		float score;
+		int tier;
+		if (RB_FireVStablePoolIsResident(slot))
+			continue;
+		if (!pool->valid || !pool->latchValid)
+			continue;
+		tier = RB_FireV083ViewTier(srcFbo, pool);
+		if (tier > maxViewTier)
+			continue;
+		score = RB_FireVStableCandidatePriority(srcFbo, slot, liveIndex, liveSynthetic);
+		if (score > bestScore)
+		{
+			bestScore = score;
+			best = slot;
+		}
+	}
+	return best;
+}
+
+static int RB_FireVStableBestNonResident(FBO_t *srcFbo, const int *liveIndex,
+	const qboolean *liveSynthetic)
+{
+	// R3: tier2 is latent registry state only. After its 120ms resident grace expires it must
+	// remain nonresident until visibility returns to tier0/tier1; never reacquire from tier2.
+	return RB_FireVStableBestNonResidentTier(srcFbo, liveIndex, liveSynthetic, 1);
+}
+
+static int RB_FireVStableFindRegistryPreemptionSlot(FBO_t *srcFbo,
+	const int *liveIndex, const qboolean *liveSynthetic, const vec3_t candidateOrigin,
+	int nowMs, int graceMs)
+{
+	int slot, best = -1;
+	float candidateDist = candidateOrigin ? RB_FireVStableCameraDistance(candidateOrigin) : 0.0f;
+	float bestVictimScore = -1.0e30f;
+	float preemptDistance;
+	RB_FireVolumetricEnsureCvars();
+	preemptDistance = Com_Clamp(64.0f, 2048.0f, s_rVolumetricFireResidencyPreemptDistance->value);
+	for (slot = 0; slot < FIREVOL07_MAX_POOL; ++slot)
+	{
+		fireVolumetricV07PoolSlot_t *pool = &s_fireV07Pool[slot];
+		float victimDist, victimScore;
+		int tier;
+		qboolean stale;
+		if (!pool->valid || !pool->latchValid)
+			continue;
+		// Never evict an active resident or a fixture currently inside the main-camera frustum.
+		if (RB_FireVStablePoolIsResident(slot))
+			continue;
+		tier = RB_FireV083ViewTier(srcFbo, pool);
+		if (tier == 0)
+			continue;
+		victimDist = RB_FireVStableCameraDistance(pool->latchedFlameOrigin);
+		stale = (liveIndex[slot] < 0 && !liveSynthetic[slot] && pool->missingSinceMs &&
+			nowMs - pool->missingSinceMs >= graceMs) ? qtrue : qfalse;
+		if (!stale && victimDist <= candidateDist + preemptDistance)
+			continue;
+		victimScore = victimDist;
+		if (tier == 2) victimScore += 10000.0f;
+		if (stale) victimScore += 20000.0f;
+		if (pool->sourceClass == FIREVOL082_SOURCE_SYNTHETIC) victimScore += 100.0f;
+		else if (pool->sourceClass == FIREVOL082_SOURCE_FALLBACK) victimScore += 50.0f;
+		if (victimScore > bestVictimScore)
+		{
+			bestVictimScore = victimScore;
+			best = slot;
+		}
+	}
+	return best;
+}
+
+static float RB_FireVStableGeometryRadius(const dlight_t *dl,
+	fireVolumetricV07PoolSlot_t *pool, int nowMs)
+{
+	float rawRadius, minRadius, maxRadius, target, smoothMs, alpha;
+	int dt;
+	vec3_t delta;
+	if (!dl)
+		return 1.0f;
+	rawRadius = MAX(dl->radius, 1.0f);
+	if (!pool || !s_rVolumetricFireRadiusStabilize || !s_rVolumetricFireRadiusStabilize->integer)
+		return rawRadius;
+	minRadius = Com_Clamp(64.0f, 1024.0f, s_rVolumetricFireRadiusMin->value);
+	maxRadius = Com_Clamp(64.0f, 1024.0f, s_rVolumetricFireRadiusMax->value);
+	if (maxRadius < minRadius)
+	{
+		float temp = minRadius;
+		minRadius = maxRadius;
+		maxRadius = temp;
+	}
+	target = Com_Clamp(minRadius, maxRadius, rawRadius);
+	smoothMs = Com_Clamp(50.0f, 3000.0f, s_rVolumetricFireRadiusSmoothMs->value);
+	VectorSubtract(dl->origin, pool->radiusStateOrigin, delta);
+	if (!pool->radiusStateValid || DotProduct(delta, delta) > (16.0f * 16.0f) ||
+		nowMs < pool->radiusStateLastMs || nowMs - pool->radiusStateLastMs > 2000)
+	{
+		pool->radiusStateValid = qtrue;
+		VectorCopy(dl->origin, pool->radiusStateOrigin);
+		pool->radiusStateValue = target;
+		pool->radiusStateLastMs = nowMs;
+		return pool->radiusStateValue;
+	}
+	dt = nowMs - pool->radiusStateLastMs;
+	pool->radiusStateLastMs = nowMs;
+	alpha = Com_Clamp(0.0f, 1.0f, (float)dt / smoothMs);
+	pool->radiusStateValue += (target - pool->radiusStateValue) * alpha;
+	pool->radiusStateValue = Com_Clamp(minRadius, maxRadius, pool->radiusStateValue);
+	return pool->radiusStateValue;
+}
+
+static int RB_FireVStableSelectResidents(FBO_t *srcFbo, const int *liveIndex,
+	const qboolean *liveSynthetic, int maxActive, int nowMs,
+	int outPool[FIREVOL081_RENDER_CAP], float outWeight[FIREVOL081_RENDER_CAP])
+{
+	const int tier1GraceMs = 650;
+	const int tier2GraceMs = 120;
+	int i, count = 0, fadeMs, holdMs;
+	float preemptDistance;
+	RB_FireVolumetricEnsureCvars();
+	fadeMs = Com_Clamp(0, 2000, s_rVolumetricFireResidencyFadeMs->integer);
+	holdMs = Com_Clamp(0, 5000, s_rVolumetricFireResidencyHoldMs->integer);
+	preemptDistance = Com_Clamp(64.0f, 2048.0f, s_rVolumetricFireResidencyPreemptDistance->value);
+	for (i = 0; i < FIREVOL081_RENDER_CAP; ++i)
+	{
+		outPool[i] = -1;
+		outWeight[i] = 0.0f;
+		if (i >= maxActive)
+			RB_FireVStableClearResident(i);
+	}
+
+	// Retain existing ownership, but never let a latent tier2 source own a GPU slot merely
+	// because it remains inside ActiveRadius. Tier2 gets only a tiny portal/PVS transition grace.
+	for (i = 0; i < maxActive; ++i)
+	{
+		fireVolumetricStableResident_t *resident = &s_fireVStableResidents[i];
+		fireVolumetricV07PoolSlot_t *pool;
+		float distanceWeight, fadeIn = 1.0f, weight;
+		qboolean live;
+		int viewTier;
+		if (resident->poolSlot < 0 || resident->poolSlot >= FIREVOL07_MAX_POOL)
+			continue;
+		pool = &s_fireV07Pool[resident->poolSlot];
+		if (!pool->valid || !pool->latchValid)
+		{
+			RB_FireVStableClearResident(i);
+			continue;
+		}
+		viewTier = RB_FireV083ViewTier(srcFbo, pool);
+		if (resident->viewTier != viewTier)
+		{
+			resident->viewTier = viewTier;
+			resident->viewTierSinceMs = nowMs;
+		}
+		if (viewTier == 2 && nowMs - resident->viewTierSinceMs >= tier2GraceMs)
+		{
+			RB_FireVStableClearResident(i);
+			s_fireVStableResidentRetirements++;
+			s_fireVStableR2Tier2Evictions++;
+			continue;
+		}
+		live = (liveIndex[resident->poolSlot] >= 0 || liveSynthetic[resident->poolSlot]) ? qtrue : qfalse;
+		distanceWeight = RB_FireVStableDistanceWeight(pool->latchedFlameOrigin);
+		if ((!live || distanceWeight <= 0.001f) && resident->retireStartMs <= 0)
+		{
+			resident->retireStartMs = nowMs;
+			resident->retireStartWeight = resident->lastWeight > 0.0f ? resident->lastWeight : distanceWeight;
+			s_fireVStableResidentRetirements++;
+		}
+		if (fadeMs > 0)
+			fadeIn = RB_FireVStableSmooth01((float)(nowMs - resident->acquireMs) / (float)fadeMs);
+		weight = distanceWeight * fadeIn;
+		if (resident->retireStartMs > 0)
+		{
+			float retireT = fadeMs > 0 ? (float)(nowMs - resident->retireStartMs) / (float)fadeMs : 1.0f;
+			float retireWeight = resident->retireStartWeight * (1.0f - RB_FireVStableSmooth01(retireT));
+			if (retireWeight < weight || !live)
+				weight = retireWeight;
+			if (retireT >= 1.0f || weight <= 0.001f)
+			{
+				RB_FireVStableClearResident(i);
+				continue;
+			}
+		}
+		resident->lastWeight = Com_Clamp(0.0f, 1.0f, weight);
+	}
+
+	// Visibility-aware fast promotion. A visible tier0 candidate never waits behind a tier2
+	// resident, and after a short hysteresis window it may also replace a tier1 resident.
+	// These replacements are immediate because the victim is outside the main-camera frustum;
+	// this also stops stale shadow-aware FireVol from projecting into the current room.
+	{
+		int tier0Candidate = RB_FireVStableBestNonResidentTier(srcFbo, liveIndex, liveSynthetic, 0);
+		int victim = -1;
+		float victimDistance = -1.0f;
+		if (tier0Candidate >= 0)
+		{
+			for (i = 0; i < maxActive; ++i)
+			{
+				fireVolumetricStableResident_t *resident = &s_fireVStableResidents[i];
+				fireVolumetricV07PoolSlot_t *pool;
+				float dist;
+				if (resident->poolSlot < 0 || resident->retireStartMs > 0)
+					continue;
+				pool = &s_fireV07Pool[resident->poolSlot];
+				if (!pool->valid || !pool->latchValid)
+					continue;
+				if (resident->viewTier != 2)
+					continue;
+				dist = RB_FireVStableCameraDistance(pool->latchedFlameOrigin);
+				if (dist > victimDistance)
+				{
+					victimDistance = dist;
+					victim = i;
+				}
+			}
+			if (victim >= 0)
+			{
+				RB_FireVStableClearResident(victim);
+				s_fireVStableResidentRetirements++;
+				s_fireVStableR2Tier2Evictions++;
+			}
+			else
+			{
+				for (i = 0; i < maxActive; ++i)
+				{
+					fireVolumetricStableResident_t *resident = &s_fireVStableResidents[i];
+					fireVolumetricV07PoolSlot_t *pool;
+					float dist;
+					if (resident->poolSlot < 0 || resident->retireStartMs > 0 || resident->viewTier != 1)
+						continue;
+					if (nowMs - resident->viewTierSinceMs < tier1GraceMs)
+						continue;
+					pool = &s_fireV07Pool[resident->poolSlot];
+					if (!pool->valid || !pool->latchValid)
+						continue;
+					dist = RB_FireVStableCameraDistance(pool->latchedFlameOrigin);
+					if (dist > victimDistance)
+					{
+						victimDistance = dist;
+						victim = i;
+					}
+				}
+				if (victim >= 0)
+				{
+					RB_FireVStableClearResident(victim);
+					s_fireVStableResidentRetirements++;
+					s_fireVStableR2Tier1Evictions++;
+				}
+			}
+		}
+	}
+
+	// Fill free slots by authoritative tier first, then locality inside the tier.
+	for (i = 0; i < maxActive; ++i)
+	{
+		fireVolumetricStableResident_t *resident = &s_fireVStableResidents[i];
+		int candidate;
+		fireVolumetricV07PoolSlot_t *pool;
+		if (resident->poolSlot >= 0)
+			continue;
+		candidate = RB_FireVStableBestNonResident(srcFbo, liveIndex, liveSynthetic);
+		if (candidate < 0)
+			continue;
+		pool = &s_fireV07Pool[candidate];
+		resident->poolSlot = candidate;
+		resident->acquireMs = nowMs;
+		resident->retireStartMs = 0;
+		resident->retireStartWeight = 0.0f;
+		resident->lastWeight = 0.0f;
+		resident->viewTier = RB_FireV083ViewTier(srcFbo, pool);
+		resident->viewTierSinceMs = nowMs;
+	}
+
+	// Same-tier locality preemption keeps Production v1 hysteresis. The 384-unit/1500-ms
+	// rule is intentionally NOT used for tier0-vs-tier2 or tier0-vs-mature-tier1 above.
+	{
+		qboolean retirementInProgress = qfalse;
+		int candidate = -1;
+		for (i = 0; i < maxActive; ++i)
+			if (s_fireVStableResidents[i].poolSlot >= 0 && s_fireVStableResidents[i].retireStartMs > 0)
+				retirementInProgress = qtrue;
+		if (!retirementInProgress)
+			candidate = RB_FireVStableBestNonResident(srcFbo, liveIndex, liveSynthetic);
+		if (candidate >= 0)
+		{
+			fireVolumetricV07PoolSlot_t *candidatePool = &s_fireV07Pool[candidate];
+			int candidateTier = RB_FireV083ViewTier(srcFbo, candidatePool);
+			float candidateDist = RB_FireVStableCameraDistance(candidatePool->latchedFlameOrigin);
+			int victimResident = -1;
+			float farthestDist = -1.0f;
+			for (i = 0; i < maxActive; ++i)
+			{
+				fireVolumetricStableResident_t *resident = &s_fireVStableResidents[i];
+				fireVolumetricV07PoolSlot_t *pool;
+				float residentDist;
+				if (resident->poolSlot < 0 || resident->retireStartMs > 0)
+					continue;
+				if (resident->viewTier != candidateTier)
+					continue;
+				if (nowMs - resident->acquireMs < holdMs)
+					continue;
+				pool = &s_fireV07Pool[resident->poolSlot];
+				if (!pool->valid || !pool->latchValid)
+					continue;
+				residentDist = RB_FireVStableCameraDistance(pool->latchedFlameOrigin);
+				if (residentDist > candidateDist + preemptDistance && residentDist > farthestDist)
+				{
+					farthestDist = residentDist;
+					victimResident = i;
+				}
+			}
+			if (victimResident >= 0)
+			{
+				fireVolumetricStableResident_t *resident = &s_fireVStableResidents[victimResident];
+				resident->retireStartMs = nowMs;
+				resident->retireStartWeight = resident->lastWeight;
+				s_fireVStableResidentRetirements++;
+			}
+		}
+	}
+
+	for (i = 0; i < maxActive; ++i)
+	{
+		fireVolumetricStableResident_t *resident = &s_fireVStableResidents[i];
+		fireVolumetricV07PoolSlot_t *pool;
+		float weight;
+		if (resident->poolSlot < 0 || resident->poolSlot >= FIREVOL07_MAX_POOL)
+			continue;
+		pool = &s_fireV07Pool[resident->poolSlot];
+		if (!pool->valid || !pool->latchValid)
+			continue;
+		weight = resident->lastWeight;
+		if (weight <= 0.0f)
+		{
+			float fadeIn = fadeMs > 0 ? RB_FireVStableSmooth01((float)(nowMs - resident->acquireMs) / (float)fadeMs) : 1.0f;
+			weight = RB_FireVStableDistanceWeight(pool->latchedFlameOrigin) * fadeIn;
+			resident->lastWeight = weight;
+		}
+		if (weight <= 0.001f)
+			continue;
+		outPool[count] = resident->poolSlot;
+		outWeight[count] = Com_Clamp(0.0f, 1.0f, weight);
+		count++;
+	}
+	return count;
+}
+
+static int RB_FireV07BestAdmissionDlight(int sourceMode, int maxSlots, const int *usedAnchors, int usedAnchorCount,
+	const qboolean *blockedFallbackOwners, float maxDistance, int *outAnchor, float *outBestDistance, float *outSpeakerDistance,
+	int *outCandidateCount, float *outSecondDistance, int *outAmbiguity)
+{
+	int i, bestIndex = -1, bestAnchor = -1;
+	float bestScore = -1.0f;
+	float bestDistance = -1.0f, bestSpeakerDistance = -1.0f, bestSecondDistance = -1.0f;
+	int bestCandidateCount = 0, bestAmbiguity = 0;
+	for (i = 0; i < backEnd.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+	{
+		dlight_t *dl = &backEnd.refdef.dlights[i];
+		int anchorIndex, candidateCount = 0, ambiguity = 0;
+		float dlightDistance = -1.0f, speakerDistance = -1.0f, secondDistance = -1.0f;
+		float score;
+		if (!RB_FireVolumetricEligible(dl, sourceMode))
+			continue;
+		if (dl->fireVolumetricNativeOrdinal < 0 && blockedFallbackOwners && blockedFallbackOwners[i])
+			continue;
+		anchorIndex = RB_FireV07FindRenderedAnchor(dl, usedAnchors, usedAnchorCount, maxDistance,
+			&dlightDistance, &speakerDistance, &candidateCount, &secondDistance, &ambiguity);
+		if (anchorIndex < 0)
+			continue;
+		// Positive native identities keep the proven path. The -1 fallback path may bind only
+		// to a real flame-family fixture; burn/scorch decals can no longer create DLight-backed entries.
+		if (dl->fireVolumetricNativeOrdinal < 0 &&
+			!RB_FireV082ShaderLooksLikeFlame(s_fireV07Anchors[anchorIndex].shaderName))
+			continue;
+		if (RB_FireV082IdentityInPool(dl->fireVolumetricNativeOrdinal,
+			&s_fireV07Anchors[anchorIndex], maxSlots))
+			continue;
+		score = RB_LocalVolumetricDlightScore(dl);
+		if (score > bestScore)
+		{
+			bestScore = score;
+			bestIndex = i;
+			bestAnchor = anchorIndex;
+			bestDistance = dlightDistance;
+			bestSpeakerDistance = speakerDistance;
+			bestCandidateCount = candidateCount;
+			bestSecondDistance = secondDistance;
+			bestAmbiguity = ambiguity;
+		}
+	}
+	if (outAnchor) *outAnchor = bestAnchor;
+	if (outBestDistance) *outBestDistance = bestDistance;
+	if (outSpeakerDistance) *outSpeakerDistance = bestSpeakerDistance;
+	if (outCandidateCount) *outCandidateCount = bestCandidateCount;
+	if (outSecondDistance) *outSecondDistance = bestSecondDistance;
+	if (outAmbiguity) *outAmbiguity = bestAmbiguity;
+	return bestIndex;
+}
+
+// DARKWOLF_FIREVOL_OCCLUSION_PRODUCTION_V1: source selection is not changed; this helper only locates a ready cached shadow for an already-selected source.
+// DARKWOLF_FIREVOL_STABLE_RESIDENCY_FULL_FIXTURE_REGISTRY_PRODUCTION_V1
+// DARKWOLF_FIREVOL_STABLE_RESIDENCY_PVS_VIEW_TIER_CORRECTION_R2
+// R2 keeps Production v1 radius/sourceWeight/capture work, but makes the eight GPU residents
+// visibility-aware: tier0 > tier1 > tier2. Tier2 cannot remain sticky due to distance alone.
+// DARKWOLF_FIREVOL_STABLE_RESIDENCY_TIER2_REACQUIRE_GATE_FULL_CANDIDATE_AUDIT_R3
+// R3 closes the R2 reacquire loop: a nonresident tier2 fixture remains registered but cannot
+// newly acquire one of the eight GPU residency slots until it returns to tier0 or tier1.
+// R3 also audits every registered candidate plus selected shadow/cache identity without changing
+// the accepted FireVol Occlusion v1 shadow generation, cache capture, or render path.
+// Production candidate over runtime-accepted Run 34012437835. Registry/capture/residency/radius
+// are improved while the proven FireVol occlusion/shadow architecture remains unchanged.
+static image_t *RB_FireVolProductionFindCachedShadow(const fireVolumetricV07Selection_t *sel, dlight_t *shadowLight)
+{
+	int i;
+	if (!sel || !sel->latchValid || !shadowLight) return NULL;
+	for (i = 0; i < FIREVOL_SYNTH_SHADOW_CACHE_MAX; ++i)
+	{
+		fireVolumetricSyntheticShadowCache_t *cache = &tr.fireVolumetricSyntheticShadowCache[i];
+		vec3_t delta;
+		if (!cache->valid || cache->flameSurface != sel->latchedFlameSurface || !tr.fireVolumetricSyntheticShadowCubemaps[i]) continue;
+		VectorSubtract(cache->captureOrigin, sel->latchedFlameOrigin, delta);
+		if (DotProduct(delta, delta) > 4.0f) continue;
+		Com_Memset(shadowLight, 0, sizeof(*shadowLight));
+		VectorCopy(cache->captureOrigin, shadowLight->origin);
+		VectorSet(shadowLight->color, 1.0f, 1.0f, 1.0f);
+		shadowLight->radius = MAX(cache->captureRadius, 1.0f);
+		cache->lastUsedTime = backEnd.refdef.time;
+		return tr.fireVolumetricSyntheticShadowCubemaps[i];
+	}
+	return NULL;
+}
+
+static const char *RB_FireVStableR2ShadowPath(const fireVolumetricV07Selection_t *sel)
+{
+	int i;
+	if (!sel || !sel->latchValid)
+		return "INVALID";
+	if (!sel->syntheticVolumeOnly && sel->shadowSlot >= 0 && sel->shadowSlot < MAX_DLIGHT_SHADOWS &&
+		tr.shadowCubemaps[sel->shadowSlot])
+		return "REAL_DLIGHT_CUBEMAP";
+	for (i = 0; i < FIREVOL_SYNTH_SHADOW_CACHE_MAX; ++i)
+	{
+		fireVolumetricSyntheticShadowCache_t *cache = &tr.fireVolumetricSyntheticShadowCache[i];
+		vec3_t delta;
+		if (!cache->valid || cache->flameSurface != sel->latchedFlameSurface ||
+			!tr.fireVolumetricSyntheticShadowCubemaps[i])
+			continue;
+		VectorSubtract(cache->captureOrigin, sel->latchedFlameOrigin, delta);
+		if (DotProduct(delta, delta) <= 4.0f)
+			return "SYNTHETIC_CACHE";
+	}
+	return "BASE_FALLBACK";
+}
