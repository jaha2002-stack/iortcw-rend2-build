+static qboolean RB_DlightFootprintLockedActive(void)
+{
+	return RB_DlightMaterialLockedActive();
+}
+
+static qboolean RB_DlightFootprintSnapshotMatches(void)
+{
+	vec3_t originDelta;
+	vec3_t colorDelta;
+	VectorSubtract(dlightMaterialDiagLockOrigin, s_dlightFootprintFrozenOrigin, originDelta);
+	VectorSubtract(dlightMaterialDiagLockColor, s_dlightFootprintFrozenColor, colorDelta);
+	if (DotProduct(originDelta, originDelta) > 0.0001f)
+		return qfalse;
+	if (DotProduct(colorDelta, colorDelta) > 0.000001f)
+		return qfalse;
+	if (fabs(dlightMaterialDiagLockRadius - s_dlightFootprintFrozenRadius) > 0.001f)
+		return qfalse;
+	return qtrue;
+}
+
+static void RB_DlightFootprintSetFixedSettings(void)
+{
+	// These values must remain identical across all four captures.
+	ri.Cvar_Set("r_dlightShadowCasterMode", "0");
+	ri.Cvar_Set("r_dlightShadowKernelMode", "0");
+	ri.Cvar_Set("r_dlightShadowBias", "0.0033");
+	ri.Cvar_Set("r_dlightShadowStrength", "0.88");
+	ri.Cvar_Set("r_dlightMaterialStage", "0");
+	ri.Cvar_Set("r_dlightMaterialProbe", "0");
+}
+
+static void RB_DlightFootprintConfigureStage(int stage)
+{
+	char value[32];
+	if (stage < 0) stage = 0;
+	if (stage > 3) stage = 3;
+	s_dlightFootprintStage = stage;
+	s_dlightFootprintActiveMs = 0;
+	s_dlightFootprintLastTick = ri.Milliseconds();
+	RB_DlightFootprintSetFixedSettings();
+	Com_sprintf(value, sizeof(value), "%.2f", s_dlightFootprintSoftness[stage]);
+	ri.Cvar_Set("r_dlightShadowSoftness", value);
+	ri.Printf(PRINT_ALL,
+		"DLIGHT_FOOTPRINT_AB configured stage=%d name=%s map=512 caster=0 kernel=0 bias=0.0033 strength=0.88 softness=%s frozenIndex=%d\n",
+		stage + 1, RB_DlightFootprintStageName(stage), value, dlightMaterialDiagLockCurrentIndex);
+}
+
+static void RB_DlightFootprintRecordStage(int stage)
+{
+	char line[768];
+	char command[192];
+	qboolean stable = RB_DlightFootprintSnapshotMatches();
+	if (!stable)
+		s_dlightFootprintSnapshotStable = 0;
+	Com_sprintf(line, sizeof(line),
+		"stage=%d name=%s mapSize=512 caster=0 kernel=0 bias=0.0033 strength=0.88 softness=%.2f lockIndex=%d frozenOrigin=%.2f,%.2f,%.2f frozenRadius=%.2f frozenColor=%.3f,%.3f,%.3f snapshotStable=%d\n",
+		stage + 1, RB_DlightFootprintStageName(stage), s_dlightFootprintSoftness[stage],
+		dlightMaterialDiagLockCurrentIndex,
+		dlightMaterialDiagLockOrigin[0], dlightMaterialDiagLockOrigin[1], dlightMaterialDiagLockOrigin[2],
+		dlightMaterialDiagLockRadius,
+		dlightMaterialDiagLockColor[0], dlightMaterialDiagLockColor[1], dlightMaterialDiagLockColor[2],
+		stable ? 1 : 0);
+	RB_DlightFootprintAppend(line);
+	ri.Printf(PRINT_ALL, "DLIGHT_FOOTPRINT_CAPTURE %s", line);
+	Com_sprintf(command, sizeof(command), "screenshot dlight_footprint_ab_%s\n", RB_DlightFootprintStageName(stage));
+	ri.Cmd_ExecuteText(EXEC_APPEND, command);
+}
+
+static void RB_DlightFootprintRestore(void)
+{
+	// Restore accepted production V8.5/V8.6 shadow quality values.
+	ri.Cvar_Set("r_dlightShadowCasterMode", "0");
+	ri.Cvar_Set("r_dlightShadowKernelMode", "0");
+	ri.Cvar_Set("r_dlightShadowBias", "0.0033");
+	ri.Cvar_Set("r_dlightShadowSoftness", "1.70");
+	ri.Cvar_Set("r_dlightShadowStrength", "0.88");
+	ri.Cvar_Set("r_dlightMaterialStage", "0");
+	ri.Cvar_Set("r_dlightMaterialProbe", "0");
+	ri.Cvar_Set("r_dlightShadowTestLock", "0");
+}
+
+static void RB_DlightFootprintReset(void)
+{
+	s_dlightFootprintState = 0;
+	s_dlightFootprintStage = -1;
+	s_dlightFootprintLastTick = 0;
+	s_dlightFootprintActiveMs = 0;
+	s_dlightFootprintWaitStamp = 0;
+	s_dlightFootprintSnapshotStable = 1;
+	s_dlightFootprintSummaryLength = 0;
+	s_dlightFootprintSummary[0] = '\0';
+	VectorClear(s_dlightFootprintFrozenOrigin);
+	VectorClear(s_dlightFootprintFrozenColor);
+	s_dlightFootprintFrozenRadius = 0.0f;
+}
+
+static void RB_DlightFootprintAutoTestStep(void)
+{
+	int now;
+	int stageTime;
+
+	if (!r_dlightFootprintAutoTest || !r_dlightFootprintAutoTest->integer)
+	{
+		if (s_dlightFootprintState != 0)
+		{
+			RB_DlightFootprintRestore();
+			RB_DlightFootprintReset();
+		}
+		return;
+	}
+	if (backEnd.refdef.rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+		return;
+
+	now = ri.Milliseconds();
+	stageTime = r_dlightShadowAutoStageTime ? r_dlightShadowAutoStageTime->integer : 1800;
+	if (stageTime < 800) stageTime = 800;
+	if (stageTime > 5000) stageTime = 5000;
+
+	if (s_dlightFootprintState == 0)
+	{
+		RB_DlightFootprintReset();
+		if (!r_dlightShadowMapSize || r_dlightShadowMapSize->integer != 512)
+		{
+			ri.Printf(PRINT_ALL,
+				"DLIGHT_FOOTPRINT_AB ABORT: requires r_dlightShadowMapSize 512 at renderer startup; current=%d\n",
+				r_dlightShadowMapSize ? r_dlightShadowMapSize->integer : -1);
+			ri.Cvar_Set("r_dlightFootprintAutoTest", "0");
+			return;
+		}
+		// Explicitly suppress the two older auto-tests so they cannot contaminate this A/B.
+		ri.Cvar_Set("r_dlightShadowAutoTest", "0");
+		ri.Cvar_Set("r_dlightMaterialAutoTest", "0");
+		ri.Cvar_Set("r_dlightMaterialProbe", "0");
+		ri.Cvar_Set("r_dlightMaterialStage", "0");
+		ri.Cvar_Set("r_dlightShadowTestLock", "1");
+		RB_DlightFootprintSetFixedSettings();
+		RB_DlightFootprintAppend("REND2_DLIGHT_FROZEN_TESLA_FOOTPRINT_AB_V8_6_8\n");
+		RB_DlightFootprintAppend("base=REND2_DLIGHT_MODEL_BMODEL_MATERIAL_PROBE_V8_6_7\n");
+		RB_DlightFootprintAppend("lockMode=TESLA_BLUE_EXACT_FROZEN_UNCHANGED_FROM_V8_6_6\n");
+		RB_DlightFootprintAppend("invariant=map512_caster0_kernel0_bias0.0033_strength0.88_material_and_caster_paths_unchanged\n");
+		RB_DlightFootprintAppend("variable=r_dlightShadowSoftness_only values=1.70,1.20,0.80,0.50\n");
+		s_dlightFootprintState = 1;
+		s_dlightFootprintWaitStamp = now;
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_FOOTPRINT_AB armed: wait for stationary blue Tesla; exact origin/radius/color will freeze once and all four softness stages will capture automatically\n");
+		return;
+	}
+
+	if (s_dlightFootprintState == 1)
+	{
+		char line[512];
+		if (!RB_DlightFootprintLockedActive())
+		{
+			if (now - s_dlightFootprintWaitStamp > 2000)
+			{
+				s_dlightFootprintWaitStamp = now;
+				ri.Printf(PRINT_ALL, "DLIGHT_FOOTPRINT_AB waiting for exact frozen stationary Tesla pulse\n");
+			}
+			return;
+		}
+		VectorCopy(dlightMaterialDiagLockOrigin, s_dlightFootprintFrozenOrigin);
+		VectorCopy(dlightMaterialDiagLockColor, s_dlightFootprintFrozenColor);
+		s_dlightFootprintFrozenRadius = dlightMaterialDiagLockRadius;
+		Com_sprintf(line, sizeof(line),
+			"initialLockIndex=%d frozenOrigin=%.2f,%.2f,%.2f frozenRadius=%.2f frozenColor=%.3f,%.3f,%.3f\n",
+			dlightMaterialDiagLockCurrentIndex,
+			s_dlightFootprintFrozenOrigin[0], s_dlightFootprintFrozenOrigin[1], s_dlightFootprintFrozenOrigin[2],
+			s_dlightFootprintFrozenRadius,
+			s_dlightFootprintFrozenColor[0], s_dlightFootprintFrozenColor[1], s_dlightFootprintFrozenColor[2]);
+		RB_DlightFootprintAppend(line);
+		RB_DlightFootprintConfigureStage(0);
+		s_dlightFootprintState = 2;
+		return;
+	}
+
+	if (s_dlightFootprintState == 2)
+	{
+		int delta = now - s_dlightFootprintLastTick;
+		s_dlightFootprintLastTick = now;
+		if (!RB_DlightFootprintLockedActive())
+			return;
+		if (!RB_DlightFootprintSnapshotMatches())
+			s_dlightFootprintSnapshotStable = 0;
+		if (delta < 0) delta = 0;
+		if (delta > 100) delta = 100;
+		s_dlightFootprintActiveMs += delta;
+		if (s_dlightFootprintActiveMs < stageTime)
+			return;
+		RB_DlightFootprintRecordStage(s_dlightFootprintStage);
+		s_dlightFootprintState = 3;
+		s_dlightFootprintWaitStamp = now;
+		return;
+	}
+
+	if (s_dlightFootprintState == 3)
+	{
+		if (now - s_dlightFootprintWaitStamp < 650)
+			return;
+		if (s_dlightFootprintStage < 3)
+		{
+			RB_DlightFootprintConfigureStage(s_dlightFootprintStage + 1);
+			s_dlightFootprintState = 2;
+			return;
+		}
+
+		if (s_dlightFootprintSnapshotStable)
+			RB_DlightFootprintAppend("snapshotValidation=PASS_EXACT_FROZEN_ORIGIN_RADIUS_COLOR_ALL_STAGES\n");
+		else
+			RB_DlightFootprintAppend("snapshotValidation=FAIL_FROZEN_LIGHT_CHANGED_TEST_INVALID\n");
+		RB_DlightFootprintAppend("status=COMPLETE\n");
+		ri.FS_WriteFile("dlight_footprint_ab_summary.txt", s_dlightFootprintSummary, s_dlightFootprintSummaryLength);
+		ri.Cmd_ExecuteText(EXEC_APPEND, "condump dlight_footprint_ab_console.txt\n");
+		RB_DlightFootprintRestore();
+		ri.Cvar_Set("r_dlightFootprintAutoTest", "0");
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_FOOTPRINT_AB COMPLETE: 4 frozen-light screenshots + dlight_footprint_ab_summary.txt; production softness restored to 1.70\n");
+		s_dlightFootprintState = 4;
+		return;
+	}
+}
+
+static void RB_DlightMaterialAutoTestStep(void)
+{
+	int now;
+	int stageTime;
+
+	// REND2_DLIGHT_FROZEN_TESLA_FOOTPRINT_AB_V8_6_8: share the already-proven
+	// once-per-frame backend diagnostic hook. Keep this after local declarations
+	// so the source remains compatible with the existing renderer C style.
+	RB_DlightFootprintAutoTestStep();
+	if (r_dlightFootprintAutoTest && r_dlightFootprintAutoTest->integer)
+		return;
+
+	if (!r_dlightMaterialAutoTest || !r_dlightMaterialAutoTest->integer)
+	{
+		if (s_dlightMaterialAutoState != 0)
+			RB_DlightMaterialReset();
+		return;
+	}
+	if (backEnd.refdef.rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+		return;
+
+	now = ri.Milliseconds();
+	stageTime = r_dlightShadowAutoStageTime ? r_dlightShadowAutoStageTime->integer : 1800;
+
+	if (s_dlightMaterialAutoState == 0)
+	{
+		RB_DlightMaterialReset();
+		dlightMaterialDiagTargetShaderIndex = -1;
+		dlightMaterialDiagTargetSurfaceIndex = -1;
+		dlightMaterialDiagTargetEntityNum = -1;
+		dlightMaterialDiagTargetShaderName[0] = '\0';
+		ri.Cvar_Set("r_dlightShadowAutoTest", "0");
+		ri.Cvar_Set("r_dlightMaterialStage", "0");
+		ri.Cvar_Set("r_dlightMaterialProbe", "1");
+		ri.Cvar_Set("r_dlightShadowTestLock", "1");
+		RB_DlightMaterialAppend("REND2_DLIGHT_MODEL_BMODEL_MATERIAL_PROBE_V8_6_7\n");
+		RB_DlightMaterialAppend("base=REND2_DLIGHT_ROBUST_PROBE_FROZEN_RES_V8_6_6\n");
+		RB_DlightMaterialAppend("purpose=exact_bsp_bmodel_or_mdv_grating_material_path_with_unchanged_frozen_tesla\n");
+		RB_DlightMaterialAppend("lockMode=TESLA_BLUE_EXACT_FROZEN_UNCHANGED_FROM_V8_6_6\n");
+		s_dlightMaterialAutoState = 1;
+		s_dlightMaterialAutoWaitStamp = now;
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_MATERIAL_AUTOTEST armed: center dot must be on a SOLID grating bar; waiting for exact material probe + one real dlight lock\n");
+		return;
+	}
+
+	if (s_dlightMaterialAutoState == 1)
+	{
+		char line[768];
+		// -1 means no target; -2 is the V8.6.7 exact model-entity/shader sentinel.
+		if (dlightMaterialDiagTargetShaderIndex < 0 || dlightMaterialDiagTargetSurfaceIndex == -1)
+		{
+			if (now - s_dlightMaterialAutoWaitStamp > 3000)
+			{
+				ri.Cvar_Set("r_dlightMaterialProbe", "1");
+				s_dlightMaterialAutoWaitStamp = now;
+				ri.Printf(PRINT_ALL,
+					"DLIGHT_MATERIAL_AUTOTEST waiting: no exact BSP/BMODEL/MDV triangle hit yet; keep center dot on a solid grating bar\n");
+			}
+			return;
+		}
+		if (!RB_DlightMaterialLockedActive())
+		{
+			if (now - s_dlightMaterialAutoWaitStamp > 2000)
+			{
+				s_dlightMaterialAutoWaitStamp = now;
+				ri.Printf(PRINT_ALL,
+					"DLIGHT_MATERIAL_AUTOTEST waiting: target=%s identified, waiting for the locked Tesla/dlight pulse\n",
+					dlightMaterialDiagTargetShaderName);
+			}
+			return;
+		}
+		Com_sprintf(line, sizeof(line),
+			"targetSurface=%d targetEntity=%d shader=%s sort=%d alpha=%d blend=%d passes=%d initialLockIndex=%d initialLockOrigin=%.2f,%.2f,%.2f initialLockRadius=%.2f initialLockColor=%.3f,%.3f,%.3f\n",
+			dlightMaterialDiagTargetSurfaceIndex, dlightMaterialDiagTargetEntityNum,
+			dlightMaterialDiagTargetShaderName, dlightMaterialDiagTargetSort,
+			dlightMaterialDiagTargetHasAlpha, dlightMaterialDiagTargetHasBlend,
+			dlightMaterialDiagTargetNumPasses, dlightMaterialDiagLockCurrentIndex,
+			dlightMaterialDiagLockOrigin[0], dlightMaterialDiagLockOrigin[1], dlightMaterialDiagLockOrigin[2],
+			dlightMaterialDiagLockRadius,
+			dlightMaterialDiagLockColor[0], dlightMaterialDiagLockColor[1], dlightMaterialDiagLockColor[2]);
+		RB_DlightMaterialAppend(line);
+		RB_DlightMaterialConfigureStage(0);
+		s_dlightMaterialAutoState = 2;
+		return;
+	}
+
+	if (s_dlightMaterialAutoState == 2)
+	{
+		int delta = now - s_dlightMaterialAutoLastTick;
+		s_dlightMaterialAutoLastTick = now;
+		if (!RB_DlightMaterialLockedActive())
+			return;
+		if (delta < 0) delta = 0;
+		if (delta > 100) delta = 100;
+		s_dlightMaterialAutoActiveMs += delta;
+		if (s_dlightMaterialAutoActiveMs < stageTime)
+			return;
+		RB_DlightMaterialRecordStage(s_dlightMaterialAutoStage);
+		s_dlightMaterialAutoState = 3;
+		s_dlightMaterialAutoWaitStamp = now;
+		return;
+	}
+
+	if (s_dlightMaterialAutoState == 3)
+	{
+		if (now - s_dlightMaterialAutoWaitStamp < 650)
+			return;
+		if (s_dlightMaterialAutoStage < 3)
+		{
+			RB_DlightMaterialConfigureStage(s_dlightMaterialAutoStage + 1);
+			s_dlightMaterialAutoState = 2;
+			return;
+		}
+
+		if (s_materialStageSeen[0] == 0)
+			RB_DlightMaterialAppend("diagnosis=TARGET_NOT_REACHED_R_ADDWORLDSURFACE_IN_BASELINE\n");
+		else if (s_materialStageAdded[0] == 0 && s_materialStageCulled[0] > 0 && s_materialStageAdded[2] > 0)
+			RB_DlightMaterialAppend("diagnosis=FRONTEND_SURFACE_CULL_CONFIRMED\n");
+		else if (s_materialStageAdded[0] > 0 && s_materialStageBackendRendered[0] == 0 && s_materialStageBackendRendered[1] > 0)
+			RB_DlightMaterialAppend("diagnosis=BACKEND_SHADER_SORT_EXCLUSION_CONFIRMED\n");
+		else if (s_materialStageAdded[0] > 0 && s_materialStageBackendRendered[0] > 0)
+			RB_DlightMaterialAppend("diagnosis=TARGET_ALREADY_REACHES_POINT_SHADOW_RENDER_PATH_CHECK_LIGHT_GEOMETRY_OR_RESOLUTION\n");
+		else
+			RB_DlightMaterialAppend("diagnosis=CHECK_STAGE_COUNTERS_AND_SCREENSHOTS\n");
+
+		if (dlightMaterialDiagTargetHasAlpha)
+			RB_DlightMaterialAppend(s_materialStageAlphaAware[3] > 0 ?
+				"alphaAware=TARGET_ALPHA_AWARE_PATH_EXECUTED\n" :
+				"alphaAware=TARGET_HAS_ALPHA_BUT_ALPHA_AWARE_PATH_NOT_EXECUTED\n");
+		else
+			RB_DlightMaterialAppend("alphaAware=TARGET_HAS_NO_ALPHA_TEST\n");
+		RB_DlightMaterialAppend("status=COMPLETE\n");
+		ri.FS_WriteFile("dlight_material_lock_summary.txt", s_dlightMaterialAutoSummary,
+			s_dlightMaterialAutoSummaryLength);
+		ri.Cmd_ExecuteText(EXEC_APPEND, "condump dlight_material_lock_console.txt\n");
+		RB_DlightMaterialRestore();
+		ri.Cvar_Set("r_dlightMaterialAutoTest", "0");
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_MATERIAL_AUTOTEST COMPLETE: dlight_material_probe.txt + 4 locked-light screenshots + dlight_material_lock_summary.txt\n");
+		s_dlightMaterialAutoState = 4;
+	}
+}
+
+// REND2_DLIGHT_AUTOCAPTURE_V3
+static int s_dlightDiagAutoState = 0;
+static int s_dlightDiagAutoStage = -1;
+static int s_dlightDiagAutoStamp = 0;
+static int s_dlightDiagAutoSummaryLength = 0;
+static char s_dlightDiagAutoSummary[4096];
+
+static const char *RB_DlightDiagAutoStageName(int stage)
+{
+	static const char *names[6] = {
+		"01_F7_NORMAL",
+		"02_F8_SHADOW_RED_GREEN",
+		"03_F9_SHADOW_GRAYSCALE",
+		"04_F10_CUBEMAP_HEAT",
+		"05_F11_CUBEMAP_GRAYSCALE",
+		"06_F12_CUBEMAP_RAW_RGB"
+	};
+
+	if (stage < 0 || stage >= 6)
+		return "UNKNOWN";
+	return names[stage];
+}
+
+static void RB_DlightDiagAutoAppend(const char *line)
+{
+	int length;
+
+	if (!line)
+		return;
+	length = (int)strlen(line);
+	if (length <= 0 || s_dlightDiagAutoSummaryLength + length >= (int)sizeof(s_dlightDiagAutoSummary) - 1)
+		return;
+	memcpy(s_dlightDiagAutoSummary + s_dlightDiagAutoSummaryLength, line, length);
+	s_dlightDiagAutoSummaryLength += length;
+	s_dlightDiagAutoSummary[s_dlightDiagAutoSummaryLength] = '\0';
+}
+
+static int RB_DlightDiagAutoCapturedFaces(void)
+{
+	return backEnd.dlightDiagCaptureTime == backEnd.refdef.time
+		? backEnd.dlightDiagFacesCaptured : 0;
+}
+
+static void RB_DlightDiagAutoConfigureStage(int stage)
+{
+	s_dlightDiagAutoStage = stage;
+	ri.Cvar_Set("r_dlightDiagTintSelected", "1");
+
+	switch (stage)
+	{
+	case 0: // F7: normal shaded result, no cubemap atlas
+		ri.Cvar_Set("r_dlightDiagShadowView", "0");
+		ri.Cvar_Set("r_dlightDiagDepth", "0");
+		ri.Cvar_Set("r_dlightDiagDepthMode", "0");
+		break;
+	case 1: // F8: red=blocked, green=visible, blue=no slot
+		ri.Cvar_Set("r_dlightDiagShadowView", "1");
+		ri.Cvar_Set("r_dlightDiagDepth", "0");
+		ri.Cvar_Set("r_dlightDiagDepthMode", "0");
+		break;
+	case 2: // F9: grayscale visibility
+		ri.Cvar_Set("r_dlightDiagShadowView", "2");
+		ri.Cvar_Set("r_dlightDiagDepth", "0");
+		ri.Cvar_Set("r_dlightDiagDepthMode", "0");
+		break;
+	case 3: // F10: six-face decoded heat map
+		ri.Cvar_Set("r_dlightDiagShadowView", "0");
+		ri.Cvar_Set("r_dlightDiagDepth", "1");
+		ri.Cvar_Set("r_dlightDiagDepthMode", "0");
+		break;
+	case 4: // F11: six-face decoded grayscale
+		ri.Cvar_Set("r_dlightDiagShadowView", "0");
+		ri.Cvar_Set("r_dlightDiagDepth", "1");
+		ri.Cvar_Set("r_dlightDiagDepthMode", "1");
+		break;
+	default: // F12: raw packed RGB
+		ri.Cvar_Set("r_dlightDiagShadowView", "0");
+		ri.Cvar_Set("r_dlightDiagDepth", "1");
+		ri.Cvar_Set("r_dlightDiagDepthMode", "2");
+		break;
+	}
+
+	ri.Printf(PRINT_ALL,
+		"DLIGHT_DIAG_AUTOCAPTURE configured stage=%d name=%s shadowView=%d depth=%d depthMode=%d\n",
+		stage + 7, RB_DlightDiagAutoStageName(stage),
+		r_dlightDiagShadowView->integer, r_dlightDiagDepth->integer,
+		r_dlightDiagDepthMode->integer);
+}
+
+static void RB_DlightDiagAutoRecordStage(int stage)
+{
+	char line[512];
+	char command[160];
+	int slot = backEnd.refdef.dlightDiagSelectedSlot;
+	int depthSlot = r_dlightDiagDepthSlot->integer >= 0
+		? r_dlightDiagDepthSlot->integer : slot;
+	int captured = RB_DlightDiagAutoCapturedFaces();
+
+	Com_sprintf(line, sizeof(line),
+		"stage=%d name=%s active=%d injected=%d selected=%d slot=%d facesIssued=%d facesCaptured=%d lightallShadowDraws=%d depthSlot=%d shadowView=%d depth=%d depthMode=%d\n",
+		stage + 7, RB_DlightDiagAutoStageName(stage), backEnd.refdef.num_dlights,
+		backEnd.refdef.dlightDiagInjectedIndex,
+		backEnd.refdef.dlightDiagSelectedIndex, slot,
+		backEnd.refdef.dlightDiagFacesIssued, captured,
+		backEnd.dlightDiagShadowLightallDraws, depthSlot,
+		r_dlightDiagShadowView->integer, r_dlightDiagDepth->integer,
+		r_dlightDiagDepthMode->integer);
+	RB_DlightDiagAutoAppend(line);
+
+	ri.Printf(PRINT_ALL, "DLIGHT_DIAG_CAPTURE %s", line);
+	Com_sprintf(command, sizeof(command), "screenshot dlight_diag_%s\n",
+		RB_DlightDiagAutoStageName(stage));
+	ri.Cmd_ExecuteText(EXEC_APPEND, command);
+}
+
+static void RB_DlightDiagAutoReset(void)
+{
+	s_dlightDiagAutoState = 0;
+	s_dlightDiagAutoStage = -1;
+	s_dlightDiagAutoStamp = 0;
+	s_dlightDiagAutoSummaryLength = 0;
+	s_dlightDiagAutoSummary[0] = '\0';
+}
+
+static void RB_DlightDiagAutoCaptureStep(void)
+{
+	int now;
+	int delay;
+	int stageTime;
+
+	if (!r_dlightDiagAutoCapture || !r_dlightDiagAutoCapture->integer)
+	{
+		if (s_dlightDiagAutoState != 0)
+			RB_DlightDiagAutoReset();
+		return;
+	}
+
+	// Do not start in menus, loading screens, sky portals, or auxiliary views.
+	if (backEnd.refdef.rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+		return;
+	if (backEnd.refdef.dlightDiagInjectedIndex < 0)
+		return;
+
+	now = ri.Milliseconds();
+	delay = r_dlightDiagAutoDelay->integer;
+	stageTime = r_dlightDiagAutoStageTime->integer;
+
+	if (s_dlightDiagAutoState == 0)
+	{
+		RB_DlightDiagAutoReset();
+		s_dlightDiagAutoState = 1;
+		s_dlightDiagAutoStamp = now;
+		RB_DlightDiagAutoAppend("REND2_DLIGHT_AUTOCAPTURE_V3\n");
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_DIAG_AUTOCAPTURE armed delayMs=%d stageMs=%d autoQuit=%d\n",
+			delay, stageTime, r_dlightDiagAutoQuit->integer);
+		return;
+	}
+
+	if (s_dlightDiagAutoState == 1)
+	{
+		if (now - s_dlightDiagAutoStamp < delay)
+			return;
+		RB_DlightDiagAutoConfigureStage(0);
+		s_dlightDiagAutoState = 2;
+		s_dlightDiagAutoStamp = now;
+		return;
+	}
+
+	if (s_dlightDiagAutoState == 2)
+	{
+		if (now - s_dlightDiagAutoStamp < stageTime)
+			return;
+		RB_DlightDiagAutoRecordStage(s_dlightDiagAutoStage);
+		s_dlightDiagAutoState = 3;
+		s_dlightDiagAutoStamp = now;
+		return;
+	}
+
+	if (s_dlightDiagAutoState == 3)
+	{
+		// Give the renderer enough time to execute the queued screenshot command.
+		if (now - s_dlightDiagAutoStamp < 750)
+			return;
+
+		if (s_dlightDiagAutoStage < 5)
+		{
+			RB_DlightDiagAutoConfigureStage(s_dlightDiagAutoStage + 1);
+			s_dlightDiagAutoState = 2;
+			s_dlightDiagAutoStamp = now;
+			return;
+		}
+
+		RB_DlightDiagAutoAppend("status=COMPLETE\n");
+		ri.FS_WriteFile("dlight_diag_summary.txt", s_dlightDiagAutoSummary,
+			s_dlightDiagAutoSummaryLength);
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_DIAG_AUTOCAPTURE COMPLETE screenshots=6 summary=dlight_diag_summary.txt console=dlight_diag_console.txt\n");
+		ri.Cmd_ExecuteText(EXEC_APPEND, "condump dlight_diag_console.txt\n");
+		s_dlightDiagAutoState = 4;
+		s_dlightDiagAutoStamp = now;
+		return;
+	}
+
+	if (s_dlightDiagAutoState == 4)
+	{
+		if (now - s_dlightDiagAutoStamp < 1500)
+			return;
+		s_dlightDiagAutoState = 5;
+		if (r_dlightDiagAutoQuit->integer)
+		{
+			ri.Printf(PRINT_ALL, "DLIGHT_DIAG_AUTOCAPTURE quitting for automatic result collection\n");
+			ri.Cmd_ExecuteText(EXEC_APPEND, "quit\n");
+		}
+		else
+		{
+			ri.Cvar_Set("r_dlightDiagAutoCapture", "0");
+		}
+	}
+}
