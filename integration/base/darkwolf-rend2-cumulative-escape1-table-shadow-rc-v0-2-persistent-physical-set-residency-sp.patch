+// Called only after the normal R_CullSurface() has accepted the surface and
+// after the stock R_DlightSurface() has produced its exact filtered bitset.
+void R_DarkWolfPCRBE2E07ObserveSurface(msurface_t *surf, int entityNum, int filteredDlightBits)
+{
+    int t;
+    int surfaceIndex = -1;
+    if (!surf || !tr.world)
+        return;
+    if (tr.viewParms.isPortal ||
+        (tr.viewParms.flags & (VPF_SHADOWMAP | VPF_DEPTHSHADOW | VPF_ORTHOGRAPHIC)))
+        return;
+    if (surf >= tr.world->surfaces && surf < tr.world->surfaces + tr.world->numsurfaces)
+        surfaceIndex = (int)(surf - tr.world->surfaces);
+
+    for (t = 0; t < PCRB_E2E07_TARGETS; ++t)
+    {
+        pcrbE2E07Target_t *target = &s_pcrbE2E07[t];
+        qboolean touched;
+        qboolean actualBit = qfalse;
+        if (!target->active)
+            continue;
+        target->visibleSurfaces++;
+        touched = R_DarkWolfPCRBE2E07SurfaceTouched(surf, target->origin, target->runtimeRadius);
+        if (!touched)
+            continue;
+        target->touchedVisibleSurfaces++;
+        if (entityNum == REFENTITYNUM_WORLD)
+            target->touchedWorldSurfaces++;
+        else
+            target->touchedBmodelSurfaces++;
+        if (target->addedDlightIndex >= 0 && target->addedDlightIndex < 32 &&
+            (((unsigned int)filteredDlightBits) & (1u << target->addedDlightIndex)))
+        {
+            actualBit = qtrue;
+            target->actualDlightTouchedSurfaces++;
+        }
+        if (target->topCount < PCRB_E2E07_TOP_SURFACES && surfaceIndex >= 0)
+        {
+            pcrbE2E07SurfaceHit_t *hit = &target->top[target->topCount++];
+            hit->surfaceIndex = surfaceIndex;
+            hit->entityNum = entityNum;
+            hit->actualDlightBit = actualBit ? 1 : 0;
+        }
+    }
+}
