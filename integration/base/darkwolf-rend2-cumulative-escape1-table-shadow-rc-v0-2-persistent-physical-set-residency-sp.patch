+
+static int R_StaticPromoteFindCrosshairFixture(float *forwardDistanceOut, float *lateralDistanceOut)
+{
+	int i;
+	int best = -1;
+	float bestScore = 1.0e30f;
+	float bestForward = 0.0f;
+	float bestLateral = 0.0f;
+
+	if (!s_staticPromoteLastViewValid || !tr.world)
+		return -1;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		vec3_t delta;
+		float forwardDistance;
+		float totalSq;
+		float lateralSq;
+		float lateralDistance;
+		float coneRadius;
+		float score;
+		VectorSubtract(s_staticPromotePersistentLights[i].candidate.origin, s_staticPromoteLastViewOrg, delta);
+		forwardDistance = DotProduct(delta, s_staticPromoteLastViewForward);
+		if (forwardDistance < 16.0f || forwardDistance > 4096.0f)
+			continue;
+		totalSq = DotProduct(delta, delta);
+		lateralSq = totalSq - forwardDistance * forwardDistance;
+		if (lateralSq < 0.0f)
+			lateralSq = 0.0f;
+		lateralDistance = sqrt(lateralSq);
+		coneRadius = 96.0f + forwardDistance * 0.18f;
+		if (coneRadius > 320.0f)
+			coneRadius = 320.0f;
+		if (lateralDistance > coneRadius)
+			continue;
+		score = lateralSq / (coneRadius * coneRadius) + forwardDistance * 0.00001f;
+		if (score < bestScore)
+		{
+			bestScore = score;
+			best = i;
+			bestForward = forwardDistance;
+			bestLateral = lateralDistance;
+		}
+	}
+	if (forwardDistanceOut)
+		*forwardDistanceOut = bestForward;
+	if (lateralDistanceOut)
+		*lateralDistanceOut = bestLateral;
+	return best;
+}
+
+// DARKWOLF_USLRD_ROOT_CAUSE_V0_1 -------------------------------------------------
+// Diagnostic only: lock one stable fixture under the crosshair and correlate logical
+// delivery with the exact submitted dlight plus nearby fixture overlap.  No selection,
+// residency, gain, radius, color, shadow, volumetric or post-process policy is changed.
+static int s_uslrdRcLastFrontMs = -1;
+static int s_uslrdRcLastPeerMs = -1;
+static int s_uslrdRcLastFocus = -999999;
+
+static int R_StaticPromoteRootCauseFindFixtureByEntity(int entityOrdinal)
+{
+    int i;
+    for (i = 0; i < s_staticPromotePersistentCount; ++i)
+        if (s_staticPromotePersistentLights[i].candidate.entityOrdinal == entityOrdinal)
+            return i;
+    return -1;
+}
+
+static float R_StaticPromoteRootCauseLuminance(const vec3_t c)
+{
+    return 0.2126f * c[0] + 0.7152f * c[1] + 0.0722f * c[2];
+}
+
+static dlight_t *R_StaticPromoteRootCauseRuntimeDlight(const staticPromotePersistentLight_t *light, int *sceneIndexOut)
+{
+    int globalIndex;
+    if (sceneIndexOut) *sceneIndexOut = -1;
+    if (!light || light->unifiedActualDlightIndex < 0)
+        return NULL;
+    globalIndex = r_firstSceneDlight + light->unifiedActualDlightIndex;
+    if (globalIndex < r_firstSceneDlight || globalIndex < 0 || globalIndex >= r_numdlights || globalIndex >= MAX_DLIGHTS)
+        return NULL;
+    if (sceneIndexOut) *sceneIndexOut = light->unifiedActualDlightIndex;
+    return &backEndData->dlights[globalIndex];
+}
+
+static void R_StaticPromoteRootCauseCapture(void)
+{
+    int fixtureIndex;
+    float forwardDistance = 0.0f, lateralDistance = 0.0f;
+    if (!r_staticPromoteRootCauseCapture || !r_staticPromoteRootCauseCapture->integer)
+        return;
+    fixtureIndex = R_StaticPromoteFindCrosshairFixture(&forwardDistance, &lateralDistance);
+    if (fixtureIndex >= 0)
+    {
+        staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[fixtureIndex];
+        ri.Cvar_Set("r_staticPromoteRootCauseFocus", va("%d", light->candidate.entityOrdinal));
+        ri.Printf(PRINT_ALL,
+            "USLRD_RC_LOCK map=%s fixture=%d fixtureIndex=%d synthetic=%d syntheticId=%d physical=%d forward=%.2f lateral=%.2f origin=%.2f,%.2f,%.2f intensity=%.2f\\n",
+            tr.world ? tr.world->baseName : "<none>", light->candidate.entityOrdinal, fixtureIndex,
+            light->synthetic ? 1 : 0, light->syntheticId, light->physicalRecognitionAccepted ? 1 : 0,
+            forwardDistance, lateralDistance, light->candidate.origin[0], light->candidate.origin[1],
+            light->candidate.origin[2], light->candidate.intensity);
+    }
+    else
+    {
+        ri.Printf(PRINT_WARNING, "USLRD_RC_LOCK_FAILED map=%s reason=NO_FIXTURE_NEAR_CROSSHAIR\\n",
+            tr.world ? tr.world->baseName : "<none>");
+    }
+    ri.Cvar_Set("r_staticPromoteRootCauseCapture", "0");
+}
+
+static void R_StaticPromoteRootCauseDiagFrame(const refdef_t *fd)
+{
+    int now, sampleMs, focusId, fixtureIndex, sceneIndex = -1;
+    staticPromotePersistentLight_t *light;
+    dlight_t *dl;
+    vec3_t delta;
+    float dist2, dist, forward, lateral2, lateral, viewCos;
+    float directLum = 0.0f, directRadius = 0.0f;
+    int directPresent = 0, directLocalVol = 0, directNative = 0, directForced = 0, directNoShadow = 0;
+    int peerCount = 0, peerActive = 0, nearestPeer = -1;
+    float peerLumSum = 0.0f, nearestPeerDist = 999999.0f;
+    int i;
+
+    if (!r_staticPromoteRootCauseDiag || !r_staticPromoteRootCauseDiag->integer || !fd || !tr.world)
+        return;
+    R_StaticPromoteRootCauseCapture();
+    focusId = r_staticPromoteRootCauseFocus ? r_staticPromoteRootCauseFocus->integer : -1;
+    if (focusId < 0)
+        return;
+    fixtureIndex = R_StaticPromoteRootCauseFindFixtureByEntity(focusId);
+    if (fixtureIndex < 0)
+    {
+        if (focusId != s_uslrdRcLastFocus)
+            ri.Printf(PRINT_WARNING, "USLRD_RC_FOCUS_MISSING map=%s fixture=%d\\n", tr.world->baseName, focusId);
+        s_uslrdRcLastFocus = focusId;
+        return;
+    }
+    light = &s_staticPromotePersistentLights[fixtureIndex];
+    now = ri.Milliseconds();
+    sampleMs = r_staticPromoteRootCauseSampleMs ? CLAMP(r_staticPromoteRootCauseSampleMs->integer, 50, 1000) : 200;
+    if (s_uslrdRcLastFrontMs >= 0 && now - s_uslrdRcLastFrontMs < sampleMs && focusId == s_uslrdRcLastFocus)
+        return;
+    s_uslrdRcLastFrontMs = now;
+    s_uslrdRcLastFocus = focusId;
+
+    VectorSubtract(light->candidate.origin, fd->vieworg, delta);
+    dist2 = DotProduct(delta, delta);
+    dist = sqrtf(MAX(dist2, 0.0f));
+    forward = DotProduct(delta, fd->viewaxis[0]);
+    lateral2 = MAX(0.0f, dist2 - forward * forward);
+    lateral = sqrtf(lateral2);
+    viewCos = dist > 0.001f ? forward / dist : 1.0f;
+
+    dl = R_StaticPromoteRootCauseRuntimeDlight(light, &sceneIndex);
+    if (dl)
+    {
+        directPresent = 1;
+        directLum = R_StaticPromoteRootCauseLuminance(dl->color);
+        directRadius = dl->radius;
+        directLocalVol = dl->localVolumetricLamp ? 1 : 0;
+        directNative = dl->nativeAuthoredDlight ? 1 : 0;
+        directForced = dl->forced ? 1 : 0;
+        directNoShadow = dl->noDlightShadow ? 1 : 0;
+    }
+
+    for (i = 0; i < s_staticPromotePersistentCount; ++i)
+    {
+        staticPromotePersistentLight_t *peer = &s_staticPromotePersistentLights[i];
+        vec3_t pd;
+        float pdist;
+        dlight_t *pdl;
+        if (i == fixtureIndex)
+            continue;
+        VectorSubtract(peer->candidate.origin, light->candidate.origin, pd);
+        pdist = sqrtf(MAX(DotProduct(pd, pd), 0.0f));
+        if (pdist > 128.0f)
+            continue;
+        peerCount++;
+        if (pdist < nearestPeerDist)
+        {
+            nearestPeerDist = pdist;
+            nearestPeer = i;
+        }
+        pdl = R_StaticPromoteRootCauseRuntimeDlight(peer, NULL);
+        if (pdl)
+        {
+            peerActive++;
+            peerLumSum += R_StaticPromoteRootCauseLuminance(pdl->color);
+        }
+    }
+
+    ri.Printf(PRINT_ALL,
+        "USLRD_RC_FRONT ms=%d map=%s fixture=%d fixtureIndex=%d synthetic=%d syntheticId=%d physical=%d nativeSuppressed=%d rawMembers=%d intensity=%.2f camDist=%.2f forward=%.2f lateral=%.2f viewCos=%.5f tier=%s route=%s resident=%d selectedSlot=%d sceneDlight=%d surface=%d spherePvs=%d pvsBit=%d areaRejected=%d physicalFallback=%d held=%d lastVisibleAgeMs=%d directPresent=%d directRadius=%.2f directColor=%.5f,%.5f,%.5f directLum=%.6f localVolMarker=%d nativeAuthored=%d forced=%d noShadow=%d peer128=%d peerActive=%d peerLumSum=%.6f nearestPeerFixture=%d nearestPeerDist=%.2f\\n",
+        now, tr.world->baseName, focusId, fixtureIndex, light->synthetic ? 1 : 0, light->syntheticId,
+        light->physicalRecognitionAccepted ? 1 : 0, light->nativeDuplicateSuppressed ? 1 : 0,
+        light->rawMembers, light->candidate.intensity, dist, forward, lateral, viewCos,
+        R_StaticPromoteUSLRDTierName(light->unifiedVisibilityTier), R_StaticPromoteUSLRDRouteName(light->unifiedRoute),
+        light->unifiedResident ? 1 : 0, light->unifiedSelectedSlot, sceneIndex,
+        light->unifiedSurfaceSignal ? 1 : 0, light->unifiedSpherePvsConnected ? 1 : 0,
+        light->unifiedSpherePvsBitSeen ? 1 : 0, light->unifiedAreaPortalRejected ? 1 : 0,
+        light->unifiedPhysicalFallback ? 1 : 0, light->unifiedHeld ? 1 : 0,
+        light->unifiedLastVisibleMs >= 0 ? now - light->unifiedLastVisibleMs : -1,
+        directPresent, directRadius, dl ? dl->color[0] : 0.0f, dl ? dl->color[1] : 0.0f,
+        dl ? dl->color[2] : 0.0f, directLum, directLocalVol, directNative, directForced, directNoShadow,
+        peerCount, peerActive, peerLumSum,
+        nearestPeer >= 0 ? s_staticPromotePersistentLights[nearestPeer].candidate.entityOrdinal : -1,
+        nearestPeer >= 0 ? nearestPeerDist : -1.0f);
+
+    if (s_uslrdRcLastPeerMs < 0 || now - s_uslrdRcLastPeerMs >= 1000)
+    {
+        s_uslrdRcLastPeerMs = now;
+        for (i = 0; i < s_staticPromotePersistentCount; ++i)
+        {
+            staticPromotePersistentLight_t *peer = &s_staticPromotePersistentLights[i];
+            vec3_t pd;
+            float pdist;
+            dlight_t *pdl;
+            int psi = -1;
+            if (i == fixtureIndex)
+                continue;
+            VectorSubtract(peer->candidate.origin, light->candidate.origin, pd);
+            pdist = sqrtf(MAX(DotProduct(pd, pd), 0.0f));
+            if (pdist > 128.0f)
+                continue;
+            pdl = R_StaticPromoteRootCauseRuntimeDlight(peer, &psi);
+            ri.Printf(PRINT_ALL,
+                "USLRD_RC_PEER ms=%d map=%s focus=%d peer=%d dist=%.2f synthetic=%d syntheticId=%d physical=%d tier=%s route=%s resident=%d sceneDlight=%d radius=%.2f color=%.5f,%.5f,%.5f lum=%.6f\\n",
+                now, tr.world->baseName, focusId, peer->candidate.entityOrdinal, pdist, peer->synthetic ? 1 : 0,
+                peer->syntheticId, peer->physicalRecognitionAccepted ? 1 : 0,
+                R_StaticPromoteUSLRDTierName(peer->unifiedVisibilityTier), R_StaticPromoteUSLRDRouteName(peer->unifiedRoute),
+                peer->unifiedResident ? 1 : 0, psi, pdl ? pdl->radius : 0.0f,
+                pdl ? pdl->color[0] : 0.0f, pdl ? pdl->color[1] : 0.0f, pdl ? pdl->color[2] : 0.0f,
+                pdl ? R_StaticPromoteRootCauseLuminance(pdl->color) : 0.0f);
+        }
+    }
+}
