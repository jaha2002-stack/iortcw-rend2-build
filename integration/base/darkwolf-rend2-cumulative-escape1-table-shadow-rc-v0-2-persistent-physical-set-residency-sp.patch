+	float maxRadius = r_staticPromoteMaxRadius ? r_staticPromoteMaxRadius->value : 320.0f;
+	float maxColor = r_staticPromoteMaxColor ? r_staticPromoteMaxColor->value : 0.50f;
+	int dlightMode = r_dlightMode ? r_dlightMode->integer : 0;
+	int shadowBudget = r_dlightShadowMaxLights ? r_dlightShadowMaxLights->integer : 3;
+
+	if (s_staticPromoteLastReportWorld == tr.world &&
+		s_staticPromoteLastEnable == enable &&
+		s_staticPromoteLastManualOverride == manualOverride &&
+		s_staticPromoteLastMaxLights == maxLights &&
+		s_staticPromoteLastActiveCount == activeCount &&
+		s_staticPromoteLastSelectionSignature == selectionSignature &&
+		s_staticPromoteLastIndex0 == index0 &&
+		s_staticPromoteLastIndex1 == index1 &&
+		s_staticPromoteLastAutoMapLights == autoMapLights &&
+		s_staticPromoteLastPVS == pvsEnabled &&
+		s_staticPromoteLastPVSHoldMs == pvsHoldMs &&
+		s_staticPromoteLastViewCluster == viewCluster &&
+		s_staticPromoteLastVisibleCount == visibleCount &&
+		s_staticPromoteLastHeldCount == heldCount &&
+		s_staticPromoteLastRegistryCount == s_staticPromotePersistentCount &&
+		s_staticPromoteLastRawLightCount == s_staticPromotePersistentRawLightCount &&
+		s_staticPromoteLastOverflowCount == overflowCount &&
+		s_staticPromoteLastClassifierAccepted == classifierAccepted &&
+		s_staticPromoteLastClassifierRejected == classifierRejected &&
+		s_staticPromoteLastInfluenceVisible == visibleCount &&
+		s_staticPromoteLastShadowBudget == shadowBudget &&
+		fabs(s_staticPromoteLastGain - gain) < 0.0001f &&
+		fabs(s_staticPromoteLastDirectGain - directGain) < 0.0001f &&
+		fabs(s_staticPromoteLastRadiusScale - radiusScale) < 0.0001f &&
+		fabs(s_staticPromoteLastMinRadius - minRadius) < 0.0001f &&
+		fabs(s_staticPromoteLastMaxRadius - maxRadius) < 0.0001f &&
+		fabs(s_staticPromoteLastMaxColor - maxColor) < 0.0001f &&
+		s_staticPromoteLastDlightMode == dlightMode)
+		return;
+
+	s_staticPromoteLastReportWorld = tr.world;
+	s_staticPromoteLastEnable = enable;
+	s_staticPromoteLastManualOverride = manualOverride;
+	s_staticPromoteLastMaxLights = maxLights;
+	s_staticPromoteLastActiveCount = activeCount;
+	s_staticPromoteLastSelectionSignature = selectionSignature;
+	s_staticPromoteLastIndex0 = index0;
+	s_staticPromoteLastIndex1 = index1;
+	s_staticPromoteLastAutoMapLights = autoMapLights;
+	s_staticPromoteLastPVS = pvsEnabled;
+	s_staticPromoteLastPVSHoldMs = pvsHoldMs;
+	s_staticPromoteLastViewCluster = viewCluster;
+	s_staticPromoteLastVisibleCount = visibleCount;
+	s_staticPromoteLastHeldCount = heldCount;
+	s_staticPromoteLastRegistryCount = s_staticPromotePersistentCount;
+	s_staticPromoteLastRawLightCount = s_staticPromotePersistentRawLightCount;
+	s_staticPromoteLastOverflowCount = overflowCount;
+	s_staticPromoteLastClassifierAccepted = classifierAccepted;
+	s_staticPromoteLastClassifierRejected = classifierRejected;
+	s_staticPromoteLastInfluenceVisible = visibleCount;
+	s_staticPromoteLastShadowBudget = shadowBudget;
+	s_staticPromoteLastGain = gain;
+	s_staticPromoteLastDirectGain = directGain;
+	s_staticPromoteLastRadiusScale = radiusScale;
+	s_staticPromoteLastMinRadius = minRadius;
+	s_staticPromoteLastMaxRadius = maxRadius;
+	s_staticPromoteLastMaxColor = maxColor;
+	s_staticPromoteLastDlightMode = dlightMode;
+	ri.FS_WriteFile("static_promote_v12_fix_v5_1_status.txt", report, reportLength);
+	ri.Printf(PRINT_ALL,
+		"STATIC_PROMOTE_V12_FIX_V5_1_STATUS map=%s enable=%d autoMap=%d pvs=%d cluster=%d influenceVisible=%d held=%d active=%d maxLights=%d overflow=%d classifierAccepted=%d classifierRejected=%d fixtures=%d raw=%d learnedOn=%d learnedOff=%d synthetic=%d mode=%d shadowBudget=%d shadowMap=%d\n",
+		tr.world ? tr.world->baseName : "<none>", enable, autoMapLights, pvsEnabled,
+		viewCluster, visibleCount, heldCount, activeCount, maxLights, overflowCount,
+		classifierAccepted, classifierRejected, s_staticPromotePersistentCount,
+		s_staticPromotePersistentRawLightCount,
+		R_StaticPromoteUserOverrideCountForMap(tr.world ? tr.world->baseName : "", 1),
+		R_StaticPromoteUserOverrideCountForMap(tr.world ? tr.world->baseName : "", -1),
+		R_StaticPromoteSyntheticCountForMap(tr.world ? tr.world->baseName : ""),
+		dlightMode, shadowBudget,
+		r_dlightShadowMapSize ? r_dlightShadowMapSize->integer : -1);
+}
