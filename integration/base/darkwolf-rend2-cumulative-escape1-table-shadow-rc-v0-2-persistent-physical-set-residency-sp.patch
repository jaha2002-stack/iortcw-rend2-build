+// DARKWOLF_NATIVE_DLIGHT_MULTI_AREA_FIX_CANDIDATE_V1
+// V5.3 deliberately expands authored SP_dlight server visibility bounds. A large
+// non-solid light can therefore touch more than the two areas represented by
+// svEntity_t::areanum/areanum2. Only when BOTH legacy area slots fail, inspect
+// the real non-solid BSP leaves inside the already-linked dlight bounds. This
+// does not bypass cluster PVS and does not make the entity broadcast/global.
+#define DW_NATIVE_DLIGHT_MULTI_AREA_MAX_LEAFS 1024
+
+static qboolean SV_DarkWolfNativeMultiAreaFixEnabled(const sharedEntity_t *ent)
+{
+	if (!ent || !(ent->r.svFlags & DARKWOLF_SVF_NATIVE_DLIGHT_DIAG))
+		return qfalse;
+	if (!Cvar_VariableIntegerValue("g_dlightPVSFix"))
+		return qfalse;
+	return qtrue;
+}
+
+static qboolean SV_DarkWolfNativeMultiAreaConnected(const sharedEntity_t *ent, int clientArea,
+	int *matchedArea, int *leafCount, int *overflow)
+{
+	int leafs[DW_NATIVE_DLIGHT_MULTI_AREA_MAX_LEAFS];
+	int lastLeaf = -1;
+	int count;
+	int i;
+
+	if (matchedArea) *matchedArea = -1;
+	if (leafCount) *leafCount = 0;
+	if (overflow) *overflow = 0;
+	if (!ent)
+		return qfalse;
+
+	count = CM_BoxLeafnums(ent->r.absmin, ent->r.absmax, leafs, ARRAY_LEN(leafs), &lastLeaf);
+	if (leafCount) *leafCount = count;
+	if (overflow && count == (int)ARRAY_LEN(leafs) && count > 0 && lastLeaf != leafs[count - 1])
+		*overflow = 1;
+
+	for (i = 0; i < count; ++i)
+	{
+		int area = CM_LeafArea(leafs[i]);
+		if (area < 0)
+			continue;
+		if (CM_AreasConnected(clientArea, area))
+		{
+			if (matchedArea) *matchedArea = area;
+			return qtrue;
+		}
+	}
+
+	return qfalse;
+}
