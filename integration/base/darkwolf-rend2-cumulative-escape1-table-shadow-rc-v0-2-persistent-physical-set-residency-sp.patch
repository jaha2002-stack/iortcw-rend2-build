+
+static qboolean RB_FireV07ShaderEvidence(const shader_t *shader, int *animated, int *animationFrames)
+{
+	int stageIndex;
+	qboolean semantic = qfalse;
+	*animated = 0;
+	*animationFrames = 0;
+	if (!shader)
+		return qfalse;
+	if (RB_FireV07NameLooksFire(shader->name))
+		semantic = qtrue;
+	for (stageIndex = 0; stageIndex < shader->numUnfoggedPasses && stageIndex < MAX_SHADER_STAGES; ++stageIndex)
+	{
+		shaderStage_t *stage = shader->stages[stageIndex];
+		textureBundle_t *bundle;
+		int imageIndex;
+		if (!stage || !stage->active)
+			continue;
+		bundle = &stage->bundle[TB_DIFFUSEMAP];
+		if (bundle->tcGen == TCGEN_FIRERISEENV_MAPPED)
+			semantic = qtrue;
+		if (bundle->numImageAnimations > 1)
+		{
+			*animated = 1;
+			*animationFrames += bundle->numImageAnimations;
+		}
+		for (imageIndex = 0; imageIndex < bundle->numImageAnimations && imageIndex < MAX_IMAGE_ANIMATIONS; ++imageIndex)
+		{
+			image_t *image = bundle->image[imageIndex];
+			if (image && RB_FireV07NameLooksFire(image->imgName))
+				semantic = qtrue;
+		}
+		if (bundle->numImageAnimations <= 0 && bundle->image[0] &&
+			RB_FireV07NameLooksFire(bundle->image[0]->imgName))
+			semantic = qtrue;
+	}
+	return semantic;
+}
