+static mnode_t *R_StaticPromotePointInLeafSafe(const vec3_t point)
+{
+	mnode_t *node;
+	float d;
+	cplane_t *plane;
+
+	if (!tr.world || !tr.world->nodes || tr.world->numnodes <= 0)
+		return NULL;
+	node = tr.world->nodes;
+	while (node && node->contents == CONTENTS_NODE)
+	{
+		plane = node->plane;
+		if (!plane)
+			return NULL;
+		d = DotProduct(point, plane->normal) - plane->dist;
+		node = node->children[d > 0.0f ? 0 : 1];
+	}
+	return node;
+}
