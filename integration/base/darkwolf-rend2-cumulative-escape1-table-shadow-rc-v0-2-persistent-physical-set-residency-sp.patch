+static qboolean R_MapLightingV02IndexInRanges(int surfaceIndex, const mapLightingV02Range_t *ranges, int count)
+{
+	int lo = 0;
+	int hi = count - 1;
+	while (lo <= hi)
+	{
+		int mid = lo + ((hi - lo) >> 1);
+		const mapLightingV02Range_t *r = &ranges[mid];
+		if (surfaceIndex < r->first)
+			hi = mid - 1;
+		else if (surfaceIndex > r->last)
+			lo = mid + 1;
+		else
+			return qtrue;
+	}
+	return qfalse;
+}
