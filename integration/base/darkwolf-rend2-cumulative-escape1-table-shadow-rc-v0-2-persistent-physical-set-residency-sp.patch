+
+// DARKWOLF_VISIBLE_SURFACE_RESIDENCY_PRODUCTION_CANDIDATE_V1
+// Functional candidate based on PCRB E2E v0.7 ground truth. The signal is the
+// previous main-view frame's actually visible Rend2 surface geometry touched by
+// the fixture's real promoted-DLight sphere. It is never a camera-to-emitter LOS.
+typedef struct staticPromoteVisibleSurfaceCache_s {
+    qboolean valid;
+    int fixtureOrdinal;
+    int sourceFrameTime;
+    int touchedSurfaces;
+    int touchedWorld;
+    int touchedBmodel;
+} staticPromoteVisibleSurfaceCache_t;
+
+static staticPromoteVisibleSurfaceCache_t s_staticPromoteVisibleSurfaceCurrent[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static staticPromoteVisibleSurfaceCache_t s_staticPromoteVisibleSurfaceNext[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static qboolean s_staticPromoteVisibleSurfaceSignalNow[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static qboolean s_staticPromoteVisibleSurfaceResidencyNow[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static int s_staticPromoteVisibleSurfaceProbeIndices[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static float s_staticPromoteVisibleSurfaceProbeRadius[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static int s_staticPromoteVisibleSurfaceProbeCount = 0;
+static int s_staticPromoteVisibleSurfaceRegistryGeneration = -1;
+static int s_staticPromoteVisibleSurfaceLastAdvanceTime = -1;
+
+static qboolean R_StaticPromoteVisibleSurfaceResidencyEnabled(void)
+{
+    return qtrue;
+}
+
+static qboolean R_StaticPromoteVisibleSurfaceResidencyDiagEnabled(void)
+{
+    return qfalse;
+}
+
+static qboolean R_StaticPromoteVisibleSurfaceObserverEnabled(void)
+{
+    return (R_StaticPromoteVisibleSurfaceResidencyEnabled() ||
+        R_StaticPromoteVisibleSurfaceResidencyDiagEnabled()) ? qtrue : qfalse;
+}
+
+static float R_StaticPromoteVisibleSurfaceRuntimeRadius(const staticPromoteCandidate_t *candidate)
+{
+    float radiusScale;
+    float minRadius;
+    float maxRadius;
+    float radius;
+    if (!candidate)
+        return 0.0f;
+    radiusScale = r_staticPromoteRadiusScale ? r_staticPromoteRadiusScale->value : 0.70f;
+    minRadius = r_staticPromoteMinRadius ? r_staticPromoteMinRadius->value : 192.0f;
+    maxRadius = r_staticPromoteMaxRadius ? r_staticPromoteMaxRadius->value : 320.0f;
+    radiusScale = CLAMP(radiusScale, 0.10f, 1.50f);
+    maxRadius = CLAMP(maxRadius, 64.0f, 512.0f);
+    minRadius = CLAMP(minRadius, 64.0f, maxRadius);
+    radius = candidate->intensity * radiusScale;
+    return CLAMP(radius, minRadius, maxRadius);
+}
+
+// Must stay geometrically equivalent to stock R_DlightSurface() for the
+// surface types which can receive a BSP dlight bit.
+static qboolean R_StaticPromoteVisibleSurfaceTouched(msurface_t *surf,
+    vec3_t origin, float radius)
+{
+    float d;
+    if (!surf || !surf->data)
+        return qfalse;
+
+    if (surf->cullinfo.type & CULLINFO_PLANE)
+    {
+        d = DotProduct(origin, surf->cullinfo.plane.normal) - surf->cullinfo.plane.dist;
+        if (d < -radius || d > radius)
+            return qfalse;
+    }
+    if (surf->cullinfo.type & CULLINFO_BOX)
+    {
+        if (origin[0] - radius > surf->cullinfo.bounds[1][0] ||
+            origin[0] + radius < surf->cullinfo.bounds[0][0] ||
+            origin[1] - radius > surf->cullinfo.bounds[1][1] ||
+            origin[1] + radius < surf->cullinfo.bounds[0][1] ||
+            origin[2] - radius > surf->cullinfo.bounds[1][2] ||
+            origin[2] + radius < surf->cullinfo.bounds[0][2])
+            return qfalse;
+    }
+    if (surf->cullinfo.type & CULLINFO_SPHERE)
+    {
+        if (!SpheresIntersect(origin, radius, surf->cullinfo.localOrigin, surf->cullinfo.radius))
+            return qfalse;
+    }
+
+    switch (*surf->data)
+    {
+        case SF_FACE:
+        case SF_GRID:
+        case SF_TRIANGLES:
+            return qtrue;
+        default:
+            return qfalse;
+    }
+}
+
+static void R_StaticPromoteVisibleSurfaceClearAll(void)
+{
+    Com_Memset(s_staticPromoteVisibleSurfaceCurrent, 0, sizeof(s_staticPromoteVisibleSurfaceCurrent));
+    Com_Memset(s_staticPromoteVisibleSurfaceNext, 0, sizeof(s_staticPromoteVisibleSurfaceNext));
+    Com_Memset(s_staticPromoteVisibleSurfaceSignalNow, 0, sizeof(s_staticPromoteVisibleSurfaceSignalNow));
+    Com_Memset(s_staticPromoteVisibleSurfaceResidencyNow, 0, sizeof(s_staticPromoteVisibleSurfaceResidencyNow));
+    s_staticPromoteVisibleSurfaceProbeCount = 0;
+    s_staticPromoteVisibleSurfaceLastAdvanceTime = -1;
+}
+
+static void R_StaticPromoteVisibleSurfaceBeginFrame(const refdef_t *fd)
+{
+    if (!fd)
+        return;
+    if (s_staticPromoteVisibleSurfaceRegistryGeneration != s_staticPromotePersistentBuildGeneration)
+    {
+        R_StaticPromoteVisibleSurfaceClearAll();
+        s_staticPromoteVisibleSurfaceRegistryGeneration = s_staticPromotePersistentBuildGeneration;
+    }
+    if (s_staticPromoteVisibleSurfaceLastAdvanceTime == fd->time)
+        return;
+
+    Com_Memcpy(s_staticPromoteVisibleSurfaceCurrent, s_staticPromoteVisibleSurfaceNext,
+        sizeof(s_staticPromoteVisibleSurfaceCurrent));
+    Com_Memset(s_staticPromoteVisibleSurfaceNext, 0, sizeof(s_staticPromoteVisibleSurfaceNext));
+    Com_Memset(s_staticPromoteVisibleSurfaceSignalNow, 0, sizeof(s_staticPromoteVisibleSurfaceSignalNow));
+    Com_Memset(s_staticPromoteVisibleSurfaceResidencyNow, 0, sizeof(s_staticPromoteVisibleSurfaceResidencyNow));
+    s_staticPromoteVisibleSurfaceProbeCount = 0;
+    s_staticPromoteVisibleSurfaceLastAdvanceTime = fd->time;
+}
+
+static qboolean R_StaticPromoteVisibleSurfaceSignalForFixture(int fixtureIndex,
+    const staticPromotePersistentLight_t *light)
+{
+    const staticPromoteVisibleSurfaceCache_t *entry;
+    if (!light || fixtureIndex < 0 || fixtureIndex >= STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES)
+        return qfalse;
+    entry = &s_staticPromoteVisibleSurfaceCurrent[fixtureIndex];
+    if (!entry->valid || entry->fixtureOrdinal != light->candidate.entityOrdinal)
+        return qfalse;
+    return qtrue;
+}
+
+static void R_StaticPromoteVisibleSurfaceAddProbe(int fixtureIndex,
+    const staticPromotePersistentLight_t *light)
+{
+    int slot;
+    if (!light || !R_StaticPromoteVisibleSurfaceObserverEnabled())
+        return;
+    if (fixtureIndex < 0 || fixtureIndex >= STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES)
+        return;
+    if (s_staticPromoteVisibleSurfaceProbeCount >= STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES)
+        return;
+    slot = s_staticPromoteVisibleSurfaceProbeCount++;
+    s_staticPromoteVisibleSurfaceProbeIndices[slot] = fixtureIndex;
+    s_staticPromoteVisibleSurfaceProbeRadius[slot] =
+        R_StaticPromoteVisibleSurfaceRuntimeRadius(&light->candidate);
+}
+
+// Called from tr_world.c only after stock R_CullSurface() accepted the surface
+// and stock R_DlightSurface() ran. Portal, shadow-map, depth-shadow, and
+// orthographic views are excluded so only the real main camera contributes.
+void R_DarkWolfVisibleSurfaceResidencyObserveSurface(msurface_t *surf, int entityNum,
+    int filteredDlightBits)
+{
+    int p;
+    (void)filteredDlightBits;
+    if (!surf || !tr.world || s_staticPromoteVisibleSurfaceProbeCount <= 0)
+        return;
+    if (!R_StaticPromoteVisibleSurfaceObserverEnabled())
+        return;
+    if (tr.viewParms.isPortal ||
+        (tr.viewParms.flags & (VPF_SHADOWMAP | VPF_DEPTHSHADOW | VPF_ORTHOGRAPHIC)))
+        return;
+
+    for (p = 0; p < s_staticPromoteVisibleSurfaceProbeCount; ++p)
+    {
+        int fixtureIndex = s_staticPromoteVisibleSurfaceProbeIndices[p];
+        staticPromotePersistentLight_t *light;
+        staticPromoteVisibleSurfaceCache_t *entry;
+        float radius;
+        if (fixtureIndex < 0 || fixtureIndex >= s_staticPromotePersistentCount)
+            continue;
+        entry = &s_staticPromoteVisibleSurfaceNext[fixtureIndex];
+        // Production only needs the boolean. PCRB E2E v0.7 separately keeps
+        // complete per-surface counts for the two proof targets.
+        if (entry->valid)
+            continue;
+        light = &s_staticPromotePersistentLights[fixtureIndex];
+        radius = s_staticPromoteVisibleSurfaceProbeRadius[p];
+        if (!R_StaticPromoteVisibleSurfaceTouched(surf, light->candidate.origin, radius))
+            continue;
+        entry->valid = qtrue;
+        entry->fixtureOrdinal = light->candidate.entityOrdinal;
+        entry->sourceFrameTime = tr.refdef.time;
+        entry->touchedSurfaces = 1;
+        if (entityNum == REFENTITYNUM_WORLD)
+            entry->touchedWorld = 1;
+        else
+            entry->touchedBmodel = 1;
+    }
+}
