+// DARKWOLF_COPLANAR_CONTAINED_BSP_FACE_DECONFLICTION_CLEAN_PRODUCTION_V1
+// Clean production deconfliction for a deliberately narrow BSP pathology class:
+// two ordinary WORLD SF_FACE surfaces using the exact same opaque, non-offset,
+// non-deformed shader and exact same culling plane/fog/cubemap/lightmap identity,
+// where the smaller FACE is a strict XYZ+diffuse-ST vertex subset of the larger.
+// The larger FACE remains canonical because it alone guarantees complete coverage.
+// The smaller FACE is skipped only from ordinary main-world draw submission.
+// Portal, orthographic, shadow-map and depth-shadow views fail open to parent behavior.
+//
+// r_coplanarContainedFaceDeconflict defaults to 1 in production. Set it to 0 for
+// immediate rollback to exact accepted-parent world-surface submission semantics.
+#define DW_CCDF_HASH_SIZE 1024
+
+typedef struct dwCoplanarContainedRegistry_s
+{
+    const world_t *world;
+    msurface_t *surfaces;
+    int numWorldSurfaces;
+    int *canonicalForSurface;
+    qboolean built;
+} dwCoplanarContainedRegistry_t;
+
+static dwCoplanarContainedRegistry_t s_dwCoplanarContainedRegistry;
+
+static float R_DW_CCDFTriangleArea(const srfBspSurface_t *srf, int tri)
+{
+    int base;
+    glIndex_t i0, i1, i2;
+    vec3_t e1, e2, cross;
+
+    if (!srf || !srf->verts || !srf->indexes || tri < 0)
+        return 0.0f;
+
+    base = tri * 3;
+    if (base + 2 >= srf->numIndexes)
+        return 0.0f;
+
+    i0 = srf->indexes[base + 0];
+    i1 = srf->indexes[base + 1];
+    i2 = srf->indexes[base + 2];
+    if ((int)i0 < 0 || (int)i1 < 0 || (int)i2 < 0 ||
+        (int)i0 >= srf->numVerts || (int)i1 >= srf->numVerts || (int)i2 >= srf->numVerts)
+        return 0.0f;
+
+    VectorSubtract(srf->verts[i1].xyz, srf->verts[i0].xyz, e1);
+    VectorSubtract(srf->verts[i2].xyz, srf->verts[i0].xyz, e2);
+    CrossProduct(e1, e2, cross);
+    return 0.5f * VectorLength(cross);
+}
+
+static float R_DW_CCDFTotalArea(const srfBspSurface_t *srf)
+{
+    int tri;
+    float area = 0.0f;
+
+    if (!srf || srf->numIndexes <= 0 || (srf->numIndexes % 3) != 0)
+        return 0.0f;
+
+    for (tri = 0; tri < srf->numIndexes / 3; ++tri)
+        area += R_DW_CCDFTriangleArea(srf, tri);
+    return area;
+}
+
+static qboolean R_DW_CCDFValidFace(const msurface_t *ms)
+{
+    const srfBspSurface_t *srf;
+
+    if (!ms || !ms->data || !ms->shader || *ms->data != SF_FACE)
+        return qfalse;
+    if (ms->shader->sort != SS_OPAQUE || ms->shader->polygonOffset || ms->shader->numDeforms != 0 ||
+        ms->shader->isSky || ms->shader->isPortal || ms->shader->lightmapIndex < 0)
+        return qfalse;
+    if (!(ms->cullinfo.type & CULLINFO_PLANE))
+        return qfalse;
+
+    srf = (const srfBspSurface_t *)ms->data;
+    if (srf->numVerts < 3 || srf->numIndexes < 3 || (srf->numIndexes % 3) != 0 ||
+        !srf->verts || !srf->indexes)
+        return qfalse;
+
+    return qtrue;
+}
+
+static qboolean R_DW_CCDFExactPlane(const msurface_t *a, const msurface_t *b)
+{
+    if (a->cullinfo.type != b->cullinfo.type)
+        return qfalse;
+    return a->cullinfo.plane.normal[0] == b->cullinfo.plane.normal[0] &&
+           a->cullinfo.plane.normal[1] == b->cullinfo.plane.normal[1] &&
+           a->cullinfo.plane.normal[2] == b->cullinfo.plane.normal[2] &&
+           a->cullinfo.plane.dist == b->cullinfo.plane.dist;
+}
+
+static qboolean R_DW_CCDFExactXYZAndST(const srfVert_t *a, const srfVert_t *b)
+{
+    return a->xyz[0] == b->xyz[0] && a->xyz[1] == b->xyz[1] && a->xyz[2] == b->xyz[2] &&
+           a->st[0] == b->st[0] && a->st[1] == b->st[1];
+}
+
+static qboolean R_DW_CCDFStrictVertexSubset(const srfBspSurface_t *small, const srfBspSurface_t *large)
+{
+    int i, j;
+
+    if (!small || !large || small->numVerts >= large->numVerts)
+        return qfalse;
+
+    for (i = 0; i < small->numVerts; ++i)
+    {
+        int matches = 0;
+        for (j = 0; j < large->numVerts; ++j)
+        {
+            if (R_DW_CCDFExactXYZAndST(&small->verts[i], &large->verts[j]))
+                ++matches;
+        }
+        if (matches != 1)
+            return qfalse;
+    }
+
+    return qtrue;
+}
+
+static qboolean R_DW_CCDFQualifies(const msurface_t *smallMs, const msurface_t *largeMs)
+{
+    const srfBspSurface_t *small;
+    const srfBspSurface_t *large;
+    float smallArea, largeArea;
+
+    if (!R_DW_CCDFValidFace(smallMs) || !R_DW_CCDFValidFace(largeMs))
+        return qfalse;
+    if (smallMs->shader != largeMs->shader ||
+        smallMs->shader->lightmapIndex != largeMs->shader->lightmapIndex ||
+        smallMs->fogIndex != largeMs->fogIndex || smallMs->cubemapIndex != largeMs->cubemapIndex)
+        return qfalse;
+    if (!R_DW_CCDFExactPlane(smallMs, largeMs))
+        return qfalse;
+
+    small = (const srfBspSurface_t *)smallMs->data;
+    large = (const srfBspSurface_t *)largeMs->data;
+    if (small->numVerts >= large->numVerts || small->numIndexes >= large->numIndexes)
+        return qfalse;
+    if (!R_DW_CCDFStrictVertexSubset(small, large))
+        return qfalse;
+
+    smallArea = R_DW_CCDFTotalArea(small);
+    largeArea = R_DW_CCDFTotalArea(large);
+    if (!(smallArea > 0.0f && largeArea > smallArea))
+        return qfalse;
+
+    return qtrue;
+}
+
+static unsigned int R_DW_CCDFShaderBucket(const shader_t *shader)
+{
+    unsigned int index = shader ? (unsigned int)shader->index : 0u;
+    return index & (DW_CCDF_HASH_SIZE - 1u);
+}
+
+static void R_DW_CCDFFreeRegistry(void)
+{
+    if (s_dwCoplanarContainedRegistry.canonicalForSurface)
+        ri.Free(s_dwCoplanarContainedRegistry.canonicalForSurface);
+    Com_Memset(&s_dwCoplanarContainedRegistry, 0, sizeof(s_dwCoplanarContainedRegistry));
+}
+
+static void R_DW_CCDFBuildRegistry(void)
