+static void R_Mat1PresetForClass(byte materialClass, float *specular, float *roughness, float *metallic)
+{
+	switch (materialClass)
+	{
+		case MATDBG_CLASS_MINERAL:
+			*specular = r_materialFallbackMineralSpecular->value;
+			*roughness = r_materialFallbackMineralRoughness->value;
+			*metallic = r_materialFallbackMineralMetallic->value;
+			break;
+		case MATDBG_CLASS_WOOD:
+			*specular = r_materialFallbackWoodSpecular->value;
+			*roughness = r_materialFallbackWoodRoughness->value;
+			*metallic = r_materialFallbackWoodMetallic->value;
+			break;
+		case MATDBG_CLASS_METAL:
+			*specular = r_materialFallbackMetalSpecular->value;
+			*roughness = r_materialFallbackMetalRoughness->value;
+			*metallic = r_materialFallbackMetalMetallic->value;
+			break;
+		case MATDBG_CLASS_GLASS:
+			*specular = r_materialFallbackGlassSpecular->value;
+			*roughness = r_materialFallbackGlassRoughness->value;
+			*metallic = r_materialFallbackGlassMetallic->value;
+			break;
+		case MATDBG_CLASS_ORGANIC:
+			*specular = r_materialFallbackOrganicSpecular->value;
+			*roughness = r_materialFallbackOrganicRoughness->value;
+			*metallic = r_materialFallbackOrganicMetallic->value;
+			break;
+		case MATDBG_CLASS_SNOW:
+			*specular = r_materialFallbackSnowSpecular->value;
+			*roughness = r_materialFallbackSnowRoughness->value;
+			*metallic = r_materialFallbackSnowMetallic->value;
+			break;
+		case MATDBG_CLASS_FABRIC:
+			*specular = r_materialFallbackFabricSpecular->value;
+			*roughness = r_materialFallbackFabricRoughness->value;
+			*metallic = r_materialFallbackFabricMetallic->value;
+			break;
+		case MATDBG_CLASS_CERAMIC:
+			*specular = r_materialFallbackCeramicSpecular->value;
+			*roughness = r_materialFallbackCeramicRoughness->value;
+			*metallic = r_materialFallbackCeramicMetallic->value;
+			break;
+		case MATDBG_CLASS_UNKNOWN:
+		default:
+			*specular = r_materialFallbackUnknownSpecular->value;
+			*roughness = r_materialFallbackUnknownRoughness->value;
+			*metallic = r_materialFallbackUnknownMetallic->value;
+			break;
+	}
+}
+
+static void R_Mat1ApplyFallbackPreset(shaderStage_t *diffuse)
+{
+	float specular;
+	float roughness;
+	float metallic;
+	float encodedGloss;
+	int classBit;
+
+	if (!diffuse || !r_materialAwareFallback || !r_materialAwareFallback->integer)
+		return;
+	if (diffuse->materialSpecularSource != MATDBG_SPEC_FALLBACK || diffuse->materialExplicitResponse)
+		return;
+	if (diffuse->materialHeuristicClass > MATDBG_CLASS_CERAMIC)
+		diffuse->materialHeuristicClass = MATDBG_CLASS_UNKNOWN;
+
+	classBit = 1 << diffuse->materialHeuristicClass;
+	if (!(r_materialFallbackClassMask->integer & classBit))
+		return;
+
+	R_Mat1PresetForClass(diffuse->materialHeuristicClass, &specular, &roughness, &metallic);
+	specular = CLAMP(specular, 0.0f, 1.0f);
+	roughness = CLAMP(roughness, 0.02f, 1.0f);
+	metallic = CLAMP(metallic, 0.0f, 1.0f);
+	encodedGloss = R_Mat1RoughnessToEncodedGloss(roughness);
+
+	if (r_pbr->integer)
+	{
+		// PBR LightAll semantics: R=gloss, G=metallicness. B/A are not material inputs in this branch.
+		VectorSet4(diffuse->specularScale, encodedGloss, metallic, 1.0f, 1.0f);
+	}
+	else
+	{
+		// Classic LightAll semantics: RGB=F0/specular reflectance, A=gloss.
+		VectorSet4(diffuse->specularScale, specular, specular, specular, encodedGloss);
+	}
+	diffuse->materialFallbackApplied = 1;
+}
