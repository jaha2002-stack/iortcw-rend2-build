+static qboolean R_Mat0NameHas(const char *name, const char *needle)
+{
+	char normalizedName[MAX_QPATH];
+	char normalizedNeedle[MAX_QPATH];
+	int i;
+
+	if (!name || !name[0] || !needle || !needle[0])
+		return qfalse;
+
+	// Runtime names may contain either slash style (both occur on Assault).
+	// Normalize both operands before semantic matching so identical assets classify identically.
+	Q_strncpyz(normalizedName, name, sizeof(normalizedName));
+	Q_strncpyz(normalizedNeedle, needle, sizeof(normalizedNeedle));
+	for (i = 0; normalizedName[i]; i++)
+		if (normalizedName[i] == '\\')
+			normalizedName[i] = '/';
+	for (i = 0; normalizedNeedle[i]; i++)
+		if (normalizedNeedle[i] == '\\')
+			normalizedNeedle[i] = '/';
+
+	return Q_stristr(normalizedName, normalizedNeedle) ? qtrue : qfalse;
+}
+
+static const char *R_Mat0LeafName(const char *name)
+{
+	const char *leaf = name ? name : "";
+	const char *p;
+
+	for (p = leaf; *p; p++)
+		if (*p == '/' || *p == '\\')
+			leaf = p + 1;
+	return leaf;
+}
+
+static qboolean R_Mat0EitherNameHas(const char *shaderName, const char *imageName, const char *needle)
+{
+	return R_Mat0NameHas(shaderName, needle) || R_Mat0NameHas(imageName, needle);
+}
+
+static qboolean R_Mat0EitherLeafHas(const char *shaderName, const char *imageName, const char *needle)
+{
+	return R_Mat0NameHas(R_Mat0LeafName(shaderName), needle) ||
+		R_Mat0NameHas(R_Mat0LeafName(imageName), needle);
+}
