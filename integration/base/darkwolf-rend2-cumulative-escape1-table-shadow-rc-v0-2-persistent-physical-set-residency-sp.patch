+static void RB_FireV07CaptureDrawSurfs(drawSurf_t *drawSurfs, int numDrawSurfs)
+{
+	int pass, drawIndex;
+	s_fireV07AnchorCount = 0;
+	s_fireV07AnchorSemanticCount = 0;
+	s_fireV07AnchorAnimatedCount = 0;
+	s_fireV07AnchorDropped = 0;
+
+	s_fireV07CaptureValid = qfalse;
+	s_fireV07CaptureTime = backEnd.refdef.time;
+	s_fireV07CaptureViewport[0] = backEnd.viewParms.viewportX;
+	s_fireV07CaptureViewport[1] = backEnd.viewParms.viewportY;
+	s_fireV07CaptureViewport[2] = backEnd.viewParms.viewportWidth;
+	s_fireV07CaptureViewport[3] = backEnd.viewParms.viewportHeight;
+
+	if (!ri.Cvar_VariableIntegerValue("r_volumetricFire") ||
+		ri.Cvar_VariableIntegerValue("r_volumetricFireV07Mode") <= 0)
+		return;
+	s_fireV07CaptureValid = qtrue;
+
+	// Production v1: semantic flame evidence gets the finite capture array first.
+	// Pass 1 only fills remaining room with generic animated evidence.
+	for (pass = 0; pass < 2; ++pass)
+	for (drawIndex = 0; drawIndex < numDrawSurfs; ++drawIndex)
+	{
+		drawSurf_t *draw = &drawSurfs[drawIndex];
+		shader_t *shader;
+		int entityNum, fogNum, dlighted, pshadowed, atiTess;
+		int animated = 0, animationFrames = 0;
+		qboolean semantic;
+		fireVolumetricV07Anchor_t candidate;
+		if (!draw->surface)
+			continue;
+		R_DecomposeSort(draw->sort, &entityNum, &shader, &fogNum, &dlighted, &pshadowed, &atiTess);
+		if (!shader)
+			continue;
+		semantic = RB_FireV07ShaderEvidence(shader, &animated, &animationFrames);
+		if (!semantic && !animated)
+			continue;
+		if (pass == 0 && !semantic)
+			continue;
+		if (pass == 1 && semantic)
+			continue;
+		memset(&candidate, 0, sizeof(candidate));
+		candidate.shaderIndex = shader->index;
+		candidate.entityNum = entityNum;
+		candidate.drawIndex = drawIndex;
+		candidate.semanticFire = semantic ? 1 : 0;
+		candidate.animated = animated;
+		candidate.animationFrames = animationFrames;
+		Q_strncpyz(candidate.shaderName, shader->name, sizeof(candidate.shaderName));
+		if (!RB_FireV07SurfaceCenter(draw, drawIndex, entityNum, candidate.origin,
+			&candidate.primitive, &candidate.surfaceIndex, candidate.modelName, sizeof(candidate.modelName)))
+			continue;
+		if (RB_FireV07AnchorDuplicate(&candidate))
+			continue;
+		if (s_fireV07AnchorCount >= FIREVOL07_MAX_RENDERED_ANCHORS)
+		{
+			s_fireV07AnchorDropped++;
+			continue;
+		}
+		s_fireV07Anchors[s_fireV07AnchorCount++] = candidate;
+		if (candidate.semanticFire) s_fireV07AnchorSemanticCount++;
+		if (candidate.animated) s_fireV07AnchorAnimatedCount++;
+	}
+}
