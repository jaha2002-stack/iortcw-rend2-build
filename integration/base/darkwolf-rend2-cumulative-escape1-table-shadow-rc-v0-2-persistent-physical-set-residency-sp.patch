+float SsgiResolveDepthWeight(const vec2 centerUv, const vec2 sampleUv, const float centerDepth, const vec2 depthSlope)
+{
+	float sampleDepth = SsgiLinearDepth(sampleUv);
+	vec2 o = sampleUv - centerUv;
+	float expectedDepth = centerDepth + clamp(dot(depthSlope, o), -0.04, 0.04);
+	float residualWorld = abs(sampleDepth - expectedDepth) * u_ViewInfo.y;
+	return 1.0 - smoothstep(1.5, 12.0, residualWorld);
+}
+
+void SsgiResolveTap(const vec2 centerUv,
+	const vec2 sampleUv,
+	const float spatialWeight,
+	const float centerDepth,
+	const vec2 depthSlope,
+	const vec2 maskTexel,
+	inout vec3 sumColor,
+	inout float sumWeight)
+{
+	if (spatialWeight <= 0.0001)
+		return;
+
+	float receiverRadius = max(1.0, clamp(u_ViewInfo.z, 0.0, 2.0));
+	if (SsgiSceneEntityGuardMask(sampleUv, maskTexel, receiverRadius) > 0.20)
+		return;
+	if (SsgiViewmodelMask(sampleUv) > 0.5)
+		return;
+
+	float depthWeight = SsgiResolveDepthWeight(centerUv, sampleUv, centerDepth, depthSlope);
+	float w = spatialWeight * depthWeight;
+	if (w <= 0.0001)
+		return;
+
+	sumColor += texture2D(u_ScreenImageMap, sampleUv).rgb * w;
+	sumWeight += w;
+}
+
+void SsgiBilateralResolve()
+{
+	vec2 lowTexel = max(u_InvTexRes, vec2(1.0e-6));
+	float centerDepth = SsgiLinearDepth(var_ScreenTex);
+	float uvDx = max(abs(dFdx(var_ScreenTex.x)), 1.0e-6);
+	float uvDy = max(abs(dFdy(var_ScreenTex.y)), 1.0e-6);
+	vec2 depthSlope = vec2(dFdx(centerDepth) / uvDx, dFdy(centerDepth) / uvDy);
+	float receiverRadius = max(1.0, clamp(u_ViewInfo.z, 0.0, 2.0));
+
+	if (SsgiSceneEntityGuardMask(var_ScreenTex, lowTexel, receiverRadius) > 0.20 ||
+		SsgiViewmodelMask(var_ScreenTex) > 0.5)
+	{
+		gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
+		return;
+	}
+
+	vec2 texPos = var_ScreenTex / lowTexel - vec2(0.5);
+	vec2 base = floor(texPos);
+	vec2 f = fract(texPos);
+	vec2 uv00 = (base + vec2(0.5, 0.5)) * lowTexel;
+	vec2 uv10 = (base + vec2(1.5, 0.5)) * lowTexel;
+	vec2 uv01 = (base + vec2(0.5, 1.5)) * lowTexel;
+	vec2 uv11 = (base + vec2(1.5, 1.5)) * lowTexel;
+	vec2 lo = vec2(0.001);
+	vec2 hi = vec2(0.999);
+	uv00 = clamp(uv00, lo, hi);
+	uv10 = clamp(uv10, lo, hi);
+	uv01 = clamp(uv01, lo, hi);
+	uv11 = clamp(uv11, lo, hi);
+
+	vec3 sumColor = vec3(0.0);
+	float sumWeight = 0.0;
+	SsgiResolveTap(var_ScreenTex, uv00, (1.0 - f.x) * (1.0 - f.y), centerDepth, depthSlope, lowTexel, sumColor, sumWeight);
+	SsgiResolveTap(var_ScreenTex, uv10, f.x * (1.0 - f.y), centerDepth, depthSlope, lowTexel, sumColor, sumWeight);
+	SsgiResolveTap(var_ScreenTex, uv01, (1.0 - f.x) * f.y, centerDepth, depthSlope, lowTexel, sumColor, sumWeight);
+	SsgiResolveTap(var_ScreenTex, uv11, f.x * f.y, centerDepth, depthSlope, lowTexel, sumColor, sumWeight);
+
+	vec3 resolved = (sumWeight > 0.0001) ? (sumColor / sumWeight) : vec3(0.0);
+	gl_FragColor = vec4(resolved, 1.0);
+}
+
+void SsgiAccumulate(const vec2 offset,
+	const float centerDepth,
+	const vec2 depthSlope,
+	const vec2 maskTexel,
+	const vec3 centerColor,
+	inout vec3 sumColor,
+	inout float accepted)
+{
+	vec2 uv = clamp(var_ScreenTex + offset, vec2(0.001), vec2(0.999));
+
+	// Exact visible entity rejection is always active.
+	if (SsgiSceneEntityMask(uv) > 0.35)
+		return;
+	if (SsgiViewmodelMask(uv) > 0.5)
+		return;
+
+	float sampleDepth = SsgiLinearDepth(uv);
+	float rawDeltaWorld = abs(sampleDepth - centerDepth) * u_ViewInfo.y;
+	float predictedDelta = dot(depthSlope, offset);
+	predictedDelta = clamp(predictedDelta, -0.08, 0.08);
+	float expectedDepth = centerDepth + predictedDelta;
+	float residualWorld = abs(sampleDepth - expectedDepth) * u_ViewInfo.y;
+	float separated = smoothstep(0.45, 2.5, residualWorld);
+	float residualNear = 1.0 - smoothstep(28.0, 96.0, residualWorld);
+	float localDepth = 1.0 - smoothstep(128.0, 280.0, rawDeltaWorld);
+	float geometryWeight = separated * residualNear * localDepth;
+	if (geometryWeight <= 0.0001)
+		return;
+
+	vec3 sampleColor = texture2D(u_ScreenImageMap, uv).rgb;
+	float centerLuma = SsgiLuma(centerColor);
+	float sourceLuma = SsgiLuma(sampleColor);
+	float brightSourceScale = 1.0;
+	float donor = clamp((sourceLuma - centerLuma * 0.72 - 0.015) * 1.45, 0.0, 1.0);
+	if (u_ViewInfo.w >= 0.5)
+	{
+		brightSourceScale = SsgiBrightSourceScale(sampleColor, centerLuma);
+		donor *= sqrt(brightSourceScale);
+	}
+	if (donor <= 0.0001)
+		return;
+
+	// Mode 1/2 symmetrically dilates the donor rejection mask. Mode 0 preserves v1.6.
+	float donorRadius = clamp(u_ViewInfo.z, 0.0, 2.0);
+	if (donorRadius > 0.5 && SsgiSceneEntityGuardMask(uv, maskTexel, donorRadius) > 0.20)
+		return;
+
+	float w = geometryWeight * donor;
+	vec3 donorColor = sampleColor;
+	float donorLuma = sourceLuma;
+	if (u_ViewInfo.w >= 0.5)
+	{
+		donorColor *= brightSourceScale;
+		donorLuma = SsgiLuma(donorColor);
+	}
+	vec3 tinted = mix(vec3(donorLuma), donorColor, clamp(u_Color.y, 0.0, 1.0));
+	sumColor += tinted * w;
+	accepted += geometryWeight;
+}
+
+void main()
+{
+	// Special second use of the same program: depth-aware bilateral upscale of the half-res GI buffer.
+	if (u_Color.w >= 15.5)
+	{
+		SsgiBilateralResolve();
+		return;
+	}
+
+	vec3 centerColor = texture2D(u_ScreenImageMap, var_ScreenTex).rgb;
+	float centerDepth = SsgiLinearDepth(var_ScreenTex);
+	float uvDx = max(abs(dFdx(var_ScreenTex.x)), 1.0e-6);
+	float uvDy = max(abs(dFdy(var_ScreenTex.y)), 1.0e-6);
+	vec2 maskTexel = vec2(uvDx, uvDy);
+	vec2 depthSlope = vec2(dFdx(centerDepth) / uvDx, dFdy(centerDepth) / uvDy);
+	float receiverRadius = max(1.0, clamp(u_ViewInfo.z, 0.0, 2.0));
+	float exactEntity = SsgiSceneEntityMask(var_ScreenTex);
+	float guardEntity = SsgiSceneEntityGuardMask(var_ScreenTex, maskTexel, receiverRadius);
+	float edgeStability = SsgiEdgeStabilityAt(var_ScreenTex, centerDepth, depthSlope, maskTexel);
+
+	// High-signal diagnostics. White means the tested condition is present.
+	if (u_Color.w > 5.5)
+	{
+		float edgeRisk = clamp((1.0 - edgeStability) / 0.40, 0.0, 1.0);
+		gl_FragColor = vec4(vec3(edgeRisk), 1.0);
+		return;
+	}
+	if (u_Color.w > 4.5)
+	{
+		gl_FragColor = vec4(vec3(guardEntity), 1.0);
+		return;
+	}
+	if (u_Color.w > 3.5)
+	{
+		gl_FragColor = vec4(vec3(exactEntity), 1.0);
+		return;
+	}
+
+	if (guardEntity > 0.20)
+	{
+		gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
+		return;
+	}
+	if (SsgiViewmodelMask(var_ScreenTex) > 0.5)
+	{
+		gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
+		return;
+	}
+
+	vec3 sumColor = vec3(0.0);
+	float accepted = 0.0;
+	float centerWorld = max(centerDepth * u_ViewInfo.y, 1.0);
+	float distanceScale = clamp(96.0 / centerWorld, 0.20, 1.0);
+	vec2 r = u_InvTexRes * distanceScale;
+	vec2 h = r * 0.5;
+
+	SsgiAccumulate(vec2( r.x,  0.0), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2(-r.x,  0.0), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2( 0.0,  r.y), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2( 0.0, -r.y), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2( r.x,  r.y) * 0.7071, centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2(-r.x,  r.y) * 0.7071, centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2( r.x, -r.y) * 0.7071, centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2(-r.x, -r.y) * 0.7071, centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2( h.x,  h.y), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2(-h.x,  h.y), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2( h.x, -h.y), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+	SsgiAccumulate(vec2(-h.x, -h.y), centerDepth, depthSlope, maskTexel, centerColor, sumColor, accepted);
+
+	vec3 bounce = sumColor * (clamp(u_Color.x, 0.0, 2.0) / 4.5);
+	bounce *= edgeStability;
+	bounce = min(bounce, vec3(clamp(u_Color.z, 0.0, 1.0)));
+
+	if (u_Color.w > 2.5)
+	{
+		float mask = clamp((accepted / 5.0) * edgeStability, 0.0, 1.0);
+		gl_FragColor = vec4(vec3(mask), 1.0);
+	}
+	else if (u_Color.w > 1.5)
+	{
+		gl_FragColor = vec4(min(bounce * 4.0, vec3(1.0)), 1.0);
+	}
+	else
+	{
+		gl_FragColor = vec4(bounce, 1.0);
+	}
+}
diff --git a/SP/code/rend2/glsl/ssgi_vp.glsl b/SP/code/rend2/glsl/ssgi_vp.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..542ca8e216bc1f63fecc367a1b3d0e634497e71d
--- /dev/null
+++ b/SP/code/rend2/glsl/ssgi_vp.glsl
@@ -0,0 +1,17 @@
+// REND2_GI_2_V1_SCREEN_SPACE_LOCAL_INDIRECT
+// REND2_GI_2_V1_3_FBO_BLIT_VERTEX_FIX
+// FBO_Blit supplies pixel-space quad vertices and uploads u_ModelViewProjectionMatrix.
+// Stock SSAO instead builds clip-space [-1,1] vertices manually, so its direct
+// gl_Position = attr_Position contract must not be copied into this FBO_Blit path.
+attribute vec3 attr_Position;
+attribute vec4 attr_TexCoord0;
+
+uniform mat4 u_ModelViewProjectionMatrix;
+
+varying vec2 var_ScreenTex;
+
+void main()
+{
+	gl_Position = u_ModelViewProjectionMatrix * vec4(attr_Position, 1.0);
+	var_ScreenTex = attr_TexCoord0.xy;
+}
diff --git a/SP/code/rend2/glsl/texturecolor_fp.glsl b/SP/code/rend2/glsl/texturecolor_fp.glsl
index 7c9046e18ed6d82fd093892ba74f3da360b96333..8a2ad6e1974d3e7007f6e725fc72f061bdea97d8 100644
--- a/SP/code/rend2/glsl/texturecolor_fp.glsl
+++ b/SP/code/rend2/glsl/texturecolor_fp.glsl
@@ -1,10 +1,69 @@
+// REND2_DLIGHT_DIAGNOSTIC_V2
+#if defined(USE_DLIGHT_DEBUG_CUBE)
+uniform samplerCube u_CubeMap;
+#else
 uniform sampler2D u_DiffuseMap;
-uniform vec4      u_Color;
+#endif
+uniform vec4 u_Color;
 
-varying vec2      var_Tex1;
+varying vec2 var_Tex1;
 
+#if defined(USE_DLIGHT_DEBUG_CUBE)
+float DecodeDlightDebugDepth(vec3 encodedDepth)
+{
+	return clamp(dot(encodedDepth, vec3(1.0 / 65536.0, 1.0 / 256.0, 1.0)), 0.0, 1.0);
+}
+
+vec3 DlightDebugFaceDirection(float face, vec2 uv)
+{
+	vec2 p = uv * 2.0 - 1.0;
+
+	if (face < 0.5)
+		return normalize(vec3( 1.0, -p.y, -p.x));
+	if (face < 1.5)
+		return normalize(vec3(-1.0, -p.y,  p.x));
+	if (face < 2.5)
+		return normalize(vec3( p.x,  1.0,  p.y));
+	if (face < 3.5)
+		return normalize(vec3( p.x, -1.0, -p.y));
+	if (face < 4.5)
+		return normalize(vec3( p.x, -p.y,  1.0));
+	return normalize(vec3(-p.x, -p.y, -1.0));
+}
+#endif
 
 void main()
 {
+#if defined(USE_DLIGHT_DEBUG_CUBE)
+	vec3 direction = DlightDebugFaceDirection(floor(u_Color.x + 0.5), var_Tex1);
+  #if __VERSION__ >= 130
+	vec3 packedDepth = texture(u_CubeMap, direction).rgb;
+  #else
+	vec3 packedDepth = textureCube(u_CubeMap, direction).rgb;
+  #endif
+	float depth = DecodeDlightDebugDepth(packedDepth);
+	vec3 result;
+
+	if (u_Color.y < 0.5)
+	{
+		// Heat map: valid geometry is colored from red (near) to cyan (far).
+		// The white-cleared unobstructed value (depth 1) stays black.
+		float valid = 1.0 - step(0.999, depth);
+		result = mix(vec3(1.0, 0.02, 0.02), vec3(0.02, 1.0, 1.0), depth) * valid;
+	}
+	else if (u_Color.y < 1.5)
+	{
+		// Inverted decoded distance: near geometry is bright, far/background dark.
+		result = vec3(pow(clamp(1.0 - depth, 0.0, 1.0), 0.35));
+	}
+	else
+	{
+		// Raw RGB packing view. A uniformly black face usually means capture/copy failed.
+		result = packedDepth;
+	}
+
+	gl_FragColor = vec4(result, 1.0);
+#else
 	gl_FragColor = texture2D(u_DiffuseMap, var_Tex1) * u_Color;
+#endif
 }
diff --git a/SP/code/rend2/glsl/volumetriclocal_fp.glsl b/SP/code/rend2/glsl/volumetriclocal_fp.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..5cda69f6a3dd2cbd9cdc0471511b6b9217766dc5
--- /dev/null
+++ b/SP/code/rend2/glsl/volumetriclocal_fp.glsl
@@ -0,0 +1,395 @@
+// DARKWOLF_LOCAL_VOLUMETRIC_V0_1
+// DARKWOLF_FIRE_VOLUMETRIC_V0_7_2_WORLD_PROJECTION_DEPTH_GPU_ISOLATION
+// DARKWOLF_FIRE_VOLUMETRIC_V0_8_PRODUCTION_FLAME_VOLUME
+// DARKWOLF_FIRE_VOLUMETRIC_V0_8_1_PRODUCTION_VISIBILITY_FULL_COVERAGE
+// DARKWOLF_FIREVOL_OCCLUSION_PRODUCTION_V1: physical shadow origin and rendered flame-volume origin are separated without a runtime test mode.
+// Diagnostic-first local volumetric core.
+// mode 1 = lamp source diagnostic (unshadowed, boosted)
+// mode 2 = lamp point volumetric, unshadowed
+// mode 3 = lamp point volumetric, production dlight cubemap shadow-aware
+// mode 4 = ET_SPOTLIGHT_EF cone, unshadowed in v0.1
+// mode 5 = DARKWOLF_FIRE_VOLUMETRIC_V0_2_CORE_SHAPE localized vertical fire plume, unshadowed
+// mode 6 = DARKWOLF_FIRE_VOLUMETRIC_V0_2_CORE_SHAPE localized vertical fire plume, point-shadow aware
+// mode 7 = DARKWOLF_FIRE_VOLUMETRIC_V0_5_VISIBILITY_PROOF exaggerated shadow-aware physical scatter
+// mode 8 = DARKWOLF_FIRE_VOLUMETRIC_V0_5_VISIBILITY_PROOF false-color integrated medium coverage mask
+// mode 9 = DARKWOLF_FIRE_VOLUMETRIC_V0_7_2 yellow source probe; same view-ray/sphere path as mode 1, scene-depth cap bypassed
+// u_Color:          strength, density, anisotropy, maxDistance
+// u_EnableTextures: samples, local-PCF (0/1), jitter, mode
+// u_BaseColor:      energy gain, soft-knee, spot cos(inner), reserved
+// u_PrimaryLightOrigin: xyz physical shadow/attenuation origin, w physical radius/range
+// u_CubeMapInfo:     xyz rendered fire-volume origin, w fire-volume geometry radius
+// u_DlightInfo:     xyz spotlight direction, w spot cos(outer)
+// u_DlightShadowParams: enabled, bias, normalized softness, shadow strength
+uniform sampler2D u_ScreenDepthMap;
+uniform samplerCube u_DlightShadowMap;
+
+uniform vec3 u_ViewOrigin;
+uniform vec4 u_ViewInfo;
+uniform vec4 u_PrimaryLightOrigin;
+uniform vec4 u_CubeMapInfo;
+uniform vec3 u_PrimaryLightColor;
+uniform vec4 u_DlightInfo;
+uniform vec4 u_DlightShadowParams;
+uniform vec4 u_Color;
+uniform vec4 u_EnableTextures;
+uniform vec4 u_BaseColor;
+
+varying vec2 var_DepthTex;
+varying vec3 var_ViewDir;
+
+#define DEPTH_MAX_ERROR 0.000000059604644775390625
+#define LOCALVOL_MAX_SAMPLES 48 // DARKWOLF_LOCAL_VOLUMETRIC_SPOTLIGHT_QUALITY_V0_4: 48 only for spotlight quality ceiling
+
+float getLinearDepth(sampler2D depthMap, vec2 tex, float zFarDivZNear)
+{
+    float sampleZDivW = texture2D(depthMap, tex).r - DEPTH_MAX_ERROR;
+    return 1.0 / mix(zFarDivZNear, 1.0, sampleZDivW);
+}
+
+float interleavedGradientNoise(vec2 p)
+{
+    return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
+}
+
+float phaseHG(float cosTheta, float g)
+{
+    float gg = g * g;
+    float denom = max(1.0 + gg - 2.0 * g * cosTheta, 0.0025);
+    return (1.0 - gg) / (4.0 * M_PI * pow(denom, 1.5));
+}
+
+float localLightAttenuation(float distanceSquared, float radiusSquared)
+{
+    float nd2 = distanceSquared / max(radiusSquared, 0.0001);
+    float radial = clamp(1.0 - nd2, 0.0, 1.0);
+    float smoothCutoff = radial * radial * radial * (radial * (radial * 6.0 - 15.0) + 10.0);
+    float shoulder = 1.0 / (1.0 + 0.55 * nd2);
+    return clamp(smoothCutoff * (0.35 + 0.65 * shoulder), 0.0, 1.0);
+}
+
+float decodeDlightShadowDepth(vec3 encodedDepth)
+{
+    return clamp(dot(encodedDepth, vec3(1.0 / 65536.0, 1.0 / 256.0, 1.0)), 0.0, 1.0);
+}
+
+// DARKWOLF_FIRE_VOLUMETRIC_V0_2_CORE_SHAPE
+// Cheap analytic/procedural fire medium. No noise texture, history buffer, or new FBO is required.
+// u_BaseColor.z/w = plume radius / plume height ratios.
+// u_DlightInfo.x/y = turbulence amount / animation speed.
+// DARKWOLF_FIRE_VOLUMETRIC_V0_3_QUALITY_STABILITY: u_DlightInfo.z = raw physical DLight radius.
+// u_ViewInfo.z = renderer time in seconds.
+// Production torch-fire medium: compact hot core, tapered body, separated tongues,
+// faint outer scatter and animated upper wisps. The authored flame sprite remains the
+// visible flame; this medium adds volume without returning to a spherical glow blob.
+float fireShapeMask(vec3 worldPos, vec3 lightOrigin, float lightRadius)
+{
+    vec3 rel = worldPos - lightOrigin;
+    float plumeRadius = clamp(u_BaseColor.z, 0.15, 0.90);
+    float plumeHeight = clamp(u_BaseColor.w, 0.35, 1.20);
+    float turbulence = clamp(u_DlightInfo.x, 0.0, 1.0);
+    float speed = clamp(u_DlightInfo.y, 0.0, 4.0);
+    float time = u_ViewInfo.z * speed;
+
+    float height = max(lightRadius * plumeHeight, 1.0);
+    float zNorm = rel.z / height;
+    float z01 = clamp(zNorm, 0.0, 1.0);
+
+    // Fire is almost entirely above the sprite centre and dies before the enclosing
+    // ray sphere reaches its top. This removes the old round/spherical silhouette.
+    float upwardGate = smoothstep(-0.025, 0.040, zNorm);
+    float topFade = 1.0 - smoothstep(0.78, 1.015, zNorm);
+    if (upwardGate * topFade <= 0.00001)
+        return 0.0;
+
+    // Low-frequency body sway plus a smaller high-frequency tongue motion. Offsets
+    // increase with height so the base stays glued to the physical flame centre.
+    vec2 bend;
+    bend.x = sin(zNorm * 9.7 + time * 1.70) + 0.36 * sin(zNorm * 21.1 - time * 1.05);
+    bend.y = sin(zNorm * 11.3 - time * 1.45) + 0.33 * sin(zNorm * 19.4 + time * 1.25);
+    bend *= lightRadius * 0.028 * turbulence * (0.10 + 0.90 * z01);
+
+    vec2 flutter;
+    flutter.x = sin(zNorm * 23.7 - time * 2.85) + 0.32 * sin(zNorm * 39.1 + time * 1.80);
+    flutter.y = sin(zNorm * 20.3 + time * 2.55) + 0.28 * sin(zNorm * 35.7 - time * 1.65);
+    flutter *= lightRadius * 0.016 * turbulence * z01 * z01;
+
+    // World-space procedural turbulence: stable in space, animated in time, and
+    // deliberately non-binary to avoid quarter-resolution sparkling.
+    float n1 = 0.5 + 0.5 * sin(worldPos.x * 0.115 + worldPos.z * 0.091 + time * 3.15);
+    float n2 = 0.5 + 0.5 * sin(worldPos.y * 0.103 - worldPos.z * 0.078 - time * 2.60);
+    float n3 = 0.5 + 0.5 * sin((worldPos.x + worldPos.y) * 0.057 + worldPos.z * 0.147 + time * 3.85);
+    float n4 = 0.5 + 0.5 * sin((worldPos.x - worldPos.y) * 0.081 - worldPos.z * 0.119 - time * 4.35);
+    float noiseField = clamp(0.25 + 0.30 * n1 + 0.22 * n2 + 0.15 * n3 + 0.08 * n4, 0.0, 1.0);
+    float softNoise = mix(1.0, smoothstep(0.14, 0.88, noiseField), turbulence);
+
+    // 1) Hot core: narrow and anchored. It exists only in the lower half so the
+    // volumetric does not cover the complete torch sprite with one bright disc.
+    vec2 coreXY = rel.xy - bend * 0.22;
+    float coreWidth = max(lightRadius * plumeRadius * mix(0.46, 0.34, z01), 1.0);
+    float coreR = length(coreXY) / coreWidth;
+    float coreRadial = exp(-6.5 * coreR * coreR);
+    float coreVertical = smoothstep(-0.012, 0.045, zNorm) * (1.0 - smoothstep(0.30, 0.50, zNorm));
+    float core = coreRadial * coreVertical * mix(0.96, softNoise, 0.20 * turbulence);
+
+    // 2) Main body: unlike v0.7.x it tapers with height rather than expanding upward.
+    vec2 bodyXY = rel.xy - bend;
+    float bodyWidthScale = mix(0.68, 0.35, smoothstep(0.04, 0.86, z01));
+    float bodyWidth = max(lightRadius * plumeRadius * bodyWidthScale, 1.0);
+    float bodyR = length(bodyXY) / bodyWidth;
+    float bodyRadial = exp(-4.6 * bodyR * bodyR);
+    float bodyVertical = smoothstep(-0.010, 0.055, zNorm) * (1.0 - smoothstep(0.62, 0.91, zNorm));
+    float body = bodyRadial * bodyVertical * mix(1.0, 0.56 + 0.44 * softNoise, turbulence);
+
+    // 3) Two upper flame tongues. Their small opposing offsets create a readable
+    // flame silhouette without a texture or geometry emitter.
+    float tongueGate = smoothstep(0.30, 0.48, zNorm) * (1.0 - smoothstep(0.82, 1.00, zNorm));
+    float tongueOffset = lightRadius * plumeRadius * (0.075 + 0.030 * sin(time * 1.7));
+    vec2 tongueAxis = bend + flutter;
+    vec2 tongue1XY = rel.xy - tongueAxis - vec2(tongueOffset, -0.35 * tongueOffset);
+    vec2 tongue2XY = rel.xy - tongueAxis + vec2(0.78 * tongueOffset, 0.42 * tongueOffset);
+    float tongueWidth = max(lightRadius * plumeRadius * mix(0.34, 0.18, z01), 1.0);
+    float tongue1 = exp(-6.8 * dot(tongue1XY, tongue1XY) / (tongueWidth * tongueWidth));
+    float tongue2 = exp(-7.6 * dot(tongue2XY, tongue2XY) / (tongueWidth * tongueWidth));
+    float tongueBreakup = smoothstep(0.30, 0.83, noiseField);
+    float tongues = (0.62 * tongue1 + 0.48 * tongue2) * tongueGate * mix(0.72, tongueBreakup, 0.35 + 0.55 * turbulence);
+
+    // 4) Very soft outer participating medium. This is intentionally weak: it gives
+    // the fire a volumetric halo without obscuring nearby stonework or creating an orb.
+    vec2 haloXY = rel.xy - bend * 0.70;
+    float haloWidth = max(lightRadius * plumeRadius * mix(0.98, 0.48, z01), 1.0);
+    float haloR = length(haloXY) / haloWidth;
+    float haloRadial = exp(-3.1 * haloR * haloR);
+    float haloVertical = smoothstep(-0.018, 0.055, zNorm) * (1.0 - smoothstep(0.60, 0.92, zNorm));
+    float halo = 0.23 * haloRadial * haloVertical * (0.78 + 0.22 * softNoise);
+
+    float shaped = 1.12 * core + 0.94 * body + 0.68 * tongues + halo;
+    shaped *= upwardGate * topFade;
+
+    // Final tapered guard ensures the enclosing sphere can never become visible.
+    float guardWidth = max(lightRadius * plumeRadius * mix(1.06, 0.50, z01), 1.0);
+    float guardR = length(rel.xy - bend) / guardWidth;
+    float lateralGuard = 1.0 - smoothstep(0.70, 1.06, guardR);
+    return clamp(shaped * lateralGuard, 0.0, 1.0);
+}
+
+vec3 fireProductionTint(vec3 worldPos, vec3 lightOrigin, float lightRadius)
+{
+    float plumeHeight = clamp(u_BaseColor.w, 0.35, 1.20);
+    float height = max(lightRadius * plumeHeight, 1.0);
+    float z01 = clamp((worldPos.z - lightOrigin.z) / height, 0.0, 1.0);
+    float sourcePeak = max(max(u_PrimaryLightColor.r, u_PrimaryLightColor.g),
+                           max(u_PrimaryLightColor.b, 0.001));
+    vec3 sourceTint = u_PrimaryLightColor / sourcePeak;
+
+    // Warm RTCW-compatible gradient: yellow-gold at the base, orange through the body,
+    // deeper amber/red only in the thin tip. Blend with the authored DLight tint so
+    // map-specific light colour is preserved.
+    vec3 hotTint = vec3(1.00, 0.79, 0.30);
+    vec3 bodyTint = vec3(1.00, 0.43, 0.075);
+    vec3 tipTint = vec3(0.82, 0.19, 0.030);
+    vec3 fireTint = mix(hotTint, bodyTint, smoothstep(0.10, 0.56, z01));
+    fireTint = mix(fireTint, tipTint, smoothstep(0.58, 0.98, z01));
+    return mix(sourceTint, fireTint, 0.58);
+}
+#if __VERSION__ >= 130
+#define LOCALVOL_TEXTURE_CUBE(s, d) texture((s), (d))
+#else
+#define LOCALVOL_TEXTURE_CUBE(s, d) textureCube((s), (d))
+#endif
+
+float compareDlightShadow(vec3 direction, float currentDepth, float bias)
+{
+    float storedDepth = decodeDlightShadowDepth(LOCALVOL_TEXTURE_CUBE(u_DlightShadowMap, normalize(direction)).rgb);
+    return step(currentDepth - bias, storedDepth);
+}
+
+float localDlightVisibility(vec3 fragmentToLight, float currentDepth, int pcfMode)
+{
+    if (u_DlightShadowParams.x < 0.5)
+        return 1.0;
+
+    vec3 dir = normalize(fragmentToLight);
+    float bias = max(u_DlightShadowParams.y, 0.0);
+    float filtered;
+
+    if (pcfMode <= 0)
+    {
+        filtered = compareDlightShadow(dir, currentDepth, bias);
+    }
+    else
+    {
+        vec3 helper = abs(dir.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
+        vec3 tangent = normalize(cross(helper, dir));
+        vec3 bitangent = cross(dir, tangent);
+        float radius = max(u_DlightShadowParams.z, 0.00001);
+        filtered = compareDlightShadow(dir, currentDepth, bias) * 0.50;
+        filtered += compareDlightShadow(dir + tangent * radius, currentDepth, bias) * 0.125;
+        filtered += compareDlightShadow(dir - tangent * radius, currentDepth, bias) * 0.125;
+        filtered += compareDlightShadow(dir + bitangent * radius, currentDepth, bias) * 0.125;
+        filtered += compareDlightShadow(dir - bitangent * radius, currentDepth, bias) * 0.125;
+    }
+
+    return mix(1.0, filtered, clamp(u_DlightShadowParams.w, 0.0, 1.0));
+}
+
+bool raySphereSegment(vec3 rayOrigin, vec3 rayDir, vec3 center, float radius,
+                      float maxDistance, out float segmentStart, out float segmentEnd)
+{
+    vec3 oc = rayOrigin - center;
+    float b = dot(oc, rayDir);
+    float c = dot(oc, oc) - radius * radius;
+    float h = b * b - c;
+    if (h <= 0.0)
+        return false;
+    h = sqrt(h);
+    segmentStart = max(-b - h, 0.0);
+    segmentEnd = min(-b + h, maxDistance);
+    return segmentEnd > segmentStart;
+}
+
+void main()
+{
+    float zFar = max(u_ViewInfo.y, 1.0);
+    int mode = int(clamp(u_EnableTextures.w, 1.0, 9.0) + 0.5);
+    float rayLength = max(length(var_ViewDir), 0.0001);
+    vec3 rayDir = var_ViewDir / rayLength;
+    float maxDistance = max(u_Color.w, 1.0);
+
+    // v0.7.2 isolation: mode 9 keeps the exact view-ray and sphere intersection
+    // but removes only scene-depth clipping. All other modes are byte-behavior equivalent.
+    if (mode != 9)
+    {
+        float sceneDepth = getLinearDepth(u_ScreenDepthMap, var_DepthTex, u_ViewInfo.x);
+        float sceneDistance = rayLength * sceneDepth;
+        maxDistance = min(sceneDistance, maxDistance);
+    }
+
+    vec3 lightOrigin = u_PrimaryLightOrigin.xyz;
+    float lightRadius = max(u_PrimaryLightOrigin.w, 1.0);
+    vec3 volumeOrigin = ((mode >= 5 && mode <= 8) ? u_CubeMapInfo.xyz : lightOrigin);
+    float volumeRadius = ((mode >= 5 && mode <= 8) ? max(u_CubeMapInfo.w, 1.0) : lightRadius);
+    float segmentStart, segmentEnd;
+    if (!raySphereSegment(u_ViewOrigin, rayDir, volumeOrigin, volumeRadius,
+                          maxDistance, segmentStart, segmentEnd))
+    {
+        gl_FragColor = vec4(0.0);
+        return;
+    }
+
+    float strength = max(u_Color.x, 0.0);
+    float density = max(u_Color.y, 0.000001);
+    float g = clamp(u_Color.z, -0.70, 0.70);
+    int sampleCount = int(clamp(u_EnableTextures.x, 4.0, float(LOCALVOL_MAX_SAMPLES)) + 0.5);
+    int pcfMode = int(clamp(u_EnableTextures.y, 0.0, 1.0) + 0.5);
+    float jitterAmount = clamp(u_EnableTextures.z, 0.0, 0.50);
+    float physicalLightRadius = ((mode >= 5 && mode <= 8) && u_DlightInfo.z > 1.0) ? u_DlightInfo.z : lightRadius;
+    float energyGain = clamp(u_BaseColor.x, 0.0, 16.0);
+    float kneeStrength = clamp(u_BaseColor.y, 0.0, 4.0);
+
+    float segmentLength = segmentEnd - segmentStart;
+    float stepLength = segmentLength / float(sampleCount);
+    float jitter = (interleavedGradientNoise(gl_FragCoord.xy) - 0.5) * jitterAmount;
+    float integrated = 0.0;
+    vec3 integratedFire = vec3(0.0); // v0.8 production per-sample flame tint
+    float debugCoverage = 0.0; // v0.5 direct visibility proof; only consumed by mode 8
+
+    for (int i = 0; i < LOCALVOL_MAX_SAMPLES; ++i)
+    {
+        if (i >= sampleCount)
+            break;
+
+        float t = segmentStart + stepLength * (float(i) + 0.5 + jitter);
+        t = clamp(t, segmentStart, segmentEnd);
+        vec3 worldPos = u_ViewOrigin + rayDir * t;
+        vec3 toLight = lightOrigin - worldPos;
+        float distanceSquared = dot(toLight, toLight);
+        float distanceToLight = sqrt(max(distanceSquared, 0.000001));
+        // v0.3: fire medium geometry is stable, but intensity attenuation still follows raw DLight flicker.
+        float attenuation = 1.0;
+        if (mode != 8)
+        {
+            attenuation = localLightAttenuation(distanceSquared, physicalLightRadius * physicalLightRadius);
+            if (attenuation <= 0.00001)
+                continue;
+        }
+
+        float cone = 1.0;
+        if (mode == 4)
+        {
+            vec3 fromLight = -toLight / distanceToLight;
+            float coneDot = dot(fromLight, normalize(u_DlightInfo.xyz));
+            float cosOuter = u_DlightInfo.w;
+            float cosInner = max(u_BaseColor.z, cosOuter + 0.0001);
+            cone = smoothstep(cosOuter, cosInner, coneDot);
+            if (cone <= 0.00001)
+                continue;
+        }
+
+        float mediumMask = 1.0;
+        if (mode >= 5 && mode <= 8)
+        {
+            mediumMask = fireShapeMask(worldPos, volumeOrigin, volumeRadius);
+            if (mediumMask <= 0.00001)
+                continue;
+        }
+
+        // v0.5 mode 8 proves ray/sphere/depth/shape/composite coverage directly. It intentionally
+        // ignores physical attenuation, phase and cubemap shadow so an invisible physical scatter
+        // cannot be confused with missing pixel coverage. The mask is still integrated through the
+        // same quarter-resolution raymarch and composited through the same additive FBO path.
+        if (mode == 8)
+        {
+            debugCoverage += mediumMask * stepLength / max(volumeRadius, 1.0);
+            continue;
+        }
+
+        float visibility = 1.0;
+        if (mode == 3 || mode == 6 || mode == 7)
+            visibility = localDlightVisibility(toLight, distanceToLight / physicalLightRadius, pcfMode);
+
+        float phase = (mode == 1 || mode == 9) ? 1.0 : phaseHG(clamp(dot(normalize(toLight), rayDir), -1.0, 1.0), g);
+        // v0.8.1: production fire uses an artist-calibrated phase scale. phaseHG is physically
+        // normalized by 1/(4*pi), which made the effect disappear against RTCW's bright sprite.
+        // Remove only that normalization for shaped fire modes; lamp/diagnostic modes are unchanged.
+        if (mode >= 5 && mode <= 7)
+            phase *= (4.0 * M_PI);
+        float transmittance = exp(-density * max(t - segmentStart, 0.0));
+        float sampleContribution = attenuation * mediumMask * cone * visibility * phase * transmittance * density * stepLength;
+        integrated += sampleContribution;
+        if (mode >= 5 && mode <= 7)
+            integratedFire += fireProductionTint(worldPos, volumeOrigin, volumeRadius) * sampleContribution;
+    }
+
+    if (mode == 8)
+    {
+        float mask = clamp(1.0 - exp(-debugCoverage * 12.0), 0.0, 1.0);
+        // Electric cyan is deliberately non-physical and highly distinguishable from RTCW fire sprites.
+        gl_FragColor = vec4(vec3(0.0, 4.0, 7.0) * mask, 0.0);
+        return;
+    }
+
+    float lightPeak = max(max(u_PrimaryLightColor.r, u_PrimaryLightColor.g),
+                          max(u_PrimaryLightColor.b, 0.001));
+    vec3 lightTint = u_PrimaryLightColor / lightPeak;
+    float colorEnergy = sqrt(lightPeak / (lightPeak + 0.35));
+
+    if (mode >= 5 && mode <= 7)
+    {
+        vec3 fireScatter = integratedFire * strength * colorEnergy;
+        if (mode == 7)
+            fireScatter *= 4.0; // diagnostic visibility proof remains exaggerated
+        fireScatter *= energyGain;
+        float firePeak = max(max(fireScatter.r, fireScatter.g), fireScatter.b);
+        fireScatter /= (1.0 + kneeStrength * firePeak);
+        gl_FragColor = vec4(max(fireScatter, vec3(0.0)), 0.0);
+        return;
+    }
+
+    float scatterAmount = integrated * strength * colorEnergy;
+    if (mode == 1 || mode == 9)
+        scatterAmount *= 2.5; // source-probe boost: diagnostic only; mode 9 differs only by scene-depth bypass
+    scatterAmount *= energyGain;
+    scatterAmount = scatterAmount / (1.0 + kneeStrength * scatterAmount);
+
+    gl_FragColor = vec4(max(lightTint * scatterAmount, vec3(0.0)), 0.0);
+}
diff --git a/SP/code/rend2/glsl/volumetriclocal_upscale_fp.glsl b/SP/code/rend2/glsl/volumetriclocal_upscale_fp.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..ff5ca279a5ca6d0c014613b2990e06811e733017
--- /dev/null
+++ b/SP/code/rend2/glsl/volumetriclocal_upscale_fp.glsl
@@ -0,0 +1,41 @@
+// DARKWOLF_LOCAL_VOLUMETRIC_SPOTLIGHT_QUALITY_V0_4
+// DARKWOLF_FIREVOL_SPATIAL_RECONSTRUCTION_EDGE_QUALITY_PC02
+// u_Color.x = relative-depth rejection strength; u_Color.y = kernel mode (1=3x3, 2=5x5).
+uniform sampler2D u_DiffuseMap;
+uniform sampler2D u_ScreenDepthMap;
+uniform vec2 u_InvTexRes;
+uniform vec4 u_ViewInfo;
+uniform vec4 u_Color;
+varying vec2 var_DepthTex;
+#define DEPTH_MAX_ERROR 0.000000059604644775390625
+float getLinearDepth(sampler2D d, vec2 t, float z) { float v=texture2D(d,t).r-DEPTH_MAX_ERROR; return 1.0/mix(z,1.0,v); }
+float depthWeight(float c,float d,float r) { float q=abs(d-c)/max(c,0.0005); return exp(-q*max(r,0.0)); }
+void main()
+{
+ vec2 texel=u_InvTexRes, lo=texel*0.5, hi=vec2(1.0)-lo, uv=clamp(var_DepthTex,lo,hi);
+ float cd=getLinearDepth(u_ScreenDepthMap,uv,u_ViewInfo.x), reject=u_Color.x;
+ int kernelMode=int(floor(u_Color.y+0.5)); vec3 sum=vec3(0.0); float sumW=0.0;
+ if (kernelMode >= 2)
+ {
+  for (int y=-2;y<=2;++y) for (int x=-2;x<=2;++x)
+  {
+   vec2 suv=clamp(uv+vec2(float(x)*texel.x,float(y)*texel.y),lo,hi);
+   float sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); float r2=float(x*x+y*y);
+   float w=depthWeight(cd,sd,reject)*exp(-0.22*r2); sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  }
+ }
+ else
+ {
+  vec2 suv; float sd,w;
+  suv=uv; sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*1.00; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2( texel.x,0.0),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.70; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2(-texel.x,0.0),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.70; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2(0.0, texel.y),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.70; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2(0.0,-texel.y),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.70; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2( texel.x, texel.y),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.45; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2(-texel.x, texel.y),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.45; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2( texel.x,-texel.y),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.45; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+  suv=clamp(uv+vec2(-texel.x,-texel.y),lo,hi); sd=getLinearDepth(u_ScreenDepthMap,suv,u_ViewInfo.x); w=depthWeight(cd,sd,reject)*0.45; sum+=texture2D(u_DiffuseMap,suv).rgb*w; sumW+=w;
+ }
+ gl_FragColor=vec4(sum/max(sumW,0.0001),0.0);
+}
diff --git a/SP/code/rend2/glsl/volumetriclocal_vp.glsl b/SP/code/rend2/glsl/volumetriclocal_vp.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..b258acb5a78489bd5290e283d3c37a4fc48e7062
--- /dev/null
+++ b/SP/code/rend2/glsl/volumetriclocal_vp.glsl
@@ -0,0 +1,27 @@
+// DARKWOLF_LOCAL_VOLUMETRIC_V0_1
+// DARKWOLF_FIRE_VOLUMETRIC_V0_7_4_VERTICAL_SCREEN_RAY_CONTRACT_FIX
+// The quarter-resolution local-volumetric pass is vertically inverted once by the
+// explicit source-box -> implicit quarter-FBO blit and inverted once again when
+// composited back into the explicit destination box. screenCoords.y is therefore
+// the INTERMEDIATE-FBO NDC Y, opposite to the final main-view screen Y. X is unchanged.
+// Build the world ray with -screenCoords.y so ray, depth sample and final pixel agree.
+// Fullscreen vertex contract intentionally matches proven Sun Volumetric v0.3.
+attribute vec4 attr_Position;
+attribute vec4 attr_TexCoord0;
+
+uniform mat4 u_ModelViewProjectionMatrix;
+uniform vec3 u_ViewForward;
+uniform vec3 u_ViewLeft;
+uniform vec3 u_ViewUp;
+uniform vec4 u_ViewInfo;
+
+varying vec2 var_DepthTex;
+varying vec3 var_ViewDir;
+
+void main()
+{
+    gl_Position = u_ModelViewProjectionMatrix * vec4(attr_Position.xyz, 1.0);
+    vec2 screenCoords = gl_Position.xy / gl_Position.w;
+    var_DepthTex = attr_TexCoord0.xy;
+    var_ViewDir = u_ViewForward + u_ViewLeft * -screenCoords.x + u_ViewUp * -screenCoords.y;
+}
diff --git a/SP/code/rend2/glsl/volumetricsun_fp.glsl b/SP/code/rend2/glsl/volumetricsun_fp.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..2991296eb6633dca14fd9c63acdcf076f2efa86b
--- /dev/null
+++ b/SP/code/rend2/glsl/volumetricsun_fp.glsl
@@ -0,0 +1,225 @@
+// DARKWOLF_SUN_VOLUMETRIC_V0_3
+// Energy calibration shader. v0.3 preserves the v0.2 sampling/PCF/jitter softness.
+// u_Color:          strength, density, anisotropy, maxDistance
+// u_EnableTextures: samples, PCF mode (0/1/2), jitter amount, map-response amount
+// u_BaseColor:      energy gain, soft-knee strength, reserved, reserved
+uniform sampler2D u_ScreenDepthMap;
+uniform sampler2DShadow u_ShadowMap;
+#if defined(USE_SHADOW_CASCADE)
+uniform sampler2DShadow u_ShadowMap2;
+uniform sampler2DShadow u_ShadowMap3;
+uniform sampler2DShadow u_ShadowMap4;
+#endif
+
+uniform mat4 u_ShadowMvp;
+#if defined(USE_SHADOW_CASCADE)
+uniform mat4 u_ShadowMvp2;
+uniform mat4 u_ShadowMvp3;
+uniform mat4 u_ShadowMvp4;
+#endif
+
+uniform vec3 u_ViewOrigin;
+uniform vec4 u_ViewInfo;
+uniform vec4 u_PrimaryLightOrigin;
+uniform vec3 u_PrimaryLightColor;
+uniform vec4 u_Color;
+uniform vec4 u_EnableTextures;
+uniform vec4 u_BaseColor;
+
+varying vec2 var_DepthTex;
+varying vec3 var_ViewDir;
+
+#define DEPTH_MAX_ERROR 0.000000059604644775390625
+#define VOLUMETRIC_MAX_SAMPLES 32
+
+float getLinearDepth(sampler2D depthMap, vec2 tex, float zFarDivZNear)
+{
+    float sampleZDivW = texture2D(depthMap, tex).r - DEPTH_MAX_ERROR;
+    return 1.0 / mix(zFarDivZNear, 1.0, sampleZDivW);
+}
+
+bool insideShadowClip(vec4 p)
+{
+    vec3 a = abs(p.xyz);
+    float w = abs(p.w);
+    return w > 0.000001 && all(lessThan(a, vec3(w)));
+}
+
+vec3 toShadowTex(vec4 p)
+{
+    return p.xyz * (0.5 / p.w) + vec3(0.5);
+}
+
+float pcfShadow0(vec3 tc, int mode)
+{
+    if (mode <= 0)
+        return shadow2D(u_ShadowMap, tc);
+    float t = 1.0 / max(r_shadowMapSize, 1.0);
+    if (mode == 1)
+    {
+        return 0.25 * (
+            shadow2D(u_ShadowMap, vec3(tc.xy + vec2(-0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap, vec3(tc.xy + vec2( 0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap, vec3(tc.xy + vec2(-0.5,  0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap, vec3(tc.xy + vec2( 0.5,  0.5) * t, tc.z)));
+    }
+    float sum = 0.0;
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x)
+            sum += shadow2D(u_ShadowMap, vec3(tc.xy + vec2(float(x), float(y)) * t, tc.z));
+    return sum / 9.0;
+}
+
+#if defined(USE_SHADOW_CASCADE)
+float pcfShadow1(vec3 tc, int mode)
+{
+    if (mode <= 0) return shadow2D(u_ShadowMap2, tc);
+    float t = 1.0 / max(r_shadowMapSize, 1.0);
+    if (mode == 1)
+    {
+        return 0.25 * (
+            shadow2D(u_ShadowMap2, vec3(tc.xy + vec2(-0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap2, vec3(tc.xy + vec2( 0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap2, vec3(tc.xy + vec2(-0.5,  0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap2, vec3(tc.xy + vec2( 0.5,  0.5) * t, tc.z)));
+    }
+    float sum = 0.0;
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x)
+            sum += shadow2D(u_ShadowMap2, vec3(tc.xy + vec2(float(x), float(y)) * t, tc.z));
+    return sum / 9.0;
+}
+
+float pcfShadow2(vec3 tc, int mode)
+{
+    if (mode <= 0) return shadow2D(u_ShadowMap3, tc);
+    float t = 1.0 / max(r_shadowMapSize, 1.0);
+    if (mode == 1)
+    {
+        return 0.25 * (
+            shadow2D(u_ShadowMap3, vec3(tc.xy + vec2(-0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap3, vec3(tc.xy + vec2( 0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap3, vec3(tc.xy + vec2(-0.5,  0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap3, vec3(tc.xy + vec2( 0.5,  0.5) * t, tc.z)));
+    }
+    float sum = 0.0;
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x)
+            sum += shadow2D(u_ShadowMap3, vec3(tc.xy + vec2(float(x), float(y)) * t, tc.z));
+    return sum / 9.0;
+}
+
+float pcfShadow3(vec3 tc, int mode)
+{
+    if (mode <= 0) return shadow2D(u_ShadowMap4, tc);
+    float t = 1.0 / max(r_shadowMapSize, 1.0);
+    if (mode == 1)
+    {
+        return 0.25 * (
+            shadow2D(u_ShadowMap4, vec3(tc.xy + vec2(-0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap4, vec3(tc.xy + vec2( 0.5, -0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap4, vec3(tc.xy + vec2(-0.5,  0.5) * t, tc.z)) +
+            shadow2D(u_ShadowMap4, vec3(tc.xy + vec2( 0.5,  0.5) * t, tc.z)));
+    }
+    float sum = 0.0;
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x)
+            sum += shadow2D(u_ShadowMap4, vec3(tc.xy + vec2(float(x), float(y)) * t, tc.z));
+    return sum / 9.0;
+}
+#endif
+
+float sunVisibility(vec3 worldPos, int pcfMode)
+{
+    vec4 p = u_ShadowMvp * vec4(worldPos, 1.0);
+#if defined(USE_SHADOW_CASCADE)
+    if (insideShadowClip(p)) return pcfShadow0(toShadowTex(p), pcfMode);
+    p = u_ShadowMvp2 * vec4(worldPos, 1.0);
+    if (insideShadowClip(p)) return pcfShadow1(toShadowTex(p), pcfMode);
+    p = u_ShadowMvp3 * vec4(worldPos, 1.0);
+    if (insideShadowClip(p)) return pcfShadow2(toShadowTex(p), pcfMode);
+    p = u_ShadowMvp4 * vec4(worldPos, 1.0);
+    if (insideShadowClip(p)) return pcfShadow3(toShadowTex(p), pcfMode);
+    return 0.0;
+#else
+    if (!insideShadowClip(p)) return 0.0;
+    return pcfShadow0(toShadowTex(p), pcfMode);
+#endif
+}
+
+float interleavedGradientNoise(vec2 p)
+{
+    return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
+}
+
+float phaseHG(float cosTheta, float g)
+{
+    float gg = g * g;
+    float denom = max(1.0 + gg - 2.0 * g * cosTheta, 0.0025);
+    // Correct normalized Henyey-Greenstein phase function. DIAG-2 missed 1/(4*pi),
+    // which made forward scattering several times too bright on sun-facing views.
+    return (1.0 - gg) / (4.0 * M_PI * pow(denom, 1.5));
+}
+
+void main()
+{
+    float zFar = max(u_ViewInfo.y, 1.0);
+    float sceneDepth = getLinearDepth(u_ScreenDepthMap, var_DepthTex, u_ViewInfo.x);
+    float maxDepth = min(sceneDepth, max(u_Color.w, 1.0) / zFar);
+    if (maxDepth <= 0.0)
+    {
+        gl_FragColor = vec4(0.0);
+        return;
+    }
+
+    float strength = max(u_Color.x, 0.0);
+    float density = max(u_Color.y, 0.000001);
+    float g = clamp(u_Color.z, -0.70, 0.70);
+    int sampleCount = int(clamp(u_EnableTextures.x, 4.0, float(VOLUMETRIC_MAX_SAMPLES)) + 0.5);
+    int pcfMode = int(clamp(u_EnableTextures.y, 0.0, 2.0) + 0.5);
+    float jitterAmount = clamp(u_EnableTextures.z, 0.0, 0.50);
+    float mapResponse = clamp(u_EnableTextures.w, 0.0, 1.0);
+    float energyGain = clamp(u_BaseColor.x, 0.0, 16.0);
+    float kneeStrength = clamp(u_BaseColor.y, 0.0, 4.0);
+
+    float viewRayLength = max(length(var_ViewDir), 0.0001);
+    vec3 viewRayDir = var_ViewDir / viewRayLength;
+    vec3 sunDir = normalize(u_PrimaryLightOrigin.xyz);
+    float phase = phaseHG(clamp(dot(viewRayDir, sunDir), -1.0, 1.0), g);
+
+    float stepDepth = maxDepth / float(sampleCount);
+    float worldStep = viewRayLength * stepDepth;
+    float jitter = (interleavedGradientNoise(gl_FragCoord.xy) - 0.5) * jitterAmount;
+    float integrated = 0.0;
+
+    for (int i = 0; i < VOLUMETRIC_MAX_SAMPLES; ++i)
+    {
+        if (i >= sampleCount)
+            break;
+        float sampleDepth = stepDepth * (float(i) + 0.5 + jitter);
+        sampleDepth = clamp(sampleDepth, 0.0, maxDepth);
+        float worldDistance = viewRayLength * sampleDepth;
+        vec3 worldPos = u_ViewOrigin + var_ViewDir * sampleDepth;
+        float visibility = sunVisibility(worldPos, pcfMode);
+        float transmittance = exp(-density * worldDistance);
+        integrated += visibility * transmittance * density * worldStep;
+    }
+
+    float sunPeak = max(max(u_PrimaryLightColor.r, u_PrimaryLightColor.g),
+                        max(u_PrimaryLightColor.b, 0.001));
+    vec3 sunTint = u_PrimaryLightColor / sunPeak;
+    // RTCW map sun intensities are not calibrated consistently across maps.
+    // Preserve their relative intent through a compressed response instead of
+    // either ignoring magnitude completely (DIAG-2) or multiplying by it raw.
+    float compressedMapEnergy = sqrt(sunPeak / (sunPeak + 0.50));
+    float sunEnergy = mix(1.0, compressedMapEnergy, mapResponse);
+
+    float scatterAmount = integrated * phase * strength * sunEnergy;
+    // v0.3 energy calibration: preserve the exact v0.2 raymarch/PCF/jitter
+    // softness, then recover perceptual shaft energy before a configurable
+    // soft knee. Gain=1/Knee=1 exactly reproduces the v0.2 energy response.
+    scatterAmount *= energyGain;
+    scatterAmount = scatterAmount / (1.0 + kneeStrength * scatterAmount);
+    vec3 scatter = sunTint * scatterAmount;
+    gl_FragColor = vec4(max(scatter, vec3(0.0)), 0.0);
+}
