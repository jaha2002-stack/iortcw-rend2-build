+	if (debugMode > 0 && (s_debugWorld != tr.world || s_debugMode != debugMode))
+	{
+		ri.Printf(PRINT_ALL, "MAPLIGHT_V02 map=escape1 mode=%d contained=1121 boundaryExcluded=203 oldOverlap=1324\n", debugMode); // DARKWOLF_MAP_LIGHTING_OVERRIDE_V0_2_SURFACE_CONTAINMENT_DEBUG_PROOF
+		if (debugMode >= 2)
+			ri.Printf(PRINT_ALL, "MAPLIGHT_V02 bounds=x[816,1848] y[109,1427] z[-787,-379] criterion=FULL_AABB_CONTAINMENT debug3=GREEN_CONTAINED_ORANGE_EXCLUDED_BOUNDARY\n");
+		s_debugWorld = tr.world;
+		s_debugMode = debugMode;
+	}
+	else if (debugMode == 0 && s_debugMode != 0)
+	{
+		s_debugWorld = tr.world;
+		s_debugMode = 0;
+	}
+
+	surfaceIndex = (int)(surf - tr.world->surfaces);
+	if (R_MapLightingV02IndexInRanges(surfaceIndex, s_mapLightingV02Escape1ContainedRanges,
+		(int)(sizeof(s_mapLightingV02Escape1ContainedRanges) / sizeof(s_mapLightingV02Escape1ContainedRanges[0]))))
+		return 1;
+	if (debugMode >= 3 && R_MapLightingV02IndexInRanges(surfaceIndex, s_mapLightingV02Escape1BoundaryRanges,
+		(int)(sizeof(s_mapLightingV02Escape1BoundaryRanges) / sizeof(s_mapLightingV02Escape1BoundaryRanges[0]))))
+		return 2;
+	return 0;
+}
