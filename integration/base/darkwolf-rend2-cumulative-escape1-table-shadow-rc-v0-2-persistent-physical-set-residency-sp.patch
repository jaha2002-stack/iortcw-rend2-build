+		backEnd.viewParms.zFar / MAX(r_znear->value, 0.001f),
+		backEnd.viewParms.zFar,
+		0.0f,
+		range);
+	VectorSet2(invTexRes,
+		glConfig.vidWidth > 0 ? 1.0f / (float)glConfig.vidWidth : 0.0f,
+		glConfig.vidHeight > 0 ? 1.0f / (float)glConfig.vidHeight : 0.0f);
