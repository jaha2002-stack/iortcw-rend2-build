+static float CG_DarkWolfPCRBV05InfluenceRadius( void ) {
+	char value[64];
+	float radius;
+	trap_Cvar_VariableStringBuffer( "r_staticPromoteInfluenceRadius", value, sizeof( value ) );
+	radius = value[0] ? (float)atof( value ) : 320.0f;
+	if ( radius < 128.0f ) radius = 128.0f;
+	if ( radius > 512.0f ) radius = 512.0f;
+	return radius;
+}
+
+static void CG_DarkWolfPCRBV05BuildInfluencePoints( const vec3_t center,
+	vec3_t points[PCRB_V05_PVS_POINT_COUNT] ) {
+	float radius = CG_DarkWolfPCRBV05InfluenceRadius();
+	int i;
+	VectorCopy( center, points[0] );
+	for ( i = 0; i < 26; ++i ) {
+		VectorMA( center, radius, s_pcrbV05InfluenceDirections[i], points[i + 1] );
+	}
+}
