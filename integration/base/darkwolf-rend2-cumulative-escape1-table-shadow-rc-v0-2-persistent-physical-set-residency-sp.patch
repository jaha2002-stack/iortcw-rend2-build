+void R_StaticPromoteSynthetic_f(void)
+{
+	float distance = 96.0f;
+	float intensity = 60.0f;
+	vec3_t color = { 1.0f, 0.90f, 0.80f };
+	vec3_t origin;
+	int id = -1;
+	if (!tr.world || !s_staticPromoteLastViewValid)
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE SYNTH: no loaded world/view\n");
+		return;
+	}
+	if (ri.Cmd_Argc() >= 2) distance = (float)atof(ri.Cmd_Argv(1));
+	if (ri.Cmd_Argc() >= 3) intensity = (float)atof(ri.Cmd_Argv(2));
+	if (ri.Cmd_Argc() >= 6)
+	{
+		color[0] = (float)atof(ri.Cmd_Argv(3)); color[1] = (float)atof(ri.Cmd_Argv(4)); color[2] = (float)atof(ri.Cmd_Argv(5));
+	}
+	distance = CLAMP(distance, 32.0f, 1024.0f);
+	intensity = CLAMP(intensity, 5.0f, 350.0f);
+	R_StaticPromoteSyntheticClampColor(color);
+	VectorMA(s_staticPromoteLastViewOrg, distance, s_staticPromoteLastViewForward, origin);
+	if (!R_StaticPromoteSyntheticAdd(tr.world->baseName, origin, intensity, color, &id))
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE SYNTH FAILED: could not save %s\n", STATIC_PROMOTE_SYNTHETIC_FILE);
+		return;
+	}
+	s_staticPromotePersistentReady = qfalse;
+	R_StaticPromoteBuildPersistentRegistry();
+	s_staticPromoteLastReportWorld = NULL;
+	ri.Printf(PRINT_ALL, "STATIC_PROMOTE SYNTH SAVED map=%s id=%d origin=%.1f %.1f %.1f distance=%.1f intensity=%.1f color=%.3f %.3f %.3f file=%s\n",
+		tr.world->baseName, id, origin[0], origin[1], origin[2], distance, intensity, color[0], color[1], color[2], STATIC_PROMOTE_SYNTHETIC_FILE);
+}
+
+void R_StaticPromoteSyntheticRemove_f(void)
+{
+	int i;
+	int best = -1;
+	float bestScore = 1.0e30f;
+	if (!tr.world || !s_staticPromoteLastViewValid || !R_StaticPromoteBuildPersistentRegistry())
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE SYNTH REMOVE: no loaded world/view\n");
+		return;
+	}
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		vec3_t delta;
+		float fwd, totalSq, latSq, lat, cone, score;
+		if (!light->synthetic) continue;
+		VectorSubtract(light->candidate.origin, s_staticPromoteLastViewOrg, delta);
+		fwd = DotProduct(delta, s_staticPromoteLastViewForward);
+		if (fwd < 16.0f || fwd > 2048.0f) continue;
+		totalSq = DotProduct(delta, delta); latSq = totalSq - fwd * fwd; if (latSq < 0.0f) latSq = 0.0f; lat = sqrt(latSq);
+		cone = 96.0f + fwd * 0.20f; if (cone > 320.0f) cone = 320.0f;
+		if (lat > cone) continue;
+		score = latSq / (cone * cone) + fwd * 0.00001f;
+		if (score < bestScore) { bestScore = score; best = i; }
+	}
+	if (best < 0)
+	{
+		ri.Printf(PRINT_WARNING, "STATIC_PROMOTE SYNTH REMOVE: no learned synthetic light near crosshair.\n");
+		return;
+	}
+	{
+		int id = s_staticPromotePersistentLights[best].syntheticId;
+		R_StaticPromoteUserOverrideSet(tr.world->baseName, STATIC_PROMOTE_SYNTHETIC_ENTITY_BASE + id, 0);
+		if (!R_StaticPromoteSyntheticRemoveId(tr.world->baseName, id))
+		{
+			ri.Printf(PRINT_WARNING, "STATIC_PROMOTE SYNTH REMOVE FAILED id=%d\n", id);
+			return;
+		}
+		s_staticPromotePersistentReady = qfalse;
+		R_StaticPromoteBuildPersistentRegistry();
+		s_staticPromoteLastReportWorld = NULL;
+		ri.Printf(PRINT_ALL, "STATIC_PROMOTE SYNTH REMOVED map=%s id=%d file=%s\n", tr.world->baseName, id, STATIC_PROMOTE_SYNTHETIC_FILE);
+	}
+}
