+		else
+		{
+			fst1Stats.blockedDepthStages++;
+		}
+	}
+
+	GLSL_SetUniformVec4(sp, UNIFORM_VIEWINFO, viewInfo);
+	GLSL_SetUniformVec2(sp, UNIFORM_INVTEXRES, invTexRes);
+}
