+static const char *R_DarkWolfFactoryInfluenceReason(const refdef_t *fd,
+	const staticPromotePersistentLight_t *light, int *pvsMatchedOut, int *areaPassedOut,
+	int *firstPvsClusterOut, int *firstPvsAreaOut, int *firstVisibleClusterOut, int *firstVisibleAreaOut)
+{
+	mnode_t *viewLeaf;
+	const byte *vis = NULL;
+	int viewCluster;
+	int pvsEnabled;
+	int pvsMatched = 0;
+	int areaPassed = 0;
+	int firstPvsCluster = -1, firstPvsArea = -1;
+	int firstVisibleCluster = -1, firstVisibleArea = -1;
+	int i;
+	if (pvsMatchedOut) *pvsMatchedOut = 0;
+	if (areaPassedOut) *areaPassedOut = 0;
+	if (firstPvsClusterOut) *firstPvsClusterOut = -1;
+	if (firstPvsAreaOut) *firstPvsAreaOut = -1;
+	if (firstVisibleClusterOut) *firstVisibleClusterOut = -1;
+	if (firstVisibleAreaOut) *firstVisibleAreaOut = -1;
+	if (!fd || !light || !tr.world || light->influenceCount <= 0)
+		return "NO_INFLUENCE";
+	pvsEnabled = r_staticPromotePVS ? r_staticPromotePVS->integer : 1;
+	if (!pvsEnabled)
+		return "PVS_DISABLED_VISIBLE";
+	viewLeaf = R_StaticPromotePointInLeafSafe(fd->vieworg);
+	viewCluster = viewLeaf ? viewLeaf->cluster : -1;
+	if (tr.world->vis && viewCluster >= 0 && viewCluster < tr.world->numClusters)
+		vis = tr.world->vis + viewCluster * tr.world->clusterBytes;
+	for (i = 0; i < light->influenceCount; ++i)
+	{
+		int cluster = light->influenceCluster[i];
+		int area = light->influenceArea[i];
+		if (cluster < 0 || cluster >= tr.world->numClusters)
+			continue;
+		if (vis && !(vis[cluster >> 3] & (1 << (cluster & 7))))
+			continue;
+		pvsMatched++;
+		if (firstPvsCluster < 0) { firstPvsCluster = cluster; firstPvsArea = area; }
+		if (area >= 0 && area < MAX_MAP_AREA_BYTES * 8 &&
+			(fd->areamask[area >> 3] & (1 << (area & 7))))
+			continue;
+		areaPassed++;
+		if (firstVisibleCluster < 0) { firstVisibleCluster = cluster; firstVisibleArea = area; }
+	}
+	if (pvsMatchedOut) *pvsMatchedOut = pvsMatched;
+	if (areaPassedOut) *areaPassedOut = areaPassed;
+	if (firstPvsClusterOut) *firstPvsClusterOut = firstPvsCluster;
+	if (firstPvsAreaOut) *firstPvsAreaOut = firstPvsArea;
+	if (firstVisibleClusterOut) *firstVisibleClusterOut = firstVisibleCluster;
+	if (firstVisibleAreaOut) *firstVisibleAreaOut = firstVisibleArea;
+	if (areaPassed > 0)
+		return "VISIBLE";
+	if (pvsMatched > 0)
+		return "AREAMASK";
+	return "NO_PVS";
+}
