+// DARKWOLF_ELECTROSHOCKER_VISIBLE_INFLUENCE_RESIDENCY_PRODUCTION_V1
+// Runtime-validated Mode-D core promoted without diagnostic modes.
+// Existing area/PVS visibility remains the first and fast path. This helper is called only
+// at a normal visibility rejection and performs BSP leaf work only for exact supported
+// dlight-bearing source classes (authored native dlight or ET_TESLA_EF).
+#define DW_DLIGHT_INFLUENCE_MAX_LEAFS 1024
+
+enum {
+	DW_DLIGHT_KIND_NONE = 0,
+	DW_DLIGHT_KIND_NATIVE,
+	DW_DLIGHT_KIND_TESLA
+};
+
+typedef struct dwDlightInfluenceInfo_s {
+	int kind;
+	vec3_t center;
+	vec3_t mins;
+	vec3_t maxs;
+} dwDlightInfluenceInfo_t;
+
+static int SV_DarkWolfDlightInfluenceKind(const sharedEntity_t *ent)
+{
+	if (!ent)
+		return DW_DLIGHT_KIND_NONE;
+	if (ent->s.eType == ET_TESLA_EF && ent->s.dl_intensity && ent->s.time > 0)
+		return DW_DLIGHT_KIND_TESLA;
+	if (ent->r.svFlags & DARKWOLF_SVF_NATIVE_DLIGHT_DIAG)
+		return DW_DLIGHT_KIND_NATIVE;
+	return DW_DLIGHT_KIND_NONE;
+}
+
+static float SV_DarkWolfDlightElectricRadiusScale(void)
+{
+	float scale = 1.0f;
+	if (Cvar_VariableIntegerValue("cg_dlightEffectEnhance"))
+		scale = Cvar_VariableValue("cg_dlightElectricRadiusScale");
+	if (scale < 0.0f) scale = 0.0f;
+	if (scale > 3.0f) scale = 3.0f;
+	return scale;
+}
+
+static qboolean SV_DarkWolfDlightInfluenceBounds(const sharedEntity_t *ent,
+	dwDlightInfluenceInfo_t *info)
+{
+	int kind;
+	if (!ent || !info)
+		return qfalse;
+	Com_Memset(info, 0, sizeof(*info));
+	kind = SV_DarkWolfDlightInfluenceKind(ent);
+	info->kind = kind;
+	if (kind == DW_DLIGHT_KIND_NONE)
+		return qfalse;
+
+	if (kind == DW_DLIGHT_KIND_TESLA)
+	{
+		vec3_t dir;
+		float distance;
+		float offset;
+		float radius = (float)ent->s.time * SV_DarkWolfDlightElectricRadiusScale();
+		VectorCopy(ent->s.origin, info->center);
+		VectorSubtract(ent->s.origin2, ent->s.origin, dir);
+		distance = VectorNormalize(dir);
+		if (distance > 1.0f)
+		{
+			offset = distance * 0.08f;
+			if (offset > 32.0f) offset = 32.0f;
+			VectorMA(ent->s.origin, offset, dir, info->center);
+		}
+		if (radius <= 0.0f)
+			return qfalse;
+		VectorSet(info->mins, info->center[0] - radius, info->center[1] - radius, info->center[2] - radius);
+		VectorSet(info->maxs, info->center[0] + radius, info->center[1] + radius, info->center[2] + radius);
+		return qtrue;
+	}
+
+	// Authored SP_dlight: V5.3 already owns and save/load-rehydrates these exact linked bounds.
+	VectorCopy(ent->r.currentOrigin, info->center);
+	VectorCopy(ent->r.absmin, info->mins);
+	VectorCopy(ent->r.absmax, info->maxs);
+	return qtrue;
+}
+
+static qboolean SV_DarkWolfDlightInfluenceVisible(const sharedEntity_t *ent, int clientArea,
+	const byte *clientpvs)
+{
+	int leafs[DW_DLIGHT_INFLUENCE_MAX_LEAFS];
+	int lastLeaf = -1;
+	int count;
+	int i;
+	dwDlightInfluenceInfo_t info;
+
+	// Cheap semantic classifier first. No BoxLeafnums for unrelated snapshot entities.
+	if (!ent || !clientpvs || SV_DarkWolfDlightInfluenceKind(ent) == DW_DLIGHT_KIND_NONE)
+		return qfalse;
+	if (!SV_DarkWolfDlightInfluenceBounds(ent, &info))
+		return qfalse;
+
+	count = CM_BoxLeafnums(info.mins, info.maxs, leafs, ARRAY_LEN(leafs), &lastLeaf);
+	for (i = 0; i < count; ++i)
+	{
+		int area = CM_LeafArea(leafs[i]);
+		int cluster = CM_LeafCluster(leafs[i]);
+		if (area < 0 || cluster < 0)
+			continue;
+		if (!CM_AreasConnected(clientArea, area))
+			continue;
+		if (clientpvs[cluster >> 3] & (1 << (cluster & 7)))
+			return qtrue;
+	}
+	return qfalse;
+}
