+// REND2_EFFECT_LIGHTING_V8
+static float CG_ClampEffectLightScale( float value ) {
+	if ( value < 0.0f ) {
+		return 0.0f;
+	}
+	if ( value > 3.0f ) {
+		return 3.0f;
+	}
+	return value;
+}
+
+void CG_AddEffectLightToScene( const vec3_t origin, float radius,
+								float r, float g, float b, int overdraw,
+								cgEffectLightType_t type ) {
+	float radiusScale = 1.0f;
+	float intensityScale = 1.0f;
+
+	if ( cg_dlightEffectEnhance.integer ) {
+		switch ( type ) {
+		case CG_EFFECTLIGHT_FIRE:
+			radiusScale = cg_dlightFireRadiusScale.value;
+			intensityScale = cg_dlightFireIntensityScale.value;
+			break;
+		case CG_EFFECTLIGHT_EXPLOSION:
+			radiusScale = cg_dlightExplosionRadiusScale.value;
+			intensityScale = cg_dlightExplosionIntensityScale.value;
+			break;
+		case CG_EFFECTLIGHT_MUZZLE:
+			radiusScale = cg_dlightMuzzleRadiusScale.value;
+			intensityScale = cg_dlightMuzzleIntensityScale.value;
+			break;
+		case CG_EFFECTLIGHT_ELECTRIC:
+		case CG_EFFECTLIGHT_ENVIRONMENTAL_TESLA:
+		case CG_EFFECTLIGHT_WEAPON_TESLA_ENDPOINT: // DARKWOLF_PLAYER_NPC_TESLA_WEAPON_ENDPOINT_SHADOW_PRODUCTION_CANDIDATE_V1
+		case CG_EFFECTLIGHT_WEAPON_TESLA_MUZZLE: // DARKWOLF_STAGE11_UNIFIED_ASSET_SHADOW_COVERAGE_V0_1
+			radiusScale = cg_dlightElectricRadiusScale.value;
+			intensityScale = cg_dlightElectricIntensityScale.value;
+			break;
+		default:
+			break;
+		}
+	}
+
+	radiusScale = CG_ClampEffectLightScale( radiusScale );
+	intensityScale = CG_ClampEffectLightScale( intensityScale );
+	if ( radius <= 0.0f || radiusScale <= 0.0f || intensityScale <= 0.0f ) {
+		return;
+	}
+
+	// DARKWOLF_DLIGHT_FX_SHADOW_ELIGIBILITY_TESLA_PC01
+	// Generic/transient electric FX keep their exact direct-light radius/color/pulse, but can be
+	// excluded from the generic point-light cubemap shadow budget. Environmental ET_TESLA_EF
+	// uses CG_EFFECTLIGHT_ENVIRONMENTAL_TESLA, preserving the same electric scaling while
+	// deliberately remaining eligible for cubemap shadow. No map/coordinate/color/radius hardcode.
+	if ( ( type == CG_EFFECTLIGHT_ELECTRIC || type == CG_EFFECTLIGHT_WEAPON_TESLA_MUZZLE )
+		&& cg_dlightFxShadowPolicy.integer > 0 ) {
+		overdraw |= DARKWOLF_REF_FX_NO_DLIGHT_SHADOW;
+	}
+
+	// DARKWOLF_STAGE11_UNIFIED_ASSET_SHADOW_COVERAGE_V0_1: semantic source identity only.
+	switch ( type ) {
+	case CG_EFFECTLIGHT_MUZZLE:
+		overdraw |= DARKWOLF_REF_SHADOWSRC_MUZZLE;
+		break;
+	case CG_EFFECTLIGHT_ENVIRONMENTAL_TESLA:
+	case CG_EFFECTLIGHT_WEAPON_TESLA_ENDPOINT:
+		overdraw |= DARKWOLF_REF_SHADOWSRC_TESLA_ENDPOINT;
+		break;
+	case CG_EFFECTLIGHT_WEAPON_TESLA_MUZZLE:
+		overdraw |= DARKWOLF_REF_SHADOWSRC_TESLA_MUZZLE;
+		break;
+	case CG_EFFECTLIGHT_EXPLOSION:
+		overdraw |= DARKWOLF_REF_SHADOWSRC_EXPLOSION;
+		break;
+	default:
+		break;
+	}
+
+	trap_R_AddLightToScene( origin, radius * radiusScale,
+		r * intensityScale, g * intensityScale, b * intensityScale, overdraw );
+}
