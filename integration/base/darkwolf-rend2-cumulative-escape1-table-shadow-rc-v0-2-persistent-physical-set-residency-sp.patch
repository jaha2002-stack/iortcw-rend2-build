+static void R_StaticPromotePhysicalResidencyFrameDiag(const refdef_t *fd,
+	staticPromotePersistentLight_t **selected, int selectedCount)
+{
+	// DARKWOLF_USLRD_CLEAN_PRODUCTION_V1: retained call site, diagnostic body disabled.
+	return;
+	static unsigned int lastSignature[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+	static int lastGeneration = -1;
+	int i;
+	int sceneDlights;
+	int promotedCount = 0;
+	int nativeCount;
+	int headroom;
+	int j;
+
+	if (!fd || !tr.world || !0)
+		return;
+	if (lastGeneration != s_staticPromotePersistentBuildGeneration)
+	{
+		Com_Memset(lastSignature, 0, sizeof(lastSignature));
+		lastGeneration = s_staticPromotePersistentBuildGeneration;
+	}
+	for (j = r_firstSceneDlight; j < r_numdlights; ++j)
+		if (backEndData->dlights[j].localVolumetricLamp)
+			promotedCount++;
+	sceneDlights = r_numdlights - r_firstSceneDlight;
+	nativeCount = sceneDlights - promotedCount;
+	headroom = MAX(0, MAX_DLIGHTS - sceneDlights);
+
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		int selectedSlot = -1;
+		int addedIndex;
+		int runtimeClass;
+		const char *decision;
+		unsigned int sig;
+		qboolean watch;
+
+		if (!light->physicalRecognitionAccepted)
+			continue;
+		watch = R_StaticPromotePhysicalResidencyWatch(tr.world->baseName, light->candidate.entityOrdinal);
+		for (j = 0; j < selectedCount; ++j)
+			if (selected[j] == light) { selectedSlot = j; break; }
+		addedIndex = R_DarkWolfFindPromotedDlightIndex(light);
+		runtimeClass = R_StaticPromoteClassifyFixture(light);
+		if (light->physicalSourceRoute == PLR_V01_SOURCE_NATIVE || light->nativeDuplicateSuppressed)
+			decision = "SOURCE_NATIVE";
+		else if (runtimeClass != STATIC_PROMOTE_CLASS_ACCEPT)
+			decision = "CLASS_REJECTED";
+		else if (light->influenceVisibleNow)
+			decision = "PVS_VISIBLE";
+		else if (s_staticPromotePhysicalResidencyFallbackNow[i])
+			decision = "PHYSICAL_CORONA_LOS";
+		else if (s_staticPromoteVisibleSurfaceResidencyNow[i])
+			decision = "SURFACE_RESIDENCY";
+		else if (light->heldResident)
+			decision = "HELD";
+		else
+			decision = "NO_RESIDENCY";
+
+		sig = (unsigned int)(light->influenceVisibleNow ? 1 : 0);
+		sig = sig * 33u + (unsigned int)(s_staticPromotePhysicalResidencyCoronaPresent[i] ? 1 : 0);
+		sig = sig * 33u + (unsigned int)(s_staticPromotePhysicalResidencyCoronaFlags[i] + 1);
+		sig = sig * 33u + (unsigned int)(s_staticPromotePhysicalResidencyFallbackNow[i] ? 1 : 0);
+		sig = sig * 33u + (unsigned int)(s_staticPromoteVisibleSurfaceSignalNow[i] ? 1 : 0);
+		sig = sig * 33u + (unsigned int)(s_staticPromoteVisibleSurfaceResidencyNow[i] ? 1 : 0);
+		sig = sig * 33u + (unsigned int)(light->heldResident ? 1 : 0);
+		sig = sig * 33u + (unsigned int)(selectedSlot + 2);
+		sig = sig * 33u + (unsigned int)(addedIndex + 2);
+		sig = sig * 33u + (unsigned int)(sceneDlights + 1);
+		if (!watch && lastSignature[i] == sig)
+			continue;
+		lastSignature[i] = sig;
+		ri.Printf(PRINT_ALL,
+			"SPR_FIXV1_FRAME map=%s entity=%d watch=%d sourceRoute=%s pvsVisible=%d coronaOrdinal=%d coronaScenePresent=%d coronaFlags=%d coronaLOSVisible=%d physicalFallback=%d surfaceSignal=%d surfaceResidency=%d held=%d selectedSlot=%d addedDlightIndex=%d promotedDlightCount=%d nativeDlightCount=%d sceneDlights=%d MAX_DLIGHTS_HEADROOM=%d finalResidencyDecision=%s\\n",
+			tr.world->baseName, light->candidate.entityOrdinal, watch ? 1 : 0,
+			R_StaticPromotePLRSourceName(light->physicalSourceRoute),
+			light->influenceVisibleNow ? 1 : 0, light->physicalCoronaOrdinal,
+			s_staticPromotePhysicalResidencyCoronaPresent[i] ? 1 : 0,
+			s_staticPromotePhysicalResidencyCoronaFlags[i],
+			(s_staticPromotePhysicalResidencyCoronaFlags[i] & 1) ? 1 : 0,
+			s_staticPromotePhysicalResidencyFallbackNow[i] ? 1 : 0,
+			s_staticPromoteVisibleSurfaceSignalNow[i] ? 1 : 0,
+			s_staticPromoteVisibleSurfaceResidencyNow[i] ? 1 : 0,
+			light->heldResident ? 1 : 0, selectedSlot, addedIndex,
+			promotedCount, nativeCount, sceneDlights, headroom, decision);
+	}
+}
