+// DARKWOLF_PCRB_V0_2_SPATIAL_CORONA_BINDING_ROOT_CAUSE
+#define PCRB_V02_BIND_POS_TOLERANCE   2.0f
+#define PCRB_V02_BIND_COLOR_TOLERANCE 0.020f
+#define PCRB_V02_BIND_SCALE_TOLERANCE 0.020f
+
+static const staticPromotePLRMarker_t *R_DarkWolfPCRBFindBspCorona(int ordinal)
+{
+	int i;
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		const staticPromotePLRMarker_t *m = &s_staticPromotePLRMarkers[i];
+		if (m->kind == PLR_V01_MARKER_CORONA && m->entityOrdinal == ordinal)
+			return m;
+	}
+	return NULL;
+}
+
+static int R_DarkWolfPCRBSpatialMatchRuntimeCorona(const staticPromotePLRMarker_t *bsp,
+	int *acceptedCountOut, int *spatialCountOut, int *nearestIdOut,
+	float *nearestDistOut, float *nearestColorOut, float *nearestScaleOut)
+{
+	int id;
+	int acceptedCount = 0;
+	int spatialCount = 0;
+	int acceptedId = -1;
+	int nearestId = -1;
+	float nearestDist = 1.0e30f;
+	float nearestColor = 1.0e30f;
+	float nearestScale = 1.0e30f;
+
+	if (acceptedCountOut) *acceptedCountOut = 0;
+	if (spatialCountOut) *spatialCountOut = 0;
+	if (nearestIdOut) *nearestIdOut = -1;
+	if (nearestDistOut) *nearestDistOut = 1.0e30f;
+	if (nearestColorOut) *nearestColorOut = 1.0e30f;
+	if (nearestScaleOut) *nearestScaleOut = 1.0e30f;
+	if (!bsp)
+		return -1;
+
+	for (id = 0; id < MAX_GENTITIES; ++id)
+	{
+		const corona_t *meta;
+		float dist;
+		float colorDelta;
+		float scaleDelta;
+		if (!s_darkWolfCoronaResidencyMetaValid[id])
+			continue;
+		meta = &s_darkWolfCoronaResidencyMeta[id];
+		dist = R_StaticPromotePLRDistance(bsp->origin, meta->origin);
+		colorDelta = R_StaticPromotePLRColorDelta(bsp->color, meta->color);
+		scaleDelta = fabs(bsp->scale - meta->scale);
+
+		if (dist < nearestDist)
+		{
+			nearestDist = dist;
+			nearestColor = colorDelta;
+			nearestScale = scaleDelta;
+			nearestId = id;
+		}
+		if (dist > PCRB_V02_BIND_POS_TOLERANCE)
+			continue;
+		spatialCount++;
+		if (colorDelta > PCRB_V02_BIND_COLOR_TOLERANCE || scaleDelta > PCRB_V02_BIND_SCALE_TOLERANCE)
+			continue;
+		acceptedCount++;
+		acceptedId = id;
+	}
+
+	if (acceptedCountOut) *acceptedCountOut = acceptedCount;
+	if (spatialCountOut) *spatialCountOut = spatialCount;
+	if (nearestIdOut) *nearestIdOut = nearestId;
+	if (nearestDistOut) *nearestDistOut = nearestDist;
+	if (nearestColorOut) *nearestColorOut = nearestColor;
+	if (nearestScaleOut) *nearestScaleOut = nearestScale;
+
+	// Strict no-guess contract: exactly one candidate must satisfy all three gates.
+	return (acceptedCount == 1) ? acceptedId : -1;
+}
