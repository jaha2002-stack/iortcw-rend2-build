+{
+	int i;
+	for (i = 0; i < s_fireV07AnchorCount && i < FIREVOL07_MAX_RENDERED_ANCHORS; ++i)
+	{
+		const fireVolumetricV07Anchor_t *anchor = &s_fireV07Anchors[i];
+		vec3_t delta;
+		if (!anchor->semanticFire || anchor->surfaceIndex != surfaceIndex)
+			continue;
+		if (Q_stricmp(anchor->shaderName, shaderName))
+			continue;
+		VectorSubtract(anchor->origin, origin, delta);
+		if (DotProduct(delta, delta) <= 4.0f)
+			return i;
+	}
+	return -1;
+}
