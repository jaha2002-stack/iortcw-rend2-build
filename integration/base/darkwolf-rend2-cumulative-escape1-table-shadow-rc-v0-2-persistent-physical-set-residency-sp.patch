+			fabs(meta.color[2] - 0.584314f) <= 0.03f &&
+			R_StaticPromoteExact8ModelNear(light->candidate.origin, PLR_SPTWO_MODEL_P_NOLIGHT, 112.0f) &&
+			R_StaticPromoteExact8ModelNear(light->candidate.origin, PLR_EXACT8_MODEL_CAGE_5K, 112.0f) &&
+			R_StaticPromoteExact8CountSurfacesNear(light->candidate.origin, PLR_SPTWO_SHADER_PENDANT2,
+				112.0f, &surfaceIndex, &surfaceDistance) >= 1 &&
+			R_StaticPromoteExact8CountSurfacesNear(light->candidate.origin, PLR_EXACT8_SHADER_CAGE_5K,
+				112.0f, NULL, NULL) >= 1 &&
+			R_StaticPromoteExact8MarkerNear(light->candidate.origin, PLR_V01_MARKER_LIGHTJUNIOR, 72.0f, &juniorOrdinal) &&
+			R_StaticPromoteExact8MarkerNear(light->candidate.origin, PLR_V01_MARKER_CORONA, 104.0f, &coronaOrdinal) &&
+			!R_StaticPromoteExact8PersistentIntensityNear(light->candidate.origin, 10.0f, 64.0f))
+		{
+			match = qtrue;
+		}
+		// Second-pass X3) Exact xlight fixture: authored light75/spawnflags16 + exact cool fixture geometry + corona.
+		// No lightJunior is required because this authored fixture has none; all global classifier gates remain unchanged.
+		else if (light->rawMembers == 1 && !meta.style && meta.spawnflags == 16 && !meta.haveFade &&
+			!meta.target[0] && !meta.targetname[0] && fabs(meta.intensity - 75.0f) <= 0.5f &&
+			fabs(meta.color[0] - 0.850980f) <= 0.03f && fabs(meta.color[1] - 0.949020f) <= 0.03f &&
+			fabs(meta.color[2] - 1.0f) <= 0.02f &&
+			R_StaticPromoteExact8ModelNear(light->candidate.origin, PLR_SPTHREE_MODEL_XLIGHT, 32.0f) &&
+			R_StaticPromoteExact8CountSurfacesNear(light->candidate.origin, PLR_SPTWO_SHADER_BASE_LAMP,
+				32.0f, &surfaceIndex, &surfaceDistance) >= 1 &&
+			R_StaticPromoteExact8CountSurfacesNear(light->candidate.origin, PLR_SPTWO_SHADER_PROP_LIGHT,
+				32.0f, NULL, NULL) >= 1 &&
+			R_StaticPromoteExact8MarkerNear(light->candidate.origin, PLR_V01_MARKER_CORONA, 24.0f, &coronaOrdinal))
+		{
+			match = qtrue;
+		}
+
+		if (match)
+		{
+			R_StaticPromoteExact8MarkAccepted(light, 0, surfaceDistance, juniorOrdinal, coronaOrdinal);
+			accepted++;
+		}
+	}
+	return accepted;
+}
+
+static int R_StaticPromoteExact8AppendDerivedType(const char *shaderName, float juniorMaxDistance,
+	int originalPersistentCount, int firstDerived)
+{
+	int appended = 0;
+	int i;
+	if (!tr.world || !tr.world->surfaces || !shaderName)
+		return 0;
+	for (i = 0; i < tr.world->numWorldSurfaces; ++i)
+	{
+		msurface_t *surface = &tr.world->surfaces[i];
+		vec3_t mins, maxs, center, origin;
+		staticPromotePLRMarker_t *junior;
+		staticPromoteExact8EntityMeta_t juniorMeta;
+		float juniorDistance = 0.0f;
+		int nativeOrdinal = -1;
+		staticPromotePersistentLight_t *fixture;
+
+		if (!surface->shader || Q_stricmp(surface->shader->name, shaderName))
+			continue;
+		if (!R_StaticPromoteExact8SurfaceBounds(surface, mins, maxs))
+			continue;
+		if (R_StaticPromoteExact8PersistentNearBounds(mins, maxs, PLR_EXACT8_AUTHORED_GUARD_DIST,
+			originalPersistentCount))
+			continue;
+		junior = R_StaticPromoteExact8NearestJuniorToBounds(mins, maxs, juniorMaxDistance, &juniorDistance);
+		if (!junior)
+			continue;
+		if (!R_StaticPromoteExact8ReadEntityMeta(junior->entityOrdinal, &juniorMeta) ||
+			Q_stricmp(juniorMeta.classname, "lightJunior") || !juniorMeta.haveOrigin ||
+			juniorMeta.style || juniorMeta.spawnflags || juniorMeta.target[0] || juniorMeta.targetname[0] ||
+			juniorMeta.intensity <= 0.0f)
+			continue;
+		R_StaticPromoteExact8BoundsCenter(mins, maxs, center);
+		if (R_StaticPromoteExact8MarkerNear(center, PLR_V01_MARKER_DLIGHT,
+			PLR_EXACT8_NATIVE_GUARD_DIST, &nativeOrdinal))
+			continue;
+		if (R_StaticPromoteExact8DerivedCenterNear(center, PLR_EXACT8_DERIVED_DEDUP_DIST, firstDerived))
+			continue;
+		if (s_staticPromotePersistentCount >= STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES)
+			break;
+
+		VectorCopy(center, origin);
+		if (surface->cullinfo.type & CULLINFO_PLANE)
+			VectorMA(origin, PLR_EXACT8_SURFACE_NORMAL_OFFSET, surface->cullinfo.plane.normal, origin);
+		fixture = &s_staticPromotePersistentLights[s_staticPromotePersistentCount++];
+		memset(fixture, 0, sizeof(*fixture));
+		fixture->candidate.entityOrdinal = PLR_EXACT8_SURFACE_ENTITY_BASE + i;
+		VectorCopy(origin, fixture->candidate.origin);
+		VectorCopy(junior->color, fixture->candidate.color);
+		fixture->candidate.intensity = CLAMP(juniorMeta.intensity, 5.0f, 1000.0f);
+		fixture->candidate.style = 0;
+		fixture->candidate.targetname[0] = '\0';
+		fixture->rawMembers = 1;
+		fixture->lastInfluenceVisibleMs = -1000000000;
+		fixture->approvedFallback = qfalse;
+		fixture->scripted = qfalse;
+		fixture->synthetic = qfalse;
+		R_StaticPromotePLRClearLight(fixture);
+		R_StaticPromoteExact8MarkAccepted(fixture, PLR_EXACT8_EVIDENCE_DERIVED_CANDIDATE,
+			juniorDistance, junior->entityOrdinal, -1);
+		appended++;
+	}
+	return appended;
+}
+
+static void R_StaticPromoteExact8PhysicalFixtureExtension(void)
+{
+	int originalPersistentCount;
+	int firstDerived;
+	int authoredAccepted;
+	int c02Derived;
+	int xlight2500Derived;
+
+	if (!R_StaticPromotePLREnabled() || !tr.world || !tr.world->surfaces)
+		return;
+	originalPersistentCount = s_staticPromotePersistentCount;
+	authoredAccepted = R_StaticPromoteExact8AcceptAuthored();
+	firstDerived = s_staticPromotePersistentCount;
+	// 1) exact light_c02_10000: every approved candidate must have authored lightJunior evidence <=128.
+	c02Derived = R_StaticPromoteExact8AppendDerivedType(PLR_EXACT8_SHADER_C02_10000, 128.0f,
+		originalPersistentCount, firstDerived);
+	// 2) exact light_xlight_2500: deliberately stricter than the old generic PLR v0.2 fallback.
+	// Ambiguous surfaces without lightJunior evidence <=256 fail open and remain unchanged.
+	xlight2500Derived = R_StaticPromoteExact8AppendDerivedType(PLR_EXACT8_SHADER_XLIGHT_2500, 256.0f,
+		originalPersistentCount, firstDerived);
+
+	ri.Printf(PRINT_DEVELOPER,
+		"PLR_EXACT8 map=%s authoredAccepted=%d c02Derived=%d xlight2500Derived=%d total=%d\n",
+		tr.world->baseName, authoredAccepted, c02Derived, xlight2500Derived, s_staticPromotePersistentCount);
+}
