+// physical fixture whose source route is PROMOTED and whose exact associated corona
+// is present in this scene with RTCW's existing LOS-visible flag (bit 0).
+static qboolean s_staticPromotePhysicalResidencyFallbackNow[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static qboolean s_staticPromotePhysicalResidencyCoronaPresent[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
+static int s_staticPromotePhysicalResidencyCoronaFlags[STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES];
