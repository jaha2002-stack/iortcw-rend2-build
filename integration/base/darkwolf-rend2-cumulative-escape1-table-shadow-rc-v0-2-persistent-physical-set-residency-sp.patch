+// DARKWOLF_PHYSICAL_LIGHT_DELIVERY_RESIDENCY_DIAG_V0_1
+static int R_DarkWolfNativeShadowWatchSlot(const vec3_t origin)
+{
+	static const vec3_t watch[] = {
+		{ 1752.0f, 1332.0f, -636.0f }, { 1566.0f, 1184.0f, -636.0f },
+		{ 1564.0f, 608.0f, -636.0f }, { 1652.0f, 268.0f, -636.0f }, { -1340.0f, 692.0f, -36.0f },
+		{ -1408.0f, -384.0f, 280.0f }, { -1376.0f, 828.0f, -292.0f }, { -1164.0f, 956.0f, -292.0f }, { -516.0f, 956.0f, -292.0f }
+	};
+	int i;
+	for (i = 0; i < (int)ARRAY_LEN(watch); ++i)
+	{
+		vec3_t d;
+		VectorSubtract(origin, watch[i], d);
+		if (DotProduct(d, d) <= 16.0f * 16.0f)
+			return i;
+	}
+	return -1;
+}
