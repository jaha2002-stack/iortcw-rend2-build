+static void CG_DarkWolfPCRBV05SetTraceTag( int active, int runtimeId, int fixture,
+	int sample, int point ) {
+	char value[32];
+	Com_sprintf( value, sizeof( value ), "%d", runtimeId ); trap_Cvar_Set( "dw_pcrbV05TraceRuntime", value );
+	Com_sprintf( value, sizeof( value ), "%d", fixture ); trap_Cvar_Set( "dw_pcrbV05TraceFixture", value );
+	Com_sprintf( value, sizeof( value ), "%d", sample ); trap_Cvar_Set( "dw_pcrbV05TraceSample", value );
+	Com_sprintf( value, sizeof( value ), "%d", point ); trap_Cvar_Set( "dw_pcrbV05TracePoint", value );
+	trap_Cvar_Set( "dw_pcrbV05TraceActive", active ? "1" : "0" );
+}
