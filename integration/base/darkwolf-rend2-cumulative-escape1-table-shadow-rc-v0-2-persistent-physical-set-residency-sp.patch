+static qboolean CG_DarkWolfPCRBV04ReadFixtureState( int runtimeId,
+	pcrbV04FixtureState_t *state ) {
+	char cvarName[64];
+	char value[MAX_STRING_CHARS];
+	int parsed;
+	int valid;
+
+	if ( !state ) {
+		return qfalse;
+	}
+	memset( state, 0, sizeof( *state ) );
+	Com_sprintf( cvarName, sizeof( cvarName ), "dw_pcrbV04Fixture%d", runtimeId );
+	trap_Cvar_VariableStringBuffer( cvarName, value, sizeof( value ) );
+	if ( !value[0] ) {
+		return qfalse;
+	}
+	parsed = sscanf( value,
+		"%d %d %d %d %f %f %f %f %f %f %d %d %d %d %d %f",
+		&state->mapCode, &state->runtimeId, &state->fixtureOrdinal, &valid,
+		&state->lightCenter[0], &state->lightCenter[1], &state->lightCenter[2],
+		&state->coronaOrigin[0], &state->coronaOrigin[1], &state->coronaOrigin[2],
+		&state->influencePVSVisible, &state->physicalVisible, &state->heldResident,
+		&state->coronaPresent, &state->coronaLOS, &state->associationScore );
