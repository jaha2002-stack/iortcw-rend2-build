+	float normalizedDistanceSquared = 1.0 / max(radiusSquaredOverDistanceSquared, DLIGHT_EPSILON);
+	float radial = clamp(1.0 - normalizedDistanceSquared, 0.0, 1.0);
+	float smoothCutoff = radial * radial * radial * (radial * (radial * 6.0 - 15.0) + 10.0);
+	float physical = 1.0 / (1.0 + 2.50 * normalizedDistanceSquared);
+	return smoothCutoff * (0.15 + 0.85 * physical);
