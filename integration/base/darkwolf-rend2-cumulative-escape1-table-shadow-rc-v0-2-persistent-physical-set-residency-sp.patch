+static int R_StaticPromoteFindFixtureMergeSlot(const vec3_t origin)
+{
+	int i;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		if (fabs(light->candidate.origin[0] - origin[0]) <= STATIC_PROMOTE_FIXTURE_MERGE_XY &&
+			fabs(light->candidate.origin[1] - origin[1]) <= STATIC_PROMOTE_FIXTURE_MERGE_XY &&
+			fabs(light->candidate.origin[2] - origin[2]) <= STATIC_PROMOTE_FIXTURE_MERGE_Z)
+			return i;
+	}
+	return -1;
+}
+
+static void R_StaticPromoteInfluenceAddLeaf(staticPromotePersistentLight_t *light, mnode_t *leaf)
+{
+	int i;
+	if (!light || !leaf)
+		return;
+	if (leaf->cluster < 0 || leaf->cluster >= tr.world->numClusters)
+		return;
+	for (i = 0; i < light->influenceCount; ++i)
+	{
+		if (light->influenceCluster[i] == leaf->cluster && light->influenceArea[i] == leaf->area)
+			return;
+	}
+	if (light->influenceCount >= STATIC_PROMOTE_INFLUENCE_MAX_LEAVES)
+		return;
+	light->influenceCluster[light->influenceCount] = leaf->cluster;
+	light->influenceArea[light->influenceCount] = leaf->area;
+	light->influenceCount++;
+}
