+	darkWolfShadowMaterialClass_t c = R_DarkWolfClassifyShadowMaterial(shader);
+	if (c == DWSHADOW_MATERIAL_OPAQUE_SOLID || c == DWSHADOW_MATERIAL_ALPHA_CUTOUT)
+		return qtrue;
+	return qfalse;
