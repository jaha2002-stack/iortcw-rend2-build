+static void R_DlightMaterialShaderFlags(const shader_t *shader, int *hasAlpha, int *hasBlend, int *hasDepthWrite)
+{
+	int stageIndex;
+	*hasAlpha = 0;
+	*hasBlend = 0;
+	*hasDepthWrite = 0;
+	if (!shader)
+		return;
+	for (stageIndex = 0; stageIndex < shader->numUnfoggedPasses && stageIndex < MAX_SHADER_STAGES; stageIndex++)
+	{
+		shaderStage_t *stage = shader->stages[stageIndex];
+		if (!stage || !stage->active)
+			continue;
+		if (stage->stateBits & GLS_ATEST_BITS)
+			*hasAlpha = 1;
+		if (stage->stateBits & (GLS_SRCBLEND_BITS | GLS_DSTBLEND_BITS))
+			*hasBlend = 1;
+		if (stage->stateBits & GLS_DEPTHMASK_TRUE)
+			*hasDepthWrite = 1;
+	}
+}
+
+static qboolean R_DlightMaterialShadowCapable(const shader_t *shader, const char **reason,
+	int *hasAlpha, int *hasBlend, int *hasDepthWrite)
+{
+	int sort;
+	R_DlightMaterialShaderFlags(shader, hasAlpha, hasBlend, hasDepthWrite);
+	if (!shader)
+	{
+		*reason = "no_shader";
+		return qfalse;
+	}
+	sort = (int)(shader->sort + 0.5f);
+	if (shader->isSky || sort == SS_ENVIRONMENT)
+	{
+		*reason = "sky_environment";
+		return qfalse;
+	}
+	if (shader->isPortal || sort == SS_PORTAL)
+	{
+		*reason = "portal";
+		return qfalse;
+	}
+	if (sort == SS_FOG || sort == SS_UNDERWATER)
+	{
+		*reason = "fog_or_underwater";
+		return qfalse;
+	}
+	if (sort >= SS_BLEND0)
+	{
+		*reason = "blend_sort";
+		return qfalse;
+	}
+	if (*hasBlend && !*hasAlpha && !*hasDepthWrite)
+	{
+		*reason = "blend_no_alpha_no_depth";
+		return qfalse;
+	}
+	if (shader->numUnfoggedPasses <= 0)
+	{
+		*reason = "no_passes";
+		return qfalse;
+	}
+	*reason = "shadow_candidate";
+	return qtrue;
+}
