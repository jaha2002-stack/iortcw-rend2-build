+static qboolean R_StaticPromotePhysicalResidencyWatch(const char *mapName, int entityOrdinal)
+{
+	if (!mapName)
+		return qfalse;
+	if (!Q_stricmp(mapName, "factory"))
+	{
+		switch (entityOrdinal)
+		{
+		case 109: case 110: case 111: case 201:
+		case 206: case 207: case 241: case 300:
+			return qtrue;
+		default: break;
+		}
+	}
+	else if (!Q_stricmp(mapName, "escape1"))
+	{
+		switch (entityOrdinal)
+		{
+		case 791: case 798: case 885: case 892:
+		case 899: case 905: case 918:
+			return qtrue;
+		default: break;
+		}
+	}
+	return qfalse;
+}
