+	{ 0.0f, 0.7071f, 0.7071f }, { 0.0f, 0.7071f, -0.7071f },
+	{ 0.0f, -0.7071f, 0.7071f }, { 0.0f, -0.7071f, -0.7071f },
+	{ 0.5774f, 0.5774f, 0.5774f }, { 0.5774f, 0.5774f, -0.5774f },
+	{ 0.5774f, -0.5774f, 0.5774f }, { 0.5774f, -0.5774f, -0.5774f },
+	{ -0.5774f, 0.5774f, 0.5774f }, { -0.5774f, 0.5774f, -0.5774f },
+	{ -0.5774f, -0.5774f, 0.5774f }, { -0.5774f, -0.5774f, -0.5774f }
+};
