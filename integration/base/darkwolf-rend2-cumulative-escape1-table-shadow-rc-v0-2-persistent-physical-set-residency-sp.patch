+// DARKWOLF_SUN_VOLUMETRIC_V0_3
+static void RB_VolumetricSunPerfTrace(void)
+{
+	// Production release: diagnostic telemetry removed.
+}
+
+// DARKWOLF_SUN_VOLUMETRIC_PERF_ISOLATION_V0_3
+static void RB_VolumetricSun(FBO_t *srcFbo, ivec4_t srcBox)
+{
+	vec4_t viewInfo, sunDir, params, qualityParams, energyParams;
+	vec3_t viewVector, volumetricSunColor;
+	float zmax, ymax, xmax;
+	float sunDirLenSq, sunPeak;
+	float saturation, colorLuma, saturatedPeak, peakScale;
+	qboolean gateShader = tr.volumetricSunShader.program ? qtrue : qfalse;
+	qboolean gateFbo = (glRefConfig.framebufferObject && tr.quarterFbo[0]) ? qtrue : qfalse;
+	qboolean gateSrc = srcFbo ? qtrue : qfalse;
+	qboolean gateHdr = (r_hdr && r_hdr->integer) ? qtrue : qfalse;
+	qboolean gateWorld = (backEnd.refdef.rdflags & RDF_NOWORLDMODEL) ? qfalse : qtrue;
+	qboolean gateDepth = tr.renderDepthImage ? qtrue : qfalse;
+	qboolean gateSunlight = (r_sunlightMode && r_sunlightMode->integer) ? qtrue : qfalse;
+	qboolean legacySunSource = (tr.sunShadows || (r_forceSun && r_forceSun->integer)) ? qtrue : qfalse;
+	qboolean c0 = tr.sunShadowDepthImage[0] ? qtrue : qfalse;
+	qboolean c1 = tr.sunShadowDepthImage[1] ? qtrue : qfalse;
+	qboolean c2 = tr.sunShadowDepthImage[2] ? qtrue : qfalse;
+	qboolean c3 = tr.sunShadowDepthImage[3] ? qtrue : qfalse;
+	qboolean gateMapSun, gateCsmAllocated, gateCsmUsable;
+
+	if (!r_volumetricSun || !r_volumetricSun->integer ||
+		!r_volumetricSunMode || !r_volumetricSunMode->integer)
+		return; // DARKWOLF_SUN_VOLUMETRIC_PERF_ISOLATION_V0_3: true live raymarch bypass
+
+	sunDirLenSq = DotProduct(backEnd.refdef.sunDir, backEnd.refdef.sunDir);
+	sunPeak = MAX(backEnd.refdef.sunCol[0], MAX(backEnd.refdef.sunCol[1], backEnd.refdef.sunCol[2]));
+	gateMapSun = (sunDirLenSq > 0.25f && sunPeak > 0.0001f) ? qtrue : qfalse;
+	gateCsmAllocated = (r_shadowCascadeZFar->integer != 0) ? (c0 && c1 && c2 && c3) : c3;
+	gateCsmUsable = legacySunSource ? gateCsmAllocated :
+		((r_shadowCascadeZFar->integer != 0) ?
+		 (tr.volumetricSunCsmValid[0] && tr.volumetricSunCsmValid[1] && tr.volumetricSunCsmValid[2] && tr.volumetricSunCsmValid[3]) :
+		 tr.volumetricSunCsmValid[3]);
+
+	if (!gateShader || !gateFbo || !gateSrc || !gateHdr || !gateWorld || !gateDepth || !gateSunlight || !gateMapSun || !gateCsmUsable)
+		return;
+
+	GLSL_BindProgram(&tr.volumetricSunShader);
+	GL_BindToTMU(tr.renderDepthImage, TB_NORMALMAP);
+	if (r_shadowCascadeZFar->integer != 0)
+	{
+		GL_BindToTMU(tr.sunShadowDepthImage[0], TB_SHADOWMAP);
+		GL_BindToTMU(tr.sunShadowDepthImage[1], TB_SHADOWMAP2);
+		GL_BindToTMU(tr.sunShadowDepthImage[2], TB_SHADOWMAP3);
+		GL_BindToTMU(tr.sunShadowDepthImage[3], TB_SHADOWMAP4);
+		GLSL_SetUniformMat4(&tr.volumetricSunShader, UNIFORM_SHADOWMVP,  backEnd.refdef.sunShadowMvp[0]);
+		GLSL_SetUniformMat4(&tr.volumetricSunShader, UNIFORM_SHADOWMVP2, backEnd.refdef.sunShadowMvp[1]);
+		GLSL_SetUniformMat4(&tr.volumetricSunShader, UNIFORM_SHADOWMVP3, backEnd.refdef.sunShadowMvp[2]);
+		GLSL_SetUniformMat4(&tr.volumetricSunShader, UNIFORM_SHADOWMVP4, backEnd.refdef.sunShadowMvp[3]);
+	}
+	else
+	{
+		GL_BindToTMU(tr.sunShadowDepthImage[3], TB_SHADOWMAP);
+		GLSL_SetUniformMat4(&tr.volumetricSunShader, UNIFORM_SHADOWMVP, backEnd.refdef.sunShadowMvp[3]);
+	}
+
+	zmax = backEnd.viewParms.zFar;
+	ymax = zmax * tan(backEnd.viewParms.fovY * M_PI / 360.0f);
+	xmax = zmax * tan(backEnd.viewParms.fovX * M_PI / 360.0f);
+	GLSL_SetUniformVec3(&tr.volumetricSunShader, UNIFORM_VIEWORIGIN, backEnd.refdef.vieworg);
+	VectorScale(backEnd.refdef.viewaxis[0], zmax, viewVector);
+	GLSL_SetUniformVec3(&tr.volumetricSunShader, UNIFORM_VIEWFORWARD, viewVector);
+	VectorScale(backEnd.refdef.viewaxis[1], xmax, viewVector);
+	GLSL_SetUniformVec3(&tr.volumetricSunShader, UNIFORM_VIEWLEFT, viewVector);
+	VectorScale(backEnd.refdef.viewaxis[2], ymax, viewVector);
+	GLSL_SetUniformVec3(&tr.volumetricSunShader, UNIFORM_VIEWUP, viewVector);
+	VectorSet4(viewInfo, zmax / r_znear->value, zmax, 0.0f, 0.0f);
+	GLSL_SetUniformVec4(&tr.volumetricSunShader, UNIFORM_VIEWINFO, viewInfo);
+	VectorSet4(sunDir, backEnd.refdef.sunDir[0], backEnd.refdef.sunDir[1], backEnd.refdef.sunDir[2], 0.0f);
+	GLSL_SetUniformVec4(&tr.volumetricSunShader, UNIFORM_PRIMARYLIGHTORIGIN, sunDir);
+
+	// Production-only tint control. Saturation=1.0 preserves the approved v0.3 color exactly.
+	// Peak magnitude is renormalized, so saturation does not alter map-energy compression.
+	VectorCopy(backEnd.refdef.sunCol, volumetricSunColor);
+	saturation = Com_Clamp(0.0f, 2.0f, r_volumetricSunSaturation->value);
+	if (sunPeak > 0.0001f && saturation != 1.0f)
+	{
+		colorLuma = volumetricSunColor[0] * 0.2126f + volumetricSunColor[1] * 0.7152f + volumetricSunColor[2] * 0.0722f;
+		volumetricSunColor[0] = MAX(0.0f, colorLuma + (volumetricSunColor[0] - colorLuma) * saturation);
+		volumetricSunColor[1] = MAX(0.0f, colorLuma + (volumetricSunColor[1] - colorLuma) * saturation);
+		volumetricSunColor[2] = MAX(0.0f, colorLuma + (volumetricSunColor[2] - colorLuma) * saturation);
+		saturatedPeak = MAX(volumetricSunColor[0], MAX(volumetricSunColor[1], volumetricSunColor[2]));
+		if (saturatedPeak > 0.0001f)
+		{
+			peakScale = sunPeak / saturatedPeak;
+			volumetricSunColor[0] *= peakScale;
+			volumetricSunColor[1] *= peakScale;
+			volumetricSunColor[2] *= peakScale;
+		}
+	}
+	GLSL_SetUniformVec3(&tr.volumetricSunShader, UNIFORM_PRIMARYLIGHTCOLOR, volumetricSunColor);
+
+	VectorSet4(params,
+		Com_Clamp(0.0f, 2.0f, r_volumetricSunStrength->value),
+		Com_Clamp(0.000001f, 0.02f, r_volumetricSunDensity->value),
+		Com_Clamp(-0.70f, 0.70f, r_volumetricSunAnisotropy->value),
+		Com_Clamp(64.0f, zmax, r_volumetricSunMaxDistance->value));
+	VectorSet4(qualityParams,
+		(float)Com_Clamp(4, 32, r_volumetricSunSamples->integer),
+		(float)Com_Clamp(0, 2, r_volumetricSunShadowPcf->integer),
+		Com_Clamp(0.0f, 0.50f, r_volumetricSunJitter->value),
+		Com_Clamp(0.0f, 1.0f, r_volumetricSunMapResponse->value));
+	VectorSet4(energyParams,
+		Com_Clamp(0.0f, 16.0f, r_volumetricSunGain->value),
+		Com_Clamp(0.0f, 4.0f, r_volumetricSunKnee->value),
+		0.0f, 0.0f);
+	GLSL_SetUniformVec4(&tr.volumetricSunShader, UNIFORM_ENABLETEXTURES, qualityParams);
+	GLSL_SetUniformVec4(&tr.volumetricSunShader, UNIFORM_BASECOLOR, energyParams);
+
+	tr.volumetricSunPerfRaymarchThisFrame = 1; // DARKWOLF_SUN_VOLUMETRIC_PERF_ISOLATION_V0_3
+	FBO_Blit(srcFbo, srcBox, NULL, tr.quarterFbo[0], NULL, &tr.volumetricSunShader, params, 0);
+	FBO_Blit(tr.quarterFbo[0], NULL, NULL, srcFbo, srcBox, NULL, NULL, GLS_SRCBLEND_ONE | GLS_DSTBLEND_ONE);
+}
+
+// DARKWOLF_LAMP_VOLUMETRIC_PRODUCTION_CANDIDATE_RELEASE_V1
+// DARKWOLF_LOCAL_VOLUMETRIC_V0_1
+static float RB_LocalVolumetricDlightScore(const dlight_t *dl)
+{
+	vec3_t delta;
+	float distanceSquared, radiusSquared, luminance;
+	VectorSubtract(dl->origin, backEnd.refdef.vieworg, delta);
+	distanceSquared = DotProduct(delta, delta);
+	radiusSquared = dl->radius * dl->radius;
+	luminance = 0.2126f * dl->color[0] + 0.7152f * dl->color[1] + 0.0722f * dl->color[2];
+	return radiusSquared * (0.25f + luminance) /
+		(distanceSquared + radiusSquared * 0.25f + 1.0f);
+}
+
+static int RB_LocalVolumetricSelectLamp(qboolean requireShadow, int *shadowSlot, qboolean *marked)
+{
+	int pass, i, best = -1;
+	float bestScore = -1.0f;
+	int sourceMode = r_volumetricLocalSourceMode ? r_volumetricLocalSourceMode->integer : 0;
+	*shadowSlot = -1;
+	*marked = qfalse;
+
+	// pass 0: only Static Promotion / Lamp Learn-marked dlights.
+	// pass 1 (diagnostic fallback): any dlight, but only when explicitly allowed by SourceMode=1.
+	for (pass = 0; pass < 2; ++pass)
+	{
+		best = -1;
+		bestScore = -1.0f;
+		for (i = 0; i < backEnd.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+		{
+			dlight_t *dl = &backEnd.refdef.dlights[i];
+			int slot = (int)backEnd.refdef.dlightShadowSlot[i];
+			qboolean hasShadow = (backEnd.refdef.dlightShadowMask & (1u << i)) &&
+				slot >= 0 && slot < MAX_DLIGHT_SHADOWS && tr.shadowCubemaps[slot] != NULL;
+			float score;
+
+			if (pass == 0 && !dl->localVolumetricLamp)
+				continue;
+			if (pass == 1 && sourceMode == 0)
+				continue;
+			if (requireShadow && !hasShadow)
+				continue;
+			score = RB_LocalVolumetricDlightScore(dl);
+			if (score > bestScore)
+			{
+				bestScore = score;
+				best = i;
+			}
+		}
+		if (best >= 0)
+		{
+			int slot = (int)backEnd.refdef.dlightShadowSlot[best];
+			*marked = backEnd.refdef.dlights[best].localVolumetricLamp;
+			if ((backEnd.refdef.dlightShadowMask & (1u << best)) &&
+				slot >= 0 && slot < MAX_DLIGHT_SHADOWS && tr.shadowCubemaps[slot])
+				*shadowSlot = slot;
+			return best;
+		}
+	}
+	return -1;
+}
