+static void RB_FireV07LogFallbackNearest(const dlight_t *dl, int maxRanks)
+{
+	int used[FIREVOL07_MAX_RENDERED_ANCHORS];
+	int usedCount = 0;
+	int rank;
+	if (!dl)
+		return;
+	if (s_fireV07AnchorCount <= 0)
+	{
+		ri.Printf(PRINT_ALL,
+			"FIREVOL07_FALLBACK map=%s status=NO_RENDERED_FIRE_OR_ANIMATED_SURFACES nativeDlightOrdinal=%d dlightOrigin=%.1f,%.1f,%.1f\n",
+			tr.world ? tr.world->baseName : "<none>", dl->fireVolumetricNativeOrdinal,
+			dl->origin[0], dl->origin[1], dl->origin[2]);
+		return;
+	}
+	for (rank = 0; rank < maxRanks; ++rank)
+	{
+		int i, best = -1;
+		float bestSq = 1.0e30f;
+		for (i = 0; i < s_fireV07AnchorCount && i < FIREVOL07_MAX_RENDERED_ANCHORS; ++i)
+		{
+			const fireVolumetricV07Anchor_t *anchor = &s_fireV07Anchors[i];
+			vec3_t delta;
+			float distSq;
+			if (RB_FireV07AnchorAlreadyUsed(i, used, usedCount))
+				continue;
+			VectorSubtract(anchor->origin, dl->origin, delta);
+			distSq = DotProduct(delta, delta);
+			if (distSq < bestSq) { bestSq = distSq; best = i; }
+		}
+		if (best < 0)
+			break;
+		used[usedCount++] = best;
+		{
+			const fireVolumetricV07Anchor_t *anchor = &s_fireV07Anchors[best];
+			ri.Printf(PRINT_ALL,
+				"FIREVOL07_FALLBACK map=%s rank=%d nativeDlightOrdinal=%d shader=%s primitive=%s entity=%d surface=%d draw=%d model=%s semanticFire=%d animated=%d animationFrames=%d origin=%.1f,%.1f,%.1f dlightDistance=%.2f\n",
+				tr.world ? tr.world->baseName : "<none>", rank, dl->fireVolumetricNativeOrdinal,
+				anchor->shaderName, RB_FireV07PrimitiveName(anchor->primitive), anchor->entityNum,
+				anchor->surfaceIndex, anchor->drawIndex, anchor->modelName, anchor->semanticFire,
+				anchor->animated, anchor->animationFrames, anchor->origin[0], anchor->origin[1], anchor->origin[2], sqrt(bestSq));
+		}
+	}
+}
