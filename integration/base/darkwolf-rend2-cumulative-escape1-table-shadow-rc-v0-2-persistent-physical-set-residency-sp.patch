+static qboolean R_DlightMaterialMdvVertex(const mdvSurface_t *surface, int frame, int oldframe,
+	float backlerp, int vertexIndex, vec3_t out)
+{
+	const mdvVertex_t *newVertex;
+	const mdvVertex_t *oldVertex;
+	if (!surface || !surface->verts || vertexIndex < 0 || vertexIndex >= surface->numVerts)
+		return qfalse;
+	newVertex = surface->verts + frame * surface->numVerts + vertexIndex;
+	if (backlerp <= 0.0f || oldframe == frame)
+	{
+		VectorCopy(newVertex->xyz, out);
+		return qtrue;
+	}
+	oldVertex = surface->verts + oldframe * surface->numVerts + vertexIndex;
+	VectorLerp(newVertex->xyz, oldVertex->xyz, backlerp, out);
+	return qtrue;
+}
