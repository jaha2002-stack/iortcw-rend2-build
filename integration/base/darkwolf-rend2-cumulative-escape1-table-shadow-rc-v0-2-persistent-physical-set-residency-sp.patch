+// DARKWOLF_FIREVOL_OCCLUSION_PRODUCTION_V1: exact legacy DLight cubemap face orientation, reused for synthetic FireVol cache captures.
+static void R_FireVolProductionSetCubeAxis(viewParms_t *parms, int side)
+{
+	switch (side)
+	{
+	case 0: VectorSet(parms->or.axis[0], -1, 0, 0); VectorSet(parms->or.axis[1], 0, 0, -1); VectorSet(parms->or.axis[2], 0, 1, 0); break;
+	case 1: VectorSet(parms->or.axis[0],  1, 0, 0); VectorSet(parms->or.axis[1], 0, 0,  1); VectorSet(parms->or.axis[2], 0, 1, 0); break;
+	case 2: VectorSet(parms->or.axis[0], 0, -1, 0); VectorSet(parms->or.axis[1], 1, 0, 0); VectorSet(parms->or.axis[2], 0, 0, -1); break;
+	case 3: VectorSet(parms->or.axis[0], 0,  1, 0); VectorSet(parms->or.axis[1], 1, 0, 0); VectorSet(parms->or.axis[2], 0, 0,  1); break;
+	case 4: VectorSet(parms->or.axis[0], 0, 0, -1); VectorSet(parms->or.axis[1], 1, 0, 0); VectorSet(parms->or.axis[2], 0, 1, 0); break;
+	default: VectorSet(parms->or.axis[0], 0, 0, 1); VectorSet(parms->or.axis[1], -1, 0, 0); VectorSet(parms->or.axis[2], 0, 1, 0); break;
+	}
+}
