+static void R_MapLightingLearnFreeArrays(void)
+{
+	if (s_mapLightingLearnSurfaceZone) ri.Free(s_mapLightingLearnSurfaceZone);
+	if (s_mapLightingLearnCurrentLeafMask) ri.Free(s_mapLightingLearnCurrentLeafMask);
+	if (s_mapLightingLearnCurrentClusterMask) ri.Free(s_mapLightingLearnCurrentClusterMask);
+	s_mapLightingLearnSurfaceZone = NULL;
+	s_mapLightingLearnCurrentLeafMask = NULL;
+	s_mapLightingLearnCurrentClusterMask = NULL;
+	s_mapLightingLearnWorldSurfaces = NULL;
+	s_mapLightingLearnWorldSurfaceCount = 0;
+}
+
+static unsigned int R_MapLightingLearnComputeFingerprint(void)
+{
+	void *raw = NULL;
+	long len;
+	unsigned int hash = 2166136261u;
+	const byte *p;
+	long i;
+	char bspPath[MAX_QPATH];
+
+	if (!tr.world || !tr.world->baseName[0])
+		return 0;
+	Com_sprintf(bspPath, sizeof(bspPath), "maps/%s.bsp", tr.world->baseName);
+	len = ri.FS_ReadFile(bspPath, &raw);
+	if (len <= 0 || !raw)
+	{
+		if (raw) ri.FS_FreeFile(raw);
+		return 0;
+	}
+	p = (const byte *)raw;
+	for (i = 0; i < len; ++i)
+	{
+		hash ^= (unsigned int)p[i];
+		hash *= 16777619u;
+	}
+	ri.FS_FreeFile(raw);
+	return hash;
+}
+
+static qboolean R_MapLightingLearnSurfaceUsesLightmap(const msurface_t *surf)
+{
+	int i;
+	if (!surf || !surf->shader)
+		return qfalse;
+	for (i = 0; i < surf->shader->numUnfoggedPasses && i < MAX_SHADER_STAGES; ++i)
+	{
+		shaderStage_t *stage = surf->shader->stages[i];
+		if (stage && (stage->bundle[0].isLightmap || stage->bundle[1].isLightmap))
+			return qtrue;
+	}
+	return qfalse;
+}
+
+static void R_MapLightingLearnMarkLeafSurfaces(const mnode_t *leaf, byte *mask)
+{
+	int i;
+	if (!leaf || !mask || !tr.world || leaf->contents == CONTENTS_NODE)
+		return;
+	for (i = 0; i < leaf->nummarksurfaces; ++i)
+	{
+		int surfaceIndex = tr.world->marksurfaces[leaf->firstmarksurface + i];
+		if (surfaceIndex < 0 || surfaceIndex >= tr.world->numWorldSurfaces)
+			continue;
+		if (!R_MapLightingLearnSurfaceUsesLightmap(&tr.world->surfaces[surfaceIndex]))
+			continue;
+		mask[surfaceIndex] = 1;
+	}
+}
+
+static void R_MapLightingLearnUpdateFocus(void)
+{
+	mnode_t *leaf;
+	int leafIndex;
+	int i;
+	if (!tr.world || !s_mapLightingLearnCurrentLeafMask || !s_mapLightingLearnCurrentClusterMask)
+		return;
+	leaf = R_PointInLeaf(tr.refdef.vieworg);
+	if (!leaf || leaf->contents == CONTENTS_NODE)
+		return;
+	leafIndex = (int)(leaf - tr.world->nodes);
+	if (leafIndex == s_mapLightingLearnLeafIndex && leaf->cluster == s_mapLightingLearnCluster && leaf->area == s_mapLightingLearnArea)
+		return;
+
+	Com_Memset(s_mapLightingLearnCurrentLeafMask, 0, s_mapLightingLearnWorldSurfaceCount);
+	Com_Memset(s_mapLightingLearnCurrentClusterMask, 0, s_mapLightingLearnWorldSurfaceCount);
+	R_MapLightingLearnMarkLeafSurfaces(leaf, s_mapLightingLearnCurrentLeafMask);
+	if (leaf->cluster >= 0)
+	{
+		for (i = tr.world->numDecisionNodes; i < tr.world->numnodes; ++i)
+		{
+			mnode_t *other = &tr.world->nodes[i];
+			if (other->contents != CONTENTS_NODE && other->cluster == leaf->cluster)
+				R_MapLightingLearnMarkLeafSurfaces(other, s_mapLightingLearnCurrentClusterMask);
+		}
+	}
+	s_mapLightingLearnLeafIndex = leafIndex;
+	s_mapLightingLearnCluster = leaf->cluster;
+	s_mapLightingLearnArea = leaf->area;
+}
+
+static int R_MapLightingLearnCountMask(const byte *mask)
+{
+	int i, count = 0;
+	if (!mask) return 0;
+	for (i = 0; i < s_mapLightingLearnWorldSurfaceCount; ++i)
+		if (mask[i]) ++count;
+	return count;
+}
+
+static void R_MapLightingLearnSanitizeName(char *dst, int dstSize, const char *src)
+{
+	int i, out = 0;
+	if (!src || !src[0]) src = "zone";
+	for (i = 0; src[i] && out < dstSize - 1; ++i)
+	{
+		char c = src[i];
+		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9') || c == '_' || c == '-')
+			dst[out++] = c;
+		else
+			dst[out++] = '_';
+	}
+	dst[out] = '\0';
+}
+
+static qboolean R_MapLightingLearnAppend(char *buffer, int capacity, int *used, const char *fmt, ...)
+{
+	va_list ap;
+	int written;
+	if (!buffer || !used || *used < 0 || *used >= capacity)
+		return qfalse;
+	va_start(ap, fmt);
+	written = Q_vsnprintf(buffer + *used, (size_t)(capacity - *used), fmt, ap);
+	va_end(ap);
+	if (written < 0 || written >= capacity - *used)
+		return qfalse;
+	*used += written;
+	return qtrue;
+}
+
+static qboolean R_MapLightingLearnLoadProfileInternal(qboolean autoload)
+{
+	void *fileData = NULL;
+	char *copy = NULL;
+	char *line;
+	long len;
+	int version = -1;
+	char mapName[MAX_QPATH] = {0};
+	unsigned int fingerprint = 0;
+	int worldSurfaces = -1;
+	byte *tempSurfaceZone = NULL;
+	mapLightingLearnZone_t tempZones[MAPLIGHT_LEARN_MAX_ZONES + 1];
+	qboolean sawEnd = qfalse;
+	qboolean ok = qfalse;
+	int i;
+
+	if (!tr.world || !s_mapLightingLearnSurfaceZone)
+		return qfalse;
+	len = ri.FS_ReadFile(s_mapLightingLearnProfilePath, &fileData);
+	if (len < 0 || !fileData)
+	{
+		if (!autoload)
+			ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN: profile not found: %s\n", s_mapLightingLearnProfilePath);
+		return qfalse;
+	}
+
+	copy = ri.Z_Malloc((int)len + 1);
+	Com_Memcpy(copy, fileData, (int)len);
+	copy[len] = '\0';
+	ri.FS_FreeFile(fileData);
+	fileData = NULL;
+	tempSurfaceZone = ri.Z_Malloc(s_mapLightingLearnWorldSurfaceCount);
+	Com_Memset(tempSurfaceZone, 0, s_mapLightingLearnWorldSurfaceCount);
+	Com_Memset(tempZones, 0, sizeof(tempZones));
+
+	for (line = strtok(copy, "\r\n"); line; line = strtok(NULL, "\r\n"))
+	{
+		int zoneId, first, last;
+		char modeText[32], nameText[32];
+		float scale;
+		if (!line[0] || line[0] == '#') continue;
+		if (sscanf(line, "version %d", &version) == 1) continue;
+		if (sscanf(line, "map %63s", mapName) == 1) continue;
+		if (sscanf(line, "fingerprint %x", &fingerprint) == 1) continue;
+		if (sscanf(line, "world_surfaces %d", &worldSurfaces) == 1) continue;
+		if (sscanf(line, "zone %d %31s %f %31s", &zoneId, modeText, &scale, nameText) == 4)
+		{
+			mapLightingLearnMode_t mode;
+			if (zoneId <= 0 || zoneId > MAPLIGHT_LEARN_MAX_ZONES || !R_MapLightingLearnParseMode(modeText, &mode))
+				goto done;
+			tempZones[zoneId].used = qtrue;
+			tempZones[zoneId].mode = mode;
+			tempZones[zoneId].bakedScale = Com_Clamp(0.0f, 1.0f, scale);
+			R_MapLightingLearnSanitizeName(tempZones[zoneId].name, sizeof(tempZones[zoneId].name), nameText);
+			continue;
+		}
+		if (sscanf(line, "range %d %d %d", &zoneId, &first, &last) == 3)
+		{
+			if (zoneId <= 0 || zoneId > MAPLIGHT_LEARN_MAX_ZONES || !tempZones[zoneId].used ||
+				first < 0 || last < first || last >= s_mapLightingLearnWorldSurfaceCount)
+				goto done;
+			for (i = first; i <= last; ++i)
+			{
+				if (tempSurfaceZone[i] != 0 && tempSurfaceZone[i] != zoneId)
+					goto done;
+				tempSurfaceZone[i] = (byte)zoneId;
+			}
+			continue;
+		}
+		if (!Q_stricmp(line, "end")) { sawEnd = qtrue; continue; }
+		goto done;
+	}
+
+	if (!sawEnd || version != MAPLIGHT_LEARN_PROFILE_VERSION ||
+		Q_stricmp(mapName, s_mapLightingLearnMapName) ||
+		worldSurfaces != s_mapLightingLearnWorldSurfaceCount ||
+		fingerprint == 0 || fingerprint != s_mapLightingLearnFingerprint)
+		goto done;
+
+	for (i = 0; i < s_mapLightingLearnWorldSurfaceCount; ++i)
+	{
+		int z = tempSurfaceZone[i];
+		if (z > 0) tempZones[z].surfaceCount++;
+	}
+	Com_Memcpy(s_mapLightingLearnSurfaceZone, tempSurfaceZone, s_mapLightingLearnWorldSurfaceCount);
+	Com_Memcpy(s_mapLightingLearnZones, tempZones, sizeof(tempZones));
+	s_mapLightingLearnProfileLoaded = qtrue;
+	s_mapLightingLearnDirty = qfalse;
+	s_mapLightingLearnActiveZone = 0;
+	ok = qtrue;
+	ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN: loaded %s fingerprint=%08x zones/profile ready\n",
+		s_mapLightingLearnProfilePath, s_mapLightingLearnFingerprint);
+
+done:
+	if (!ok && !autoload)
+		ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN: REJECTED profile %s (format/map/fingerprint/surface-layout mismatch)\n", s_mapLightingLearnProfilePath);
+	if (tempSurfaceZone) ri.Free(tempSurfaceZone);
+	if (copy) ri.Free(copy);
+	return ok;
+}
+
+static void R_MapLightingLearnEnsureWorld(void)
+{
+	if (!tr.world || !tr.world->surfaces || tr.world->numWorldSurfaces <= 0)
+		return;
+	if (s_mapLightingLearnWorldSurfaces == tr.world->surfaces &&
+		s_mapLightingLearnWorldSurfaceCount == tr.world->numWorldSurfaces)
+		return;
+
+	if (s_mapLightingLearnDirty && s_mapLightingLearnMapName[0])
+		ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN: unsaved changes for %s discarded by map/world change\n", s_mapLightingLearnMapName);
+	R_MapLightingLearnFreeArrays();
+	Com_Memset(s_mapLightingLearnZones, 0, sizeof(s_mapLightingLearnZones));
+	s_mapLightingLearnActiveZone = 0;
+	s_mapLightingLearnProfileLoaded = qfalse;
+	s_mapLightingLearnDirty = qfalse;
+	s_mapLightingLearnLeafIndex = -1;
+	s_mapLightingLearnCluster = -999999;
+	s_mapLightingLearnArea = -1;
+	s_mapLightingLearnWorldSurfaces = tr.world->surfaces;
+	s_mapLightingLearnWorldSurfaceCount = tr.world->numWorldSurfaces;
+	s_mapLightingLearnSurfaceZone = ri.Z_Malloc(s_mapLightingLearnWorldSurfaceCount);
+	s_mapLightingLearnCurrentLeafMask = ri.Z_Malloc(s_mapLightingLearnWorldSurfaceCount);
+	s_mapLightingLearnCurrentClusterMask = ri.Z_Malloc(s_mapLightingLearnWorldSurfaceCount);
+	Com_Memset(s_mapLightingLearnSurfaceZone, 0, s_mapLightingLearnWorldSurfaceCount);
+	Com_Memset(s_mapLightingLearnCurrentLeafMask, 0, s_mapLightingLearnWorldSurfaceCount);
+	Com_Memset(s_mapLightingLearnCurrentClusterMask, 0, s_mapLightingLearnWorldSurfaceCount);
+	Q_strncpyz(s_mapLightingLearnMapName, tr.world->baseName, sizeof(s_mapLightingLearnMapName));
+	Com_sprintf(s_mapLightingLearnProfilePath, sizeof(s_mapLightingLearnProfilePath), "maplighting/%s.maplight", s_mapLightingLearnMapName);
+	s_mapLightingLearnFingerprint = R_MapLightingLearnComputeFingerprint();
+	ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN: world=%s worldSurfaces=%d fingerprint=%08x profile=%s\n",
+		s_mapLightingLearnMapName, s_mapLightingLearnWorldSurfaceCount, s_mapLightingLearnFingerprint, s_mapLightingLearnProfilePath);
+	if (r_mapLightingAutoload && r_mapLightingAutoload->integer)
+		R_MapLightingLearnLoadProfileInternal(qtrue);
+}
+
+static byte R_MapLightingLearnEncodeScale(float scale)
+{
+	int q;
+	scale = Com_Clamp(0.0f, 1.0f, scale);
+	if (scale >= 0.999f)
+		return 0;
+	q = (int)(scale * (float)(MAPLIGHT_LEARN_KEY_SCALE_MAX - 1) + 0.5f);
+	if (q < 0) q = 0;
+	if (q > MAPLIGHT_LEARN_KEY_SCALE_MAX - 1) q = MAPLIGHT_LEARN_KEY_SCALE_MAX - 1;
+	return (byte)(q + 1);
+}
+
+float R_MapLightingLearnScaleForKey(byte key)
+{
+	if (key == MAPLIGHT_LEARN_KEY_DEBUG_UNASSIGNED) return 5.0f;
+	if (key == MAPLIGHT_LEARN_KEY_DEBUG_CANDIDATE) return 2.0f;
+	if (key == MAPLIGHT_LEARN_KEY_DEBUG_ACTIVE) return 3.0f;
+	if (key == MAPLIGHT_LEARN_KEY_DEBUG_TRAINED) return 4.0f;
+	if (key >= 1 && key <= MAPLIGHT_LEARN_KEY_SCALE_MAX)
+		return (float)(key - 1) / (float)(MAPLIGHT_LEARN_KEY_SCALE_MAX - 1);
+	return 1.0f;
+}
+
+static byte R_MapLightingLearnLegacyV02Key(const msurface_t *surf)
+{
+	byte legacyKey = R_MapLightingV02WorldSurfaceKey(surf);
+	if (legacyKey == 1)
+	{
+		if (r_mapLightingOverride && r_mapLightingOverride->integer && r_mapLightingDebug && r_mapLightingDebug->integer >= 3)
+			return MAPLIGHT_LEARN_KEY_DEBUG_ACTIVE; /* preserve v0.2 GREEN contained debug */
+		return R_MapLightingLearnEncodeScale(r_mapLightingBakedScale ? r_mapLightingBakedScale->value : 1.0f);
+	}
+	if (legacyKey == 2 && r_mapLightingOverride && r_mapLightingOverride->integer && r_mapLightingDebug && r_mapLightingDebug->integer >= 3)
+		return MAPLIGHT_LEARN_KEY_DEBUG_TRAINED; /* preserve v0.2 ORANGE boundary debug */
+	return 0;
+}
+
+static byte R_MapLightingLearnWorldSurfaceKey(const msurface_t *surf)
+{
+	int surfaceIndex, zoneId, showMode;
+	qboolean learnOn, profileOn;
+	R_MapLightingLearnEnsureWorld();
+	if (!tr.world || !surf || !s_mapLightingLearnSurfaceZone ||
+		surf < tr.world->surfaces || surf >= tr.world->surfaces + tr.world->numWorldSurfaces)
+		return R_MapLightingLearnLegacyV02Key(surf);
+
+	surfaceIndex = (int)(surf - tr.world->surfaces);
+	learnOn = (r_mapLightingLearn && r_mapLightingLearn->integer) ? qtrue : qfalse;
+	profileOn = (s_mapLightingLearnProfileLoaded && r_mapLightingProfileEnable && r_mapLightingProfileEnable->integer) ? qtrue : qfalse;
+	showMode = (learnOn && r_mapLightingLearnShow) ? r_mapLightingLearnShow->integer : 0;
+	if (learnOn)
+		R_MapLightingLearnUpdateFocus();
+	zoneId = s_mapLightingLearnSurfaceZone[surfaceIndex];
+
+	if (showMode > 0)
+	{
+		if (zoneId > 0 && zoneId == s_mapLightingLearnActiveZone)
+			return MAPLIGHT_LEARN_KEY_DEBUG_ACTIVE;
+		if (showMode == 3)
+		{
+			/* DARKWOLF_MAP_LIGHTING_LEARN_V0_3_DETERMINISTIC_VISIBLE_SURFACE_STACK_OVERLAY_PASS_THROUGH_COMPLETE_COVERAGE: every actually submitted lightmapped world surface is classified; no current-cluster gate. */
+			if (zoneId > 0)
+				return MAPLIGHT_LEARN_KEY_DEBUG_TRAINED;
+			if (R_MapLightingLearnSurfaceUsesLightmap(surf))
+				return MAPLIGHT_LEARN_KEY_DEBUG_UNASSIGNED;
+		}
+		else if ((showMode == 1 && s_mapLightingLearnCurrentLeafMask[surfaceIndex]) ||
+			(showMode == 2 && s_mapLightingLearnCurrentClusterMask[surfaceIndex]))
+			return MAPLIGHT_LEARN_KEY_DEBUG_CANDIDATE;
+		if (zoneId > 0)
+			return MAPLIGHT_LEARN_KEY_DEBUG_TRAINED;
+	}
+
+	if ((learnOn || profileOn) && zoneId > 0 && zoneId <= MAPLIGHT_LEARN_MAX_ZONES && s_mapLightingLearnZones[zoneId].used)
+		return R_MapLightingLearnEncodeScale(s_mapLightingLearnZones[zoneId].bakedScale);
+
+	if (learnOn || profileOn)
+		return 0;
+	return R_MapLightingLearnLegacyV02Key(surf);
+}
+
+static int R_MapLightingLearnApplyMaskToActiveZone(const byte *mask, qboolean add)
+{
+	int i, changed = 0;
+	if (!mask || s_mapLightingLearnActiveZone <= 0 || s_mapLightingLearnActiveZone > MAPLIGHT_LEARN_MAX_ZONES ||
+		!s_mapLightingLearnZones[s_mapLightingLearnActiveZone].used)
+		return -1;
+	for (i = 0; i < s_mapLightingLearnWorldSurfaceCount; ++i)
+	{
+		if (!mask[i]) continue;
+		if (add)
+		{
+			int old = s_mapLightingLearnSurfaceZone[i];
+			if (old == s_mapLightingLearnActiveZone) continue;
+			if (old > 0 && old <= MAPLIGHT_LEARN_MAX_ZONES && s_mapLightingLearnZones[old].surfaceCount > 0)
+				s_mapLightingLearnZones[old].surfaceCount--;
+			s_mapLightingLearnSurfaceZone[i] = (byte)s_mapLightingLearnActiveZone;
+			s_mapLightingLearnZones[s_mapLightingLearnActiveZone].surfaceCount++;
+			changed++;
+		}
+		else if (s_mapLightingLearnSurfaceZone[i] == s_mapLightingLearnActiveZone)
+		{
+			s_mapLightingLearnSurfaceZone[i] = 0;
+			if (s_mapLightingLearnZones[s_mapLightingLearnActiveZone].surfaceCount > 0)
+				s_mapLightingLearnZones[s_mapLightingLearnActiveZone].surfaceCount--;
+			changed++;
+		}
+	}
+	if (changed > 0) s_mapLightingLearnDirty = qtrue;
+	return changed;
+}
+
+// DARKWOLF_MAP_LIGHTING_LEARN_V0_3_DETERMINISTIC_VISIBLE_SURFACE_STACK_OVERLAY_PASS_THROUGH_COMPLETE_COVERAGE
+#define MAPLIGHT_LEARN_PICK_MAX_DISTANCE 8192.0f
+#define MAPLIGHT_LEARN_PICK_DIAGNOSTIC_MAX 16
+
+typedef enum mapLightingLearnHitClass_e {
+	MAPLIGHT_LEARN_HIT_EDITABLE_LIGHTMAPPED = 0,
+	MAPLIGHT_LEARN_HIT_NONLIGHTMAPPED_FOG_EFFECT,
+	MAPLIGHT_LEARN_HIT_ALPHA_TRANSPARENT_OVERLAY,
+	MAPLIGHT_LEARN_HIT_DECAL,
+	MAPLIGHT_LEARN_HIT_OPAQUE_NONLIGHTMAPPED_BLOCKER
+} mapLightingLearnHitClass_t;
+
+typedef struct mapLightingLearnSurfaceHit_s {
+	int surfaceIndex;
+	float distance;
+	mapLightingLearnHitClass_t hitClass;
+} mapLightingLearnSurfaceHit_t;
+
+typedef struct mapLightingLearnPick_s {
+	qboolean worldHit;
+	qboolean worldBlocked;
+	qboolean submodelBlocked;
+	int surfaceIndex;
+	int blockedSurfaceIndex;
+	float distance;
+	float blockedDistance;
+	vec3_t point;
+	int leafIndex;
+	int cluster;
+	int area;
+	int submodelEntityNum;
+	int submodelHandle;
+	char submodelName[MAX_QPATH];
+	int totalHitCount;
+	int passThroughCount;
+	int diagnosticHitCount;
+	mapLightingLearnSurfaceHit_t diagnosticHits[MAPLIGHT_LEARN_PICK_DIAGNOSTIC_MAX];
+} mapLightingLearnPick_t;
+
+static const char *R_MapLightingLearnSurfaceTypeName(surfaceType_t type)
+{
+	switch (type)
+	{
+	case SF_FACE: return "face";
+	case SF_GRID: return "grid";
+	case SF_TRIANGLES: return "triangles";
+	default: return "other";
+	}
+}
+
+static const char *R_MapLightingLearnHitClassName(mapLightingLearnHitClass_t hitClass)
+{
+	switch (hitClass)
+	{
+	case MAPLIGHT_LEARN_HIT_EDITABLE_LIGHTMAPPED: return "EDITABLE_LIGHTMAPPED";
+	case MAPLIGHT_LEARN_HIT_NONLIGHTMAPPED_FOG_EFFECT: return "NONLIGHTMAPPED_FOG_EFFECT";
+	case MAPLIGHT_LEARN_HIT_ALPHA_TRANSPARENT_OVERLAY: return "ALPHA_TRANSPARENT_OVERLAY";
+	case MAPLIGHT_LEARN_HIT_DECAL: return "DECAL";
+	case MAPLIGHT_LEARN_HIT_OPAQUE_NONLIGHTMAPPED_BLOCKER: return "OPAQUE_NONLIGHTMAPPED_BLOCKER";
+	default: return "UNKNOWN";
+	}
+}
+
+static qboolean R_MapLightingLearnHitClassPassesThrough(mapLightingLearnHitClass_t hitClass)
+{
+	return hitClass == MAPLIGHT_LEARN_HIT_NONLIGHTMAPPED_FOG_EFFECT ||
+		hitClass == MAPLIGHT_LEARN_HIT_ALPHA_TRANSPARENT_OVERLAY ||
+		hitClass == MAPLIGHT_LEARN_HIT_DECAL;
+}
+
+static mapLightingLearnHitClass_t R_MapLightingLearnClassifySurfaceHit(const msurface_t *surf)
+{
+	const shader_t *shader;
+	if (R_MapLightingLearnSurfaceUsesLightmap(surf))
+		return MAPLIGHT_LEARN_HIT_EDITABLE_LIGHTMAPPED;
+	if (!surf || !surf->shader)
+		return MAPLIGHT_LEARN_HIT_OPAQUE_NONLIGHTMAPPED_BLOCKER;
+	shader = surf->shader;
+	if ((shader->contentFlags & CONTENTS_FOG) || shader->sort == SS_FOG)
+		return MAPLIGHT_LEARN_HIT_NONLIGHTMAPPED_FOG_EFFECT;
+	if (shader->sort == SS_DECAL)
+		return MAPLIGHT_LEARN_HIT_DECAL;
+	if (shader->sort >= SS_SEE_THROUGH)
+		return MAPLIGHT_LEARN_HIT_ALPHA_TRANSPARENT_OVERLAY;
+	return MAPLIGHT_LEARN_HIT_OPAQUE_NONLIGHTMAPPED_BLOCKER;
+}
+
+static qboolean R_MapLightingLearnRayTriangle(const vec3_t rayOrigin, const vec3_t rayDir,
+	const vec3_t a, const vec3_t b, const vec3_t c, float *outDistance)
+{
+	vec3_t edge1, edge2, pvec, tvec, qvec;
+	float det, invDet, u, v, distance;
+	VectorSubtract(b, a, edge1);
+	VectorSubtract(c, a, edge2);
+	CrossProduct(rayDir, edge2, pvec);
+	det = DotProduct(edge1, pvec);
+	if (det > -0.000001f && det < 0.000001f)
+		return qfalse;
+	invDet = 1.0f / det;
+	VectorSubtract(rayOrigin, a, tvec);
+	u = DotProduct(tvec, pvec) * invDet;
+	if (u < 0.0f || u > 1.0f)
+		return qfalse;
+	CrossProduct(tvec, edge1, qvec);
+	v = DotProduct(rayDir, qvec) * invDet;
+	if (v < 0.0f || u + v > 1.0f)
+		return qfalse;
+	distance = DotProduct(edge2, qvec) * invDet;
+	if (distance <= 0.01f || distance > MAPLIGHT_LEARN_PICK_MAX_DISTANCE)
+		return qfalse;
+	*outDistance = distance;
+	return qtrue;
+}
+
+static qboolean R_MapLightingLearnRaySurface(const msurface_t *surf, const vec3_t rayOrigin,
+	const vec3_t rayDir, float *outDistance)
+{
+	const srfBspSurface_t *bsp;
+	int i;
+	float best = MAPLIGHT_LEARN_PICK_MAX_DISTANCE + 1.0f;
+	qboolean hit = qfalse;
+	if (!surf || !surf->data)
+		return qfalse;
+	if (*surf->data != SF_FACE && *surf->data != SF_GRID && *surf->data != SF_TRIANGLES)
+		return qfalse;
+	bsp = (const srfBspSurface_t *)surf->data;
+	if (!bsp->verts || !bsp->indexes || bsp->numVerts <= 0 || bsp->numIndexes < 3)
+		return qfalse;
+	for (i = 0; i + 2 < bsp->numIndexes; i += 3)
+	{
+		int ia = (int)bsp->indexes[i + 0];
+		int ib = (int)bsp->indexes[i + 1];
+		int ic = (int)bsp->indexes[i + 2];
+		float distance;
+		if (ia < 0 || ia >= bsp->numVerts || ib < 0 || ib >= bsp->numVerts || ic < 0 || ic >= bsp->numVerts)
+			continue;
+		if (R_MapLightingLearnRayTriangle(rayOrigin, rayDir, bsp->verts[ia].xyz, bsp->verts[ib].xyz, bsp->verts[ic].xyz, &distance) && distance < best)
+		{
+			best = distance;
+			hit = qtrue;
+		}
+	}
+	if (hit) *outDistance = best;
+	return hit;
+}
+
+static qboolean R_MapLightingLearnRayAabb(const vec3_t rayOrigin, const vec3_t rayDir,
+	const vec3_t mins, const vec3_t maxs, float *outDistance)
+{
+	float tmin = 0.0f;
+	float tmax = MAPLIGHT_LEARN_PICK_MAX_DISTANCE;
+	int axis;
+	for (axis = 0; axis < 3; ++axis)
+	{
+		float d = rayDir[axis];
+		float o = rayOrigin[axis];
+		if (d > -0.000001f && d < 0.000001f)
+		{
+			if (o < mins[axis] || o > maxs[axis]) return qfalse;
+		}
+		else
+		{
+			float inv = 1.0f / d;
+			float t1 = (mins[axis] - o) * inv;
+			float t2 = (maxs[axis] - o) * inv;
+			if (t1 > t2) { float tmp = t1; t1 = t2; t2 = tmp; }
+			if (t1 > tmin) tmin = t1;
+			if (t2 < tmax) tmax = t2;
+			if (tmin > tmax) return qfalse;
+		}
+	}
+	if (tmax <= 0.01f || tmin > MAPLIGHT_LEARN_PICK_MAX_DISTANCE)
+		return qfalse;
+	*outDistance = tmin > 0.01f ? tmin : tmax;
+	return *outDistance > 0.01f && *outDistance <= MAPLIGHT_LEARN_PICK_MAX_DISTANCE;
+}
+
+static qboolean R_MapLightingLearnNearestBrushBlocker(const vec3_t rayOrigin, const vec3_t rayDir,
+	float maxDistance, int *outEntityNum, int *outHandle, char *outName, int outNameSize, float *outDistance)
+{
+	int i, axis;
+	qboolean found = qfalse;
+	float best = maxDistance;
+	for (i = 0; i < tr.refdef.num_entities; ++i)
+	{
+		trRefEntity_t *ent = &tr.refdef.entities[i];
+		model_t *model;
+		bmodel_t *bmodel;
+		vec3_t delta, localOrigin, localDir;
+		float distance;
+		if (!ent->e.hModel) continue;
+		model = R_GetModelByHandle(ent->e.hModel);
+		if (!model || model->type != MOD_BRUSH || !model->bmodel || !Q_stricmp(model->name, "*0")) continue;
+		bmodel = model->bmodel;
+		VectorSubtract(rayOrigin, ent->e.origin, delta);
+		for (axis = 0; axis < 3; ++axis)
+		{
+			float axisLenSq = DotProduct(ent->e.axis[axis], ent->e.axis[axis]);
+			if (axisLenSq <= 0.000001f) break;
+			localOrigin[axis] = DotProduct(delta, ent->e.axis[axis]) / axisLenSq;
+			localDir[axis] = DotProduct(rayDir, ent->e.axis[axis]) / axisLenSq;
+		}
+		if (axis != 3) continue;
+		if (!R_MapLightingLearnRayAabb(localOrigin, localDir, bmodel->bounds[0], bmodel->bounds[1], &distance)) continue;
+		if (distance >= best) continue;
+		best = distance;
+		*outEntityNum = ent->e.entityNum;
+		*outHandle = ent->e.hModel;
+		Q_strncpyz(outName, model->name, outNameSize);
+		found = qtrue;
+	}
+	if (found) *outDistance = best;
+	return found;
+}
+
+static int R_MapLightingLearnCompareSurfaceHits(const void *a, const void *b)
+{
+	const mapLightingLearnSurfaceHit_t *ha = (const mapLightingLearnSurfaceHit_t *)a;
+	const mapLightingLearnSurfaceHit_t *hb = (const mapLightingLearnSurfaceHit_t *)b;
+	if (ha->distance < hb->distance) return -1;
+	if (ha->distance > hb->distance) return 1;
+	if (ha->surfaceIndex < hb->surfaceIndex) return -1;
+	if (ha->surfaceIndex > hb->surfaceIndex) return 1;
+	return 0;
+}
+
+static qboolean R_MapLightingLearnResolveCrosshairStack(mapLightingLearnPick_t *pick)
+{
+	vec3_t rayOrigin, rayDir, leafPoint;
+	mapLightingLearnSurfaceHit_t *hits;
+	float decisionDistance = MAPLIGHT_LEARN_PICK_MAX_DISTANCE;
+	float blockerDistance = MAPLIGHT_LEARN_PICK_MAX_DISTANCE + 1.0f;
+	int hitCount = 0;
+	int i;
+	mnode_t *leaf;
+	if (!pick) return qfalse;
+	Com_Memset(pick, 0, sizeof(*pick));
+	pick->surfaceIndex = -1;
+	pick->blockedSurfaceIndex = -1;
+	pick->leafIndex = -1;
+	pick->cluster = -1;
+	pick->area = -1;
+	pick->submodelEntityNum = -1;
+	pick->submodelHandle = 0;
+	pick->distance = MAPLIGHT_LEARN_PICK_MAX_DISTANCE + 1.0f;
+	pick->blockedDistance = MAPLIGHT_LEARN_PICK_MAX_DISTANCE + 1.0f;
+	R_MapLightingLearnEnsureWorld();
+	if (!tr.world || !s_mapLightingLearnSurfaceZone || s_mapLightingLearnWorldSurfaceCount <= 0) return qfalse;
+	VectorCopy(tr.refdef.vieworg, rayOrigin);
+	VectorCopy(tr.refdef.viewaxis[0], rayDir);
+	if (VectorNormalize(rayDir) <= 0.000001f) return qfalse;
+
+	hits = (mapLightingLearnSurfaceHit_t *)ri.Hunk_AllocateTempMemory(s_mapLightingLearnWorldSurfaceCount * sizeof(*hits));
+	if (!hits) return qfalse;
+	for (i = 0; i < s_mapLightingLearnWorldSurfaceCount; ++i)
+	{
+		float distance;
+		if (!R_MapLightingLearnRaySurface(&tr.world->surfaces[i], rayOrigin, rayDir, &distance))
+			continue;
+		hits[hitCount].surfaceIndex = i;
+		hits[hitCount].distance = distance;
+		hits[hitCount].hitClass = R_MapLightingLearnClassifySurfaceHit(&tr.world->surfaces[i]);
+		++hitCount;
+	}
+	pick->totalHitCount = hitCount;
+	if (hitCount > 1)
+		qsort(hits, (size_t)hitCount, sizeof(*hits), R_MapLightingLearnCompareSurfaceHits);
+
+	for (i = 0; i < hitCount; ++i)
+	{
+		mapLightingLearnSurfaceHit_t *hit = &hits[i];
+		if (pick->diagnosticHitCount < MAPLIGHT_LEARN_PICK_DIAGNOSTIC_MAX)
+			pick->diagnosticHits[pick->diagnosticHitCount++] = *hit;
+		if (R_MapLightingLearnHitClassPassesThrough(hit->hitClass))
+		{
+			++pick->passThroughCount;
+			continue;
+		}
+		decisionDistance = hit->distance;
+		if (hit->hitClass == MAPLIGHT_LEARN_HIT_EDITABLE_LIGHTMAPPED)
+		{
+			pick->worldHit = qtrue;
+			pick->surfaceIndex = hit->surfaceIndex;
+			pick->distance = hit->distance;
+		}
+		else
+		{
+			pick->worldBlocked = qtrue;
+			pick->blockedSurfaceIndex = hit->surfaceIndex;
+			pick->blockedDistance = hit->distance;
+			pick->distance = hit->distance;
+		}
+		break;
+	}
+
+	if (R_MapLightingLearnNearestBrushBlocker(rayOrigin, rayDir,
+		(decisionDistance < MAPLIGHT_LEARN_PICK_MAX_DISTANCE ? decisionDistance + 0.05f : MAPLIGHT_LEARN_PICK_MAX_DISTANCE),
+		&pick->submodelEntityNum, &pick->submodelHandle, pick->submodelName, sizeof(pick->submodelName), &blockerDistance))
+	{
+		pick->submodelBlocked = qtrue;
+		pick->worldHit = qfalse;
+		pick->worldBlocked = qfalse;
+		pick->surfaceIndex = -1;
+		pick->blockedSurfaceIndex = -1;
+		pick->distance = blockerDistance;
+		ri.Hunk_FreeTempMemory(hits);
+		return qtrue;
+	}
+
+	if (pick->worldHit)
+	{
+		VectorMA(rayOrigin, pick->distance, rayDir, pick->point);
+		VectorMA(pick->point, -0.5f, rayDir, leafPoint);
+		leaf = R_PointInLeaf(leafPoint);
+		if (leaf && leaf->contents != CONTENTS_NODE)
+		{
+			pick->leafIndex = (int)(leaf - tr.world->nodes);
+			pick->cluster = leaf->cluster;
+			pick->area = leaf->area;
+		}
+	}
+	ri.Hunk_FreeTempMemory(hits);
+	return hitCount > 0 || pick->submodelBlocked;
+}
+
+static void R_MapLightingLearnPrintStackHit(const mapLightingLearnSurfaceHit_t *hit, int ordinal)
+{
+	const msurface_t *surf;
+	const shader_t *shader;
+	const char *action;
+	if (!hit || hit->surfaceIndex < 0 || hit->surfaceIndex >= s_mapLightingLearnWorldSurfaceCount) return;
+	surf = &tr.world->surfaces[hit->surfaceIndex];
+	shader = surf->shader;
+	action = R_MapLightingLearnHitClassPassesThrough(hit->hitClass) ? "pass-through" :
+		(hit->hitClass == MAPLIGHT_LEARN_HIT_EDITABLE_LIGHTMAPPED ? "select" : "block");
+	ri.Printf(PRINT_ALL,
+		"MAPLIGHT_LEARN v0.3 %s surface=%d shader=%s lightmapped=%s type=%s class=%s action=%s distance=%.2f sort=%.1f surfaceFlags=0x%x contentFlags=0x%x\n",
+		ordinal == 0 ? "FRONT HIT:" : va("HIT %d:", ordinal + 1),
+		hit->surfaceIndex, shader ? shader->name : "<none>",
+		R_MapLightingLearnSurfaceUsesLightmap(surf) ? "yes" : "no",
+		R_MapLightingLearnSurfaceTypeName(*surf->data), R_MapLightingLearnHitClassName(hit->hitClass), action,
+		hit->distance, shader ? shader->sort : -1.0f, shader ? shader->surfaceFlags : 0, shader ? shader->contentFlags : 0);
+}
+
+static void R_MapLightingLearnPrintPick(const mapLightingLearnPick_t *pick)
+{
+	const msurface_t *surf;
+	int zoneId;
+	const char *zoneName;
+	int i;
+	if (!pick) return;
+	ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 stack totalHits=%d passThrough=%d diagnostics=%d/%d\n",
+		pick->totalHitCount, pick->passThroughCount, pick->diagnosticHitCount, MAPLIGHT_LEARN_PICK_DIAGNOSTIC_MAX);
+	for (i = 0; i < pick->diagnosticHitCount; ++i)
+	{
+		if (pick->submodelBlocked && pick->diagnosticHits[i].distance > pick->distance + 0.05f)
+			break;
+		R_MapLightingLearnPrintStackHit(&pick->diagnosticHits[i], i);
+	}
+	if (pick->totalHitCount > pick->diagnosticHitCount)
+		ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 stack note: %d additional world hits collected but not printed\n",
+			pick->totalHitCount - pick->diagnosticHitCount);
+	if (pick->submodelBlocked)
+	{
+		ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 SELECTED TARGET: none model=submodel entity=%d handle=%d name=%s distance=%.2f editable=no class=BRUSH_SUBMODEL_MOVER action=block\n",
+			pick->submodelEntityNum, pick->submodelHandle, pick->submodelName[0] ? pick->submodelName : "<brush>", pick->distance);
+		return;
+	}
+	if (pick->worldBlocked && pick->blockedSurfaceIndex >= 0 && pick->blockedSurfaceIndex < s_mapLightingLearnWorldSurfaceCount)
+	{
+		surf = &tr.world->surfaces[pick->blockedSurfaceIndex];
+		ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 SELECTED TARGET: none blockedBySurface=%d shader=%s lightmapped=no class=OPAQUE_NONLIGHTMAPPED_BLOCKER distance=%.2f editable=no action=block\n",
+			pick->blockedSurfaceIndex, surf->shader ? surf->shader->name : "<none>", pick->blockedDistance);
+		return;
+	}
+	if (!pick->worldHit || pick->surfaceIndex < 0 || pick->surfaceIndex >= s_mapLightingLearnWorldSurfaceCount)
+	{
+		ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 SELECTED TARGET: none editable=no reason=no-lightmapped-world-surface-behind-pass-through-stack\n");
+		return;
+	}
+	surf = &tr.world->surfaces[pick->surfaceIndex];
+	zoneId = s_mapLightingLearnSurfaceZone[pick->surfaceIndex];
+	zoneName = (zoneId > 0 && zoneId <= MAPLIGHT_LEARN_MAX_ZONES && s_mapLightingLearnZones[zoneId].used) ? s_mapLightingLearnZones[zoneId].name : "none";
+	ri.Printf(PRINT_ALL,
+		"MAPLIGHT_LEARN v0.3 SELECTED EDITABLE TARGET: surface=%d zone=%d zoneName=%s shader=%s lightmapped=yes type=%s leaf=%d cluster=%d area=%d distance=%.2f editable=yes class=EDITABLE_LIGHTMAPPED\n",
+		pick->surfaceIndex, zoneId, zoneName, surf->shader ? surf->shader->name : "<none>",
+		R_MapLightingLearnSurfaceTypeName(*surf->data), pick->leafIndex, pick->cluster, pick->area, pick->distance);
+}
+
+void R_MapLightingLearnSurfaceInspect_f(void)
+{
+	mapLightingLearnPick_t pick;
+	if (!R_MapLightingLearnResolveCrosshairStack(&pick))
+	{
+		ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 inspect hit=none editable=no\n");
+		return;
+	}
+	R_MapLightingLearnPrintPick(&pick);
+}
+
+void R_MapLightingLearnSurfaceAdd_f(void)
+{
+	mapLightingLearnPick_t pick;
+	int oldZone;
+	if (s_mapLightingLearnActiveZone <= 0 || s_mapLightingLearnActiveZone > MAPLIGHT_LEARN_MAX_ZONES || !s_mapLightingLearnZones[s_mapLightingLearnActiveZone].used)
+	{ ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN: create/select a zone first\n"); return; }
+	if (!R_MapLightingLearnResolveCrosshairStack(&pick))
+	{ ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_add: no surface stack under crosshair\n"); return; }
+	if (pick.submodelBlocked)
+	{ R_MapLightingLearnPrintPick(&pick); ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_add refused: brush submodel/mover blocks the editable world target\n"); return; }
+	if (pick.worldBlocked)
+	{ R_MapLightingLearnPrintPick(&pick); ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_add refused: opaque non-lightmapped world surface blocks the editable target\n"); return; }
+	if (!pick.worldHit || pick.surfaceIndex < 0)
+	{ R_MapLightingLearnPrintPick(&pick); ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_add refused: no editable lightmapped world target behind pass-through stack\n"); return; }
+	oldZone = s_mapLightingLearnSurfaceZone[pick.surfaceIndex];
+	if (oldZone == s_mapLightingLearnActiveZone)
+	{ ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 surface_add selectedTarget=%d already in activeZone=%d\n", pick.surfaceIndex, s_mapLightingLearnActiveZone); return; }
+	if (oldZone > 0 && oldZone <= MAPLIGHT_LEARN_MAX_ZONES && s_mapLightingLearnZones[oldZone].surfaceCount > 0)
+		s_mapLightingLearnZones[oldZone].surfaceCount--;
+	s_mapLightingLearnSurfaceZone[pick.surfaceIndex] = (byte)s_mapLightingLearnActiveZone;
+	s_mapLightingLearnZones[s_mapLightingLearnActiveZone].surfaceCount++;
+	s_mapLightingLearnDirty = qtrue;
+	ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 surface_add selectedTarget=%d movedFromZone=%d activeZone=%d passThrough=%d\n",
+		pick.surfaceIndex, oldZone, s_mapLightingLearnActiveZone, pick.passThroughCount);
+}
+
+void R_MapLightingLearnSurfaceRemove_f(void)
+{
+	mapLightingLearnPick_t pick;
+	int zoneId;
+	if (s_mapLightingLearnActiveZone <= 0 || s_mapLightingLearnActiveZone > MAPLIGHT_LEARN_MAX_ZONES || !s_mapLightingLearnZones[s_mapLightingLearnActiveZone].used)
+	{ ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN: create/select a zone first\n"); return; }
+	if (!R_MapLightingLearnResolveCrosshairStack(&pick))
+	{ ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_remove: no surface stack under crosshair\n"); return; }
+	if (pick.submodelBlocked)
+	{ R_MapLightingLearnPrintPick(&pick); ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_remove refused: brush submodel/mover blocks the editable world target\n"); return; }
+	if (pick.worldBlocked)
+	{ R_MapLightingLearnPrintPick(&pick); ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_remove refused: opaque non-lightmapped world surface blocks the editable target\n"); return; }
+	if (!pick.worldHit || pick.surfaceIndex < 0)
+	{ R_MapLightingLearnPrintPick(&pick); ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_remove refused: no editable lightmapped world target behind pass-through stack\n"); return; }
+	zoneId = s_mapLightingLearnSurfaceZone[pick.surfaceIndex];
+	if (zoneId == 0)
+	{ ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 surface_remove selectedTarget=%d zone=none changed=0\n", pick.surfaceIndex); return; }
+	if (zoneId != s_mapLightingLearnActiveZone)
+	{ ri.Printf(PRINT_WARNING, "MAPLIGHT_LEARN v0.3 surface_remove refused: selectedTarget=%d belongsToZone=%d; select that zone first\n", pick.surfaceIndex, zoneId); return; }
+	s_mapLightingLearnSurfaceZone[pick.surfaceIndex] = 0;
+	if (s_mapLightingLearnZones[zoneId].surfaceCount > 0) s_mapLightingLearnZones[zoneId].surfaceCount--;
+	s_mapLightingLearnDirty = qtrue;
+	ri.Printf(PRINT_ALL, "MAPLIGHT_LEARN v0.3 surface_remove selectedTarget=%d activeZone=%d changed=1 passThrough=%d\n",
+		pick.surfaceIndex, zoneId, pick.passThroughCount);
+}
