+static int SV_DarkWolfNativeWatchSlot(const vec3_t origin)
+{
+	static const vec3_t watch[] = {
+		{ 1752.0f, 1332.0f, -636.0f }, // escape1 start torch, authored dlight
+		{ 1566.0f, 1184.0f, -636.0f }, // escape1 start torch, authored dlight
+		{ 1564.0f,  608.0f, -636.0f }, // escape1 weak torch control
+		{ 1652.0f,  268.0f, -636.0f }, // escape1 stronger torch control
+		{-1340.0f,  692.0f,  -36.0f }, // escape1 furnace authored dlight
+		{-1408.0f, -384.0f,  280.0f }, // crypt1 known-good authored torch dlight
+		{-1376.0f,  828.0f, -292.0f }, // crypt1 control
+		{-1164.0f,  956.0f, -292.0f }, // crypt1 control
+		{ -516.0f,  956.0f, -292.0f }  // crypt1 control
+	};
+	int i;
+	for (i = 0; i < (int)ARRAY_LEN(watch); ++i)
+	{
+		vec3_t d;
+		VectorSubtract(origin, watch[i], d);
+		if (DotProduct(d, d) <= 16.0f * 16.0f)
+			return i;
+	}
+	return -1;
