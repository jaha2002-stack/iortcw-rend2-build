+static qboolean RB_FireV07SurfaceCenter(drawSurf_t *draw, int drawIndex, int entityNum,
+	vec3_t worldOrigin, int *primitive, int *surfaceIndex, char *modelName, int modelNameSize)
+{
+	surfaceType_t type;
+	if (!draw || !draw->surface)
+		return qfalse;
+	type = *draw->surface;
+	*primitive = FIREVOL_PRIM_UNKNOWN;
+	*surfaceIndex = -1;
+	RB_FireV07SetModelName(entityNum, modelName, modelNameSize);
+
+	if (type == SF_FACE || type == SF_GRID || type == SF_TRIANGLES)
+	{
+		srfBspSurface_t *bsp = (srfBspSurface_t *)draw->surface;
+		vec3_t localCenter = {0.0f, 0.0f, 0.0f};
+		int i;
+		if (!bsp->verts || bsp->numVerts <= 0)
+			return qfalse;
+		for (i = 0; i < bsp->numVerts; ++i)
+			VectorAdd(localCenter, bsp->verts[i].xyz, localCenter);
+		VectorScale(localCenter, 1.0f / (float)bsp->numVerts, localCenter);
+		RB_FireV07LocalToWorld(entityNum, localCenter, worldOrigin);
+		*primitive = (entityNum == REFENTITYNUM_WORLD) ? FIREVOL_PRIM_WORLD : FIREVOL_PRIM_BMODEL;
+		*surfaceIndex = RB_FireV07FindWorldSurface(draw->surface);
+		return qtrue;
+	}
+
+	if (type == SF_VAO_MDVMESH || type == SF_MDV)
+	{
+		mdvModel_t *mdvModel;
+		mdvSurface_t *surface;
+		model_t *handleModel;
+		trRefEntity_t *ent;
+		vec3_t localCenter = {0.0f, 0.0f, 0.0f};
+		float backlerp;
+		int i, contributed = 0;
+		if (!RB_FireV07ResolveMdv(draw, entityNum, &mdvModel, &surface, &handleModel))
+			return qfalse;
+		ent = &backEnd.refdef.entities[entityNum];
+		backlerp = Com_Clamp(0.0f, 1.0f, ent->e.backlerp);
+		for (i = 0; i < surface->numVerts; ++i)
+		{
+			vec3_t vertex;
+			if (!RB_FireV07MdvVertex(surface, ent->e.frame, ent->e.oldframe, backlerp, i, vertex))
+				continue;
+			VectorAdd(localCenter, vertex, localCenter);
+			contributed++;
+		}
+		if (contributed <= 0)
+			return qfalse;
+		VectorScale(localCenter, 1.0f / (float)contributed, localCenter);
+		RB_FireV07LocalToWorld(entityNum, localCenter, worldOrigin);
+		*primitive = FIREVOL_PRIM_MDV;
+		*surfaceIndex = (int)(surface - mdvModel->surfaces);
+		if (handleModel && handleModel->name[0])
+			Q_strncpyz(modelName, handleModel->name, modelNameSize);
+		return qtrue;
+	}
+
+	if (type == SF_POLY)
+	{
+		srfPoly_t *poly = (srfPoly_t *)draw->surface;
+		int i;
+		VectorClear(worldOrigin);
+		if (!poly->verts || poly->numVerts <= 0)
+			return qfalse;
+		for (i = 0; i < poly->numVerts; ++i)
+			VectorAdd(worldOrigin, poly->verts[i].xyz, worldOrigin);
+		VectorScale(worldOrigin, 1.0f / (float)poly->numVerts, worldOrigin);
+		*primitive = FIREVOL_PRIM_POLY;
+		*surfaceIndex = drawIndex;
+		Q_strncpyz(modelName, "<cgame-poly>", modelNameSize);
+		return qtrue;
+	}
+
+	if (type == SF_FLARE)
+	{
+		srfFlare_t *flare = (srfFlare_t *)draw->surface;
+		RB_FireV07LocalToWorld(entityNum, flare->origin, worldOrigin);
+		*primitive = FIREVOL_PRIM_FLARE;
+		*surfaceIndex = drawIndex;
+		Q_strncpyz(modelName, "<flare>", modelNameSize);
+		return qtrue;
+	}
+
+	if (type == SF_ENTITY && entityNum >= 0 && entityNum < backEnd.refdef.num_entities)
+	{
+		VectorCopy(backEnd.refdef.entities[entityNum].e.origin, worldOrigin);
+		*primitive = FIREVOL_PRIM_ENTITY;
+		*surfaceIndex = drawIndex;
+		return qtrue;
+	}
+
+	if ((type == SF_MDS || type == SF_MDR || type == SF_IQM || type == SF_VAO_IQM) &&
+		entityNum >= 0 && entityNum < backEnd.refdef.num_entities)
+	{
+		VectorCopy(backEnd.refdef.entities[entityNum].e.origin, worldOrigin);
+		*primitive = FIREVOL_PRIM_MODEL_FALLBACK;
+		*surfaceIndex = drawIndex;
+		return qtrue;
+	}
+	return qfalse;
+}
+
+static qboolean RB_FireV07AnchorDuplicate(const fireVolumetricV07Anchor_t *candidate)
+{
+	int i;
+	for (i = 0; i < s_fireV07AnchorCount; ++i)
+	{
+		const fireVolumetricV07Anchor_t *other = &s_fireV07Anchors[i];
+		if (candidate->primitive == FIREVOL_PRIM_POLY || other->primitive == FIREVOL_PRIM_POLY)
+			continue;
+		if (candidate->shaderIndex == other->shaderIndex && candidate->entityNum == other->entityNum &&
+			candidate->surfaceIndex == other->surfaceIndex && candidate->primitive == other->primitive)
+			return qtrue;
+	}
+	return qfalse;
+}
