+static float R_StaticPromoteColorRatio(const vec3_t color)
+{
+	float maxc = MAX(color[0], MAX(color[1], color[2]));
+	float minc = color[0];
+	if (color[1] < minc)
+		minc = color[1];
+	if (color[2] < minc)
+		minc = color[2];
+	if (maxc <= 0.0001f)
+		return 0.0f;
+	return minc / maxc;
+}
