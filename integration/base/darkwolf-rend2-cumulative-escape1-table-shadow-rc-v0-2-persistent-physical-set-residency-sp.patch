+static void RB_FireV07SetModelName(int entityNum, char *out, int outSize)
+{
+	Q_strncpyz(out, "<none>", outSize);
+	if (entityNum == REFENTITYNUM_WORLD)
+	{
+		Q_strncpyz(out, "<world>", outSize);
+		return;
+	}
+	if (entityNum >= 0 && entityNum < backEnd.refdef.num_entities)
+	{
+		trRefEntity_t *ent = &backEnd.refdef.entities[entityNum];
+		if (ent->e.hModel > 0)
+		{
+			model_t *model = R_GetModelByHandle(ent->e.hModel);
+			if (model && model->name[0])
+			{
+				Q_strncpyz(out, model->name, outSize);
+				return;
+			}
+		}
+		Q_strncpyz(out, "<renderer-entity>", outSize);
+	}
+}
