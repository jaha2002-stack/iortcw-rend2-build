+static void RB_FireVolumetricResetOwnerForMap(void)
+{
+	const char *mapName = tr.world ? tr.world->baseName : "<none>";
+	if (Q_stricmp(s_fireVolumetricOwnerMap, mapName))
+	{
+		Q_strncpyz(s_fireVolumetricOwnerMap, mapName, sizeof(s_fireVolumetricOwnerMap));
+		s_fireVolumetricOwnerState.valid = qfalse;
+		s_fireVolumetricOwnerState.nativeOrdinal = -1;
+		s_fireVolumetricOwnerState.speakerOrdinal = -1;
+		s_fireVolumetricPrevOwnerValid = qfalse;
+		s_fireVolumetricPrevNativeOrdinal = -1;
+		s_fireVolumetricPrevSpeakerOrdinal = -1;
+		s_fireVolumetricOwnerChangedSinceDiag = qfalse;
+		s_fireVolumetricOwnerChangeCount = 0;
+	}
+}
+
+static void RB_FireVolumetricTrackOwnerChange(const dlight_t *dl)
+{
+	if (!dl)
+		return;
+	if (s_fireVolumetricPrevOwnerValid &&
+		(dl->fireVolumetricNativeOrdinal != s_fireVolumetricPrevNativeOrdinal ||
+		 dl->fireVolumetricSpeakerOrdinal != s_fireVolumetricPrevSpeakerOrdinal))
+	{
+		s_fireVolumetricOwnerChangedSinceDiag = qtrue;
+		s_fireVolumetricOwnerChangeCount++;
+	}
+	s_fireVolumetricPrevOwnerValid = qtrue;
+	s_fireVolumetricPrevNativeOrdinal = dl->fireVolumetricNativeOrdinal;
+	s_fireVolumetricPrevSpeakerOrdinal = dl->fireVolumetricSpeakerOrdinal;
+}
+
+static int RB_FireVolumetricDrawDualMarkers(FBO_t *srcFbo, ivec4_t srcBox, const dlight_t *fireDl)
+{
+	dlight_t marker;
+	int rendered = 0;
+	if (!fireDl || !srcFbo || !tr.quarterFbo[0] || !tr.renderDepthImage || !tr.volumetricLocalShader.program)
+		return 0;
+
+	marker = *fireDl;
+	marker.radius = 28.0f;
+	VectorCopy(fireDl->origin, marker.origin);
+	VectorSet(marker.color, 0.0f, 1.0f, 1.0f); // CYAN = authored runtime DLight origin
+	RB_LocalVolumetricRender(srcFbo, srcBox, 1, &marker, -1, NULL, 1.0f, 0.0f);
+	rendered++;
+
+	if (fireDl->fireVolumetricSpeakerOrdinal >= 0)
+	{
+		VectorCopy(fireDl->fireVolumetricSpeakerOrigin, marker.origin);
+		VectorSet(marker.color, 1.0f, 0.0f, 1.0f); // MAGENTA = matched fire target_speaker origin
+		RB_LocalVolumetricRender(srcFbo, srcBox, 1, &marker, -1, NULL, 1.0f, 0.0f);
+		rendered++;
+	}
+	return rendered;
+}
