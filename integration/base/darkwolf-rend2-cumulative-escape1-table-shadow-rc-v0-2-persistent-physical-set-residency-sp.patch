+static qboolean RB_FireV07AnchorAlreadyUsed(int anchorIndex, const int *used, int usedCount)
+{
+	int i;
+	for (i = 0; i < usedCount; ++i)
+		if (used[i] == anchorIndex)
+			return qtrue;
+	return qfalse;
