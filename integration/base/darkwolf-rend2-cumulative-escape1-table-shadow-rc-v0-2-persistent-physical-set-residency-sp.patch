+	// Trace only the real main 3D view. 2D console/UI, depth prepass, cubemap and shadow passes are excluded.
+	if (backEnd.projection2D || backEnd.depthFill || renderToCubemap ||
+		(backEnd.viewParms.flags & (VPF_SHADOWMAP | VPF_DEPTHSHADOW)))
+		return;
