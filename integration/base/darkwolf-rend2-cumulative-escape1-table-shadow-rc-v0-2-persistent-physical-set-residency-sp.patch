+		const float brightKnee = 3.0;
+		float excess = max(metric - brightStart, 0.0);
+		if (excess <= 0.0)
+			return 1.0;
+		float compressed = brightStart + excess / (1.0 + brightKnee * excess);
+		return clamp(compressed / max(metric, 0.0001), 0.18, 1.0);
+	}
