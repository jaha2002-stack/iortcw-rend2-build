+			light->nativeDuplicateSuppressed ? 1 : 0,
+			light->physicalLightJuniorOrdinal, light->physicalCoronaOrdinal,
+			light->physicalNativeDlightOrdinal, light->physicalFireSpeakerOrdinal,
+			light->physicalAssociationScore < 1.0e20f ? light->physicalAssociationScore : -1.0f);
