+// DARKWOLF_FIRE_VOLUMETRIC_V0_3_QUALITY_STABILITY
+// Geometry radius is low-pass filtered and clamped independently from raw DLight radius.
+// Raw radius remains available to the shader for light attenuation and cubemap depth normalization.
+typedef struct
+{
+	qboolean valid;
+	vec3_t origin;
+	float radius;
+	int lastMs;
+} fireVolumetricRadiusState_t;
+
+static fireVolumetricRadiusState_t s_fireVolumetricRadiusState[FIREVOL_DIAG_MAX_ACTIVE];
+
+static float RB_FireVolumetricGeometryRadius(const dlight_t *dl, int stateSlot, int nowMs)
+{
+	fireVolumetricRadiusState_t *state;
+	float rawRadius, minRadius, maxRadius, target, smoothMs, alpha;
+	int dt;
+	vec3_t delta;
+
+	if (!dl)
+		return 1.0f;
+	rawRadius = MAX(dl->radius, 1.0f);
+	if (!s_rVolumetricFireRadiusStabilize || !s_rVolumetricFireRadiusStabilize->integer)
+		return rawRadius;
+
+	stateSlot = Com_Clamp(0, FIREVOL_DIAG_MAX_ACTIVE - 1, stateSlot);
+	state = &s_fireVolumetricRadiusState[stateSlot];
+	minRadius = Com_Clamp(64.0f, 1024.0f, s_rVolumetricFireRadiusMin->value);
+	maxRadius = Com_Clamp(64.0f, 1024.0f, s_rVolumetricFireRadiusMax->value);
+	if (maxRadius < minRadius)
+	{
+		float temp = minRadius;
+		minRadius = maxRadius;
+		maxRadius = temp;
+	}
+	target = Com_Clamp(minRadius, maxRadius, rawRadius);
+	smoothMs = Com_Clamp(50.0f, 3000.0f, s_rVolumetricFireRadiusSmoothMs->value);
+
+	VectorSubtract(dl->origin, state->origin, delta);
+	if (!state->valid || DotProduct(delta, delta) > (16.0f * 16.0f) ||
+		nowMs < state->lastMs || nowMs - state->lastMs > 2000)
+	{
+		state->valid = qtrue;
+		VectorCopy(dl->origin, state->origin);
+		state->radius = target;
+		state->lastMs = nowMs;
+		return state->radius;
+	}
+
+	dt = nowMs - state->lastMs;
+	state->lastMs = nowMs;
+	alpha = Com_Clamp(0.0f, 1.0f, (float)dt / smoothMs);
+	state->radius += (target - state->radius) * alpha;
+	state->radius = Com_Clamp(minRadius, maxRadius, state->radius);
+	return state->radius;
+}
+
+static qboolean RB_FireVolumetricEligible(const dlight_t *dl, int sourceMode)
+{
+	if (!dl)
+		return qfalse;
+	if (sourceMode <= 0)
+		return dl->fireVolumetricSource ? qtrue : qfalse;
+	if (sourceMode == 1)
+	{
+		// Historical positive control: any renderer-tagged authored native DLight.
+		return dl->nativeAuthoredDlight ? qtrue : qfalse;
+	}
+	// v0.8.1 production semantic-anchor hybrid. Eligibility is intentionally broad here,
+	// but admission into the persistent registry still REQUIRES a semantic rendered flame
+	// anchor within r_volumetricFireRenderedMaxDist. This covers torches that were not tagged
+	// by the old strict fireVolumetricSource path without volumetricizing unrelated DLights.
+	return (dl->fireVolumetricSource || dl->nativeAuthoredDlight) ? qtrue : qfalse;
+}
+
+static int RB_FireVolumetricSelect(int sourceMode, const int *used, int usedCount,
+	int *shadowSlot, int *strictCount, int *nativeCount)
+{
+	int i, u, best = -1;
+	float bestScore = -1.0f;
+	*shadowSlot = -1;
+	*strictCount = 0;
+	*nativeCount = 0;
+
+	for (i = 0; i < backEnd.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+	{
+		dlight_t *dl = &backEnd.refdef.dlights[i];
+		qboolean alreadyUsed = qfalse;
+		float score;
+		if (dl->fireVolumetricSource)
+			(*strictCount)++;
+		if (dl->nativeAuthoredDlight)
+			(*nativeCount)++;
+		if (!RB_FireVolumetricEligible(dl, sourceMode))
+			continue;
+		for (u = 0; u < usedCount; ++u)
+		{
+			if (used[u] == i) { alreadyUsed = qtrue; break; }
+		}
+		if (alreadyUsed)
+			continue;
+		score = RB_LocalVolumetricDlightScore(dl);
+		if (score > bestScore)
+		{
+			bestScore = score;
+			best = i;
+		}
+	}
+	if (best >= 0)
+	{
+		int slot = (int)backEnd.refdef.dlightShadowSlot[best];
+		if ((backEnd.refdef.dlightShadowMask & (1u << best)) &&
+			slot >= 0 && slot < MAX_DLIGHT_SHADOWS && tr.shadowCubemaps[slot])
+			*shadowSlot = slot;
+	}
+	return best;
+}
