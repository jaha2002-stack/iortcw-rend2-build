+float SsgiRawDepth(const vec2 uv)
+{
+	return texture2D(u_ScreenDepthMap, uv).r;
+}
+
+float SsgiLinearDepthValue(const float rawDepth)
+{
+	return 1.0 / mix(u_ViewInfo.x, 1.0, rawDepth);
+}
+
+float SsgiLinearDepth(const vec2 uv)
+{
+	return SsgiLinearDepthValue(SsgiRawDepth(uv));
+}
+
+float SsgiLuma(const vec3 c)
+{
+	return dot(c, vec3(0.2125, 0.7154, 0.0721));
