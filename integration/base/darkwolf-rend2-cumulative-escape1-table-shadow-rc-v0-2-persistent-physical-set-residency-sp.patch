+	// and much brighter than the receiving pixel.  Bright surfaces of similar energy keep GI.
+	const float emitterStart = 0.72;
+	const float emitterFull = 1.25;
+	const float contrastStart = 0.12;
+	const float contrastFull = 0.55;
+	const float emitterFloor = 0.005;
