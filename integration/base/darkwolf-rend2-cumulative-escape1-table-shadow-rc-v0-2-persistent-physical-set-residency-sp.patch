+	int activeCount, int selectionSignature, int index0, int index1,
+	int autoMapLights, int pvsEnabled, int pvsHoldMs, int viewCluster,
+	int visibleCount, int heldCount, int overflowCount,
+	int classifierAccepted, int classifierRejected,
+	const char *report, int reportLength)
+{
+	// DARKWOLF_USLRD_CLEAN_PRODUCTION_V1: production package does not write periodic StaticPromote telemetry/status files.
+	return;
+	float gain = r_staticPromoteGain ? r_staticPromoteGain->value : 0.35f;
+	float directGain = r_staticPromoteDirectGain ? r_staticPromoteDirectGain->value : 1.10f;
