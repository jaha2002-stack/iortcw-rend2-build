+// REND2_MAT_0_V2_4_CLASSIFIER_CORRECTION
+// Classify only from metadata already present in original RTCW/Rend2 assets.
+// MAT-0 v2.4 is diagnostic: no class changes specular, gloss, roughness or cubemap response.
+static byte R_Mat0SurfaceClass(int surfaceFlags)
+{
+	if (surfaceFlags & SURF_GLASS)
+		return MATDBG_CLASS_GLASS;
+	if (surfaceFlags & SURF_CERAMIC)
+		return MATDBG_CLASS_CERAMIC;
+	if (surfaceFlags & SURF_METAL)
+		return MATDBG_CLASS_METAL;
+	if (surfaceFlags & SURF_WOOD)
+		return MATDBG_CLASS_WOOD;
+	if (surfaceFlags & SURF_SNOW)
+		return MATDBG_CLASS_SNOW;
+	if (surfaceFlags & SURF_GRASS)
+		return MATDBG_CLASS_ORGANIC;
+	if (surfaceFlags & SURF_CARPET)
+		return MATDBG_CLASS_FABRIC;
+	if (surfaceFlags & (SURF_GRAVEL | SURF_RUBBLE | SURF_ROOF))
+		return MATDBG_CLASS_MINERAL;
+	return MATDBG_CLASS_UNKNOWN;
+}
