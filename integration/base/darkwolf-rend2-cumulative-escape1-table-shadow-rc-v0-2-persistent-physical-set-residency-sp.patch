+/*
+=============
+RB_PostProcess
+
+=============
+*/
+const void *RB_PostProcess(const void *data)
+{
+	const postProcessCommand_t *cmd = data;
+	FBO_t *srcFbo, *dstFbo;
+	ivec4_t srcBox, dstBox;
+	qboolean autoExposure = qfalse; // DARKWOLF_USLRD_ROOT_CAUSE_V0_1: initialized for diagnostic sampler only.
+
+	// finish any 2D drawing if needed
+	if(tess.numIndexes)
+		RB_EndSurface();
+
+	if (!glRefConfig.framebufferObject || !r_postProcess->integer)
+	{
+		// do nothing
+		return (const void *)(cmd + 1);
+	}
+
+	if (cmd)
+	{
+		backEnd.refdef = cmd->refdef;
+		backEnd.viewParms = cmd->viewParms;
+	}
+
+	srcFbo = tr.renderFbo;
+	dstFbo = tr.renderFbo;
+
+	if (tr.msaaResolveFbo)
+	{
+		// Resolve the MSAA before anything else
+		// Can't resolve just part of the MSAA FBO, so multiple views will suffer a performance hit here
+		FBO_FastBlit(tr.renderFbo, NULL, tr.msaaResolveFbo, NULL, GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+		srcFbo = tr.msaaResolveFbo;
+	}
+
+	dstBox[0] = backEnd.viewParms.viewportX;
+	dstBox[1] = backEnd.viewParms.viewportY;
+	dstBox[2] = backEnd.viewParms.viewportWidth;
+	dstBox[3] = backEnd.viewParms.viewportHeight;
+
+	RB_USLRDRootCauseBeginFrameSample(srcFbo, dstBox);
+
+	if (r_ssao->integer)
+	{
+		srcBox[0] = backEnd.viewParms.viewportX      * tr.screenSsaoImage->width  / (float)glConfig.vidWidth;
+		srcBox[1] = backEnd.viewParms.viewportY      * tr.screenSsaoImage->height / (float)glConfig.vidHeight;
+		srcBox[2] = backEnd.viewParms.viewportWidth  * tr.screenSsaoImage->width  / (float)glConfig.vidWidth;
+		srcBox[3] = backEnd.viewParms.viewportHeight * tr.screenSsaoImage->height / (float)glConfig.vidHeight;
+
+		FBO_Blit(tr.screenSsaoFbo, srcBox, NULL, srcFbo, dstBox, NULL, NULL, GLS_SRCBLEND_DST_COLOR | GLS_DSTBLEND_ZERO);
+	}
+
+	RB_USLRDRootCauseSampleStage(srcFbo, dstBox, s_uslrdRcHdrAfterSsao);
+
+	// REND2_GI_2_V1_SCREEN_SPACE_LOCAL_INDIRECT
+	// Quarter-resolution local screen-space color bounce using current color + copied depth.
+	// GI-1 remains an independent low-frequency cubemap fill and may be disabled for isolated A/B.
+	{
+		qboolean ssgiActive = qfalse;
+		const char *ssgiReason = "disabled";
+
+		if (r_ssgi && r_ssgi->integer)
+		{
+			if (!srcFbo)
+				ssgiReason = "no-src-fbo";
+			else if (!r_depthPrepass || !r_depthPrepass->integer)
+				ssgiReason = "depth-prepass-off";
+			else if (!tr.hdrDepthImage)
+				ssgiReason = "no-hdr-depth";
+			else if (!tr.quarterFbo[0])
+				ssgiReason = "no-quarter-fbo";
+			else if (!tr.ssgiEntityDepthImage || !tr.ssgiEntityDepthFbo)
+				ssgiReason = "no-entity-mask";
+			else if (backEnd.refdef.rdflags & RDF_NOWORLDMODEL)
+				ssgiReason = "no-world-model";
+			else
+			{
+				ivec4_t giSrcBox, giBox;
+				vec2_t giTexScale;
+				vec4_t giParams, giViewInfo, compositeColor;
+				float radius = r_ssgiRadius ? Com_Clamp(2.0f, 128.0f, r_ssgiRadius->value) : 32.0f;
+				int debugMode = r_ssgiDebug ? r_ssgiDebug->integer : 0;
+				// REND2_GI_2_DIAG_1_FRINGE_ROOT_CAUSE_MATRIX
+				int resolveMode = r_ssgiResolveMode ? r_ssgiResolveMode->integer : 0;
+				int guardMode = r_ssgiEntityGuardMode ? r_ssgiEntityGuardMode->integer : 0;
+
+				if (debugMode < 0) debugMode = 0;
+				if (debugMode > 6) debugMode = 6;
+				if (resolveMode < 0) resolveMode = 0;
+				if (resolveMode > 2) resolveMode = 2;
+				if (guardMode < 0) guardMode = 0;
+				if (guardMode > 2) guardMode = 2;
+
+				giSrcBox[0] = backEnd.viewParms.viewportX;
+				giSrcBox[1] = backEnd.viewParms.viewportY;
+				giSrcBox[2] = backEnd.viewParms.viewportWidth;
+				giSrcBox[3] = backEnd.viewParms.viewportHeight;
+
+				giBox[0] = backEnd.viewParms.viewportX * tr.quarterFbo[0]->width / (float)glConfig.vidWidth;
+				giBox[1] = backEnd.viewParms.viewportY * tr.quarterFbo[0]->height / (float)glConfig.vidHeight;
+				giBox[2] = backEnd.viewParms.viewportWidth * tr.quarterFbo[0]->width / (float)glConfig.vidWidth;
+				giBox[3] = backEnd.viewParms.viewportHeight * tr.quarterFbo[0]->height / (float)glConfig.vidHeight;
+
+				VectorSet2(giTexScale, radius, radius);
+				VectorSet4(giParams,
+					r_ssgiStrength ? Com_Clamp(0.0f, 2.0f, r_ssgiStrength->value) : 0.75f,
+					r_ssgiSaturation ? Com_Clamp(0.0f, 1.0f, r_ssgiSaturation->value) : 0.85f,
+					r_ssgiMax ? Com_Clamp(0.0f, 1.0f, r_ssgiMax->value) : 0.30f,
+					(float)debugMode);
+
+				VectorSet4(giViewInfo,
+					backEnd.viewParms.zFar / r_znear->value,
+					backEnd.viewParms.zFar,
+					tan(backEnd.viewParms.fovX * M_PI / 360.0f),
+					tan(backEnd.viewParms.fovY * M_PI / 360.0f));
+				giViewInfo[2] = (float)guardMode; // REND2_GI_2_DIAG_1_FRINGE_ROOT_CAUSE_MATRIX
+				giViewInfo[3] = (float)(r_ssgiBrightSourceFix ? r_ssgiBrightSourceFix->integer : 1); // DARKWOLF_SSGI_BRIGHT_SOURCE_HALO_FIX_V0_2
+
+				GL_BindToTMU(tr.hdrDepthImage, TB_LIGHTMAP);
+				GL_BindToTMU(tr.ssgiEntityDepthImage, TB_NORMALMAP); // REND2_GI_2_V1_5_SCENE_ENTITY_WORLD_MASK
+				GLSL_BindProgram(&tr.ssgiShader);
+				GLSL_SetUniformVec4(&tr.ssgiShader, UNIFORM_VIEWINFO, giViewInfo);
+				FBO_Blit(srcFbo, giSrcBox, giTexScale, tr.quarterFbo[0], giBox, &tr.ssgiShader, giParams, 0);
