+static float R_DarkWolfPCRBE2E07RuntimeRadius(const staticPromoteCandidate_t *candidate)
+{
+    float radiusScale;
+    float minRadius;
+    float maxRadius;
+    float radius;
+    if (!candidate)
+        return 0.0f;
+    radiusScale = r_staticPromoteRadiusScale ? r_staticPromoteRadiusScale->value : 0.70f;
+    minRadius = r_staticPromoteMinRadius ? r_staticPromoteMinRadius->value : 192.0f;
+    maxRadius = r_staticPromoteMaxRadius ? r_staticPromoteMaxRadius->value : 320.0f;
+    radiusScale = CLAMP(radiusScale, 0.10f, 1.50f);
+    maxRadius = CLAMP(maxRadius, 64.0f, 512.0f);
+    minRadius = CLAMP(minRadius, 64.0f, maxRadius);
+    radius = candidate->intensity * radiusScale;
+    return CLAMP(radius, minRadius, maxRadius);
+}
+
+static qboolean R_DarkWolfPCRBE2E07SphereIntersectsBounds(const vec3_t origin,
+    float radius, const vec3_t mins, const vec3_t maxs)
+{
+    float distSq = 0.0f;
+    float d;
+    int axis;
+    for (axis = 0; axis < 3; ++axis)
+    {
+        if (origin[axis] < mins[axis])
+        {
+            d = mins[axis] - origin[axis];
+            distSq += d * d;
+        }
+        else if (origin[axis] > maxs[axis])
+        {
+            d = origin[axis] - maxs[axis];
+            distSq += d * d;
+        }
+    }
+    return (distSq <= radius * radius) ? qtrue : qfalse;
+}
+
+static qboolean R_DarkWolfPCRBE2E07SurfaceTouched(const msurface_t *surf,
+    const vec3_t origin, float radius)
+{
+    float d;
+    if (!surf || !surf->data)
+        return qfalse;
+
+    if (surf->cullinfo.type & CULLINFO_PLANE)
+    {
+        d = DotProduct(origin, surf->cullinfo.plane.normal) - surf->cullinfo.plane.dist;
+        if (d < -radius || d > radius)
+            return qfalse;
+    }
+    if (surf->cullinfo.type & CULLINFO_BOX)
+    {
+        if (origin[0] - radius > surf->cullinfo.bounds[1][0] ||
+            origin[0] + radius < surf->cullinfo.bounds[0][0] ||
+            origin[1] - radius > surf->cullinfo.bounds[1][1] ||
+            origin[1] + radius < surf->cullinfo.bounds[0][1] ||
+            origin[2] - radius > surf->cullinfo.bounds[1][2] ||
+            origin[2] + radius < surf->cullinfo.bounds[0][2])
+            return qfalse;
+    }
+    if (surf->cullinfo.type & CULLINFO_SPHERE)
+    {
+        if (!SpheresIntersect(origin, radius, surf->cullinfo.localOrigin, surf->cullinfo.radius))
+            return qfalse;
+    }
+
+    switch (*surf->data)
+    {
+        case SF_FACE:
+        case SF_GRID:
+        case SF_TRIANGLES:
+            return qtrue;
+        default:
+            return qfalse;
+    }
+}
+
+static int R_DarkWolfPCRBE2E07AddUniquePair(int cluster, int area,
+    int *clusters, int *areas, int *count)
+{
+    int i;
+    for (i = 0; i < *count; ++i)
+    {
+        if (clusters[i] == cluster && areas[i] == area)
+            return i;
+    }
+    if (*count >= PCRB_E2E07_MAX_UNIQUE_LEAF_PAIRS)
+        return -1;
+    clusters[*count] = cluster;
+    areas[*count] = area;
+    (*count)++;
+    return *count - 1;
+}
+
+static void R_DarkWolfPCRBE2E07ScanVolumeLeaves(const refdef_t *fd,
+    pcrbE2E07Target_t *target)
+{
+    int pairClusters[PCRB_E2E07_MAX_UNIQUE_LEAF_PAIRS];
+    int pairAreas[PCRB_E2E07_MAX_UNIQUE_LEAF_PAIRS];
+    byte pairVisible[PCRB_E2E07_MAX_UNIQUE_LEAF_PAIRS];
+    const byte *vis = NULL;
+    int pairCount = 0;
+    int i;
+
+    if (!fd || !target || !target->active || !tr.world)
+        return;
+    Com_Memset(pairVisible, 0, sizeof(pairVisible));
+    if (r_staticPromotePVS && r_staticPromotePVS->integer && tr.world->vis &&
+        target->viewCluster >= 0 && target->viewCluster < tr.world->numClusters)
+        vis = tr.world->vis + target->viewCluster * tr.world->clusterBytes;
+
+    for (i = tr.world->numDecisionNodes; i < tr.world->numnodes; ++i)
+    {
+        mnode_t *leaf = &tr.world->nodes[i];
+        int pairSlot;
+        qboolean leafVisible = qtrue;
+        if (leaf->contents == CONTENTS_NODE)
+            continue;
+        if (leaf->cluster < 0 || leaf->cluster >= tr.world->numClusters)
+            continue;
+        if (!R_DarkWolfPCRBE2E07SphereIntersectsBounds(target->origin,
+            target->runtimeRadius, leaf->mins, leaf->maxs))
+            continue;
+
+        target->sphereOverlapLeaves++;
+        pairSlot = R_DarkWolfPCRBE2E07AddUniquePair(leaf->cluster, leaf->area,
+            pairClusters, pairAreas, &pairCount);
+        if (pairSlot < 0)
+            target->spherePairOverflow++;
+
+        if (vis && !(vis[leaf->cluster >> 3] & (1 << (leaf->cluster & 7))))
+            leafVisible = qfalse;
+        if (leafVisible && leaf->area >= 0 && leaf->area < MAX_MAP_AREA_BYTES * 8 &&
+            (fd->areamask[leaf->area >> 3] & (1 << (leaf->area & 7))))
+            leafVisible = qfalse;
+        if (!leafVisible)
+            continue;
+
+        target->sphereVisibleLeaves++;
+        if (pairSlot >= 0)
+            pairVisible[pairSlot] = 1;
+    }
+
+    target->sphereUniquePairs = pairCount;
+    for (i = 0; i < pairCount; ++i)
+        if (pairVisible[i]) target->sphereVisiblePairs++;
+}
+
+static int R_DarkWolfPCRBE2E07FinalDecision(const staticPromotePersistentLight_t *light,
+    int fixtureIndex)
+{
+    int runtimeClass;
+    if (!light)
+        return PCRB_E2E07_DECISION_UNKNOWN;
+    runtimeClass = R_StaticPromoteClassifyFixture(light);
+    if (light->physicalSourceRoute == PLR_V01_SOURCE_NATIVE || light->nativeDuplicateSuppressed)
+        return PCRB_E2E07_DECISION_SOURCE_NATIVE;
+    if (runtimeClass != STATIC_PROMOTE_CLASS_ACCEPT)
+        return PCRB_E2E07_DECISION_CLASS_REJECTED;
+    if (light->influenceVisibleNow)
+        return PCRB_E2E07_DECISION_PVS_VISIBLE;
+    if (fixtureIndex >= 0 && fixtureIndex < STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES &&
+        s_staticPromotePhysicalResidencyFallbackNow[fixtureIndex])
+        return PCRB_E2E07_DECISION_PHYSICAL_CORONA_LOS;
+    if (fixtureIndex >= 0 && fixtureIndex < STATIC_PROMOTE_PERSISTENT_MAX_FIXTURES &&
+        s_staticPromoteVisibleSurfaceResidencyNow[fixtureIndex])
+        return PCRB_E2E07_DECISION_SURFACE_RESIDENCY;
+    if (light->heldResident)
+        return PCRB_E2E07_DECISION_HELD;
+    return PCRB_E2E07_DECISION_NO_RESIDENCY;
+}
