+static void CG_DarkWolfPCRBV04Diagnostic( centity_t *cent ) {
+	static int s_lastSampleTime[MAX_GENTITIES];
+	static int s_lastWaitTime[MAX_GENTITIES];
+	static int s_sampleSequence[MAX_GENTITIES];
+	static qboolean s_startupPrinted = qfalse;
+	pcrbV04FixtureState_t state;
+	vec3_t points[PCRB_V04_POINT_COUNT];
+	const char *pointNames[PCRB_V04_POINT_COUNT];
+	trace_t traces[PCRB_V04_POINT_COUNT];
+	qboolean clears[PCRB_V04_POINT_COUNT];
+	qboolean inFrustum[PCRB_V04_POINT_COUNT];
+	float screenX[PCRB_V04_POINT_COUNT];
+	float screenY[PCRB_V04_POINT_COUNT];
+	const char *role;
+	const char *bestClearPoint;
+	int runtimeId;
+	int expectedFixture;
+	int sample;
+	int clearCount;
+	int frustumCount;
+	int inFrustumClearCount;
+	int worldBlocks;
+	int brushBlocks;
+	int bodyBlocks;
+	int i;
+
+	if ( !cent || !CG_DarkWolfDiagCvarEnabled( "dw_pcrbV04MultiPointDiag" ) ||
+		CG_DarkWolfDiagCvarEnabled( "dw_pcrbV06SuppressV04CGObserver" ) ) {
+		return;
+	}
+	runtimeId = cent->currentState.number;
+	if ( runtimeId < 0 || runtimeId >= MAX_GENTITIES ) {
+		return;
+	}
+	role = CG_DarkWolfPCRBV03Role( runtimeId );
+	if ( !role ) {
+		return;
+	}
+	expectedFixture = CG_DarkWolfPCRBV04ExpectedFixture( runtimeId );
+	if ( !CG_DarkWolfPCRBV04ReadFixtureState( runtimeId, &state ) ) {
+		if ( s_lastWaitTime[runtimeId] == 0 || cg.time < s_lastWaitTime[runtimeId] ||
+			cg.time - s_lastWaitTime[runtimeId] >= 1000 ) {
+			s_lastWaitTime[runtimeId] = cg.time;
+			CG_Printf( "SPR_LOS04_WAIT map=%s role=%s runtimeId=%d fixture=%d reason=NO_VALID_REND_FIXTURE_STATE\n",
+				cgs.mapname, role, runtimeId, expectedFixture );
+		}
+		return;
+	}
+	if ( Distance( state.coronaOrigin, cent->lerpOrigin ) > 0.25f ) {
+		CG_Printf( "SPR_LOS04_WAIT map=%s role=%s runtimeId=%d fixture=%d reason=CORONA_ORIGIN_MISMATCH rend=%.3f,%.3f,%.3f cg=%.3f,%.3f,%.3f\n",
+			cgs.mapname, role, runtimeId, expectedFixture,
+			state.coronaOrigin[0], state.coronaOrigin[1], state.coronaOrigin[2],
+			cent->lerpOrigin[0], cent->lerpOrigin[1], cent->lerpOrigin[2] );
+		return;
+	}
+	if ( !s_startupPrinted ) {
+		s_startupPrinted = qtrue;
+		CG_Printf( "SPR_LOS04_STARTUP enabled=1 valid=1 intervalMs=%d pointCount=%d functionalDecisionChanged=0\n",
+			PCRB_V04_SAMPLE_INTERVAL_MS, PCRB_V04_POINT_COUNT );
+	}
+	if ( s_lastSampleTime[runtimeId] != 0 && cg.time >= s_lastSampleTime[runtimeId] &&
+		cg.time - s_lastSampleTime[runtimeId] < PCRB_V04_SAMPLE_INTERVAL_MS ) {
+		return;
+	}
+	s_lastSampleTime[runtimeId] = cg.time;
+	sample = ++s_sampleSequence[runtimeId];
+
+	CG_DarkWolfPCRBV04BuildPoints( &state, points, pointNames );
+	clearCount = 0;
+	frustumCount = 0;
+	inFrustumClearCount = 0;
+	worldBlocks = 0;
+	brushBlocks = 0;
+	bodyBlocks = 0;
+	bestClearPoint = "NONE";
+	for ( i = 0; i < PCRB_V04_POINT_COUNT; ++i ) {
+		CG_Trace( &traces[i], cg.refdef.vieworg, NULL, NULL, points[i], -1,
+			MASK_SOLID | CONTENTS_BODY );
+		clears[i] = CG_DarkWolfPCRBV03StrictClear( &traces[i] );
+		inFrustum[i] = CG_DarkWolfPCRBV04PointInFrustum( points[i], &screenX[i], &screenY[i] );
+		if ( clears[i] ) {
+			if ( clearCount == 0 ) bestClearPoint = pointNames[i];
+			clearCount++;
+		}
+		if ( inFrustum[i] ) frustumCount++;
+		if ( inFrustum[i] && clears[i] ) inFrustumClearCount++;
+		if ( !clears[i] ) {
+			const char *hitClass = CG_DarkWolfPCRBV03HitClass( &traces[i] );
+			if ( !Q_stricmp( hitClass, "WORLD" ) ) worldBlocks++;
+			else if ( !Q_stricmp( hitClass, "BRUSH_ENTITY" ) ) brushBlocks++;
+			else if ( !Q_stricmp( hitClass, "BODY" ) || !Q_stricmp( hitClass, "PLAYER_OR_ACTOR" ) ) bodyBlocks++;
+		}
+	}
+
+	CG_Printf( "SPR_LOS04_SUMMARY map=%s role=%s runtimeId=%d fixture=%d time=%d sample=%d lightCenter=%.3f,%.3f,%.3f corona=%.3f,%.3f,%.3f centerCoronaDelta=%.3f influencePVSVisible=%d physicalVisible=%d held=%d coronaPresent=%d coronaLOS=%d associationScore=%.3f coronaClear=%d lightCenterClear=%d bodyMidClear=%d clearPoints=%d frustumPoints=%d inFrustumClearPoints=%d bestClearPoint=%s worldBlocks=%d brushBlocks=%d bodyBlocks=%d\n",
+		cgs.mapname, role, runtimeId, state.fixtureOrdinal, cg.time, sample,
+		state.lightCenter[0], state.lightCenter[1], state.lightCenter[2],
+		state.coronaOrigin[0], state.coronaOrigin[1], state.coronaOrigin[2],
+		Distance( state.lightCenter, state.coronaOrigin ), state.influencePVSVisible,
+		state.physicalVisible, state.heldResident, state.coronaPresent, state.coronaLOS,
+		state.associationScore, clears[0] ? 1 : 0, clears[1] ? 1 : 0,
+		clears[2] ? 1 : 0, clearCount, frustumCount, inFrustumClearCount,
+		bestClearPoint, worldBlocks, brushBlocks, bodyBlocks );
+
+	for ( i = 0; i < PCRB_V04_POINT_COUNT; ++i ) {
+		int hitEType;
+		int hitSolid;
+		int modelIndex;
+		int modelIndex2;
+		char modelName[MAX_QPATH];
+		float pointDistance;
+		float hitDistance;
+		float remainingDistance;
+		float planeDist;
+
+		CG_DarkWolfPCRBV03HitMeta( &traces[i], &hitEType, &hitSolid );
+		CG_DarkWolfPCRBV04ModelName( &traces[i], &modelIndex, &modelIndex2,
+			modelName, sizeof( modelName ) );
+		pointDistance = Distance( cg.refdef.vieworg, points[i] );
+		hitDistance = pointDistance * traces[i].fraction;
+		remainingDistance = pointDistance - hitDistance;
+		planeDist = DotProduct( traces[i].endpos, traces[i].plane.normal );
+		CG_Printf( "SPR_LOS04_POINT map=%s role=%s runtimeId=%d fixture=%d time=%d sample=%d point=%s pointOrigin=%.3f,%.3f,%.3f inFrustum=%d screen=%.4f,%.4f clear=%d fraction=%.6f startsolid=%d allsolid=%d hitClass=%s hitEntity=%d hitEType=%d hitSolid=%d hitModelIndex=%d hitModelIndex2=%d hitModel=%s hitContents=0x%08x surfaceFlags=0x%08x hitEnd=%.3f,%.3f,%.3f hitNormal=%.4f,%.4f,%.4f hitPlaneDist=%.3f pointDistance=%.3f hitDistance=%.3f remainingDistance=%.3f influencePVSVisible=%d\n",
+			cgs.mapname, role, runtimeId, state.fixtureOrdinal, cg.time, sample,
+			pointNames[i], points[i][0], points[i][1], points[i][2],
+			inFrustum[i] ? 1 : 0, screenX[i], screenY[i], clears[i] ? 1 : 0,
+			traces[i].fraction, traces[i].startsolid ? 1 : 0, traces[i].allsolid ? 1 : 0,
+			CG_DarkWolfPCRBV03HitClass( &traces[i] ), traces[i].entityNum,
+			hitEType, hitSolid, modelIndex, modelIndex2, modelName,
+			(unsigned int)traces[i].contents, (unsigned int)traces[i].surfaceFlags,
+			traces[i].endpos[0], traces[i].endpos[1], traces[i].endpos[2],
+			traces[i].plane.normal[0], traces[i].plane.normal[1], traces[i].plane.normal[2],
+			planeDist, pointDistance, hitDistance, remainingDistance,
+			state.influencePVSVisible );
+	}
+}
