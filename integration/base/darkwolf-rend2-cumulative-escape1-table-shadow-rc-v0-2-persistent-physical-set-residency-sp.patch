+		visibilityReason = R_DarkWolfFactoryInfluenceReason(fd, light, &pvsMatched, &areaPassed,
+			&firstPvsCluster, &firstPvsArea, &firstVisibleCluster, &firstVisibleArea);
+		nowMs = ri.Milliseconds();
+		lastVisibleAgeMs = light->lastInfluenceVisibleMs > -900000000 ? nowMs - light->lastInfluenceVisibleMs : -1;
+		if (addedIndex >= 0)
+			addState = "ADDED";
+		else if (selectedSlot >= 0 && (r_numdlights - r_firstSceneDlight) >= MAX_DLIGHTS)
+			addState = "SELECTED_DROP_MAX_DLIGHTS";
+		else if (selectedSlot >= 0)
+			addState = "SELECTED_NOT_ADDED";
+		else
+			addState = "NOT_SELECTED";
+		sig = (unsigned int)(runtimeClass + 1);
+		sig = sig * 33u + (unsigned int)(light->influenceVisibleNow ? 2 : 1);
+		sig = sig * 33u + (unsigned int)(light->heldResident ? 2 : 1);
+		sig = sig * 33u + (unsigned int)(selectedSlot + 2);
+		sig = sig * 33u + (unsigned int)(addedIndex + 2);
+		sig = sig * 33u + (unsigned int)(pvsMatched + 1);
+		sig = sig * 33u + (unsigned int)(areaPassed + 1);
+		if (!viewChanged && lastSignature[watch] == sig)
+			continue;
+		lastSignature[watch] = sig;
+		ri.Printf(PRINT_ALL, "PLR_FACTORY_FRAME viewCluster=%d viewArea=%d watch=%d entity=%d override=%d runtimeClass=%s legacyClassNoOverride=%s visibilityReason=%s pvsMatched=%d areaPassed=%d firstPvs=%d/%d firstVisible=%d/%d influenceVisible=%d held=%d lastVisibleAgeMs=%d selectedSlot=%d addState=%s addedDlightIndex=%d globalSceneDlights=%d maxDlights=%d influenceCount=%d\\n",
+			viewCluster, viewArea, watch, light->candidate.entityOrdinal,
+			R_StaticPromoteUserOverrideState(tr.world->baseName, light->candidate.entityOrdinal),
+			R_StaticPromoteClassReasonName(runtimeClass), R_StaticPromoteClassReasonName(R_DarkWolfLegacyClassReasonNoOverride(light)),
+			visibilityReason, pvsMatched, areaPassed, firstPvsCluster, firstPvsArea, firstVisibleCluster, firstVisibleArea,
+			light->influenceVisibleNow ? 1 : 0, light->heldResident ? 1 : 0, lastVisibleAgeMs, selectedSlot, addState, addedIndex,
+			r_numdlights - r_firstSceneDlight, MAX_DLIGHTS, light->influenceCount);
+	}
+}
