+// DARKWOLF_FIRE_VOLUMETRIC_V0_6_SOURCE_ANCHOR_OWNERSHIP
+// Owner identity is authored metadata, not the transient per-frame dlight array index.
+typedef struct
+{
+	qboolean valid;
+	int nativeOrdinal;
+	int speakerOrdinal;
+} fireVolumetricOwnerState_t;
+
+static fireVolumetricOwnerState_t s_fireVolumetricOwnerState;
+static char s_fireVolumetricOwnerMap[MAX_QPATH] = "";
+static qboolean s_fireVolumetricPrevOwnerValid = qfalse;
+static int s_fireVolumetricPrevNativeOrdinal = -1;
+static int s_fireVolumetricPrevSpeakerOrdinal = -1;
+static qboolean s_fireVolumetricOwnerChangedSinceDiag = qfalse;
+static int s_fireVolumetricOwnerChangeCount = 0;
+
+static int RB_FireVolumetricShadowSlotForIndex(int index)
+{
+	int slot;
+	if (index < 0 || index >= backEnd.refdef.num_dlights || index >= MAX_DLIGHTS)
+		return -1;
+	slot = (int)backEnd.refdef.dlightShadowSlot[index];
+	if ((backEnd.refdef.dlightShadowMask & (1u << index)) &&
+		slot >= 0 && slot < MAX_DLIGHT_SHADOWS && tr.shadowCubemaps[slot])
+		return slot;
+	return -1;
+}
+
+static int RB_FireVolumetricFindOwner(int sourceMode, int nativeOrdinal, int speakerOrdinal, int *shadowSlot)
+{
+	int i;
+	if (shadowSlot) *shadowSlot = -1;
+	for (i = 0; i < backEnd.refdef.num_dlights && i < MAX_DLIGHTS; ++i)
+	{
+		dlight_t *dl = &backEnd.refdef.dlights[i];
+		if (!RB_FireVolumetricEligible(dl, sourceMode))
+			continue;
+		if (dl->fireVolumetricNativeOrdinal != nativeOrdinal)
+			continue;
+		if (speakerOrdinal >= 0 && dl->fireVolumetricSpeakerOrdinal != speakerOrdinal)
+			continue;
+		if (shadowSlot) *shadowSlot = RB_FireVolumetricShadowSlotForIndex(i);
+		return i;
+	}
+	return -1;
+}
