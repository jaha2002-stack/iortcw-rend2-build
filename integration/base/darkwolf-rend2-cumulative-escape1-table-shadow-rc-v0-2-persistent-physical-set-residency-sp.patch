+	p = (char *)buffer;
+	while (*p && s_staticPromoteSyntheticCount < STATIC_PROMOTE_SYNTHETIC_MAX)
+	{
+		char line[320];
+		char mapName[MAX_QPATH];
+		char *start;
+		int lineLength;
+		int id;
+		float x, y, z, intensity, r, g, b;
