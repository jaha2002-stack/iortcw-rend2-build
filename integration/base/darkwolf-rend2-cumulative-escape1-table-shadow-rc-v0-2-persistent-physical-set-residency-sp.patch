+static void R_StaticPromoteFrame(const refdef_t *fd)
+{
+	staticPromotePersistentLight_t *selected[STATIC_PROMOTE_PRODUCTION_MAX_ACTIVE];
+	int enable;
+	int manualOverride;
+	int autoMapLights;
+	int pvsEnabled;
+	int pvsHoldMs;
+	int maxLights;
+	int selectedCount;
+	int activeCount;
+	int selectionSignature;
+	int index0;
+	int index1;
+	int viewCluster;
+	int visibleCount;
+	int heldCount;
+	int overflowCount;
+	int classifierAccepted;
+	int classifierRejected;
+	int i;
+	int reportLength;
+	char report[16384];
+	char header[3072];
+
+	// DARKWOLF_PCRB_E2E_V0_7_VISIBLE_SURFACE_INFLUENCE_AUDIT
+	R_DarkWolfPCRBE2E07ResetFrame();
+	if (!tr.world || (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL)))
+		return;
+	R_StaticPromoteParseWorld();
+	if (!R_StaticPromoteBuildPersistentRegistry())
+		return;
+	// DARKWOLF_VISIBLE_SURFACE_RESIDENCY_PRODUCTION_CANDIDATE_V1
+	R_StaticPromoteVisibleSurfaceBeginFrame(fd);
+	R_DarkWolfVisibleSurfaceResidencyStartupDiag();
+	// DARKWOLF_PHYSICAL_LIGHT_DELIVERY_RESIDENCY_DIAG_V0_1: one metadata record per Factory registry generation.
+	R_DarkWolfFactoryDiagMeta();
+	// DARKWOLF_PHYSICAL_LIGHT_RECOGNITION_V0_1: one complete recognition record per map generation.
+	R_DarkWolfPLRV01DiagMeta();
+	// DARKWOLF_STATIC_PROMOTION_PHYSICAL_RESIDENCY_FIX_CANDIDATE_V1: final startup state.
+	R_StaticPromotePhysicalResidencyStartupDiag();
+	VectorCopy(fd->vieworg, s_staticPromoteLastViewOrg);
+	VectorCopy(fd->viewaxis[0], s_staticPromoteLastViewForward);
+	VectorNormalize(s_staticPromoteLastViewForward);
+	s_staticPromoteLastViewValid = qtrue;
+
+	if (r_staticPromoteDump && r_staticPromoteDump->integer)
+		R_StaticPromoteDumpCandidates(fd);
+
+	enable = r_staticPromote ? r_staticPromote->integer : 1;
+	manualOverride = r_staticPromoteManualOverride ? r_staticPromoteManualOverride->integer : 0;
+	autoMapLights = r_staticPromoteAutoMapLights ? r_staticPromoteAutoMapLights->integer : 1;
+	pvsEnabled = r_staticPromotePVS ? r_staticPromotePVS->integer : 1;
+	pvsHoldMs = r_staticPromotePVSHoldMs ? r_staticPromotePVSHoldMs->integer : 8000;
+	pvsHoldMs = CLAMP(pvsHoldMs, 0, 30000);
+	maxLights = r_staticPromoteMaxLights ? r_staticPromoteMaxLights->integer : 24;
+	maxLights = CLAMP(maxLights, 1, STATIC_PROMOTE_PRODUCTION_MAX_ACTIVE);
+	index0 = r_staticPromoteIndex0 ? r_staticPromoteIndex0->integer : -1;
+	index1 = r_staticPromoteIndex1 ? r_staticPromoteIndex1->integer : -1;
+	selectedCount = 0;
+	activeCount = 0;
+	selectionSignature = 5381;
+	viewCluster = -1;
+	visibleCount = 0;
+	heldCount = 0;
+	overflowCount = 0;
+	classifierAccepted = 0;
+	classifierRejected = 0;
+	reportLength = 0;
+	report[0] = '\0';
+
+	if (!manualOverride)
+		selectedCount = R_StaticPromoteSelectPersistentInfluence(fd, selected, maxLights,
+			&viewCluster, &visibleCount, &heldCount, &overflowCount,
+			&classifierAccepted, &classifierRejected);
+
+	Com_sprintf(header, sizeof(header),
+		"REND2_STATIC_LIGHT_PROMOTION_FINAL_PRODUCTION_FIX_V5_1_V12_0\nmap=%s lightmapPreserved=1 allMaps=1 persistentLogicalRegistry=1 rawBspLights=%d fixtureCount=%d mergedCompanions=%d autoMapLights=%d approvedFallbackFixtures=%d classifierAccepted=%d classifierRejected=%d requestedMaxLights=%d selectedCount=%d influenceVisible=%d heldResident=%d overflow=%d selection=user_override_synthetic_physical_priority_influence_pvs_no_distance pvsEnabled=%d viewCluster=%d residencyHoldMs=%d influenceRadius=%.1f fixtureMerge=xy2_z96_plausiblePrimary classifier=physical_evidence_conservative registryGeneration=%d minFixtureMembers=%d learnedOn=%d learnedOff=%d syntheticDefined=%d syntheticOnMap=%d shadowBudget=%d shadowMap=%d startupNativeEXE=1 persistentLearn=1 wideSearch=1 syntheticLearn=1\nenable=%d manualOverride=%d index0=%d index1=%d dlightMode=%d gain=%.3f directGain=%.3f radiusScale=%.3f minRadius=%.1f maxRadius=%.1f maxColor=%.3f classifierEnabled=%d classMinIntensity=%.1f classMaxIntensity=%.1f classMinColorRatio=%.2f minFixtureMembers=%d allowScripted=%d\n",
+		tr.world->baseName, s_staticPromotePersistentRawLightCount,
+		s_staticPromotePersistentCount, s_staticPromotePersistentMergedCount,
+		autoMapLights, s_staticPromotePersistentApprovedCount,
+		classifierAccepted, classifierRejected, maxLights, selectedCount,
+		visibleCount, heldCount, overflowCount, pvsEnabled, viewCluster, pvsHoldMs,
+		r_staticPromoteInfluenceRadius ? r_staticPromoteInfluenceRadius->value : 320.0f,
+		s_staticPromotePersistentBuildGeneration,
+		r_staticPromoteClassifierMinFixtureMembers ? r_staticPromoteClassifierMinFixtureMembers->integer : 2,
+		R_StaticPromoteUserOverrideCountForMap(tr.world->baseName, 1),
+		R_StaticPromoteUserOverrideCountForMap(tr.world->baseName, -1),
+		s_staticPromoteSyntheticCount,
+		R_StaticPromoteSyntheticCountForMap(tr.world->baseName),
+		r_dlightShadowMaxLights ? r_dlightShadowMaxLights->integer : 3,
+		r_dlightShadowMapSize ? r_dlightShadowMapSize->integer : 2048,
+		enable, manualOverride, index0, index1,
+		r_dlightMode ? r_dlightMode->integer : 0,
+		r_staticPromoteGain ? r_staticPromoteGain->value : 0.35f,
+		r_staticPromoteDirectGain ? r_staticPromoteDirectGain->value : 1.10f,
+		r_staticPromoteRadiusScale ? r_staticPromoteRadiusScale->value : 0.70f,
+		r_staticPromoteMinRadius ? r_staticPromoteMinRadius->value : 192.0f,
+		r_staticPromoteMaxRadius ? r_staticPromoteMaxRadius->value : 320.0f,
+		r_staticPromoteMaxColor ? r_staticPromoteMaxColor->value : 0.50f,
+		r_staticPromoteClassifier ? r_staticPromoteClassifier->integer : 1,
+		r_staticPromoteClassifierMinIntensity ? r_staticPromoteClassifierMinIntensity->value : 30.0f,
+		r_staticPromoteClassifierMaxIntensity ? r_staticPromoteClassifierMaxIntensity->value : 350.0f,
+		r_staticPromoteClassifierMinColorRatio ? r_staticPromoteClassifierMinColorRatio->value : 0.60f,
+		r_staticPromoteClassifierMinFixtureMembers ? r_staticPromoteClassifierMinFixtureMembers->integer : 2,
+		r_staticPromoteClassifierAllowScripted ? r_staticPromoteClassifierAllowScripted->integer : 0);
+	R_StaticPromoteAppend(report, sizeof(report), &reportLength, header);
+
+	if (enable)
+	{
+		if (manualOverride)
+		{
+			if (R_StaticPromoteAddSlot(0, index0, report, sizeof(report), &reportLength))
+			{
+				activeCount++;
+				selectionSignature = selectionSignature * 33 + index0;
+			}
+			if (index1 != index0 && maxLights > 1 &&
+				R_StaticPromoteAddSlot(1, index1, report, sizeof(report), &reportLength))
+			{
+				activeCount++;
+				selectionSignature = selectionSignature * 33 + index1;
+			}
+		}
+		else
+		{
+			for (i = 0; i < selectedCount; ++i)
+			{
+				staticPromotePersistentLight_t *light = selected[i];
+				int fixtureIndex = (int)(light - s_staticPromotePersistentLights);
+				char residencyLine[320];
+				Com_sprintf(residencyLine, sizeof(residencyLine),
+					"residentSlot=%d fixtureIndex=%d entity=%d priority=%d override=%d synthetic=%d syntheticId=%d influenceLeaves=%d influenceVisible=%d surfaceSignal=%d surfaceResidency=%d held=%d rawMembers=%d scripted=%d approved=%d\n",
+					i, fixtureIndex, light->candidate.entityOrdinal, R_StaticPromotePhysicalPriority(light),
+					R_StaticPromoteUserOverrideState(tr.world->baseName, light->candidate.entityOrdinal),
+					light->synthetic ? 1 : 0, light->syntheticId, light->influenceCount,
+					light->influenceVisibleNow ? 1 : 0,
+					s_staticPromoteVisibleSurfaceSignalNow[fixtureIndex] ? 1 : 0,
+					s_staticPromoteVisibleSurfaceResidencyNow[fixtureIndex] ? 1 : 0,
+					light->heldResident ? 1 : 0,
+					light->rawMembers, light->scripted ? 1 : 0, light->approvedFallback ? 1 : 0);
+				R_StaticPromoteAppend(report, sizeof(report), &reportLength, residencyLine);
+				if (R_StaticPromoteAddCandidate(i, &light->candidate,
+					autoMapLights ? "learned-override-physical-priority-auto" : "persistent-approved",
+					fixtureIndex, report, sizeof(report), &reportLength))
+				{
+					activeCount++;
+					R_StaticPromoteUSLRDTagPromotedDlight(light);
+				}
+				selectionSignature = selectionSignature * 33 + light->candidate.entityOrdinal;
+			}
+		}
+	}
+
+	// DARKWOLF_USLRD_V0_1: compact transition/summary telemetry only when explicitly enabled.
+	R_StaticPromoteUSLRDDiagFrame();
+	// DARKWOLF_USLRD_ROOT_CAUSE_V0_1: diagnostic-only focused correlation.
+	R_StaticPromoteRootCauseDiagFrame(fd);
+	// DARKWOLF_PHYSICAL_LIGHT_DELIVERY_RESIDENCY_DIAG_V0_1: accepted parent diagnostic remains intact.
+	R_DarkWolfFactoryDiagFrame(fd, selected, selectedCount);
+	// DARKWOLF_STATIC_PROMOTION_PHYSICAL_RESIDENCY_FIX_CANDIDATE_V1: prove exact fallback/addition decisions.
+	R_StaticPromotePhysicalResidencyFrameDiag(fd, selected, selectedCount);
