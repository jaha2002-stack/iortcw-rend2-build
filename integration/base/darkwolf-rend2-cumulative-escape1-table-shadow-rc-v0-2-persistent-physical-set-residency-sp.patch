+	return FST1_CLASS_NONE;
+}
+
+static const char *R_FST1ShaderClassName(int shaderClass)
+{
+	if (shaderClass == FST1_CLASS_SMOKE) return "SMOKE";
+	if (shaderClass == FST1_CLASS_FIRE) return "FIRE";
+	return "NONE";
+}
+
+// REND2_FST_1_V1_3_PRODUCTION_CANDIDATE
+// Production-candidate routing. Only runtime-confirmed flamethrower lightall families
+// are redirected into the already validated generic soft-particle path.
+static qboolean R_FST13IsFlamethrowerSoftName(const char *name)
+{
+	if (!name || !name[0])
+		return qfalse;
+	if (R_FST1NamePrefix(name, "flamethrowerFire"))
+		return qtrue;
+	if (R_FST1NamePrefix(name, "nozzleFlame"))
+		return qtrue;
+	return qfalse;
+}
+
+static qboolean R_FST13IsSmallFireName(const char *name)
+{
+	if (!name || !name[0])
+		return qfalse;
+	// Runtime-confirmed candle family: c_flame_10a / 10b / 10c.
+	return R_FST1NamePrefix(name, "textures/sfx/c_flame_");
+}
+
+static qboolean R_FST13IsFlamethrowerGroupStage(shaderStage_t *pStage)
+{
+	if (!pStage || !tess.shader)
+		return qfalse;
+	if (pStage->glslShaderGroup != tr.lightallShader)
+		return qfalse;
+	if (R_FST1ShaderClassByName(tess.shader->name) != FST1_CLASS_FIRE)
+		return qfalse;
+	return R_FST13IsFlamethrowerSoftName(tess.shader->name);
+}
+
+static qboolean R_FST13UseGenericSoftPath(shaderStage_t *pStage)
+{
+	int mask;
+	if (!R_FST13IsFlamethrowerGroupStage(pStage))
+		return qfalse;
+	if (!r_softParticles || !r_softParticles->integer)
+		return qfalse;
+	if (!r_softParticleFlamethrowerPath || !r_softParticleFlamethrowerPath->integer)
+		return qfalse;
+	if (backEnd.projection2D || backEnd.depthFill || backEnd.ssgiEntityDepthFill)
+		return qfalse;
+	if (backEnd.viewParms.flags & VPF_SHADOWMAP)
+		return qfalse;
+	if (backEnd.refdef.rdflags & RDF_SNOOPERVIEW)
+		return qfalse;
+	mask = r_softParticleClassMask ? r_softParticleClassMask->integer : 3;
+	if (!(mask & 2))
+		return qfalse;
+	return qtrue;
+}
+
+// REND2_STAGE9_2_9_4_PRODUCTION_CANDIDATE
+// Stage 9.2-9.4 production response policy, distilled from three runtime A/B passes.
+// Master defaults OFF for rollback/back-compat; the DarkWolf production profile enables it.
+// Native fog, haze, water, standard glass, tram glass and unconfirmed FIRE families are untouched.
+static qboolean R_FX9ProdIsLargeFireName(const char *name)
+{
+	return (name && R_FST1NamePrefix(name, "textures/sfx/xflame2")) ? qtrue : qfalse;
+}
+
+static qboolean R_FX9ProdIsSmallFireName(const char *name)
+{
+	return (name && R_FST1NamePrefix(name, "textures/sfx/c_flame_")) ? qtrue : qfalse;
+}
+
+static qboolean R_FX9ProdIsBlackSmokeName(const char *name)
+{
+	if (!name) return qfalse;
+	if (R_FST1NamePrefix(name, "smokePuffblack")) return qtrue;
+	if (R_FST1NamePrefix(name, "blacksmokeanim")) return qtrue;
+	return qfalse;
+}
+
+static qboolean R_FX9ProdIsCloneDoorName(const char *name)
+{
+	return (name && !Q_stricmp(name, "models/mapobjects/clonetube/cl_door1")) ? qtrue : qfalse;
+}
+
+static void R_FX9ProdScaleRGB(vec4_t baseColor, vec4_t vertColor, float scale)
+{
+	baseColor[0] *= scale; baseColor[1] *= scale; baseColor[2] *= scale;
+	vertColor[0] *= scale; vertColor[1] *= scale; vertColor[2] *= scale;
+}
+
+static void R_FX9ProdScaleAlpha(vec4_t baseColor, vec4_t vertColor, float scale)
+{
+	baseColor[3] *= scale;
+	vertColor[3] *= scale;
+}
+
+static void R_FX9ProdApplyResponse(shaderStage_t *pStage, vec4_t baseColor, vec4_t vertColor)
+{
+	const char *name;
+	int shaderClass;
+	unsigned int src, dst;
+	float scale;
+
+	if (!r_fxStage9Enable || !r_fxStage9Enable->integer || !pStage || !tess.shader)
+		return;
+
+	name = tess.shader->name;
+	shaderClass = R_FST1ShaderClassByName(name);
+	src = pStage->stateBits & GLS_SRCBLEND_BITS;
+	dst = pStage->stateBits & GLS_DSTBLEND_BITS;
+
+	if (R_FX9ProdIsLargeFireName(name))
+	{
+		scale = r_fxLargeFireResponse ? Com_Clamp(1.0f, 1.4f, r_fxLargeFireResponse->value) : 1.30f;
+		if (scale != 1.0f)
+			R_FX9ProdScaleRGB(baseColor, vertColor, scale);
+		return;
+	}
+
+	if (R_FX9ProdIsSmallFireName(name))
+	{
+		scale = r_fxSmallFireResponse ? Com_Clamp(1.0f, 1.3f, r_fxSmallFireResponse->value) : 1.15f;
+		if (scale != 1.0f)
+			R_FX9ProdScaleRGB(baseColor, vertColor, scale);
+		return;
+	}
+
+	if (shaderClass == FST1_CLASS_SMOKE)
+	{
+		if (R_FX9ProdIsBlackSmokeName(name))
+			scale = r_fxBlackSmokeAlphaScale ? Com_Clamp(0.75f, 1.0f, r_fxBlackSmokeAlphaScale->value) : 0.90f;
+		else
+			scale = r_fxLightSmokeAlphaScale ? Com_Clamp(0.75f, 1.0f, r_fxLightSmokeAlphaScale->value) : 0.90f;
+		if (scale != 1.0f)
+			R_FX9ProdScaleAlpha(baseColor, vertColor, scale);
+		return;
+	}
+
+	if (R_FX9ProdIsCloneDoorName(name) && src == GLS_SRCBLEND_ONE && dst == GLS_DSTBLEND_ONE)
+	{
+		scale = r_fxCloneAddScale ? Com_Clamp(0.70f, 1.0f, r_fxCloneAddScale->value) : 0.85f;
+		if (scale != 1.0f)
+			R_FX9ProdScaleRGB(baseColor, vertColor, scale);
+	}
+}
+
+
+static void R_FST1RecordShader(shaderStage_t *pStage, int softMode)
+{
+	int i;
+	const char *name;
+	if (!pStage || !tess.shader)
+		return;
+	name = tess.shader->name[0] ? tess.shader->name : "<unnamed>";
+	for (i = 0; i < fst1Stats.shaderCount; i++)
+	{
+		if (!Q_stricmp(fst1Stats.shaders[i].name, name))
+		{
+			fst1Stats.shaders[i].draws++;
+			if (softMode > 0)
+				fst1Stats.shaders[i].softMode = softMode;
+			return;
+		}
+	}
+	if (fst1Stats.shaderCount >= FST1_MAX_SHADER_STATS)
+		return;
+	i = fst1Stats.shaderCount++;
+	Q_strncpyz(fst1Stats.shaders[i].name, name, sizeof(fst1Stats.shaders[i].name));
+	fst1Stats.shaders[i].draws = 1;
+	fst1Stats.shaders[i].stateBits = pStage->stateBits;
+	fst1Stats.shaders[i].sort = (int)tess.shader->sort;
+	fst1Stats.shaders[i].softMode = softMode;
+}
+
+static int R_FST1StageSoftMode(shaderStage_t *pStage)
+{
+	unsigned int src, dst;
+	int mask;
+	int shaderClass;
+	if (!pStage || !tess.shader || backEnd.projection2D)
+		return 0;
+	if (backEnd.depthFill || backEnd.ssgiEntityDepthFill || (backEnd.viewParms.flags & VPF_SHADOWMAP))
+		return 0;
+	if (backEnd.refdef.rdflags & RDF_SNOOPERVIEW)
+		return 0;
+
+	shaderClass = R_FST1ShaderClassByName(tess.shader->name);
+	if (shaderClass == FST1_CLASS_NONE)
+		return 0;
+
+	mask = r_softParticleClassMask ? r_softParticleClassMask->integer : 3;
+	src = pStage->stateBits & GLS_SRCBLEND_BITS;
+	dst = pStage->stateBits & GLS_DSTBLEND_BITS;
+
+	if (shaderClass == FST1_CLASS_SMOKE)
+	{
+		fst1Stats.smokeStages++;
+		if (!(mask & 1))
+			return 0;
+		if (src == GLS_SRCBLEND_SRC_ALPHA &&
+			(dst == GLS_DSTBLEND_ONE_MINUS_SRC_ALPHA || dst == GLS_DSTBLEND_ONE))
+			return 1; // conventional alpha smoke / alpha-additive smoke: fade alpha
+		if (src == GLS_SRCBLEND_ZERO && dst == GLS_DSTBLEND_ONE_MINUS_SRC_ALPHA)
+			return 1; // multiplicative black smoke: alpha controls destination attenuation
+		if (src == GLS_SRCBLEND_ONE && dst == GLS_DSTBLEND_ONE_MINUS_SRC_ALPHA)
+			return 3; // premultiplied alpha smoke: fade RGB and alpha
+		fst1Stats.unsupportedBlend1Stages++;
+		return 0;
+	}
+
+	fst1Stats.fireStages++;
+	if (!(mask & 2))
+		return 0;
+	if (src == GLS_SRCBLEND_SRC_ALPHA && dst == GLS_DSTBLEND_ONE)
+		return 1; // alpha-additive flame: fade alpha
+	if (src == GLS_SRCBLEND_ONE && dst == GLS_DSTBLEND_ONE)
+		return 2; // pure additive flame: fade RGB
+	if (src == GLS_SRCBLEND_ONE && dst == GLS_DSTBLEND_ONE_MINUS_SRC_COLOR)
+		return 2; // screen-like flame: fade RGB toward neutral black
+	if (src == GLS_SRCBLEND_SRC_ALPHA && dst == GLS_DSTBLEND_ONE_MINUS_SRC_COLOR)
+		return 3; // mixed screen/alpha flame: both source terms must fade
+	if (src == GLS_SRCBLEND_SRC_ALPHA && dst == GLS_DSTBLEND_ONE_MINUS_SRC_ALPHA)
+		return 1; // alpha-blended blue/fire stream: fade alpha
+	fst1Stats.unsupportedBlend1Stages++;
+	return 0;
+}
