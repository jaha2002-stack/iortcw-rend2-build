+	viewArea = viewLeaf ? viewLeaf->area : -1;
+	viewChanged = (viewCluster != lastViewCluster || viewArea != lastViewArea) ? qtrue : qfalse;
+	lastViewCluster = viewCluster;
+	lastViewArea = viewArea;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		int watch = R_DarkWolfFactoryWatchIndex(light->candidate.entityOrdinal);
+		int selectedSlot = -1, j;
+		int addedIndex;
+		int runtimeClass;
+		int pvsMatched, areaPassed, firstPvsCluster, firstPvsArea, firstVisibleCluster, firstVisibleArea;
+		int lastVisibleAgeMs;
+		int nowMs;
+		const char *visibilityReason;
+		const char *addState;
+		unsigned int sig;
+		if (watch < 0)
+			continue;
+		for (j = 0; j < selectedCount; ++j)
+			if (selected[j] == light) { selectedSlot = j; break; }
+		addedIndex = R_DarkWolfFindPromotedDlightIndex(light);
