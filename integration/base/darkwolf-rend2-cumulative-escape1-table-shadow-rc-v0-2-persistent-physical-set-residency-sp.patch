+// DARKWOLF_FIRE_VOLUMETRIC_V0_1
+// Fire-volumetric eligibility is deliberately independent from lamp promotion/classifier state.
+// A source is strict only when the *authored native dlight* submitted this frame spatially matches
+// an authored dlight marker that has a nearby target_speaker whose noise contains "fire".
+// This reuses the already accepted PLR fire evidence without auto-promoting every physical light.
+static qboolean R_DarkWolfFireVolumetricSourceMatch(const vec3_t org, float r, float g, float b,
+	int *nativeOrdinal, int *speakerOrdinal, vec3_t speakerOrigin, float *speakerDistance)
+{
+	vec3_t runtimeColor;
+	int i, j;
+	VectorSet(runtimeColor, r, g, b);
+	if (nativeOrdinal) *nativeOrdinal = -1;
+	if (speakerOrdinal) *speakerOrdinal = -1;
+	if (speakerOrigin) VectorClear(speakerOrigin);
+	if (speakerDistance) *speakerDistance = -1.0f;
+
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		staticPromotePLRMarker_t *native = &s_staticPromotePLRMarkers[i];
+		if (native->kind != PLR_V01_MARKER_DLIGHT)
+			continue;
+		if (R_StaticPromotePLRDistance(org, native->origin) > 16.0f)
+			continue;
+		if (R_StaticPromotePLRColorDelta(runtimeColor, native->color) > 0.25f)
+			continue;
+
+		for (j = 0; j < s_staticPromotePLRMarkerCount; ++j)
+		{
+			staticPromotePLRMarker_t *speaker = &s_staticPromotePLRMarkers[j];
+			if (speaker->kind != PLR_V01_MARKER_SPEAKER || !R_StaticPromotePLRNoiseIsFire(speaker->noise))
+				continue;
+			if (R_StaticPromotePLRDistance(native->origin, speaker->origin) <= PLR_V01_FIRE_PAIR_MAX_DIST)
+			{
+				float pairDistance = R_StaticPromotePLRDistance(native->origin, speaker->origin);
+				if (nativeOrdinal) *nativeOrdinal = native->entityOrdinal;
+				if (speakerOrdinal) *speakerOrdinal = speaker->entityOrdinal;
+				if (speakerOrigin) VectorCopy(speaker->origin, speakerOrigin);
+				if (speakerDistance) *speakerDistance = pairDistance;
+				return qtrue;
+			}
+		}
+	}
+	return qfalse;
+}
+
+static void R_StaticPromotePLRAddMarker(int entityOrdinal, int kind,
+	const vec3_t origin, const vec3_t color, float scale, const char *noise)
+{
+	staticPromotePLRMarker_t *dst;
+	if (s_staticPromotePLRMarkerCount >= PLR_V01_MARKER_MAX || !origin)
+		return;
+	dst = &s_staticPromotePLRMarkers[s_staticPromotePLRMarkerCount++];
+	memset(dst, 0, sizeof(*dst));
+	dst->entityOrdinal = entityOrdinal;
+	dst->kind = kind;
+	VectorCopy(origin, dst->origin);
+	if (color)
+		VectorCopy(color, dst->color);
+	else
+		VectorSet(dst->color, 1.0f, 1.0f, 1.0f);
+	dst->scale = scale;
+	if (noise && noise[0])
+		Q_strncpyz(dst->noise, noise, sizeof(dst->noise));
+}
+
+static void R_StaticPromotePLRClearLight(staticPromotePersistentLight_t *light)
+{
+	if (!light)
+		return;
+	light->physicalRecognitionAccepted = qfalse;
+	light->physicalEvidenceFlags = 0;
+	light->physicalSourceRoute = PLR_V01_SOURCE_NONE;
+	light->nativeDuplicateSuppressed = qfalse;
+	light->physicalLightJuniorOrdinal = -1;
+	light->physicalCoronaOrdinal = -1;
+	light->physicalNativeDlightOrdinal = -1;
+	light->physicalFireSpeakerOrdinal = -1;
+	light->physicalAssociationScore = 1.0e30f;
+}
+
+static staticPromotePLRMarker_t *R_StaticPromotePLRNearestNativeForLight(
+	const staticPromotePersistentLight_t *light)
+{
+	staticPromotePLRMarker_t *best = NULL;
+	float bestDist = PLR_V01_NATIVE_DUP_MAX_DIST + 0.01f;
+	int i;
+	if (!light)
+		return NULL;
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		staticPromotePLRMarker_t *m = &s_staticPromotePLRMarkers[i];
+		float dist;
+		if (m->kind != PLR_V01_MARKER_DLIGHT)
+			continue;
+		if (R_StaticPromotePLRColorDelta(light->candidate.color, m->color) > PLR_V01_NATIVE_COLOR_DELTA)
+			continue;
+		dist = R_StaticPromotePLRDistance(light->candidate.origin, m->origin);
+		if (dist <= PLR_V01_NATIVE_DUP_MAX_DIST && dist < bestDist)
+		{
+			best = m;
+			bestDist = dist;
+		}
+	}
+	return best;
+}
+
+static void R_StaticPromotePLRMarkElectricAnchor(staticPromotePLRMarker_t *junior,
+	staticPromotePLRMarker_t *corona)
+{
+	staticPromotePersistentLight_t *best = NULL;
+	float bestScore = 1.0e30f;
+	int i;
+	if (!junior || !corona)
+		return;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		float dJunior, dCorona, score;
+		if (light->synthetic || light->scripted)
+			continue;
+		// Select the physically plausible primary, not a weak decorative companion.
+		if (light->candidate.intensity < 30.0f || light->candidate.intensity > 350.0f)
+			continue;
+		if (R_StaticPromotePLRColorDelta(light->candidate.color, junior->color) > PLR_V01_PRIMARY_COLOR_DELTA)
+			continue;
+		dJunior = R_StaticPromotePLRDistance(light->candidate.origin, junior->origin);
+		dCorona = R_StaticPromotePLRDistance(light->candidate.origin, corona->origin);
+		if (dJunior > PLR_V01_ELECTRIC_PRIMARY_MAX_DIST || dCorona > PLR_V01_ELECTRIC_PRIMARY_MAX_DIST)
+			continue;
+		score = MAX(dJunior, dCorona);
+		if (!best || score < bestScore - 0.01f ||
+			(fabs(score - bestScore) <= 0.01f && light->candidate.intensity > best->candidate.intensity + 0.01f))
+		{
+			best = light;
+			bestScore = score;
+		}
+	}
+	if (best && bestScore < best->physicalAssociationScore)
+	{
+		staticPromotePLRMarker_t *native;
+		best->physicalRecognitionAccepted = qtrue;
+		best->physicalEvidenceFlags |= PLR_V01_EVIDENCE_ELECTRIC;
+		best->physicalSourceRoute = PLR_V01_SOURCE_PROMOTED;
+		best->physicalLightJuniorOrdinal = junior->entityOrdinal;
+		best->physicalCoronaOrdinal = corona->entityOrdinal;
+		best->physicalAssociationScore = bestScore;
+		native = R_StaticPromotePLRNearestNativeForLight(best);
+		if (native)
+		{
+			best->physicalEvidenceFlags |= PLR_V01_EVIDENCE_NATIVE_DLIGHT;
+			best->physicalSourceRoute = PLR_V01_SOURCE_NATIVE;
+			best->nativeDuplicateSuppressed = qtrue;
+			best->physicalNativeDlightOrdinal = native->entityOrdinal;
+		}
+	}
+}
+
+static void R_StaticPromotePLRApplyFireRoutes(void)
+{
+	int i, j;
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		staticPromotePLRMarker_t *native = &s_staticPromotePLRMarkers[i];
+		staticPromotePLRMarker_t *bestSpeaker = NULL;
+		staticPromotePersistentLight_t *bestLight = NULL;
+		float bestSpeakerDist = PLR_V01_FIRE_PAIR_MAX_DIST + 0.01f;
+		float bestLightDist = PLR_V01_NATIVE_DUP_MAX_DIST + 0.01f;
+		if (native->kind != PLR_V01_MARKER_DLIGHT)
+			continue;
+		for (j = 0; j < s_staticPromotePLRMarkerCount; ++j)
+		{
+			staticPromotePLRMarker_t *speaker = &s_staticPromotePLRMarkers[j];
+			float dist;
+			if (speaker->kind != PLR_V01_MARKER_SPEAKER || !R_StaticPromotePLRNoiseIsFire(speaker->noise))
+				continue;
+			dist = R_StaticPromotePLRDistance(native->origin, speaker->origin);
+			if (dist <= PLR_V01_FIRE_PAIR_MAX_DIST && dist < bestSpeakerDist)
+			{
+				bestSpeaker = speaker;
+				bestSpeakerDist = dist;
+			}
+		}
+		if (!bestSpeaker)
+			continue;
+		for (j = 0; j < s_staticPromotePersistentCount; ++j)
+		{
+			staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[j];
+			float dist;
+			if (light->synthetic || light->scripted)
+				continue;
+			if (light->candidate.intensity < 30.0f || light->candidate.intensity > 350.0f)
+				continue;
+			if (R_StaticPromotePLRColorDelta(light->candidate.color, native->color) > PLR_V01_NATIVE_COLOR_DELTA)
+				continue;
+			dist = R_StaticPromotePLRDistance(light->candidate.origin, native->origin);
+			if (dist <= PLR_V01_NATIVE_DUP_MAX_DIST && dist < bestLightDist)
+			{
+				bestLight = light;
+				bestLightDist = dist;
+			}
+		}
+		if (bestLight)
+		{
+			bestLight->physicalRecognitionAccepted = qtrue;
+			bestLight->physicalEvidenceFlags |= PLR_V01_EVIDENCE_NATIVE_DLIGHT | PLR_V01_EVIDENCE_FIRE_SPEAKER;
+			bestLight->physicalSourceRoute = PLR_V01_SOURCE_NATIVE;
+			bestLight->nativeDuplicateSuppressed = qtrue;
+			bestLight->physicalNativeDlightOrdinal = native->entityOrdinal;
+			bestLight->physicalFireSpeakerOrdinal = bestSpeaker->entityOrdinal;
+			if (bestLightDist < bestLight->physicalAssociationScore)
+				bestLight->physicalAssociationScore = bestLightDist;
+		}
+	}
+}
+
+static void R_StaticPromotePLRBuildAssociations(void)
+{
+	int i, j;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+		R_StaticPromotePLRClearLight(&s_staticPromotePersistentLights[i]);
+
+	// Tier A electric evidence: a coherent lightJunior + corona constellation.
+	for (i = 0; i < s_staticPromotePLRMarkerCount; ++i)
+	{
+		staticPromotePLRMarker_t *junior = &s_staticPromotePLRMarkers[i];
+		staticPromotePLRMarker_t *bestCorona = NULL;
+		float bestDist = PLR_V01_ELECTRIC_PAIR_MAX_DIST + 0.01f;
+		if (junior->kind != PLR_V01_MARKER_LIGHTJUNIOR)
+			continue;
+		for (j = 0; j < s_staticPromotePLRMarkerCount; ++j)
+		{
+			staticPromotePLRMarker_t *corona = &s_staticPromotePLRMarkers[j];
+			float dist;
+			if (corona->kind != PLR_V01_MARKER_CORONA)
+				continue;
+			if (R_StaticPromotePLRColorDelta(junior->color, corona->color) > PLR_V01_PAIR_COLOR_DELTA)
+				continue;
+			dist = R_StaticPromotePLRDistance(junior->origin, corona->origin);
+			if (dist <= PLR_V01_ELECTRIC_PAIR_MAX_DIST && dist < bestDist)
+			{
+				bestCorona = corona;
+				bestDist = dist;
+			}
+		}
+		if (bestCorona)
+			R_StaticPromotePLRMarkElectricAnchor(junior, bestCorona);
+	}
+
+	// Tier A fire evidence: authored native dlight + nearby fire sound emitter.
+	R_StaticPromotePLRApplyFireRoutes();
+
+	s_staticPromotePLRPhysicalCount = 0;
+	s_staticPromotePLRElectricCount = 0;
+	s_staticPromotePLRNativeRouteCount = 0;
+	s_staticPromotePLRFireCount = 0;
+	for (i = 0; i < s_staticPromotePersistentCount; ++i)
+	{
+		staticPromotePersistentLight_t *light = &s_staticPromotePersistentLights[i];
+		if (!light->physicalRecognitionAccepted)
+			continue;
+		s_staticPromotePLRPhysicalCount++;
+		if (light->physicalEvidenceFlags & PLR_V01_EVIDENCE_ELECTRIC)
+			s_staticPromotePLRElectricCount++;
+		if (light->physicalSourceRoute == PLR_V01_SOURCE_NATIVE)
+			s_staticPromotePLRNativeRouteCount++;
+		if (light->physicalEvidenceFlags & PLR_V01_EVIDENCE_FIRE_SPEAKER)
+			s_staticPromotePLRFireCount++;
+	}
+	if (tr.world)
+	{
+		ri.Printf(PRINT_ALL,
+			"PLR_V01_SUMMARY map=%s enabled=%d markers=%d physical=%d electric=%d nativeRoutes=%d fire=%d pairMax=%.1f primaryMax=%.1f nativeMax=%.1f\n",
+			tr.world->baseName, R_StaticPromotePLREnabled() ? 1 : 0, s_staticPromotePLRMarkerCount,
+			s_staticPromotePLRPhysicalCount, s_staticPromotePLRElectricCount,
+			s_staticPromotePLRNativeRouteCount, s_staticPromotePLRFireCount,
+			PLR_V01_ELECTRIC_PAIR_MAX_DIST, PLR_V01_ELECTRIC_PRIMARY_MAX_DIST, PLR_V01_NATIVE_DUP_MAX_DIST);
+	}
+}
