+static void R_DlightMaterialProbeDrawSurfs(drawSurf_t *drawSurfs, int numDrawSurfs)
+{
+	dlightMaterialRayHit_t hits[DLIGHT_MATERIAL_MAX_RAY_HITS];
+	int hitCount = 0;
+	int drawIndex;
+	int selectedHit = -1;
+	int unsupportedModelDrawSurfs = 0;
+	char report[12288];
+	char line[1024];
+	int stageIndex;
+
+	memset(hits, 0, sizeof(hits));
+	for (drawIndex = 0; drawIndex < numDrawSurfs; drawIndex++)
+	{
+		drawSurf_t *draw = &drawSurfs[drawIndex];
+		shader_t *shader;
+		int entityNum, fogNum, dlighted, pshadowed, atiTess;
+		surfaceType_t type;
+		if (!draw->surface)
+			continue;
+		type = *draw->surface;
+		R_DecomposeSort(draw->sort, &entityNum, &shader, &fogNum, &dlighted, &pshadowed, &atiTess);
+		if (!shader)
+			continue;
+		if (type == SF_FACE || type == SF_GRID || type == SF_TRIANGLES)
+		{
+			R_DlightMaterialAddBspHits(draw, shader, entityNum, hits, &hitCount);
+			continue;
+		}
+		if (type == SF_VAO_MDVMESH || type == SF_MDV)
+		{
+			if (!R_DlightMaterialAddMdvHits(draw, shader, entityNum, hits, &hitCount))
+				unsupportedModelDrawSurfs++;
+			continue;
+		}
+		if (type == SF_MDS || type == SF_MDR || type == SF_IQM || type == SF_VAO_IQM)
+			unsupportedModelDrawSurfs++;
+	}
+
+	R_DlightMaterialSortHits(hits, hitCount);
+	report[0] = '\0';
+	Q_strcat(report, sizeof(report), "REND2_DLIGHT_MODEL_BMODEL_MATERIAL_PROBE_V8_6_7\n");
+	Q_strcat(report, sizeof(report), "base=REND2_DLIGHT_ROBUST_PROBE_FROZEN_RES_V8_6_6\n");
+	Com_sprintf(line, sizeof(line), "rayHitCount=%d unsupportedModelDrawSurfs=%d\n", hitCount, unsupportedModelDrawSurfs);
+	Q_strcat(report, sizeof(report), line);
+	for (drawIndex = 0; drawIndex < hitCount; drawIndex++)
+	{
+		dlightMaterialRayHit_t *hit = &hits[drawIndex];
+		int sort = (int)(hit->shader->sort + 0.5f);
+		Com_sprintf(line, sizeof(line),
+			"candidate[%d].distance=%.3f entity=%d entityKind=%s surface=%d surfaceType=%s shader=%s sort=%s alpha=%d blend=%d depthWrite=%d passes=%d accept=%d reason=%s modelType=%d model=%s\n",
+			drawIndex, sqrt(hit->distanceSquared), hit->entityNum, hit->geometryKind,
+			hit->surfaceIndex, R_DlightMaterialSurfaceTypeName(*hit->draw->surface),
+			hit->shader->name, R_DlightMaterialSortName(sort), hit->hasAlpha, hit->hasBlend,
+			hit->hasDepthWrite, hit->shader->numUnfoggedPasses, hit->accepted, hit->reason,
+			hit->modelType, hit->modelName ? hit->modelName : "<none>");
+		Q_strcat(report, sizeof(report), line);
+		if (selectedHit < 0 && hit->accepted)
+			selectedHit = drawIndex;
+	}
+
+	if (selectedHit < 0)
+	{
+		Q_strcat(report, sizeof(report), "status=NO_SHADOW_CAPABLE_HIT\n");
+		if (unsupportedModelDrawSurfs > 0)
+			Q_strcat(report, sizeof(report), "nextHint=UNSUPPORTED_MODEL_TYPE_VISIBLE_ON_CENTER_RAY_CANDIDATE\n");
+		ri.FS_WriteFile("dlight_material_probe.txt", report, (int)strlen(report));
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_MATERIAL_PROBE V8.6.7 MISS: no supported BSP/MDV shadow candidate; unsupportedModelDrawSurfs=%d\n",
+			unsupportedModelDrawSurfs);
+		ri.Cvar_Set("r_dlightMaterialProbe", "0");
+		return;
+	}
+
+	{
+		dlightMaterialRayHit_t *best = &hits[selectedHit];
+		shader_t *bestShader = best->shader;
+		int hasAlpha = best->hasAlpha;
+		int hasBlend = best->hasBlend;
+		dlightMaterialDiagTargetShaderIndex = bestShader->index;
+		dlightMaterialDiagTargetSurfaceIndex = best->surfaceIndex;
+		dlightMaterialDiagTargetEntityNum = best->entityNum;
+		dlightMaterialDiagTargetSort = (int)(bestShader->sort + 0.5f);
+		dlightMaterialDiagTargetNumPasses = bestShader->numUnfoggedPasses;
+		dlightMaterialDiagTargetHasAlpha = hasAlpha;
+		dlightMaterialDiagTargetHasBlend = hasBlend;
+		Q_strncpyz(dlightMaterialDiagTargetShaderName, bestShader->name, sizeof(dlightMaterialDiagTargetShaderName));
+
+		Q_strcat(report, sizeof(report), "status=HIT\n");
+		Com_sprintf(line, sizeof(line),
+			"selectedCandidate=%d\nentityNum=%d\nentityKind=%s\nsurfaceIndex=%d\nsurfaceType=%s\ntriangle=%d\ndistance=%.3f\nmodelType=%d\nmodelName=%s\n",
+			selectedHit, best->entityNum, best->geometryKind, best->surfaceIndex,
+			R_DlightMaterialSurfaceTypeName(*best->draw->surface), best->triangle,
+			sqrt(best->distanceSquared), best->modelType,
+			best->modelName ? best->modelName : "<none>");
+		Q_strcat(report, sizeof(report), line);
+		Com_sprintf(line, sizeof(line),
+			"shader=%s\nshaderIndex=%d\nsortedIndex=%d\nlightmapIndex=%d\nsort=%d\nsortName=%s\nexplicitlyDefined=%d\nsurfaceFlags=0x%08x\ncontentFlags=0x%08x\ncullType=%d\npolygonOffset=%d\nnumUnfoggedPasses=%d\nhasAlphaTest=%d\nhasBlend=%d\nmultistage=%d\n",
+			bestShader->name, bestShader->index, bestShader->sortedIndex, bestShader->lightmapIndex,
+			dlightMaterialDiagTargetSort, R_DlightMaterialSortName(dlightMaterialDiagTargetSort),
+			bestShader->explicitlyDefined, bestShader->surfaceFlags, bestShader->contentFlags,
+			bestShader->cullType, bestShader->polygonOffset, bestShader->numUnfoggedPasses,
+			hasAlpha, hasBlend, bestShader->numUnfoggedPasses > 1 ? 1 : 0);
+		Q_strcat(report, sizeof(report), line);
+
+		for (stageIndex = 0; stageIndex < bestShader->numUnfoggedPasses && stageIndex < MAX_SHADER_STAGES; stageIndex++)
+		{
+			shaderStage_t *stage = bestShader->stages[stageIndex];
+			const char *imageName = "<none>";
+			int alphaTest = 0;
+			int blend = 0;
+			if (!stage)
+				continue;
+			if (stage->bundle[TB_DIFFUSEMAP].image[0])
+				imageName = stage->bundle[TB_DIFFUSEMAP].image[0]->imgName;
+			alphaTest = R_DlightMaterialAlphaTestBits(stage->stateBits);
+			blend = (stage->stateBits & (GLS_SRCBLEND_BITS | GLS_DSTBLEND_BITS)) ? 1 : 0;
+			Com_sprintf(line, sizeof(line),
+				"stage[%d].active=%d type=%d stateBits=0x%08x alphaTest=%d blend=%d depthWrite=%d image=%s tcGen=%d texMods=%d\n",
+				stageIndex, stage->active, stage->type, stage->stateBits, alphaTest, blend,
+				(stage->stateBits & GLS_DEPTHMASK_TRUE) ? 1 : 0, imageName,
+				stage->bundle[TB_DIFFUSEMAP].tcGen, stage->bundle[TB_DIFFUSEMAP].numTexMods);
+			Q_strcat(report, sizeof(report), line);
+		}
+		ri.FS_WriteFile("dlight_material_probe.txt", report, (int)strlen(report));
+		ri.Printf(PRINT_ALL,
+			"DLIGHT_MATERIAL_PROBE V8.6.7 HIT candidate=%d entity=%d kind=%s surface=%d type=%s shader=%s distance=%.1f model=%s\n",
+			selectedHit, best->entityNum, best->geometryKind, best->surfaceIndex,
+			R_DlightMaterialSurfaceTypeName(*best->draw->surface), bestShader->name,
+			sqrt(best->distanceSquared), best->modelName ? best->modelName : "<none>");
+	}
+	ri.Cvar_Set("r_dlightMaterialProbe", "0");
+}
