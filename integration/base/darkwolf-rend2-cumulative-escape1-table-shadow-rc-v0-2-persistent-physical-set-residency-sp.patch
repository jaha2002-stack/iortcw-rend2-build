+static int R_StaticPromoteClassifyFixture(const staticPromotePersistentLight_t *light)
+{
+	float minIntensity;
+	float maxIntensity;
+	float minColorRatio;
+	int allowScripted;
+	int minFixtureMembers;
+	int userOverride;
+
+	if (!light)
+		return STATIC_PROMOTE_CLASS_INTENSITY;
+	userOverride = R_StaticPromoteUserOverrideState(tr.world ? tr.world->baseName : "", light->candidate.entityOrdinal);
+	if (userOverride < 0)
+		return STATIC_PROMOTE_CLASS_USER_BLOCKED;
+	if (userOverride > 0)
+		return STATIC_PROMOTE_CLASS_ACCEPT;
+	// DARKWOLF_PHYSICAL_LIGHT_RECOGNITION_V0_1: manual decisions retain precedence.
+	if (R_StaticPromotePLREnabled() && light->nativeDuplicateSuppressed)
+		return STATIC_PROMOTE_CLASS_NATIVE_SOURCE;
+	if (R_StaticPromotePLREnabled() && light->physicalRecognitionAccepted)
+		return STATIC_PROMOTE_CLASS_ACCEPT;
+	if (light->synthetic)
+		return STATIC_PROMOTE_CLASS_ACCEPT;
+	if (light->approvedFallback)
+		return STATIC_PROMOTE_CLASS_ACCEPT;
+	if (r_staticPromoteClassifier && !r_staticPromoteClassifier->integer)
+		return STATIC_PROMOTE_CLASS_ACCEPT;
+
+	allowScripted = r_staticPromoteClassifierAllowScripted ? r_staticPromoteClassifierAllowScripted->integer : 0;
+	if (light->scripted && !allowScripted)
+		return STATIC_PROMOTE_CLASS_SCRIPTED;
+
+	minFixtureMembers = r_staticPromoteClassifierMinFixtureMembers ? r_staticPromoteClassifierMinFixtureMembers->integer : 2;
+	minFixtureMembers = CLAMP(minFixtureMembers, 1, 4);
+	if (light->rawMembers < minFixtureMembers)
+		return STATIC_PROMOTE_CLASS_FIXTURE_MEMBERS;
+
+	minIntensity = r_staticPromoteClassifierMinIntensity ? r_staticPromoteClassifierMinIntensity->value : 30.0f;
+	maxIntensity = r_staticPromoteClassifierMaxIntensity ? r_staticPromoteClassifierMaxIntensity->value : 350.0f;
+	minColorRatio = r_staticPromoteClassifierMinColorRatio ? r_staticPromoteClassifierMinColorRatio->value : 0.60f;
+	minIntensity = CLAMP(minIntensity, 1.0f, 1000.0f);
+	maxIntensity = CLAMP(maxIntensity, minIntensity, 2000.0f);
+	minColorRatio = CLAMP(minColorRatio, 0.0f, 1.0f);
+
+	if (light->candidate.intensity < minIntensity || light->candidate.intensity > maxIntensity)
+		return STATIC_PROMOTE_CLASS_INTENSITY;
+	if (R_StaticPromoteColorRatio(light->candidate.color) < minColorRatio)
+		return STATIC_PROMOTE_CLASS_COLOR;
+	return STATIC_PROMOTE_CLASS_ACCEPT;
+}
+
+static int R_StaticPromotePhysicalPriority(const staticPromotePersistentLight_t *light)
+{
+	int userOverride;
+	if (!light)
+		return 99;
+	userOverride = R_StaticPromoteUserOverrideState(tr.world ? tr.world->baseName : "", light->candidate.entityOrdinal);
+	if (userOverride > 0)
+		return 0;
+	// DARKWOLF_PHYSICAL_LIGHT_RECOGNITION_V0_1: true physical fixtures outrank legacy-only candidates.
+	if (R_StaticPromotePLREnabled() && light->physicalRecognitionAccepted && !light->nativeDuplicateSuppressed)
+		return 1;
+	if (light->synthetic)
+		return 2;
+	if (light->approvedFallback)
+		return 3;
+	if (light->rawMembers >= 3)
+		return 4;
+	if (light->rawMembers >= 2)
+		return 5;
+	return 6;
+}
+
+static qboolean R_StaticPromoteCandidatePlausiblePrimary(const staticPromoteCandidate_t *candidate, qboolean scripted)
+{
+	if (!candidate || scripted)
+		return qfalse;
+	if (candidate->intensity < 10.0f || candidate->intensity > 400.0f)
+		return qfalse;
+	if (R_StaticPromoteColorRatio(candidate->color) < 0.45f)
+		return qfalse;
+	return qtrue;
+}
