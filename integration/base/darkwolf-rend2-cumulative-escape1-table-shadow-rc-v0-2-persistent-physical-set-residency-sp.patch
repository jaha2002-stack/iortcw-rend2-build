+
+	proof->available = qtrue;
+	proof->fixtureOrdinal = state.fixtureOrdinal;
+	CG_DarkWolfPCRBV04BuildPoints( &state, points, names );
+
+	// Only the compact fixture region is functional in B: LIGHT_CENTER, BODY_MID,
+	// and six +/-16 body samples. CORONA and +/-32 samples remain diagnostic-only.
+	for ( i = PCRB_V06_NEAR_POINT_FIRST; i <= PCRB_V06_NEAR_POINT_LAST; ++i ) {
+		qboolean clear;
+		CG_Trace( &trc, cg.refdef.vieworg, NULL, NULL, points[i], -1,
+			MASK_SOLID | CONTENTS_BODY );
+		clear = CG_DarkWolfPCRBV03StrictClear( &trc );
+		if ( i == 1 ) proof->lightCenterClear = clear ? 1 : 0;
+		if ( i == 2 ) proof->bodyMidClear = clear ? 1 : 0;
+		if ( i >= 3 ) {
+			if ( clear ) proof->near16Clear++;
+			else proof->near16Blocked++;
+		}
+	}
+
+	// Conservative proof: either the real renderer light center or body midpoint
+	// is clear, OR at least two independent +/-16 body samples are clear.
+	proof->proof = ( proof->lightCenterClear || proof->bodyMidClear ||
+		proof->near16Clear >= 2 ) ? 1 : 0;
+	return proof->proof ? qtrue : qfalse;
+}
+
+static void CG_DarkWolfPCRBV06LogDecision( centity_t *cent, qboolean modeB,
+	qboolean baselineCoronaLOS, const pcrbV06Proof_t *proof,
+	qboolean rescuedSubmission ) {
+	static int s_lastPrint[MAX_GENTITIES];
+	static unsigned int s_lastSig[MAX_GENTITIES];
+	static int s_lastMode = -1;
+	int runtimeId;
+	int fixtureOrdinal = -1;
+	int available = 0;
+	int lightCenterClear = 0;
+	int bodyMidClear = 0;
+	int near16Clear = 0;
+	int near16Blocked = 0;
+	int physicalProof = 0;
+	pcrbV04FixtureState_t state;
+	int priorPVS = -1;
+	int priorHeld = -1;
+	int priorPhysical = -1;
+	unsigned int sig;
+
+	if ( !cent || !CG_DarkWolfDiagCvarEnabled( "dw_pcrbV06Diag" ) ) return;
+	runtimeId = cent->currentState.number;
+	if ( runtimeId < 0 || runtimeId >= MAX_GENTITIES || !CG_DarkWolfPCRBV06Target( runtimeId ) ) return;
+
+	if ( proof ) {
+		fixtureOrdinal = proof->fixtureOrdinal;
+		available = proof->available ? 1 : 0;
+		lightCenterClear = proof->lightCenterClear;
+		bodyMidClear = proof->bodyMidClear;
+		near16Clear = proof->near16Clear;
+		near16Blocked = proof->near16Blocked;
+		physicalProof = proof->proof;
+	}
+	if ( CG_DarkWolfPCRBV04ReadFixtureState( runtimeId, &state ) ) {
+		fixtureOrdinal = state.fixtureOrdinal;
+		priorPVS = state.influencePVSVisible;
+		priorHeld = state.heldResident;
+		priorPhysical = state.physicalVisible;
+	}
+
+	if ( s_lastMode != ( modeB ? 1 : 0 ) ) {
+		s_lastMode = modeB ? 1 : 0;
+		CG_Printf( "SPR_PCRB06_STARTUP mode=%s cvar=%d targetScoped=1 rule=LIGHT_CENTER_OR_BODY_MID_OR_2_NEAR16 pvsChanged=0 areaPortalChanged=0 bindingChanged=0 holdChanged=0 budgetChanged=0 rendererChanged=0\n",
+			modeB ? "B_MULTIPOINT" : "A_CORONA_ONLY", modeB ? 1 : 0 );
+	}
+
+	sig = (unsigned int)( modeB ? 1 : 0 );
+	sig = sig * 33u + (unsigned int)( baselineCoronaLOS ? 1 : 0 );
+	sig = sig * 33u + (unsigned int)( available + 1 );
+	sig = sig * 33u + (unsigned int)( physicalProof + 1 );
+	sig = sig * 33u + (unsigned int)( rescuedSubmission ? 1 : 0 );
+	sig = sig * 33u + (unsigned int)( priorPVS + 2 );
+	sig = sig * 33u + (unsigned int)( priorHeld + 2 );
+	if ( s_lastSig[runtimeId] == sig && s_lastPrint[runtimeId] != 0 &&
+		cg.time >= s_lastPrint[runtimeId] &&
+		cg.time - s_lastPrint[runtimeId] < PCRB_V06_PRINT_INTERVAL_MS ) return;
+	s_lastSig[runtimeId] = sig;
+	s_lastPrint[runtimeId] = cg.time;
+	CG_Printf( "SPR_PCRB06_DECISION map=%s role=%s runtimeId=%d fixture=%d time=%d mode=%s baselineCoronaLOS=%d proofAvailable=%d lightCenterClear=%d bodyMidClear=%d near16Clear=%d near16Blocked=%d physicalProof=%d submittedLOS=%d rescuedSubmission=%d priorRendererPVS=%d priorRendererPhysical=%d priorRendererHeld=%d counterfactualA_NoImmediateFallback=%d\n",
+		cgs.mapname, CG_DarkWolfPCRBV03Role( runtimeId ), runtimeId, fixtureOrdinal,
+		cg.time, modeB ? "B_MULTIPOINT" : "A_CORONA_ONLY",
+		baselineCoronaLOS ? 1 : 0, available, lightCenterClear, bodyMidClear,
+		near16Clear, near16Blocked, physicalProof,
+		( baselineCoronaLOS || rescuedSubmission ) ? 1 : 0, rescuedSubmission ? 1 : 0,
+		priorPVS, priorPhysical, priorHeld,
+		( !baselineCoronaLOS && priorPVS == 0 ) ? 1 : 0 );
+}
+
+static qboolean CG_DarkWolfPCRBV04PointInFrustum( const vec3_t point,
+	float *screenXOut, float *screenYOut ) {
+	vec3_t delta;
+	float forward;
+	float side;
+	float up;
+	float tanHalfX;
+	float tanHalfY;
+	float nx;
+	float ny;
+
+	VectorSubtract( point, cg.refdef.vieworg, delta );
+	forward = DotProduct( delta, cg.refdef.viewaxis[0] );
+	if ( forward <= 0.01f ) {
+		if ( screenXOut ) *screenXOut = 999.0f;
+		if ( screenYOut ) *screenYOut = 999.0f;
+		return qfalse;
+	}
+	tanHalfX = tan( cg.refdef.fov_x * (float)M_PI / 360.0f );
+	tanHalfY = tan( cg.refdef.fov_y * (float)M_PI / 360.0f );
+	if ( tanHalfX <= 0.0f || tanHalfY <= 0.0f ) {
+		return qfalse;
+	}
+	side = DotProduct( delta, cg.refdef.viewaxis[1] );
+	up = DotProduct( delta, cg.refdef.viewaxis[2] );
+	nx = side / ( forward * tanHalfX );
+	ny = up / ( forward * tanHalfY );
+	if ( screenXOut ) *screenXOut = 0.5f * ( 1.0f - nx );
+	if ( screenYOut ) *screenYOut = 0.5f * ( 1.0f - ny );
+	return ( fabs( nx ) <= 1.0f && fabs( ny ) <= 1.0f ) ? qtrue : qfalse;
+}
+
+static const char *CG_DarkWolfPCRBV04ModelName( const trace_t *tr,
+	int *modelIndexOut, int *modelIndex2Out, char *buffer, int bufferSize ) {
+	const entityState_t *es;
+	const char *name;
+
+	if ( modelIndexOut ) *modelIndexOut = -1;
+	if ( modelIndex2Out ) *modelIndex2Out = -1;
+	if ( !buffer || bufferSize <= 0 ) {
+		return "-";
+	}
+	Q_strncpyz( buffer, "-", bufferSize );
+	if ( !tr || tr->entityNum == ENTITYNUM_WORLD ) {
+		Q_strncpyz( buffer, "<world-plane>", bufferSize );
+		return buffer;
+	}
+	if ( tr->entityNum == ENTITYNUM_NONE || tr->entityNum < 0 || tr->entityNum >= MAX_GENTITIES ) {
+		return buffer;
+	}
+	es = &cg_entities[tr->entityNum].currentState;
+	if ( modelIndexOut ) *modelIndexOut = es->modelindex;
+	if ( modelIndex2Out ) *modelIndex2Out = es->modelindex2;
+	if ( es->modelindex > 0 && es->modelindex < MAX_MODELS ) {
+		name = CG_ConfigString( CS_MODELS + es->modelindex );
+		if ( name && name[0] ) {
+			Q_strncpyz( buffer, name, bufferSize );
+		}
+	}
+	return buffer;
+}
