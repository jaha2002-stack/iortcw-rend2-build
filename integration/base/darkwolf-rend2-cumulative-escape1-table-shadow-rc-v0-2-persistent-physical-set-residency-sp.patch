+static qboolean R_DlightMaterialResolveMdv(drawSurf_t *draw, int entityNum,
+	mdvModel_t **outModel, mdvSurface_t **outSurface, model_t **outHandleModel)
+{
+	trRefEntity_t *ent;
+	model_t *handleModel;
+	mdvModel_t *mdvModel = NULL;
+	mdvSurface_t *mdvSurface = NULL;
+	int lod;
+	if (!draw || !draw->surface || entityNum < 0 || entityNum >= tr.refdef.num_entities)
+		return qfalse;
+	ent = &tr.refdef.entities[entityNum];
+	if (ent->e.reType != RT_MODEL || ent->e.hModel <= 0)
+		return qfalse;
+	handleModel = R_GetModelByHandle(ent->e.hModel);
+	if (!handleModel)
+		return qfalse;
+	if (*draw->surface == SF_VAO_MDVMESH)
+	{
+		srfVaoMdvMesh_t *vaoSurface = (srfVaoMdvMesh_t *)draw->surface;
+		mdvModel = vaoSurface->mdvModel;
+		mdvSurface = vaoSurface->mdvSurface;
+	}
+	else if (*draw->surface == SF_MDV)
+	{
+		mdvSurface = (mdvSurface_t *)draw->surface;
+		for (lod = 0; lod < handleModel->numLods; lod++)
+		{
+			mdvModel_t *candidate = handleModel->mdv[lod];
+			if (!candidate || !candidate->surfaces)
+				continue;
+			if (mdvSurface >= candidate->surfaces && mdvSurface < candidate->surfaces + candidate->numSurfaces)
+			{
+				mdvModel = candidate;
+				break;
+			}
+		}
+	}
+	if (!mdvModel || !mdvSurface || !mdvSurface->verts || !mdvSurface->indexes)
+		return qfalse;
+	if (ent->e.frame < 0 || ent->e.frame >= mdvModel->numFrames
+		|| ent->e.oldframe < 0 || ent->e.oldframe >= mdvModel->numFrames)
+		return qfalse;
+	*outModel = mdvModel;
+	*outSurface = mdvSurface;
+	*outHandleModel = handleModel;
+	return qtrue;
+}
