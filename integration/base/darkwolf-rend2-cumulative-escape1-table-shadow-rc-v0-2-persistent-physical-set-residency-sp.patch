+static void R_DarkWolfFactoryDiagFrame(const refdef_t *fd,
+	staticPromotePersistentLight_t **selected, int selectedCount)
+{
+	static unsigned int lastSignature[ARRAY_LEN(s_dwFactoryWatchEntities)];
+	static int lastViewCluster = -999999;
