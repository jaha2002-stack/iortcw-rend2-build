+static void CG_DarkWolfPCRBV04BuildPoints( const pcrbV04FixtureState_t *state,
+	vec3_t points[PCRB_V04_POINT_COUNT], const char *names[PCRB_V04_POINT_COUNT] ) {
+	vec3_t bodyMid;
+	vec3_t towardView;
+	vec3_t worldUp;
+	vec3_t right;
+
+	VectorCopy( state->coronaOrigin, points[0] );
+	VectorCopy( state->lightCenter, points[1] );
+	VectorAdd( state->coronaOrigin, state->lightCenter, bodyMid );
+	VectorScale( bodyMid, 0.5f, bodyMid );
+	VectorCopy( bodyMid, points[2] );
+
+	VectorSubtract( cg.refdef.vieworg, bodyMid, towardView );
+	towardView[2] = 0.0f;
+	if ( VectorNormalize( towardView ) == 0.0f ) {
+		VectorScale( cg.refdef.viewaxis[0], -1.0f, towardView );
+		towardView[2] = 0.0f;
+		VectorNormalize( towardView );
+	}
+	VectorSet( worldUp, 0.0f, 0.0f, 1.0f );
+	CrossProduct( worldUp, towardView, right );
+	if ( VectorNormalize( right ) == 0.0f ) {
+		VectorSet( right, 1.0f, 0.0f, 0.0f );
+	}
+
+	VectorMA( bodyMid, 16.0f, worldUp, points[3] );
+	VectorMA( bodyMid, -16.0f, worldUp, points[4] );
+	VectorMA( bodyMid, -16.0f, right, points[5] );
+	VectorMA( bodyMid, 16.0f, right, points[6] );
+	VectorMA( bodyMid, 16.0f, towardView, points[7] );
+	VectorMA( bodyMid, -16.0f, towardView, points[8] );
+	VectorMA( bodyMid, 32.0f, worldUp, points[9] );
+	VectorMA( bodyMid, -32.0f, worldUp, points[10] );
+	VectorMA( bodyMid, -32.0f, right, points[11] );
+	VectorMA( bodyMid, 32.0f, right, points[12] );
+	VectorMA( bodyMid, 32.0f, towardView, points[13] );
+	VectorMA( bodyMid, -32.0f, towardView, points[14] );
+
+	names[0] = "CORONA";
+	names[1] = "LIGHT_CENTER";
+	names[2] = "BODY_MID";
+	names[3] = "BODY_UP16";
+	names[4] = "BODY_DOWN16";
+	names[5] = "BODY_LEFT16";
+	names[6] = "BODY_RIGHT16";
+	names[7] = "BODY_FRONT16";
+	names[8] = "BODY_BACK16";
+	names[9] = "BODY_UP32";
+	names[10] = "BODY_DOWN32";
+	names[11] = "BODY_LEFT32";
+	names[12] = "BODY_RIGHT32";
+	names[13] = "BODY_FRONT32";
+	names[14] = "BODY_BACK32";
+}
