+        tr.world->baseName, target->role ? target->role : "<none>", target->runtimeId,
+        target->fixtureOrdinal, target->frameTime, rank, hit->surfaceIndex, hit->entityNum,
+        hit->entityNum == REFENTITYNUM_WORLD ? 1 : 0, shaderName, typeName,
