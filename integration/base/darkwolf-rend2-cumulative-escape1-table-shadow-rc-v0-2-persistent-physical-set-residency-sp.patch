+static int CG_DarkWolfPCRBV05Slot( int runtimeId ) {
+	switch ( runtimeId ) {
+	case 352: return 0;
+	case 342: return 1;
+	case 628: return 2;
+	case 609: return 3;
+	default: return -1;
+	}
+}
