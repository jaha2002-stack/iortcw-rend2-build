+static qboolean R_FireVolProductionCacheMatchesHint(const fireVolumetricSyntheticShadowCache_t *cache, const fireVolumetricSyntheticShadowHint_t *hint)
+{
+	vec3_t delta;
+	if (!cache || !hint || !cache->valid || !hint->valid || cache->flameSurface != hint->flameSurface) return qfalse;
+	if (fabs(cache->captureRadius - MAX(hint->sampleRadius, 64.0f)) > 0.5f) return qfalse;
+	VectorSubtract(cache->captureOrigin, hint->flameOrigin, delta);
+	return DotProduct(delta, delta) <= 4.0f ? qtrue : qfalse;
+}
