+static qboolean R_StaticPromoteSyntheticAdd(const char *mapName, const vec3_t origin, float intensity, const vec3_t color, int *idOut)
+{
+	int i;
+	int nextId = 1;
+	staticPromoteSyntheticLight_t *dst;
+	R_StaticPromoteSyntheticEnsureLoaded();
+	if (!mapName || !mapName[0] || !origin || !color) return qfalse;
+	if (s_staticPromoteSyntheticCount >= STATIC_PROMOTE_SYNTHETIC_MAX) return qfalse;
+	for (i = 0; i < s_staticPromoteSyntheticCount; ++i)
+		if (s_staticPromoteSyntheticLights[i].id >= nextId) nextId = s_staticPromoteSyntheticLights[i].id + 1;
+	dst = &s_staticPromoteSyntheticLights[s_staticPromoteSyntheticCount++];
+	memset(dst, 0, sizeof(*dst));
+	Q_strncpyz(dst->mapName, mapName, sizeof(dst->mapName));
+	dst->id = nextId;
+	VectorCopy(origin, dst->origin);
+	VectorCopy(color, dst->color);
+	R_StaticPromoteSyntheticClampColor(dst->color);
+	dst->intensity = CLAMP(intensity, 5.0f, 1000.0f);
+	if (!R_StaticPromoteSyntheticSave())
+	{
+		s_staticPromoteSyntheticCount--;
+		return qfalse;
+	}
+	if (idOut) *idOut = nextId;
+	return qtrue;
+}
