+static void R_DarkWolfPCRBE2E07Finalize(const refdef_t *fd)
+{
+    int t;
+    int now;
+    if (!fd || !tr.world || !0)
+        return;
+    if (fd->rdflags & (RDF_NOWORLDMODEL | RDF_SKYBOXPORTAL))
+        return;
+    now = ri.Milliseconds();
+
+    for (t = 0; t < PCRB_E2E07_TARGETS; ++t)
+    {
+        pcrbE2E07Target_t *target = &s_pcrbE2E07[t];
+        qboolean rootMismatch;
+        qboolean volumeCandidate;
+        qboolean calibrationPossible;
+        qboolean calibrationMatch;
+        unsigned int sig;
+        int i;
+        if (!target->active)
+            continue;
+
+        rootMismatch = (!target->productionPointPVS && target->touchedVisibleSurfaces > 0) ? qtrue : qfalse;
+        volumeCandidate = (!target->productionPointPVS && target->sphereVisiblePairs > 0) ? qtrue : qfalse;
+        calibrationPossible = (target->addedDlightIndex >= 0 && target->touchedVisibleSurfaces > 0) ? qtrue : qfalse;
+        calibrationMatch = (calibrationPossible &&
+            target->actualDlightTouchedSurfaces == target->touchedVisibleSurfaces) ? qtrue : qfalse;
+
+        sig = (unsigned int)(target->productionPointPVS ? 1 : 0);
+        sig = sig * 33u + (unsigned int)(target->sphereVisiblePairs + 1);
+        sig = sig * 33u + (unsigned int)(target->touchedVisibleSurfaces + 1);
+        sig = sig * 33u + (unsigned int)(target->touchedWorldSurfaces + 1);
+        sig = sig * 33u + (unsigned int)(target->surfaceInfluenceVisible ? 1 : 0);
+        sig = sig * 33u + (unsigned int)(target->surfaceResidency ? 1 : 0);
+        sig = sig * 33u + (unsigned int)(target->held ? 1 : 0);
+        sig = sig * 33u + (unsigned int)(target->selectedSlot + 2);
+        sig = sig * 33u + (unsigned int)(target->addedDlightIndex + 2);
+        if (s_pcrbE2E07LastPrint[t] != 0 && now >= s_pcrbE2E07LastPrint[t] &&
+            now - s_pcrbE2E07LastPrint[t] < 250 && s_pcrbE2E07LastSig[t] == sig)
+            continue;
+        s_pcrbE2E07LastPrint[t] = now;
+        s_pcrbE2E07LastSig[t] = sig;
+
+        ri.Printf(PRINT_ALL,
+            "SPR_E2E07_LEDGER map=%s role=%s runtimeId=%d fixture=%d time=%d cameraDist=%.2f viewCluster=%d viewArea=%d runtimeRadius=%.2f productionPointPVS=%d influenceCount=%d sphereOverlapLeaves=%d sphereUniquePairs=%d sphereVisibleLeaves=%d sphereVisiblePairs=%d spherePairOverflow=%d coronaPresent=%d coronaLOS=%d physicalFallback=%d surfaceInfluenceVisible=%d surfaceResidency=%d surfaceSignalSourceTime=%d held=%d selectedSlot=%d addedDlightIndex=%d finalDecision=%s visibleSurfaces=%d touchedVisibleSurfaces=%d touchedWorld=%d touchedBmodel=%d actualDlightTouched=%d rootMismatch=%d volumeLeafCandidate=%d calibration=%s\\n",
+            tr.world->baseName, target->role ? target->role : "<none>", target->runtimeId,
+            target->fixtureOrdinal, target->frameTime, target->cameraDistance,
+            target->viewCluster, target->viewArea, target->runtimeRadius,
+            target->productionPointPVS ? 1 : 0, target->influenceCount,
+            target->sphereOverlapLeaves, target->sphereUniquePairs,
+            target->sphereVisibleLeaves, target->sphereVisiblePairs, target->spherePairOverflow,
+            target->coronaPresent ? 1 : 0, target->coronaLOS ? 1 : 0,
+            target->physicalFallback ? 1 : 0,
+            target->surfaceInfluenceVisible ? 1 : 0,
+            target->surfaceResidency ? 1 : 0, target->surfaceSignalSourceTime,
+            target->held ? 1 : 0, target->selectedSlot, target->addedDlightIndex,
+            R_DarkWolfPCRBE2E07DecisionName(target->finalDecision),
+            target->visibleSurfaces, target->touchedVisibleSurfaces,
+            target->touchedWorldSurfaces, target->touchedBmodelSurfaces,
+            target->actualDlightTouchedSurfaces, rootMismatch ? 1 : 0,
+            volumeCandidate ? 1 : 0,
+            calibrationPossible ? (calibrationMatch ? "MATCH" : "DIFF") : "NA");
+
+        // DARKWOLF_VISIBLE_SURFACE_RESIDENCY_PRODUCTION_CANDIDATE_V1
+        // Direct chain requested by the final functional experiment. The signal
+        // used by selection is previous-frame ground truth; actualDlightTouched
+        // is current-frame stock R_DlightSurface() calibration after addition.
+        {
+            qboolean chainComplete = (!target->productionPointPVS &&
+                target->surfaceInfluenceVisible && target->surfaceResidency &&
+                target->selectedSlot >= 0 && target->addedDlightIndex >= 0 &&
+                target->actualDlightTouchedSurfaces > 0) ? qtrue : qfalse;
+            if (target->problem &&
+                (!target->productionPointPVS || target->surfaceInfluenceVisible || chainComplete))
+            {
+                ri.Printf(PRINT_ALL,
+                    "SPR_VSR01_PROOF map=%s role=%s runtimeId=%d fixture=%d time=%d mode=%s productionPointPVS=%d surfaceInfluenceVisible=%d surfaceSignalSourceTime=%d signalAgeMs=%d surfaceResidency=%d finalDecision=%s selectedSlot=%d addedDlightIndex=%d touchedVisibleSurfaces=%d actualDlightTouched=%d chainComplete=%d\n",
+                    tr.world->baseName, target->role ? target->role : "<none>",
+                    target->runtimeId, target->fixtureOrdinal, target->frameTime,
+                    R_StaticPromoteVisibleSurfaceResidencyEnabled() ? "B_SURFACE_RESIDENCY" : "A_BASELINE",
+                    target->productionPointPVS ? 1 : 0,
+                    target->surfaceInfluenceVisible ? 1 : 0,
+                    target->surfaceSignalSourceTime,
+                    target->surfaceSignalSourceTime >= 0 ? target->frameTime - target->surfaceSignalSourceTime : -1,
+                    target->surfaceResidency ? 1 : 0,
+                    R_DarkWolfPCRBE2E07DecisionName(target->finalDecision),
+                    target->selectedSlot, target->addedDlightIndex,
+                    target->touchedVisibleSurfaces, target->actualDlightTouchedSurfaces,
+                    chainComplete ? 1 : 0);
+            }
+        }
+
+        if (rootMismatch)
+        {
+            ri.Printf(PRINT_ALL,
+                "SPR_E2E07_ROOT_CAUSE map=%s role=%s runtimeId=%d fixture=%d time=%d productionPointPVS=0 runtimeRadius=%.2f sphereVisiblePairs=%d touchedVisibleSurfaces=%d touchedWorld=%d touchedBmodel=%d finalDecision=%s conclusion=%s\\n",
+                tr.world->baseName, target->role ? target->role : "<none>", target->runtimeId,
+                target->fixtureOrdinal, target->frameTime, target->runtimeRadius,
+                target->sphereVisiblePairs, target->touchedVisibleSurfaces,
+                target->touchedWorldSurfaces, target->touchedBmodelSurfaces,
+                R_DarkWolfPCRBE2E07DecisionName(target->finalDecision),
+                target->sphereVisiblePairs > 0 ?
+                    "POINT_PVS_MISSES_VISIBLE_DLIGHT_INFLUENCE_VOLUME_LEAF_CANDIDATE_SUPPORTED" :
+                    "POINT_PVS_MISSES_VISIBLE_DLIGHT_INFLUENCE_VOLUME_LEAF_CANDIDATE_NOT_SUFFICIENT");
+            for (i = 0; i < target->topCount; ++i)
+                R_DarkWolfPCRBE2E07PrintSurfaceDetail(target, &target->top[i], i);
+        }
+    }
+}
