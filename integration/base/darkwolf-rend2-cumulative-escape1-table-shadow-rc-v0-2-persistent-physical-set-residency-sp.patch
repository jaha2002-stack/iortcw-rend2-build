+// REND2_DLIGHT_FALLOFF_V7
+float DynamicLightAttenuation(float radiusSquaredOverDistanceSquared)
+{
+#if r_dlightFalloff == 0
+	// Exact legacy behavior for a trustworthy A/B baseline.
+	float attenuation = 0.5 * radiusSquaredOverDistanceSquared - 0.5;
