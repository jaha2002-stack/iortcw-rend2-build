+	static cvar_t *captureOffsetX = NULL;
+	int offset;
+	VectorCopy(dl->origin, capture);
+	if (!captureOffsetX)
+		captureOffsetX = ri.Cvar_Get("r_dwTeslaWorldCaptureXTest", "0", 0);
+	if (!captureOffsetX || !captureOffsetX->integer || !tr.world ||
+		Q_stricmp(tr.world->baseName, "xlabs") || !dl->worldOcclusion ||
+		dl->fireVolumetricSource || dl->radius < 500.0f ||
+		dl->color[2] < dl->color[1] * 1.35f ||
+		dl->color[1] < dl->color[0] * 1.5f)
+		return;
+	offset = captureOffsetX->integer;
+	if (offset > 96) offset = 96;
+	if (offset < -96) offset = -96;
+	capture[0] += (float)offset;
+}
+
+// Key the cache by the ACTUAL depth-capture origin, never the physical light.
+static qboolean R_DlightWorldCacheMatches(const dlightWorldCache_t *cache,
+	const vec3_t captureOrigin, float radius)
+{
+	return cache->valid && VectorCompare(cache->origin, captureOrigin)
+		&& cache->radius >= radius;
 }
 
