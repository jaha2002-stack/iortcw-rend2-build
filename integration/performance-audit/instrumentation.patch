+void R_ResetDrawSurfStorage(qboolean shutdown) {
+	// Draw commands and the portal's parent view can still reference old buffers
+	// until the frame has been submitted. Keep the largest allocation for reuse.
+	drawSurfBuffer_t *buffer = s_drawSurfBuffer;
+	if (!shutdown && buffer) {
+		buffer = buffer->previous;
+		s_drawSurfBuffer->previous = NULL;
+	} else {
+		s_drawSurfBuffer = NULL;
+	}
+	while (buffer) {
+		drawSurfBuffer_t *previous = buffer->previous;
+		free(buffer);
+		buffer = previous;
+	}
