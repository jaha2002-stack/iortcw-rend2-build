+
+static void R_GrowDrawSurfStorage(int count) {
+	drawSurfBuffer_t *buffer;
+	int capacity;
+	size_t bytes;
+
+	if (count > INT_MAX / 2 ||
+		(size_t)count > (((size_t)-1 - sizeof(*buffer)) / sizeof(drawSurf_t)) / 2) {
+		ri.Error(ERR_DROP, "Draw surface storage limit reached at %d surfaces", count);
+	}
+	capacity = count * 2;
+	bytes = sizeof(*buffer) + (size_t)capacity * sizeof(drawSurf_t);
+	buffer = malloc(bytes);
+	if (!buffer) {
+		ri.Error(ERR_DROP, "Could not allocate storage for %d draw surfaces", capacity);
+	}
+	Com_Memcpy(buffer->surfaces, tr.refdef.drawSurfs, (size_t)count * sizeof(drawSurf_t));
+	buffer->capacity = capacity;
+	buffer->previous = s_drawSurfBuffer;
+	s_drawSurfBuffer = buffer;
+	tr.refdef.drawSurfs = buffer->surfaces;
+	DwPerfDrawStorageGrowth(count, capacity);
+}
