diff --git a/SP/code/rend2/tr_dw_perf.inc b/SP/code/rend2/tr_dw_perf.inc
new file mode 100644
index 0000000..6610b26
--- /dev/null
+++ b/SP/code/rend2/tr_dw_perf.inc
@@ -0,0 +1,271 @@
+/* Diagnostic scopes only. GPU queries are timestamp pairs and are never waited on. */
+#include "../qcommon/dw_perf_io.inc"
+
+#define DW_PERF_PENDING 12
+#define DW_PERF_GPU_SCOPES 192
+
+typedef struct {
+    int kind;
+    qboolean ended;
+} dwGpuPair_t;
+
+typedef struct {
+    GLuint queries[DW_PERF_GPU_SCOPES * 2];
+    dwGpuPair_t pairs[DW_PERF_GPU_SCOPES];
+    unsigned int frame;
+    int stamp, count, overflow;
+    qboolean pending;
+} dwGpuFrame_t;
+
+static const char *const dwPerfNames[] = {
+    "front_fixtures", "front_point_shadow", "front_world_shadow", "front_fire_shadow",
+    "front_csm", "front_view", "draw_world", "draw_sky", "draw_point_shadow",
+    "draw_world_shadow", "draw_fire_shadow", "draw_csm", "draw_other", "copy_shadow",
+    "resolve", "ssao_ssgi", "bloom_extract", "sun_vol", "local_vol", "fire_vol",
+    "tonemap", "bloom_final", "sun_rays", "final_fx", "finish_gl", "present", "flare_readback"
+};
+
+static dwPerfFile_t dwRenderLog, dwGpuLog;
+static PFNGLQUERYCOUNTERPROC dwQueryCounter;
+static PFNGLGETQUERYOBJECTUI64VPROC dwQueryResult;
+static dwGpuFrame_t dwGpuFrames[DW_PERF_PENDING];
+static dwGpuFrame_t *dwGpuCurrent;
+static unsigned int dwRenderFrame;
+static int dwRenderStamp, dwRenderFlush, dwSettingsStamp;
+static uint64_t dwRenderStart;
+static double dwCpuTimes[DW_PERF_COUNT];
+static unsigned int dwCounts[DW_PERF_COUNTERS];
+static float dwCamera[3];
+static int dwSceneLights, dwSceneEntities, dwSceneSurfaces, dwDrawRingPeak, dwDrawRingWraps;
+static qboolean dwRenderActive;
+
+static void DwPerfHeader(dwPerfFile_t *file, const char *prefix)
+{
+    int i;
+    DwPerfWrite(file, "%s", prefix);
+    for (i = 0; i < DW_PERF_COUNT; ++i)
+        DwPerfWrite(file, "\t%s_ms", dwPerfNames[i]);
+    DwPerfWrite(file, "\n");
+    DwPerfFlush(file);
+}
+
+static void DwGpuCollect(dwGpuFrame_t *frame)
+{
+    GLint available = GL_FALSE;
+    double times[DW_PERF_COUNT] = {0};
+    int i;
+    if (!frame->pending)
+        return;
+    if (frame->count && frame->pairs[frame->count - 1].ended)
+        qglGetQueryObjectiv(frame->queries[frame->count * 2 - 1], GL_QUERY_RESULT_AVAILABLE, &available);
+    if (!available)
+        return;
+    for (i = 0; i < frame->count; ++i) {
+        GLuint64 start, end;
+        if (!frame->pairs[i].ended)
+            continue;
+        dwQueryResult(frame->queries[2 * i], GL_QUERY_RESULT, &start);
+        dwQueryResult(frame->queries[2 * i + 1], GL_QUERY_RESULT, &end);
+        if (end >= start)
+            times[frame->pairs[i].kind] += (double)(end - start) * 0.000001;
+    }
+    DwPerfWrite(&dwGpuLog, "frame\t%u\t%d\t%d\t%d", frame->frame, frame->stamp, frame->count, frame->overflow);
+    for (i = 0; i < DW_PERF_COUNT; ++i)
+        DwPerfWrite(&dwGpuLog, "\t%.3f", times[i]);
+    DwPerfWrite(&dwGpuLog, "\n");
+    frame->pending = qfalse;
+}
+
+static void DwRenderSettings(void)
+{
+    static const char *const names[] = {
+        "com_maxfps", "r_swapInterval", "r_finish", "r_flares", "r_hdr", "r_postProcess",
+        "r_ext_framebuffer_multisample", "r_msaaSelectiveSampleShading", "r_depthPrepass",
+        "r_ssao", "r_ssgi", "r_bloomMode", "r_volumetricSun", "r_volumetricSunMode",
+        "r_volumetricSunSamples", "r_volumetricLocal", "r_volumetricLocalMode",
+        "r_volumetricLocalSamples", "r_volumetricLocalLampMaxActive", "r_volumetricFire",
+        "r_volumetricFireMode", "r_volumetricFireMaxActive", "r_dlightMode",
+        "r_dlightShadowMaxLights", "r_dlightShadowMapSize", "r_shadowCascadeZFar",
+        "r_cubeMapping", "r_parallaxMapping", "r_pbr", "r_drawSunRays"
+    };
+    unsigned int i;
+    DwPerfWrite(&dwRenderLog, "settings\t%u\t%d\t", dwRenderFrame, dwRenderStamp);
+    for (i = 0; i < ARRAY_LEN(names); ++i)
+        DwPerfWrite(&dwRenderLog, "%s=%d%s", names[i], ri.Cvar_VariableIntegerValue(names[i]),
+            i + 1 < ARRAY_LEN(names) ? ";" : "\n");
+}
+
+void DwPerfRenderInit(void)
+{
+    const char *directory = SDL_getenv("DARKWOLF_PERF_DIR");
+    int i;
+    if (!directory || !*directory)
+        return;
+    DwPerfOpen(&dwRenderLog, directory, "render.tsv");
+    if (!dwRenderLog.stream)
+        return;
+    DwPerfHeader(&dwRenderLog, "kind\tframe\tclock_ms\tmap\tx\ty\tz\tlights\tentities\tsurfaces\t"
+        "point_views\tworld_shadow_views\tfire_shadow_views\tcsm_views\tflare_reads\t"
+        "local_passes\tfire_passes\tcommand_drops\tsurface_ring_peak\tsurface_ring_wraps\tquery_status\tcpu_elapsed_ms");
+    DwPerfWrite(&dwRenderLog, "device\t%d\t%d\t%d\t%s\t%s\t%s\n", ri.Milliseconds(), glConfig.vidWidth,
+        glConfig.vidHeight, glConfig.vendor_string, glConfig.renderer_string, glConfig.version_string);
+    dwSettingsStamp = -5000;
+    if (!qglGenQueries || !qglGetQueryObjectiv ||
+        !(QGL_VERSION_ATLEAST(3, 3) || SDL_GL_ExtensionSupported("GL_ARB_timer_query")))
+        return;
+    dwQueryCounter = (PFNGLQUERYCOUNTERPROC)SDL_GL_GetProcAddress("glQueryCounter");
+    dwQueryResult = (PFNGLGETQUERYOBJECTUI64VPROC)SDL_GL_GetProcAddress("glGetQueryObjectui64v");
+    if (!dwQueryCounter || !dwQueryResult) {
+        dwQueryCounter = NULL;
+        return;
+    }
+    DwPerfOpen(&dwGpuLog, directory, "gpu.tsv");
+    if (!dwGpuLog.stream) {
+        dwQueryCounter = NULL;
+        return;
+    }
+    DwPerfHeader(&dwGpuLog, "kind\tframe\tclock_ms\tpairs\toverflow");
+    for (i = 0; i < DW_PERF_PENDING; ++i)
+        qglGenQueries(ARRAY_LEN(dwGpuFrames[i].queries), dwGpuFrames[i].queries);
+}
+
+void DwPerfRenderShutdown(void)
+{
+    int i;
+    if (dwQueryCounter) {
+        for (i = 0; i < DW_PERF_PENDING; ++i) {
+            DwGpuCollect(&dwGpuFrames[i]);
+            qglDeleteQueries(ARRAY_LEN(dwGpuFrames[i].queries), dwGpuFrames[i].queries);
+        }
+    }
+    memset(dwGpuFrames, 0, sizeof(dwGpuFrames));
+    dwQueryCounter = NULL;
+    dwGpuCurrent = NULL;
+    dwRenderActive = qfalse;
+    DwPerfClose(&dwGpuLog);
+    DwPerfClose(&dwRenderLog);
+}
+
+void DwPerfRenderBegin(void)
+{
+    int i;
+    if (!dwRenderLog.stream || dwRenderActive)
+        return;
+    dwRenderFrame++;
+    dwRenderStamp = ri.Milliseconds();
+    dwRenderStart = SDL_GetPerformanceCounter();
+    dwRenderActive = qtrue;
+    memset(dwCpuTimes, 0, sizeof(dwCpuTimes));
+    memset(dwCounts, 0, sizeof(dwCounts));
+    memset(dwCamera, 0, sizeof(dwCamera));
+    dwSceneLights = dwSceneEntities = dwSceneSurfaces = dwDrawRingPeak = dwDrawRingWraps = 0;
+    if (!dwQueryCounter)
+        return;
+    for (i = 0; i < DW_PERF_PENDING; ++i) {
+        if (dwRenderFrame - dwGpuFrames[i].frame >= 3)
+            DwGpuCollect(&dwGpuFrames[i]);
+    }
+    dwGpuCurrent = &dwGpuFrames[dwRenderFrame % DW_PERF_PENDING];
+    if (dwGpuCurrent->pending) {
+        dwGpuCurrent = NULL;
+        return;
+    }
+    dwGpuCurrent->frame = dwRenderFrame;
+    dwGpuCurrent->stamp = dwRenderStamp;
+    dwGpuCurrent->count = dwGpuCurrent->overflow = 0;
+}
+
+void DwPerfScene(void)
+{
+    if (!dwRenderActive)
+        return;
+    VectorCopy(tr.refdef.vieworg, dwCamera);
+    dwSceneLights = tr.refdef.num_dlights;
+    dwSceneEntities = tr.refdef.num_entities;
+}
+
+void DwPerfDrawRing(int total, int viewSurfaces)
+{
+    if (!dwRenderActive)
+        return;
+    dwDrawRingPeak = MAX(dwDrawRingPeak, total);
+    if (total > MAX_DRAWSURFS) {
+        dwDrawRingWraps++;
+        if (dwDrawRingWraps == 1) {
+            DwPerfWrite(&dwRenderLog, "surface_ring_overflow\t%u\t%d\t%s\t%d\t%d\t%d\t0x%x\n",
+                dwRenderFrame, ri.Milliseconds(), tr.world ? tr.world->baseName : "-", total, MAX_DRAWSURFS,
+                viewSurfaces, (unsigned int)tr.viewParms.flags);
+            DwPerfFlush(&dwRenderLog);
+        }
+    }
+}
+
+void DwPerfRenderEnd(void)
+{
+    int now, i;
+    if (!dwRenderActive)
+        return;
+    DwPerfWrite(&dwRenderLog, "frame\t%u\t%d\t%s\t%.1f\t%.1f\t%.1f\t%d\t%d\t%d\t"
+        "%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\t%d\t%d\t%s\t%.3f",
+        dwRenderFrame, dwRenderStamp, tr.world ? tr.world->baseName : "-", dwCamera[0], dwCamera[1], dwCamera[2],
+        dwSceneLights, dwSceneEntities, dwSceneSurfaces, dwCounts[DW_PERF_DRAW_POINT],
+        dwCounts[DW_PERF_DRAW_OCCLUSION], dwCounts[DW_PERF_DRAW_FIRE], dwCounts[DW_PERF_DRAW_CSM],
+        dwCounts[DW_PERF_FLARE_READ], dwCounts[DW_PERF_LOCAL_PASS], dwCounts[DW_PERF_FIRE_PASS],
+        dwCounts[DW_PERF_DROP], dwDrawRingPeak, dwDrawRingWraps, dwGpuCurrent ? "submitted" : dwQueryCounter ? "queue_full" : "unavailable",
+        DwPerfMilliseconds(dwRenderStart, SDL_GetPerformanceCounter()));
+    for (i = 0; i < DW_PERF_COUNT; ++i)
+        DwPerfWrite(&dwRenderLog, "\t%.3f", dwCpuTimes[i]);
+    DwPerfWrite(&dwRenderLog, "\n");
+    if (dwGpuCurrent)
+        dwGpuCurrent->pending = dwGpuCurrent->count > 0;
+    dwGpuCurrent = NULL;
+    dwRenderActive = qfalse;
+
+    now = ri.Milliseconds();
+    if (now - dwSettingsStamp >= 5000) {
+        DwRenderSettings();
+        dwSettingsStamp = now;
+    }
+    if (now - dwRenderFlush >= 500 || now - dwRenderStamp > 75) {
+        DwPerfFlush(&dwRenderLog);
+        DwPerfFlush(&dwGpuLog);
+        dwRenderFlush = now;
+    }
+}
+
+dwPerfScope_t DwPerfBegin(dwPerfStage_t kind, qboolean gpu)
+{
+    dwPerfScope_t scope = {0, kind, -1};
+    if (!dwRenderActive)
+        return scope;
+    scope.cpu = SDL_GetPerformanceCounter();
+    if (gpu && dwGpuCurrent) {
+        if (dwGpuCurrent->count < DW_PERF_GPU_SCOPES) {
+            scope.query = dwGpuCurrent->count++;
+            dwGpuCurrent->pairs[scope.query].kind = kind;
+            dwGpuCurrent->pairs[scope.query].ended = qfalse;
+            dwQueryCounter(dwGpuCurrent->queries[scope.query * 2], GL_TIMESTAMP);
+        } else {
+            dwGpuCurrent->overflow++;
+        }
+    }
+    return scope;
+}
+
+void DwPerfEnd(dwPerfScope_t scope)
+{
+    if (!scope.cpu)
+        return;
+    if (scope.query >= 0 && dwGpuCurrent) {
+        dwQueryCounter(dwGpuCurrent->queries[scope.query * 2 + 1], GL_TIMESTAMP);
+        dwGpuCurrent->pairs[scope.query].ended = qtrue;
+    }
+    dwCpuTimes[scope.kind] += DwPerfMilliseconds(scope.cpu, SDL_GetPerformanceCounter());
+    dwCounts[scope.kind]++;
+}
+
+void DwPerfCount(dwPerfStage_t kind)
+{
+    if (dwRenderActive)
+        dwCounts[kind]++;
+}
