diff --git a/SP/code/qcommon/dw_perf_io.inc b/SP/code/qcommon/dw_perf_io.inc
new file mode 100644
index 0000000..eba1a78
--- /dev/null
+++ b/SP/code/qcommon/dw_perf_io.inc
@@ -0,0 +1,82 @@
+/* Shared implementation for the standalone diagnostic EXE and Rend2 DLL. */
+#ifdef USE_LOCAL_HEADERS
+#include "SDL.h"
+#else
+#include <SDL.h>
+#endif
+
+typedef struct {
+    SDL_RWops *stream;
+    unsigned int bytes;
+    unsigned int used;
+    char pending[8192];
+} dwPerfFile_t;
+
+static void DwPerfFlush(dwPerfFile_t *file)
+{
+    if (!file->stream || !file->used)
+        return;
+    if (SDL_RWwrite(file->stream, file->pending, 1, file->used) != file->used) {
+        SDL_RWclose(file->stream);
+        file->stream = NULL;
+    }
+#ifdef HAVE_STDIO_H
+    else if (file->stream->type == SDL_RWOPS_STDFILE) {
+        fflush(file->stream->hidden.stdio.fp);
+    }
+#endif
+    file->used = 0;
+}
+
+static void DwPerfClose(dwPerfFile_t *file)
+{
+    DwPerfFlush(file);
+    if (file->stream) {
+        SDL_RWclose(file->stream);
+        file->stream = NULL;
+    }
+}
+
+static void DwPerfOpen(dwPerfFile_t *file, const char *directory, const char *name)
+{
+    char path[2048];
+    int length;
+    if (!directory || !*directory)
+        return;
+    length = snprintf(path, sizeof(path), "%s/%s", directory, name);
+    if (length <= 0 || length >= sizeof(path))
+        return;
+    file->stream = SDL_RWFromFile(path, "ab");
+}
+
+static void DwPerfWrite(dwPerfFile_t *file, const char *format, ...) __attribute__((format(printf, 2, 3)));
+
+static void DwPerfWrite(dwPerfFile_t *file, const char *format, ...)
+{
+    char text[3072];
+    va_list args;
+    int length;
+    if (!file->stream)
+        return;
+    va_start(args, format);
+    length = vsnprintf(text, sizeof(text), format, args);
+    va_end(args);
+    if (length <= 0 || length >= sizeof(text))
+        return;
+    if (file->bytes >= 64U * 1024U * 1024U) {
+        DwPerfClose(file);
+        return;
+    }
+    if (file->used + length > sizeof(file->pending))
+        DwPerfFlush(file);
+    if (!file->stream)
+        return;
+    memcpy(file->pending + file->used, text, length);
+    file->used += length;
+    file->bytes += length;
+}
+
+static double DwPerfMilliseconds(uint64_t a, uint64_t b)
+{
+    return (double)(b - a) * 1000.0 / (double)SDL_GetPerformanceFrequency();
+}
diff --git a/SP/code/qcommon/dw_perf_main.inc b/SP/code/qcommon/dw_perf_main.inc
new file mode 100644
index 0000000..440788e
--- /dev/null
+++ b/SP/code/qcommon/dw_perf_main.inc
@@ -0,0 +1,161 @@
+#ifndef DEDICATED
+#include "dw_perf_io.inc"
+
+typedef enum {
+    DW_MAIN_IDLE, DW_MAIN_CONFIG, DW_MAIN_WAIT, DW_MAIN_INPUT, DW_MAIN_SERVER,
+    DW_MAIN_EVENTS, DW_MAIN_CLIENT, DW_MAIN_TAIL, DW_MAIN_COUNT
+} dwMainStage_t;
+static dwPerfFile_t dwMainLog;
+static uint64_t dwMainStart, dwMainStep;
+static int dwMainStamp, dwMainFlush;
+static double dwMainTimes[DW_MAIN_COUNT];
+static volatile int dwMainStage;
+
+#ifdef _WIN32
+/* First-chance fault breadcrumb. Continue normal OS/engine exception processing. */
+static HANDLE dwFaultFile = INVALID_HANDLE_VALUE;
+static PVOID dwFaultHandler;
+static volatile LONG dwFaultCount;
+
+static LONG CALLBACK DwPerfFault(EXCEPTION_POINTERS *exception)
+{
+    struct {
+        DWORD code, phase, tick, pid, tid;
+        uintptr_t address, imageBase, detail, accessAddress;
+    } record;
+    MEMORY_BASIC_INFORMATION image;
+    EXCEPTION_RECORD *source = exception->ExceptionRecord;
+    DWORD bytes;
+    byte raw[5 * sizeof(DWORD) + 4 * sizeof(uintptr_t)];
+    switch (source->ExceptionCode) {
+    case EXCEPTION_ACCESS_VIOLATION:
+    case EXCEPTION_STACK_OVERFLOW:
+    case EXCEPTION_ILLEGAL_INSTRUCTION:
+    case EXCEPTION_IN_PAGE_ERROR:
+    case EXCEPTION_INT_DIVIDE_BY_ZERO:
+    case 0xc0000374u: /* heap corruption */
+    case 0xc0000409u: /* fast-fail class, if vectored dispatch occurs */
+        break;
+    default:
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    if (InterlockedIncrement(&dwFaultCount) > 32)
+        return EXCEPTION_CONTINUE_SEARCH;
+    record.code = source->ExceptionCode;
+    record.phase = dwMainStage;
+    record.tick = GetTickCount();
+    record.pid = GetCurrentProcessId();
+    record.tid = GetCurrentThreadId();
+    record.address = (uintptr_t)source->ExceptionAddress;
+    record.imageBase = VirtualQuery(source->ExceptionAddress, &image, sizeof(image)) ?
+        (uintptr_t)image.AllocationBase : 0;
+    record.detail = source->NumberParameters > 0 ? source->ExceptionInformation[0] : 0;
+    record.accessAddress = source->NumberParameters > 1 ? source->ExceptionInformation[1] : 0;
+    /* Write fields separately to avoid recording uninitialized struct padding. */
+    memcpy(raw, &record, 5 * sizeof(DWORD));
+    memcpy(raw + 5 * sizeof(DWORD), &record.address, 4 * sizeof(uintptr_t));
+    WriteFile(dwFaultFile, raw, sizeof(raw), &bytes, NULL);
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static void DwPerfOpenFaultFile(void)
+{
+    WCHAR path[2048];
+    DWORD length = GetEnvironmentVariableW(L"DARKWOLF_PERF_DIR", path, ARRAY_LEN(path));
+    static const WCHAR filename[] = L"\\faults.bin";
+    if (length == 0 || length >= ARRAY_LEN(path) - ARRAY_LEN(filename))
+        return;
+    memcpy(path + length, filename, sizeof(filename));
+    dwFaultFile = CreateFileW(path, FILE_APPEND_DATA, FILE_SHARE_READ, NULL, OPEN_ALWAYS,
+        FILE_ATTRIBUTE_NORMAL | FILE_FLAG_WRITE_THROUGH, NULL);
+    if (dwFaultFile != INVALID_HANDLE_VALUE)
+        dwFaultHandler = AddVectoredExceptionHandler(1, DwPerfFault);
+}
+#endif
+
+static void DwMainInit(void)
+{
+    const char *directory = SDL_getenv("DARKWOLF_PERF_DIR");
+    DwPerfOpen(&dwMainLog, directory, "engine.tsv");
+    if (!dwMainLog.stream)
+        return;
+    DwPerfWrite(&dwMainLog,
+        "kind\tframe\tclock_ms\ttotal_ms\tconfig_ms\tlimiter_ms\tinput_commands_ms\tserver_ms\t"
+        "events_ms\tclient_ms\ttail_ms\trequested_frame_ms\thunk_left_bytes\n");
+#ifdef _WIN32
+    DwPerfWrite(&dwMainLog, "clock_sync\t%lu\t%d\n", (unsigned long)GetTickCount(), Sys_Milliseconds());
+    DwPerfOpenFaultFile();
+#endif
+    DwPerfFlush(&dwMainLog);
+}
+
+static void DwMainBegin(void)
+{
+    if (!dwMainLog.stream)
+        return;
+    memset(dwMainTimes, 0, sizeof(dwMainTimes));
+    dwMainStart = dwMainStep = SDL_GetPerformanceCounter();
+    dwMainStamp = Sys_Milliseconds();
+    dwMainStage = DW_MAIN_CONFIG;
+}
+
+static void DwMainMark(dwMainStage_t next)
+{
+    uint64_t now;
+    if (!dwMainLog.stream)
+        return;
+    now = SDL_GetPerformanceCounter();
+    dwMainTimes[dwMainStage] += DwPerfMilliseconds(dwMainStep, now);
+    dwMainStep = now;
+    dwMainStage = next;
+}
+
+static void DwMainEnd(int target)
+{
+    int now;
+    if (!dwMainLog.stream)
+        return;
+    DwMainMark(DW_MAIN_IDLE);
+    now = Sys_Milliseconds();
+    DwPerfWrite(&dwMainLog, "frame\t%d\t%d\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\t%.3f\t%d\t%d\n",
+        com_frameNumber, dwMainStamp, DwPerfMilliseconds(dwMainStart, dwMainStep),
+        dwMainTimes[DW_MAIN_CONFIG], dwMainTimes[DW_MAIN_WAIT], dwMainTimes[DW_MAIN_INPUT],
+        dwMainTimes[DW_MAIN_SERVER], dwMainTimes[DW_MAIN_EVENTS], dwMainTimes[DW_MAIN_CLIENT],
+        dwMainTimes[DW_MAIN_TAIL], target, Hunk_MemoryRemaining());
+    if (now - dwMainFlush >= 500 || now - dwMainStamp > 75) {
+        DwPerfFlush(&dwMainLog);
+        dwMainFlush = now;
+    }
+}
+
+static void DwMainError(int code, const char *message)
+{
+    char safe[512];
+    int i;
+    if (!dwMainLog.stream)
+        return;
+    Q_strncpyz(safe, message, sizeof(safe));
+    for (i = 0; safe[i]; i++)
+        if (safe[i] == '\r' || safe[i] == '\n' || safe[i] == '\t') safe[i] = ' ';
+    DwPerfWrite(&dwMainLog, "error\t%d\t%d\t%d\t%d\t%s\n",
+        com_frameNumber, Sys_Milliseconds(), code, dwMainStage, safe);
+    DwPerfFlush(&dwMainLog);
+}
+
+static void DwMainShutdown(void)
+{
+    DwPerfWrite(&dwMainLog, "shutdown\t%d\t%d\n", com_frameNumber, Sys_Milliseconds());
+    DwPerfClose(&dwMainLog);
+#ifdef _WIN32
+    if (dwFaultHandler) RemoveVectoredExceptionHandler(dwFaultHandler);
+    if (dwFaultFile != INVALID_HANDLE_VALUE) CloseHandle(dwFaultFile);
+#endif
+}
+#else
+#define DwMainInit() ((void)0)
+#define DwMainBegin() ((void)0)
+#define DwMainMark(stage) ((void)0)
+#define DwMainEnd(target) ((void)0)
+#define DwMainError(code, message) ((void)0)
+#define DwMainShutdown() ((void)0)
+#endif
