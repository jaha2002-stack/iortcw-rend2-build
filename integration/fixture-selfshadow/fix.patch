+/* Ignore visual-only flame/decal layers in the body pick. Retain both
+ * solid blockers and supported cutout casters so validation cannot bind
+ * an unrelated fixture behind intervening architecture. */
+static int R_IFLC_PickBodySurface(float *distance)
+{
+    float nearest = 512.0f;
+    int i, selected = -1;
+
+    for (i = 0; i < tr.world->numWorldSurfaces; ++i) {
+        const msurface_t *surface = &tr.world->surfaces[i];
+        float hit;
+        if (!R_IFLC_SurfaceBlocks(surface) &&
+            !R_DarkWolfSupportedShadowCasterMaterial(surface->shader))
+            continue;
+        if (R_IFLC_RaySurface(surface, s_iflcViewOrigin, s_iflcViewForward, nearest, &hit)) {
+            nearest = hit;
+            selected = i;
+        }
+    }
+    if (selected >= 0)
+        *distance = nearest;
+    return selected;
+}
