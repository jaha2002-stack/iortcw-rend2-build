+/* Inherit only explicit ELSS settings from an already resolved physical
+ * owner. Leave ElectricOwner assignment and the legacy AUTO classifier alone. */
+static qboolean R_ElectricCapturePolicy(const dlight_t *dl, int *fixture)
+{
+    int i;
+    if (R_ELSS_ElectricPolicy(dl, fixture))
+        return qtrue;
+    if (dl->staticPromoteFixtureId < 0 || dl->physicalElectricOwnerId <= 0 ||
+        dl->staticPromoteFixtureId == dl->physicalElectricOwnerId ||
+        dl->shadowSourceClass != DWSHADOW_SOURCE_PERSISTENT_PHYSICAL ||
+        dl->noDlightShadow || dl->iflcOptIn || dl->fireVolumetricSource || dl->transientBlast)
+        return qfalse;
+
+    for (i = 0; i < tr.refdef.num_dlights && i < MAX_DLIGHTS; ++i) {
+        const dlight_t *owner = &tr.refdef.dlights[i];
+        if (owner->staticPromoteFixtureId == dl->physicalElectricOwnerId &&
+            owner->physicalElectricOwnerId == dl->physicalElectricOwnerId)
+            return R_ELSS_ElectricPolicy(owner, fixture);
+    }
+    return qfalse;
+}
