+// DARKWOLF_SSGI_FIRE_EMISSIVE_DONOR_ISOLATION_V2
+// Fire is alpha-composited into the color FBO but has no corresponding opaque
+// depth at its screen UV. It must not become a world-space bounce donor.
+// The blue-deficit and hotspot gates deliberately preserve ordinary warm stone,
+// daylight, non-emissive diffuse GI and all modes 0..3.
+float SsgiFireEmissionLikelihood(const vec3 c, const float centerLuma)
+{
+    float l = SsgiLuma(c);
+    float warmR = smoothstep(0.08, 0.25, c.r - c.b);
+    float warmG = smoothstep(0.025, 0.09, c.g - c.b);
+    float blueRatio = c.b / max(c.g, 0.0001);
+    float lowBlue = 1.0 - smoothstep(0.24, 0.48, blueRatio);
+    float energy = smoothstep(0.12, 0.37, l);
+    float peak = smoothstep(0.28, 0.62, max(c.r, c.g));
+    float contrast = smoothstep(0.035, 0.16, l - centerLuma);
+    return clamp(warmR * warmG * lowBlue * energy * peak * contrast, 0.0, 1.0);
+}
