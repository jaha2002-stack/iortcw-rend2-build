<Window x:Class="DarkWolfPBRStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DarkWolf PBR Studio V1 — ioRTCW Rend2 r_pbr 3"
        Width="1480" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="OpenPk3Button" Content="Open PK3…" Click="OpenPk3Button_Click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="Pk3PathText" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="No PK3 loaded"/>
                <TextBlock x:Name="MaterialStatusText" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" Text="Material: —"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Row="0" TextChanged="SearchBox_TextChanged" ToolTip="Filter texture paths" />
                    <ListBox x:Name="TextureList" Grid.Row="1" Margin="4" SelectionChanged="TextureList_SelectionChanged"
                             Background="#111318" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EntryPath}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="145"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="A — Original" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="OriginalImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="B — Selected / AI Variant" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="CurrentImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Normal (_n.tga)" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="NormalImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="ORM (R=AO, G=Roughness, B=Metallic)" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="OrmImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="2" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Variants" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="◀ Previous" Click="PreviousVariant_Click"/>
                                <Button Content="Next ▶" Click="NextVariant_Click"/>
                                <Button Content="Set as AI source" Click="SetAiSource_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="VariantList" Grid.Row="1" Margin="0,5,0,0" SelectionChanged="VariantList_SelectionChanged"
                                 Background="#111318" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#505967" BorderThickness="1" CornerRadius="4" Margin="3" Padding="7" MinWidth="125">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="AI Restoration" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <TextBlock Text="Local Real-ESRGAN ×4 (Vulkan). Preserves the original texture before PBR generation."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="5,0,5,5"/>
                        <Button x:Name="RestoreButton" Content="AI Restore ×4" Click="RestoreButton_Click"/>

                        <Separator Margin="4,10"/>

                        <TextBlock Text="AI Variations / Next" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <TextBlock Text="Local stable-diffusion.cpp img2img. Each Next uses a new seed; all variants stay in history."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="5,0,5,5"/>
                        <TextBlock Text="Prompt" Margin="5,4,5,0"/>
                        <TextBox x:Name="PromptBox" TextWrapping="Wrap" AcceptsReturn="True" Height="72"
                                 Text="restore authentic old stone texture, preserve original layout and color, physically plausible material detail, seamless game texture"/>
                        <DockPanel Margin="4">
                            <TextBlock Text="Strength" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AiStrengthText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="AiStrengthSlider" Minimum="0.10" Maximum="0.60" Value="0.28" TickFrequency="0.02"
                                IsSnapToTickEnabled="True" ValueChanged="AiStrengthSlider_ValueChanged" Margin="8,0"/>

                        <Grid Margin="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SdCliPathBox" ToolTip="Path to sd-cli.exe"/>
                            <Button Grid.Column="1" Content="sd-cli…" Click="BrowseSdCli_Click"/>
                        </Grid>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SdModelPathBox" ToolTip="Path to .safetensors/.gguf model"/>
                            <Button Grid.Column="1" Content="Model…" Click="BrowseSdModel_Click"/>
                        </Grid>
                        <TextBox x:Name="SdExtraArgsBox" ToolTip="Optional stable-diffusion.cpp extra arguments"
                                 Text="" />
                        <Button x:Name="AiNextButton" Content="AI Next — Generate new variant" Click="AiNextButton_Click"/>

                        <Separator Margin="4,10"/>

                        <TextBlock Text="PBR for r_pbr 3" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <DockPanel Margin="4">
                            <TextBlock Text="Normal strength" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NormalStrengthText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="NormalStrengthSlider" Minimum="2" Maximum="40" Value="20" TickFrequency="1"
                                ValueChanged="NormalStrengthSlider_ValueChanged" Margin="8,0"/>

                        <DockPanel Margin="4">
                            <TextBlock Text="Roughness min" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoughnessMinText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="RoughnessMinSlider" Minimum="0.20" Maximum="0.80" Value="0.46" TickFrequency="0.02"
                                ValueChanged="RoughnessSlider_ValueChanged" Margin="8,0"/>

                        <DockPanel Margin="4">
                            <TextBlock Text="Roughness max" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoughnessMaxText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="RoughnessMaxSlider" Minimum="0.50" Maximum="1.00" Value="0.92" TickFrequency="0.02"
                                ValueChanged="RoughnessSlider_ValueChanged" Margin="8,0"/>

                        <Button Content="Generate Normal + ORM" Click="GeneratePbrButton_Click"/>

                        <Separator Margin="4,10"/>

                        <TextBlock Text="Export override PK3" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <CheckBox x:Name="IncludeBaseColorCheck" Content="Include selected BaseColor variant" IsChecked="True" Margin="7,4"/>
                        <CheckBox x:Name="ExplicitMtrCheck" Content="Write explicit BSP PBR .mtr (for implicit textures)" IsChecked="True" Margin="7,4"/>
                        <TextBlock x:Name="CompatibilityHintText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="7,2,7,5"/>
                        <Button Content="Export PBR PK3…" Click="ExportButton_Click"/>

                        <Border Background="#111318" CornerRadius="5" Padding="8" Margin="4,12,4,4">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                                V1 target: ioRTCW Rend2 DarkWolf r_pbr 3, especially BSP/lightmapped world textures.
                                Original PK3 is read-only; export always creates a new override PK3.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="7" Margin="0,8,0,0">
            <DockPanel>
                <ProgressBar x:Name="BusyProgress" Width="160" Height="12" IsIndeterminate="True" Visibility="Collapsed" DockPanel.Dock="Right"/>
                <TextBlock x:Name="StatusText" Text="Ready."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
