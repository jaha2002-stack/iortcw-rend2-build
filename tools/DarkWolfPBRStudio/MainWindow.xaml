<Window x:Class="DarkWolfPBRStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DarkWolf PBR Studio V2.05.2 — Safe Material Export — ioRTCW Rend2 r_pbr 3"
        Width="1580" Height="960" MinWidth="1260" MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="OpenPk3Button" Content="Open PK3…" Click="OpenPk3Button_Click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="Pk3PathText" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="No PK3 loaded"/>
                <TextBlock x:Name="MaterialStatusText" Margin="12,0" VerticalAlignment="Center" DockPanel.Dock="Right" Text="Material: —"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Row="0" TextChanged="SearchBox_TextChanged" ToolTip="Filter texture paths"/>
                    <DockPanel Grid.Row="1" Margin="4,4,4,0">
                        <TextBlock x:Name="SelectedTextureCountText" Text="Selected: 0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <Button DockPanel.Dock="Right" Content="Generate selected batch" Click="GenerateBatchButton_Click"/>
                    </DockPanel>
                    <ListBox x:Name="TextureList" Grid.Row="2" Margin="4" SelectionChanged="TextureList_SelectionChanged"
                             SelectionMode="Extended"
                             Background="#111318" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EntryPath}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Row="3" Margin="4,6,4,0">
                        <TextBlock Text="Batch review" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Remove" Click="RemoveBatchButton_Click"/>
                            <Button Content="Clear" Click="ClearBatchButton_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="BatchList" Grid.Row="4" Margin="4" SelectionChanged="BatchList_SelectionChanged"
                             Background="#111318" Foreground="{StaticResource TextBrush}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#454B56" BorderThickness="0,0,0,1" Padding="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MaterialMode}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="{Binding MaterialKind}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="A — Original" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="OriginalImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="B — Selected / AI Variant" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="CurrentImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Height" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="HeightImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Normal (_n / _nh RGB)" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="NormalImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="ORM — AO / Roughness / Metallic" Margin="4" Foreground="{StaticResource TextBrush}">
                            <Border Background="#090A0C">
                                <Image x:Name="OrmImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="2" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Variants" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="◀ Previous" Click="PreviousVariant_Click"/>
                                <Button Content="Next ▶" Click="NextVariant_Click"/>
                                <Button Content="Set as AI source" Click="SetAiSource_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="VariantList" Grid.Row="1" Margin="0,5,0,0" SelectionChanged="VariantList_SelectionChanged"
                                 Background="#111318" Foreground="{StaticResource TextBrush}" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#505967" BorderThickness="1" CornerRadius="4" Margin="3" Padding="7" MinWidth="125">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="AI Restoration" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <TextBlock Text="Local Real-ESRGAN ×4. Restore the original first when more source detail is needed."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="5,0,5,5"/>
                        <Button x:Name="RestoreButton" Content="AI Restore ×4" Click="RestoreButton_Click"/>

                        <Separator Margin="4,10"/>

                        <TextBlock Text="AI Variations / Next" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <TextBlock Text="Local stable-diffusion.cpp img2img. Next = new seed; all candidates remain available."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="5,0,5,5"/>
                        <TextBlock Text="Prompt" Margin="5,4,5,0"/>
                        <TextBox x:Name="PromptBox" TextWrapping="Wrap" AcceptsReturn="True" Height="68"/>
                        <DockPanel Margin="4">
                            <TextBlock Text="Strength" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AiStrengthText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="AiStrengthSlider" Minimum="0.10" Maximum="0.60" Value="0.28" TickFrequency="0.02"
                                IsSnapToTickEnabled="True" ValueChanged="PbrSlider_ValueChanged" Margin="8,0"/>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SdCliPathBox" ToolTip="Path to sd-cli.exe"/>
                            <Button Grid.Column="1" Content="sd-cli…" Click="BrowseSdCli_Click"/>
                        </Grid>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SdModelPathBox" ToolTip="Path to local .safetensors/.gguf/.ckpt model"/>
                            <Button Grid.Column="1" Content="Model…" Click="BrowseSdModel_Click"/>
                        </Grid>
                        <TextBox x:Name="SdExtraArgsBox" ToolTip="Optional stable-diffusion.cpp extra arguments"/>
                        <Button x:Name="AiNextButton" Content="AI Next — Generate new variant" Click="AiNextButton_Click"/>

                        <Separator Margin="4,10"/>

                        <TextBlock Text="PBR3 Material Decomposition V2.05.2" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <TextBlock Text="Generation mode" Margin="5,4,5,0"/>
                        <ComboBox x:Name="GenerationModeCombo" Margin="4" SelectionChanged="GenerationModeCombo_SelectionChanged"/>
                        <TextBlock x:Name="GenerationModeHintText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="7,0,7,7"/>

                        <DockPanel Margin="4">
                            <TextBlock Text="Macro relief boost" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MacroReliefBoostText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="MacroReliefBoostSlider" Minimum="0.0" Maximum="1.25" Value="0.75" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="PbrSlider_ValueChanged" Margin="8,0"/>

                        <Grid Margin="4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="MaterialProfileCombo" SelectionChanged="MaterialProfileCombo_SelectionChanged"/>
                            <Button Grid.Column="1" Content="Analyze" Click="AnalyzeMaterialButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="MaterialAnalysisText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="7,2,7,7"/>

                        <DockPanel Margin="4">
                            <TextBlock Text="Normal strength" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NormalStrengthText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="NormalStrengthSlider" Minimum="2" Maximum="45" Value="14" TickFrequency="1"
                                ValueChanged="PbrSlider_ValueChanged" Margin="8,0"/>

                        <DockPanel Margin="4">
                            <TextBlock Text="Height contrast" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeightContrastText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="HeightContrastSlider" Minimum="0.30" Maximum="1.60" Value="0.72" TickFrequency="0.05"
                                ValueChanged="PbrSlider_ValueChanged" Margin="8,0"/>

                        <DockPanel Margin="4">
                            <TextBlock Text="Roughness min / max" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoughnessText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,0">
                            <Slider x:Name="RoughnessMinSlider" Width="170" Minimum="0.05" Maximum="0.90" Value="0.48" TickFrequency="0.02"
                                    ValueChanged="PbrSlider_ValueChanged"/>
                            <Slider x:Name="RoughnessMaxSlider" Width="170" Minimum="0.20" Maximum="1.00" Value="0.94" TickFrequency="0.02"
                                    ValueChanged="PbrSlider_ValueChanged"/>
                        </StackPanel>

                        <DockPanel Margin="4">
                            <TextBlock Text="Metallic" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MetallicText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="MetallicSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                                ValueChanged="PbrSlider_ValueChanged" Margin="8,0"/>

                        <CheckBox x:Name="ParallaxCheck" Content="Generate _nh and enable normalParallaxMap" Margin="7,6"
                                  Checked="ParallaxCheck_Changed" Unchecked="ParallaxCheck_Changed"/>
                        <DockPanel Margin="4">
                            <TextBlock Text="Parallax depth" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ParallaxDepthText" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="ParallaxDepthSlider" Minimum="0.002" Maximum="0.060" Value="0.010" TickFrequency="0.002"
                                ValueChanged="PbrSlider_ValueChanged" Margin="8,0"/>

                        <Button Content="Generate PBR3 Material — Height + Normal + ORM" Click="GeneratePbrButton_Click"/>
                        <Border Background="#111318" CornerRadius="5" Padding="7" Margin="4,6">
                            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Validation: not generated"/>
                        </Border>

                        <Separator Margin="4,10"/>

                        <TextBlock Text="Export material set" FontSize="16" FontWeight="Bold" Margin="5,4"/>
                        <CheckBox x:Name="IncludeBaseColorCheck" Content="Include selected BaseColor variant (single export)" IsChecked="True" Margin="7,4"/>
                        <TextBlock x:Name="CompatibilityHintText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="7,2,7,5"/>
                        <TextBlock Text="Material registration is automatic in V2.05: every export writes a unique same-basename .shader + .mtr pair; implicit materials get a new block and scripted materials are merged without dropping original stages."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="7,2,7,5"/>
                        <Button Content="Export current material PK3…" Click="ExportButton_Click"/>
                        <Button Content="Export reviewed batch → ONE PK3…" Click="ExportBatchButton_Click"/>

                        <Border Background="#111318" CornerRadius="5" Padding="8" Margin="4,12,4,4">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
                                V2.05: preserves V2.03 macro-relief quality, adds Physical Relief/POM Height generation, multi-texture batch export, and reliable paired .shader + .mtr registration.
                                Original PK3 stays read-only. Physical Relief mode is intended for PBR V3.2 with r_parallaxMapping 2.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel2Brush}" CornerRadius="6" Padding="7" Margin="0,8,0,0">
            <DockPanel>
                <ProgressBar x:Name="BusyProgress" Width="160" Height="12" IsIndeterminate="True" Visibility="Collapsed" DockPanel.Dock="Right"/>
                <TextBlock x:Name="StatusText" Text="Ready."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
